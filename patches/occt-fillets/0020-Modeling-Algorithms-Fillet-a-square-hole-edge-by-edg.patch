diff --git a/tests/bugs/modalg_8/fillet_rounded_cube_all_edges_symmetric b/tests/bugs/modalg_8/fillet_rounded_cube_all_edges_symmetric
new file mode 100644
index 000000000..90c974410
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_rounded_cube_all_edges_symmetric
@@ -0,0 +1,30 @@
+puts "============"
+puts "Modeling Algorithms - Fillet of all edges of a rounded cube with a square hole"
+puts "(FreeCAD issue 20085: cube 20 with fillets of radius 6, square hole 8 x 8)"
+puts "============"
+puts ""
+
+# All edges are given, as by the option of FreeCAD to use all edges: the 8
+# edges of the hole and the 4 concave vertical edges, the others being smooth.
+# Three fillets meet at each corner of the hole, which is closed by a patch.
+# On the face of the sphere of the corner of the cube, the boundary of the
+# patch depended on the axis of the sphere: one corner, whose sphere has a
+# horizontal axis, was turned inside out. The corners are now the same.
+restore [locate_data_file freecad20085_rounded_cube_pocket.brep] b
+explode b E
+
+set all {}
+foreach e [explode b E] {
+  lappend all 2 $e
+}
+eval blend result b $all
+
+checkshape result
+checkmaxtol result -ref 0.0788
+checkprops result -v 5096.3
+
+# The result is symmetric with respect to the axis of the hole.
+regexp {X += +([-0-9.e+]+)\s+Y += +([-0-9.e+]+)} [vprops result] full aX aY
+if {abs($aX) > 5.e-4 || abs($aY) > 5.e-4} {
+  puts "Error: the center of gravity ($aX, $aY) is not on the axis of the hole"
+}
diff --git a/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_second_fillet b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_second_fillet
new file mode 100644
index 000000000..b5f7b0757
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_second_fillet
@@ -0,0 +1,43 @@
+puts "============"
+puts "Modeling Algorithms - Second fillet next to a fillet at a square hole in a rounded cube"
+puts "(FreeCAD issue 20085: cube 20 with fillets of radius 6, square hole 8 x 8)"
+puts "============"
+puts ""
+
+# An upper edge of the hole is filleted, then the next one in a second
+# operation. The second fillet stops at the end of the first one, where its
+# spine goes on along the tangent edge between the wall and the sphere of the
+# corner of the cube: its last section lies in the plane of the wall, which
+# closes it. At its other end the walking went on past the vertex, out of the
+# wall: those surfdatas are not used.
+restore [locate_data_file freecad20085_rounded_cube_pocket.brep] b
+explode b E
+
+foreach {r vol} {1 5150.49 2 5126.76} {
+  # the upper edge on the wall y = 4
+  blend r1 b $r b_43
+
+  # the upper edge on the wall x = -4
+  set e2 ""
+  foreach e [explode r1 E] {
+    set bb [bounding $e]
+    if {abs([lindex $bb 0] + 4.) < 1.e-3 && abs([lindex $bb 3] + 4.) < 1.e-3
+        && abs([lindex $bb 2] - 10.) < 1.e-3 && abs([lindex $bb 5] - 10.) < 1.e-3
+        && [lindex $bb 4] - [lindex $bb 1] > 1.} {
+      set e2 $e
+    }
+  }
+  if {$e2 == ""} {
+    puts "Error: r = $r, the second edge is not found"
+    continue
+  }
+  if {[catch {blend result r1 $r $e2}]} {
+    puts "Error: r = $r, the second fillet is not done"
+    continue
+  }
+
+  checkshape result
+  checkmaxtol result -ref 2.e-4
+  # the second fillet removes as much as the first one
+  checkprops result -v $vol
+}
