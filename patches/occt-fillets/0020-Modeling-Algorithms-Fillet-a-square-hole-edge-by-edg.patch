+//! Removes the surfdatas computed beyond the end of a fillet at a vertex:
+//! the walking went on along the extension of the spine with one side out
+//! of its face (a surfdata with no face on that side), while the last
+//! surfdata on two faces ends on two arcs through the vertex. The end of
+//! the fillet is then computed from that surfdata, as when the walking
+//! stops there.
+//! @param[in] theStripe the stripe ending at the vertex
+//! @param[in] theVtx the vertex
+static void RemoveSurfDataBeyondVertex(const occ::handle<ChFiDS_Stripe>& theStripe,
+                                       const TopoDS_Vertex&              theVtx)
+{
+  int        aSens   = 0;
+  const int  aNum    = ChFi3d_IndexOfSurfData(theVtx, theStripe, aSens);
+  const bool isFirst = (aSens == 1);
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq =
+    theStripe->ChangeSetOfSurfData()->ChangeSequence();
+  const occ::handle<ChFiDS_SurfData>& aLast = aSeq.Value(aNum);
+  if ((aLast->IndexOfS1() == 0) == (aLast->IndexOfS2() == 0))
+  {
+    return;
+  }
+  int anIn = aNum;
+  while (anIn >= 1 && anIn <= aSeq.Length()
+         && (aSeq.Value(anIn)->IndexOfS1() <= 0 || aSeq.Value(anIn)->IndexOfS2() <= 0))
+  {
+    anIn += isFirst ? 1 : -1;
+  }
+  if (anIn < 1 || anIn > aSeq.Length())
+  {
+    return;
+  }
+  const occ::handle<ChFiDS_SurfData>& aSD = aSeq.Value(anIn);
+  for (int k = 1; k <= 2; ++k)
+  {
+    const ChFiDS_CommonPoint& aCP = aSD->Vertex(isFirst, k);
+    if (!aCP.IsOnArc())
+    {
+      return;
+    }
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aCP.Arc(), aV1, aV2);
+    if (!aV1.IsSame(theVtx) && !aV2.IsSame(theVtx))
+    {
+      return;
+    }
+  }
+  if (isFirst)
+  {
+    aSeq.Remove(1, anIn - 1);
+  }
+  else
+  {
+    aSeq.Remove(anIn + 1, aSeq.Length());
+  }
+}
+
+//=================================================================================================
+
+// A face of the result whose wire goes twice through a vertex, the face being
+// on both sides of it (two parts of a face touching at a point, left by a cap
+// cut along the edge between them), is split into one face per part.
+static TopoDS_Shape SplitPinchedFaces(const TopoDS_Shape& theShape)
+{
+  occ::handle<BRepTools_ReShape> aReShape  = new BRepTools_ReShape();
+  bool                           isChanged = false;
+  for (TopExp_Explorer aFExp(theShape, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    const TopoDS_Face& aFace = TopoDS::Face(aFExp.Current());
+    if (BRepCheck_Analyzer(aFace).IsValid())
+    {
+      continue;
+    }
+    // A vertex used by more than two edges of one wire.
+    bool isPinched = false;
+    for (TopExp_Explorer aWExp(aFace, TopAbs_WIRE); aWExp.More() && !isPinched; aWExp.Next())
+    {
+      NCollection_IndexedDataMap<TopoDS_Shape,
+                                 NCollection_List<TopoDS_Shape>,
+                                 TopTools_ShapeMapHasher>
+        aVE;
+      TopExp::MapShapesAndAncestors(aWExp.Current(), TopAbs_VERTEX, TopAbs_EDGE, aVE);
+      for (int i = 1; i <= aVE.Extent() && !isPinched; ++i)
+      {
+        isPinched = aVE(i).Extent() > 2;
+      }
+    }
+    if (!isPinched)
+    {
+      continue;
+    }
+    ShapeFix_Face aFix(aFace);
+    aFix.FixLoopWiresMode()   = 1;
+    aFix.FixSplitFaceMode()   = 1;
+    aFix.FixOrientationMode() = 1;
+    aFix.Perform();
+    const TopoDS_Shape aFixed  = aFix.Result();
+    bool               isValid = true;
+    for (TopExp_Explorer anExp(aFixed, TopAbs_FACE); anExp.More() && isValid; anExp.Next())
+    {
+      isValid = BRepCheck_Analyzer(anExp.Current()).IsValid();
+    }
+    if (isValid)
+    {
+      aReShape->Replace(aFace, aFixed);
+      isChanged = true;
+    }
+  }
+  return isChanged ? aReShape->Apply(theShape) : theShape;
+}
+
+//=================================================================================================
+
 // Two faces built on one surface handle (a cylinder split by a smooth edge)
 // keep both pcurves of their common edge in a single closed representation,
 // and which one each face gets depends on the edge orientation. Rebuilt
@@ -903,6 +1020,7 @@ void ChFi3d_Builder::ComputeOnce()
       }
     }
     FixSwappedPCurves(myShapeResult);
+    myShapeResult = SplitPinchedFaces(myShapeResult);
   }
 }
 
