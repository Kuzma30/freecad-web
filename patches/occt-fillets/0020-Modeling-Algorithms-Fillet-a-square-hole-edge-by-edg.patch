+    const gp_Vec2d          aNrm(-aD.Y(), aD.X());
+    anInG = aUV.Translated(aNrm * 1.e-3);
+    if (aClass.Perform(anInG) != TopAbs_IN)
+    {
+      anInG = aUV.Translated(-aNrm * 1.e-3);
+    }
+  }
+  const TopAbs_Orientation anOrArcG  = OrientationFromSide(aPCArcOnG, anInG);
+  const TopAbs_Orientation anOrLineK = OrientationFromSide(aPCLineOnK, anInK);
