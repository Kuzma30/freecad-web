+    gp_Pnt2d aUV;
+    gp_Vec2d aD;
+    aPCArcOnG->D1(0.5 * (aArcF + aArcL), aUV, aD);
+    if (aD.Magnitude() < gp::Resolution())
+    {
+      return false;
+    }
