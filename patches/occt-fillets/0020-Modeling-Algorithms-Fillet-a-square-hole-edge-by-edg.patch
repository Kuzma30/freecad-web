 //=================================================================================================
 
+// The index of the last surfdata of theStripe at the end theIsFirst with a
+// face on both sides: the surfdatas after it, whose side shrinks to a point
+// (the walking going on along the spine past the place where the ball fits),
+// are not used.
+static int LastSurfDataOnTwoFaces(const occ::handle<ChFiDS_Stripe>& theStripe,
+                                  const int                         theNum,
+                                  const bool                        theIsFirst)
+{
+  const int aNb  = theStripe->SetOfSurfData()->Length();
+  int       aNum = theNum;
+  while (aNum >= 1 && aNum <= aNb)
+  {
+    const occ::handle<ChFiDS_SurfData>& aSD = theStripe->SetOfSurfData()->Value(aNum);
+    if (aSD->IndexOfS1() > 0 && aSD->IndexOfS2() > 0)
+    {
+      return aNum;
+    }
+    aNum += theIsFirst ? 1 : -1;
+  }
+  return theNum;
+}
+
+//=================================================================================================
+
+bool ChFi3d_Builder::PerformCapInSectionPlane(const int theIndex)
+{
+  // The fillet stops before the end of its spine, at a vertex Vs where the
+  // spine goes on along a tangent edge on which the ball does not fit (a
+  // fillet made before has left too narrow a face there). Its last section
+  // lies in a plane through Vs, which is the plane of a face Fv of the shape
+  // near the end of the section. The end is closed by Fv extended up to the
+  // section: a planar cap bounded by the section, by the arc of the section
+  // through Vs (on the face Gj beyond that arc) and by the line from Vs to
+  // the other end of the section on the other support Fk of the fillet.
+  if (myVDataMap(theIndex).Extent() != 1)
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&        DStr    = myDS->ChangeDS();
+  const TopoDS_Vertex&               Vtx     = myVDataMap.FindKey(theIndex);
+  occ::handle<ChFiDS_Stripe>         stripe  = myVDataMap(theIndex).First();
+  int                                sens    = 0;
+  const int                          num0    = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool                         isfirst = (sens == 1);
+  const int                          num     = LastSurfDataOnTwoFaces(stripe, num0, isfirst);
+  const occ::handle<ChFiDS_SurfData> Fd      = stripe->SetOfSurfData()->Value(num);
+  if (Fd->IndexOfS1() <= 0 || Fd->IndexOfS2() <= 0)
+  {
+    return false;
+  }
+  const ChFiDS_CommonPoint* aCP[2] = {&Fd->Vertex(isfirst, 1), &Fd->Vertex(isfirst, 2)};
+  const gp_Pnt              aPVtx  = BRep_Tool::Pnt(Vtx);
+  const double              aTol   = 10. * tolapp3d;
+  for (int k = 0; k < 2; ++k)
+  {
+    if (!aCP[k]->IsOnArc() || aCP[k]->Point().Distance(aPVtx) < aTol)
+    {
+      return false;
+    }
+  }
+
+  // The plane of the last section.
+  const occ::handle<Geom_Surface>& aFilSurf = DStr.Surface(Fd->Surf()).Surface();
+  gp_Pnt2d                         aUVSec[2];
+  for (int k = 0; k < 2; ++k)
+  {
+    const ChFiDS_FaceInterference& aFi = Fd->Interference(k + 1);
+    aUVSec[k]                          = aFi.PCurveOnSurf()->Value(aFi.Parameter(isfirst));
+  }
+  const auto aSectionPoint = [&](const double theT) {
+    const gp_XY aUV = aUVSec[0].XY() * (1. - theT) + aUVSec[1].XY() * theT;
+    return aFilSurf->Value(aUV.X(), aUV.Y());
+  };
+  const gp_Pnt aP0 = aCP[0]->Point(), aP1 = aCP[1]->Point(), aPm = aSectionPoint(0.5);
+  const gp_Vec aNormal = gp_Vec(aP0, aP1).Crossed(gp_Vec(aP0, aPm));
+  if (aNormal.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  const gp_Pln aPln(aP0, gp_Dir(aNormal));
+  for (int i = 1; i < 8; ++i)
+  {
+    if (aPln.Distance(aSectionPoint(i / 8.)) > aTol)
+    {
+      return false;
+    }
+  }
+
+  // The side J whose arc goes through Vs, Vs on the plane and on Fk.
+  for (int aJ = 0; aJ < 2; ++aJ)
+  {
+    const int          aK  = 1 - aJ;
+    const TopoDS_Edge& anA = aCP[aJ]->Arc();
+    const TopoDS_Face  aFj = TopoDS::Face(DStr.Shape(Fd->Index(aJ + 1)));
+    const TopoDS_Face  aFk = TopoDS::Face(DStr.Shape(Fd->Index(aK + 1)));
+    if (!myEFMap.Contains(anA))
+    {
+      continue;
+    }
+    TopoDS_Face aGj;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(myEFMap(anA)); anIt.More(); anIt.Next())
+    {
+      if (!anIt.Value().IsSame(aFj))
+      {
+        aGj = TopoDS::Face(anIt.Value());
+      }
+    }
+    const BRepAdaptor_Surface aFkSurf(aFk, false);
+    if (aGj.IsNull() || aGj.IsSame(aFk) || aFkSurf.GetType() != GeomAbs_Plane)
+    {
+      continue;
+    }
+    TopoDS_Vertex aVA[2];
+    TopExp::Vertices(anA, aVA[0], aVA[1]);
+    for (int m = 0; m < 2; ++m)
+    {
+      const TopoDS_Vertex& aVs = aVA[m];
+      if (aVs.IsNull() || aVs.IsSame(Vtx))
+      {
+        continue;
+      }
+      const gp_Pnt aPVs   = BRep_Tool::Pnt(aVs);
+      bool         isOnFk = false;
+      for (TopExp_Explorer anExp(aFk, TopAbs_VERTEX); anExp.More() && !isOnFk; anExp.Next())
+      {
+        isOnFk = anExp.Current().IsSame(aVs);
+      }
+      if (!isOnFk || aPln.Distance(aPVs) > aTol || aPVs.Distance(aCP[aK]->Point()) < aTol)
+      {
+        continue;
+      }
+      // The line from Vs to the end of the section on Fk is on Fk and on the plane.
+      const gp_Vec aSeg(aPVs, aCP[aK]->Point());
+      if (std::abs(aSeg.Dot(aFkSurf.Plane().Axis().Direction())) > aTol
+          || std::abs(aSeg.Dot(aPln.Axis().Direction())) > aTol)
+      {
+        continue;
+      }
+      // The face Fv in the plane of the section, at the end of the section on Fk.
+      TopoDS_Face                    aFv;
+      NCollection_List<TopoDS_Shape> aCandidates;
+      const auto anAddFaces = [&aCandidates](const NCollection_List<TopoDS_Shape>& theFaces) {
+        for (NCollection_List<TopoDS_Shape>::Iterator anIt(theFaces); anIt.More(); anIt.Next())
+        {
+          aCandidates.Append(anIt.Value());
+        }
+      };
+      if (myEFMap.Contains(aCP[aK]->Arc()))
+      {
+        anAddFaces(myEFMap(aCP[aK]->Arc()));
+      }
+      if (aCP[aK]->IsVertex() && myVFMap.Contains(aCP[aK]->Vertex()))
+      {
+        anAddFaces(myVFMap(aCP[aK]->Vertex()));
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator anIt(aCandidates); anIt.More() && aFv.IsNull();
+           anIt.Next())
+      {
+        const TopoDS_Face&        aF = TopoDS::Face(anIt.Value());
+        const BRepAdaptor_Surface aS(aF, false);
+        if (aF.IsSame(aFk) || aF.IsSame(aFj) || aS.GetType() != GeomAbs_Plane)
+        {
+          continue;
+        }
+        const gp_Pln aP = aS.Plane();
+        if (aP.Axis().Direction().IsParallel(aPln.Axis().Direction(), Precision::Angular())
+            && aP.Distance(aPVs) < aTol)
+        {
+          aFv = aF;
+        }
+      }
+      if (aFv.IsNull())
+      {
+        continue;
+      }
+      return CapInSectionPlane(theIndex, aJ + 1, aVs, aGj);
+    }
+  }
+  return false;
+}
+
+//=================================================================================================
+
+bool ChFi3d_Builder::CapInSectionPlane(const int            theIndex,
+                                       const int            theJ,
+                                       const TopoDS_Vertex& theVs,
+                                       const TopoDS_Face&   theGj)
+{
+  // See PerformCapInSectionPlane: everything is checked, the cap is built as
+  // a corner whose surface is the plane of the section. Its sides are the
+  // arc of side J up to Vs (on Gj) and the line from the end of the section
+  // on Fk to Vs (on Fk); its sections are the last section of the fillet and
+  // the point Vs.
+  TopOpeBRepDS_DataStructure&        DStr    = myDS->ChangeDS();
+  const TopoDS_Vertex&               Vtx     = myVDataMap.FindKey(theIndex);
+  occ::handle<ChFiDS_Stripe>         stripe  = myVDataMap(theIndex).First();
+  int                                sens    = 0;
+  const int                          num0    = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool                         isfirst = (sens == 1);
+  const int                          num     = LastSurfDataOnTwoFaces(stripe, num0, isfirst);
+  const occ::handle<ChFiDS_SurfData> Fd      = stripe->SetOfSurfData()->Value(num);
+  const int                          aK      = 3 - theJ;
+  const ChFiDS_CommonPoint           aCPj    = Fd->Vertex(isfirst, theJ);
+  ChFiDS_CommonPoint                 aCPk    = Fd->Vertex(isfirst, aK);
+  const TopoDS_Face                  aFk     = TopoDS::Face(DStr.Shape(Fd->Index(aK)));
+  const gp_Pnt                       aPVs    = BRep_Tool::Pnt(theVs);
+  const occ::handle<Geom_Surface>    aSk     = BRep_Tool::Surface(aFk);
+
+  // The section, from the point on side 1 to the point on side 2.
+  const ChFiDS_CommonPoint&      aCP1 = Fd->Vertex(isfirst, 1);
+  const ChFiDS_CommonPoint&      aCP2 = Fd->Vertex(isfirst, 2);
+  const ChFiDS_FaceInterference& aFi1 = Fd->Interference(1);
+  const ChFiDS_FaceInterference& aFi2 = Fd->Interference(2);
+  occ::handle<Geom_Curve>        aCSec;
+  occ::handle<Geom2d_Curve>      aPCSecOnFil;
+  double                         aSec1 = 0., aSec2 = 0., aTolSec = tolapp3d;
+  ChFi3d_ComputeArete(aCP1,
+                      aFi1.PCurveOnSurf()->Value(aFi1.Parameter(isfirst)),
+                      aCP2,
+                      aFi2.PCurveOnSurf()->Value(aFi2.Parameter(isfirst)),
+                      DStr.Surface(Fd->Surf()).Surface(),
+                      aCSec,
+                      aPCSecOnFil,
+                      aSec1,
+                      aSec2,
+                      tolapp3d,
+                      tol2d,
+                      aTolSec,
+                      0);
+  if (aCSec.IsNull() || aPCSecOnFil.IsNull())
+  {
+    return false;
+  }
+
+  // The plane of the cap, its normal out of the solid (away from the part of
+  // the spine without fillet).
+  const gp_Pnt aMid = aCSec->Value(0.5 * (aSec1 + aSec2));
+  gp_Vec       aN   = gp_Vec(aCP1.Point(), aCP2.Point()).Crossed(gp_Vec(aCP1.Point(), aMid));
+  if (aN.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Plane> aPlane = new Geom_Plane(gp_Pln(aPVs, gp_Dir(aN)));
+  const bool                    isOut  = aN.Dot(gp_Vec(aPVs, BRep_Tool::Pnt(Vtx))) < 0.;
+
+  // The arc of side J and the line on Fk, both from the section to Vs, or
+  // both from Vs to the section, as the arc goes.
+  double                         anAF = 0., anAL = 0.;
+  const occ::handle<Geom_Curve>& anArcCurve = BRep_Tool::Curve(aCPj.Arc(), anAF, anAL);
+  const double                   aTj        = aCPj.ParameterOnArc();
+  const double                   aTv        = BRep_Tool::Parameter(theVs, aCPj.Arc());
+  const bool                     isFromVs   = aTv < aTj;
+  const double                   aArc1 = std::min(aTj, aTv), aArc2 = std::max(aTj, aTv);
+  if (anArcCurve.IsNull() || aArc2 - aArc1 < Precision::PConfusion())
+  {
+    return false;
+  }
+  // The arc goes from the section to Vs (the point Vs is the last section).
+  occ::handle<Geom_Curve>   aCArc = new Geom_TrimmedCurve(anArcCurve, aArc1, aArc2);
+  occ::handle<Geom2d_Curve> aPCArcOnG;
+  if (isFromVs)
+  {
+    aCArc     = aCArc->Reversed();
+    aPCArcOnG = GeomProjLib::Curve2d(aCArc,
+                                     aCArc->FirstParameter(),
+                                     aCArc->LastParameter(),
+                                     BRep_Tool::Surface(theGj));
+  }
+  else
+  {
+    double aGF = 0., aGL = 0.;
+    aPCArcOnG = BRep_Tool::CurveOnSurface(aCPj.Arc(), theGj, aGF, aGL);
+  }
+  const double                  aArcF = aCArc->FirstParameter(), aArcL = aCArc->LastParameter();
+  const double                  aLen    = aPVs.Distance(aCPk.Point());
+  const gp_Pnt                  aLStart = aCPk.Point();
+  const gp_Pnt                  aLEnd   = aPVs;
+  const occ::handle<Geom_Curve> aCLine =
+    new Geom_TrimmedCurve(new Geom_Line(aLStart, gp_Dir(gp_Vec(aLStart, aLEnd))), 0., aLen);
+  const occ::handle<Geom2d_Curve> aPCSecOnP  = GeomProjLib::Curve2d(aCSec, aSec1, aSec2, aPlane);
+  const occ::handle<Geom2d_Curve> aPCArcOnP  = GeomProjLib::Curve2d(aCArc, aArcF, aArcL, aPlane);
+  const occ::handle<Geom2d_Curve> aPCLineOnP = GeomProjLib::Curve2d(aCLine, 0., aLen, aPlane);
+  const occ::handle<Geom2d_Curve> aPCLineOnK = GeomProjLib::Curve2d(aCLine, 0., aLen, aSk);
