+
+// The same holed cube with a vertical (concave) edge of the hole filleted. At
+// its ends the walls of the hole meet the fillets of the cube along their
+// tangent lines: the last section of the fillet and the edges of the walls up
+// to the vertex lie in the plane of the top (bottom) of the cube, removed by
+// the hole and tangent to the fillets of the cube there. The ends failed with
+// faulty vertices; they are closed by planar caps in that plane.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_ConcaveEdgeEndsInTangentPlane)
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  // The vertical edge at x = 4, y = -4 alone, then with the lower edges on
+  // both sides of it.
+  const gp_Pnt aVertical(4.0, -4.0, 0.0);
+  const gp_Pnt aLower[2] = {gp_Pnt(0.0, -4.0, -10.0), gp_Pnt(4.0, 0.0, -10.0)};
+  for (int aCase = 0; aCase < 2; ++aCase)
+  {
+    const double             aRadius = aCase == 0 ? 2.0 : 1.0;
+    BRepFilletAPI_MakeFillet aFillet(aHoled);
+    for (TopExp_Explorer anExp(aHoled, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      GProp_GProps aProps;
+      BRepGProp::LinearProperties(anExp.Current(), aProps);
+      const gp_Pnt aMid = aProps.CentreOfMass();
+      if (aProps.Mass() > 1.0
+          && (aMid.Distance(aVertical) < 1.e-6
+              || (aCase == 1
+                  && (aMid.Distance(aLower[0]) < 1.e-6 || aMid.Distance(aLower[1]) < 1.e-6))))
+      {
+        aFillet.Add(aRadius, TopoDS::Edge(anExp.Current()));
+      }
+    }
+    ASSERT_EQ(aFillet.NbContours(), aCase == 0 ? 1 : 3);
+    aFillet.Build();
+    ASSERT_TRUE(aFillet.IsDone()) << "case " << aCase;
+    const TopoDS_Shape& aResult = aFillet.Shape();
+    EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid()) << "case " << aCase;
+
+    double aMaxTol = 0.0;
+    for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+    {
+      aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+    }
+    // The corner of the three fillets is a patch.
+    EXPECT_LT(aMaxTol, aCase == 0 ? 1.e-3 : 0.02) << "case " << aCase;
+
+    GProp_GProps aBefore, anAfter;
+    BRepGProp::VolumeProperties(aHoled, aBefore);
+    BRepGProp::VolumeProperties(aResult, anAfter);
+    if (aCase == 0)
+    {
+      // The fillet adds r * r * (1 - pi / 4) * 20.
+      EXPECT_NEAR(anAfter.Mass() - aBefore.Mass(),
+                  aRadius * aRadius * (1.0 - M_PI / 4.0) * 20.0,
+                  1.e-3);
+    }
+    else
+    {
+      EXPECT_NEAR(anAfter.Mass(), 5154.61, 0.05);
+    }
+  }
+}
