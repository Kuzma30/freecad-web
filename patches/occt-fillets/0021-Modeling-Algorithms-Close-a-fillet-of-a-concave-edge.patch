+bool ChFi3d_Builder::PerformCapInTangentPlane(const int theIndex)
+{
+  // The fillet ends at the end vertex V of its spine, its last section on the
+  // arcs A1 and A2 of its supports through V. The section, A1 and A2 lie in a
+  // plane, and the faces G1 and G2 beyond A1 and A2 are tangent to that plane
+  // along them (a concave edge of a hole whose walls meet the rounded edges
+  // of the shape along their tangent lines: the plane is the face of the shape
+  // removed by the hole). The end is closed by a planar cap in that plane,
+  // bounded by the section and by the arcs from the section to V.
+  if (myVDataMap(theIndex).Extent() != 1)
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&        DStr    = myDS->ChangeDS();
+  const TopoDS_Vertex&               Vtx     = myVDataMap.FindKey(theIndex);
+  occ::handle<ChFiDS_Stripe>         stripe  = myVDataMap(theIndex).First();
+  int                                sens    = 0;
+  const int                          num0    = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool                         isfirst = (sens == 1);
+  const int                          num     = LastSurfDataOnTwoFaces(stripe, num0, isfirst);
+  const occ::handle<ChFiDS_SurfData> Fd      = stripe->SetOfSurfData()->Value(num);
+  if (Fd->IndexOfS1() <= 0 || Fd->IndexOfS2() <= 0)
+  {
+    return false;
+  }
+  const gp_Pnt aPVtx = BRep_Tool::Pnt(Vtx);
+  const double aTol  = 10. * tolapp3d;
+  TopoDS_Face  aG[2];
+  for (int k = 0; k < 2; ++k)
+  {
+    const ChFiDS_CommonPoint& aCP = Fd->Vertex(isfirst, k + 1);
+    if (!aCP.IsOnArc() || aCP.Point().Distance(aPVtx) < aTol || !myEFMap.Contains(aCP.Arc()))
+    {
+      return false;
+    }
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aCP.Arc(), aV1, aV2);
+    if (!aV1.IsSame(Vtx) && !aV2.IsSame(Vtx))
+    {
+      return false;
+    }
+    const TopoDS_Shape& aF = DStr.Shape(Fd->Index(k + 1));
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(myEFMap(aCP.Arc())); anIt.More();
+         anIt.Next())
+    {
+      if (!anIt.Value().IsSame(aF))
+      {
+        aG[k] = TopoDS::Face(anIt.Value());
+      }
+    }
+    if (aG[k].IsNull())
+    {
+      return false;
+    }
+  }
+  if (aG[0].IsSame(aG[1]))
+  {
+    return false;
+  }
+
+  // The plane of the last section, through V.
+  const occ::handle<Geom_Surface>& aFilSurf = DStr.Surface(Fd->Surf()).Surface();
+  gp_Pnt2d                         aUVSec[2];
+  for (int k = 0; k < 2; ++k)
+  {
+    const ChFiDS_FaceInterference& aFi = Fd->Interference(k + 1);
+    aUVSec[k]                          = aFi.PCurveOnSurf()->Value(aFi.Parameter(isfirst));
+  }
+  const auto aSectionPoint = [&](const double theT) {
+    const gp_XY aUV = aUVSec[0].XY() * (1. - theT) + aUVSec[1].XY() * theT;
+    return aFilSurf->Value(aUV.X(), aUV.Y());
+  };
+  const gp_Pnt aP0 = Fd->Vertex(isfirst, 1).Point(), aP1 = Fd->Vertex(isfirst, 2).Point();
+  const gp_Vec aNormal = gp_Vec(aP0, aP1).Crossed(gp_Vec(aP0, aSectionPoint(0.5)));
+  if (aNormal.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  const gp_Pln aPln(aP0, gp_Dir(aNormal));
+  if (aPln.Distance(aPVtx) > aTol)
+  {
+    return false;
+  }
+  for (int i = 1; i < 8; ++i)
+  {
+    if (aPln.Distance(aSectionPoint(i / 8.)) > aTol)
+    {
+      return false;
+    }
+  }
+
+  // The arcs from the section to V lie in the plane, the faces beyond them are
+  // tangent to it.
+  for (int k = 0; k < 2; ++k)
+  {
+    const ChFiDS_CommonPoint& aCP = Fd->Vertex(isfirst, k + 1);
+    const BRepAdaptor_Curve   anArc(aCP.Arc());
+    const double              aTc = aCP.ParameterOnArc();
+    const double              aTv = BRep_Tool::Parameter(Vtx, aCP.Arc());
+    const BRepAdaptor_Surface aGS(aG[k], false);
+    for (int i = 1; i < 8; ++i)
+    {
+      const double aT = aTc + (aTv - aTc) * i / 8.;
+      if (aPln.Distance(anArc.Value(aT)) > aTol)
+      {
+        return false;
+      }
+    }
+    double                          aPF = 0., aPL = 0.;
+    const occ::handle<Geom2d_Curve> aPC = BRep_Tool::CurveOnSurface(aCP.Arc(), aG[k], aPF, aPL);
+    if (aPC.IsNull())
+    {
+      return false;
+    }
+    const gp_Pnt2d aUV = aPC->Value(0.5 * (aTc + aTv));
+    gp_Pnt         aP;
+    gp_Vec         aDU, aDV;
+    aGS.D1(aUV.X(), aUV.Y(), aP, aDU, aDV);
+    const gp_Vec aN = aDU.Crossed(aDV);
+    if (aN.Magnitude() < gp::Resolution() || !aN.IsParallel(gp_Vec(aPln.Axis().Direction()), 1.e-6))
+    {
+      return false;
+    }
+  }
+  return CapInSectionPlane(theIndex, 1, Vtx, aG[0], aG[1]);
+}
