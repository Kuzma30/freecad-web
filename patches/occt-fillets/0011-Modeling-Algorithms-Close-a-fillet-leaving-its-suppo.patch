 // Modified:    MPS :  (10-04-97) portage WNT pour GetFilletShape
 
 #include <Adaptor3d_TopolTool.hxx>
+#include <BRepAdaptor_Surface.hxx>
+#include <BRep_Tool.hxx>
+#include <Geom2d_Curve.hxx>
 #include <BRepBlend_ConstRad.hxx>
 #include <BRepBlend_ConstRadInv.hxx>
 #include <BRepBlend_CurvPointRadInv.hxx>
@@ -2669,6 +2672,44 @@ void ChFi3d_FilBuilder::ExtentThreeCorner(const TopoDS_Vertex&
 
 //=================================================================================================
 
+//=================================================================================================
+
+static bool IsTangentAtMiddle(const TopoDS_Edge& theE,
+                              const TopoDS_Face& theF1,
+                              const TopoDS_Face& theF2)
+{
+  // The faces are tangent at the middle of their common edge,
+  // within 0.1 rad.
+  gp_Vec aN[2];
+  double aT = 0.;
+  for (int i = 0; i < 2; ++i)
+  {
+    const TopoDS_Face&              aF = i == 0 ? theF1 : theF2;
+    double                          aFirst, aLast;
+    const occ::handle<Geom2d_Curve> aPC = BRep_Tool::CurveOnSurface(theE, aF, aFirst, aLast);
+    if (aPC.IsNull())
+    {
+      return true;
+    }
+    if (i == 0)
+    {
+      aT = 0.5 * (aFirst + aLast);
+    }
+    const gp_Pnt2d      aUV = aPC->Value(aT);
+    BRepAdaptor_Surface aS(aF, false);
+    gp_Pnt              aP;
+    gp_Vec              aDu, aDv;
+    aS.D1(aUV.X(), aUV.Y(), aP, aDu, aDv);
+    aN[i] = aDu.Crossed(aDv);
+    if (aN[i].SquareMagnitude() < 1.e-14)
+    {
+      return true;
+    }
+  }
+  const double aSin = std::sin(0.1);
+  return aN[0].Normalized().Crossed(aN[1].Normalized()).SquareMagnitude() < aSin * aSin;
+}
