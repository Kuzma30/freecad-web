+// Moves theCurve by whole periods of theSurf so that its value at theParam
+// is the nearest to theRef.
+static void ShiftToPeriod(const occ::handle<Geom_Surface>& theSurf,
+                          const occ::handle<Geom2d_Curve>& theCurve,
+                          const double                     theParam,
+                          const gp_Pnt2d&                  theRef)
+{
+  const gp_Pnt2d aP = theCurve->Value(theParam);
+  gp_Vec2d       aShift(0., 0.);
+  if (theSurf->IsUPeriodic())
+  {
+    const double aPer = theSurf->UPeriod();
+    aShift.SetX(aPer * std::round((theRef.X() - aP.X()) / aPer));
+  }
+  if (theSurf->IsVPeriodic())
+  {
+    const double aPer = theSurf->VPeriod();
+    aShift.SetY(aPer * std::round((theRef.Y() - aP.Y()) / aPer));
+  }
+  if (aShift.SquareMagnitude() > 0.)
+  {
+    theCurve->Translate(aShift);
+  }
+}
+
+// Same for a point.
+static gp_Pnt2d PointInPeriod(const occ::handle<Geom_Surface>& theSurf,
+                              const gp_Pnt2d&                  thePnt,
+                              const gp_Pnt2d&                  theRef)
+{
+  gp_Pnt2d aP = thePnt;
+  if (theSurf->IsUPeriodic())
+  {
+    const double aPer = theSurf->UPeriod();
+    aP.SetX(aP.X() + aPer * std::round((theRef.X() - aP.X()) / aPer));
+  }
+  if (theSurf->IsVPeriodic())
+  {
+    const double aPer = theSurf->VPeriod();
+    aP.SetY(aP.Y() + aPer * std::round((theRef.Y() - aP.Y()) / aPer));
+  }
+  return aP;
+}
+
+// Parameters of a point of a surface, by projection.
+static bool ProjectOnSurface(const Adaptor3d_Surface& theSurf,
+                             const gp_Pnt&            thePnt,
+                             const double             theTol,
+                             gp_Pnt2d&                theUV)
+{
+  Extrema_ExtPS anExt(thePnt,
+                      theSurf,
+                      Precision::PConfusion(),
+                      Precision::PConfusion(),
+                      Extrema_ExtFlag_MIN);
+  if (!anExt.IsDone() || anExt.NbExt() == 0)
+  {
+    return false;
+  }
+  int aBest = 1;
+  for (int i = 2; i <= anExt.NbExt(); ++i)
+  {
+    if (anExt.SquareDistance(i) < anExt.SquareDistance(aBest))
+    {
+      aBest = i;
+    }
+  }
+  if (anExt.SquareDistance(aBest) > theTol * theTol)
+  {
+    return false;
+  }
+  double u, v;
+  anExt.Point(aBest).Parameter(u, v);
+  theUV.SetCoord(u, v);
+  return true;
+}
+
+// Intersection curve of a fillet surface and the surface of a face, from
+// the points (theFil0, theSrf0) to (theFil1, theSrf1). Where the surfaces
+// are tangent (the fillet reaches the face along a support tangent to it)
+// the intersection stops short of the point: the curve is then completed
+// up to it on the fillet.
+static bool CutFillet(const occ::handle<GeomAdaptor_Surface>& theFil,
+                      const occ::handle<BRepAdaptor_Surface>& theSrf,
+                      const occ::handle<Geom_Surface>&        theFilSurf,
+                      const occ::handle<Geom_Surface>&        theSrfSurf,
+                      const gp_Pnt2d&                         theFil0,
+                      const gp_Pnt2d&                         theSrf0,
+                      const gp_Pnt2d&                         theFil1,
+                      const gp_Pnt2d&                         theSrf1,
+                      const double                            theTol3d,
+                      const double                            theTol2d,
+                      const double                            theTolEnds,
+                      const occ::handle<Geom2d_Curve>&        theFil1Side,
+                      occ::handle<Geom_Curve>&                theC3d,
+                      occ::handle<Geom2d_Curve>&              thePcFil,
+                      occ::handle<Geom2d_Curve>&              thePcSrf,
+                      double&                                 theTolReached)
+{
+  NCollection_Array1<double> aDeb(1, 4), aFin(1, 4);
+  aDeb(1) = theFil0.X();
+  aDeb(2) = theFil0.Y();
+  aDeb(3) = theSrf0.X();
+  aDeb(4) = theSrf0.Y();
+  aFin(1) = theFil1.X();
+  aFin(2) = theFil1.Y();
+  aFin(3) = theSrf1.X();
+  aFin(4) = theSrf1.Y();
+  try
+  {
+    OCC_CATCH_SIGNALS
+    if (!ChFi3d_ComputeCurves(theFil,
+                              theSrf,
+                              aDeb,
+                              aFin,
+                              theC3d,
+                              thePcFil,
+                              thePcSrf,
+                              theTol3d,
+                              theTol2d,
+                              theTolReached))
+    {
+      return false;
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+  const gp_Pnt aP0     = theFil->Value(theFil0.X(), theFil0.Y());
+  const gp_Pnt aP1     = theFil->Value(theFil1.X(), theFil1.Y());
+  const double aGap0   = theC3d->Value(theC3d->FirstParameter()).Distance(aP0);
+  const double aGap1   = theC3d->Value(theC3d->LastParameter()).Distance(aP1);
+  const double aSinMin = std::sin(15. * M_PI / 180.);
+  // The curve may also reach theFil1 along its side, touching or crossing
+  // it just before the end. A point is away from that side if it is on the
+  // side of theFil0 and far enough from it, seen from theFil1.
+  const auto isAway = [&](const gp_Pnt2d& theP, const double theSign) -> bool {
+    // The nearest point of the side, its ends included.
+    const double aT0 = theFil1Side->FirstParameter(), aT1 = theFil1Side->LastParameter();
+    double       aT =
+      theFil1Side->Value(aT0).Distance(theP) < theFil1Side->Value(aT1).Distance(theP) ? aT0 : aT1;
+    double                        aDist = theFil1Side->Value(aT).Distance(theP);
+    Geom2dAPI_ProjectPointOnCurve aProj(theP, theFil1Side, aT0, aT1);
+    if (aProj.NbPoints() > 0 && aProj.LowerDistance() < aDist)
+    {
+      aT    = aProj.LowerDistanceParameter();
+      aDist = aProj.LowerDistance();
+    }
+    gp_Pnt2d aPs;
+    gp_Vec2d aTs;
+    theFil1Side->D1(aT, aPs, aTs);
+    const double aSide = aTs.Crossed(gp_Vec2d(aPs, theP));
+    return aSide * theSign >= 0. && aDist >= aSinMin * theP.Distance(theFil1);
+  };
+  double aSign       = 0.;
+  bool   isAlongSide = false;
+  if (!theFil1Side.IsNull())
+  {
+    Geom2dAPI_ProjectPointOnCurve aProj0(theFil0,
+                                         theFil1Side,
+                                         theFil1Side->FirstParameter(),
+                                         theFil1Side->LastParameter());
+    if (aProj0.NbPoints() > 0)
+    {
+      gp_Pnt2d aPs;
+      gp_Vec2d aTs;
+      theFil1Side->D1(aProj0.LowerDistanceParameter(), aPs, aTs);
+      aSign = aTs.Crossed(gp_Vec2d(aPs, theFil0)) >= 0. ? 1. : -1.;
+    }
+    const double aFirstPar = theC3d->FirstParameter();
+    const double aLastPar0 = theC3d->LastParameter();
+    for (int i = 1; i < 1000 && !isAlongSide; ++i)
+    {
+      isAlongSide =
+        !isAway(thePcFil->Value(aFirstPar + (aLastPar0 - aFirstPar) * 0.001 * i), aSign);
+    }
+  }
+  // Ends farther than the approximation tolerance are completed.
+  if (aGap0 <= theTol3d && aGap1 <= theTol3d && !isAlongSide)
+  {
+    return true;
+  }
+  // Only a short end lost along a tangency is completed, by a straight
+  // segment in the parameters of the fillet: the curve stays on the fillet
+  // and inside its face, its distance to the other surface is small there.
+  const double aLength = aP0.Distance(aP1);
+  if (aGap0 > 0.05 * aLength || aGap1 > 0.05 * aLength)
+  {
+    return false;
+  }
+  // Near a tangency the intersection runs along the side of the fillet that
+  // ends at theFil1: the curve is taken back to where the segment up to
+  // theFil1 leaves that side at an angle.
+  double aLastPar = theC3d->LastParameter();
+  if ((aGap1 > theTol3d || isAlongSide) && !theFil1Side.IsNull())
+  {
+    const double aFirstPar = theC3d->FirstParameter();
+    for (int i = 1; i <= 100; ++i)
+    {
+      const double aW = aLastPar - (aLastPar - aFirstPar) * 0.005 * i;
+      if (isAway(thePcFil->Value(aW), aSign))
+      {
+        aLastPar = aW;
+        break;
+      }
+      if (i == 100)
+      {
+        return false;
+      }
+    }
+  }
+  occ::handle<Geom2d_BSplineCurve> aFil2d;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    aFil2d = Geom2dConvert::CurveToBSplineCurve(
+      new Geom2d_TrimmedCurve(thePcFil, theC3d->FirstParameter(), aLastPar));
+    Geom2dConvert_CompCurveToBSplineCurve aComp(aFil2d);
+    if (aGap0 > theTol3d)
+    {
+      const gp_Pnt2d aFrom = aFil2d->Value(aFil2d->FirstParameter());
+      if (aFrom.Distance(theFil0) > Precision::PConfusion())
+      {
+        aComp.Add(
+          new Geom2d_TrimmedCurve(new Geom2d_Line(theFil0, gp_Dir2d(gp_Vec2d(theFil0, aFrom))),
+                                  0.,
+                                  theFil0.Distance(aFrom)),
+          Precision::PConfusion(),
+          false);
+      }
+    }
+    if (aGap1 > theTol3d || aLastPar < theC3d->LastParameter())
+    {
+      const gp_Pnt2d aFrom = aFil2d->Value(aFil2d->LastParameter());
+      if (aFrom.Distance(theFil1) > Precision::PConfusion())
+      {
+        aComp.Add(
+          new Geom2d_TrimmedCurve(new Geom2d_Line(aFrom, gp_Dir2d(gp_Vec2d(aFrom, theFil1))),
+                                  0.,
+                                  aFrom.Distance(theFil1)),
+          Precision::PConfusion(),
+          true);
+      }
+    }
+    aFil2d = aComp.BSplineCurve();
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+  occ::handle<Geom_Curve> aBC;
+  {
+    Adaptor3d_CurveOnSurface aCOnS(new Geom2dAdaptor_Curve(aFil2d), theFil);
+    double                   aMaxDev = 0., anAvDev = 0.;
+    GeomLib::BuildCurve3d(theTol3d,
+                          aCOnS,
+                          aFil2d->FirstParameter(),
+                          aFil2d->LastParameter(),
+                          aBC,
+                          aMaxDev,
+                          anAvDev);
+    if (aBC.IsNull())
+    {
+      return false;
+    }
+  }
+  double                    aTolS = theTol3d;
+  occ::handle<Geom2d_Curve> aPcF  = aFil2d;
+  occ::handle<Geom2d_Curve> aPcS =
+    GeomProjLib::Curve2d(aBC, aBC->FirstParameter(), aBC->LastParameter(), theSrfSurf, aTolS);
+  if (aPcS.IsNull())
+  {
+    return false;
+  }
+  ShiftToPeriod(theSrfSurf, aPcS, aBC->FirstParameter(), theSrf0);
+  // The tolerance is the distance of the curve to the two surfaces.
+  double aDev = aTolS;
+  for (int i = 0; i <= 40; ++i)
+  {
+    const double aW =
+      aBC->FirstParameter() + (aBC->LastParameter() - aBC->FirstParameter()) * i / 40.;
+    const gp_Pnt   aP  = aBC->Value(aW);
+    const gp_Pnt2d aUf = aPcF->Value(aW);
+    const gp_Pnt2d aUs = aPcS->Value(aW);
+    aDev               = std::max(aDev, aP.Distance(theFilSurf->Value(aUf.X(), aUf.Y())));
+    aDev               = std::max(aDev, aP.Distance(theSrfSurf->Value(aUs.X(), aUs.Y())));
+  }
+  if (aBC->Value(aBC->FirstParameter()).Distance(aP0) > theTolEnds
+      || aBC->Value(aBC->LastParameter()).Distance(aP1) > theTolEnds)
+  {
+    return false;
+  }
+  aDev          = std::max(aDev, aBC->Value(aBC->FirstParameter()).Distance(aP0));
+  aDev          = std::max(aDev, aBC->Value(aBC->LastParameter()).Distance(aP1));
+  theC3d        = aBC;
+  thePcFil      = aPcF;
+  thePcSrf      = aPcS;
+  theTolReached = std::max(theTolReached, aDev);
+  return true;
+}
+
+// Orientation of the curve of a surfdata on the side theOnS, computed as in
+// ChFi3d_FilDS from the interference of the side 1 (or 2 without face on 1).
+static TopAbs_Orientation TransitionOnFillet(const TopOpeBRepDS_DataStructure&   theDStr,
+                                             const occ::handle<ChFiDS_SurfData>& theFd,
+                                             const int                           theOnS)
+{
+  const int                      anIs1 = theFd->IndexOfS1() > 0 ? 1 : 2;
+  const ChFiDS_FaceInterference& aFi   = theFd->Interference(anIs1);
+  TopAbs_Orientation             aTr   = theDStr.Shape(theFd->Index(anIs1)).Orientation();
+  aTr =
+    TopAbs::Compose(TopAbs::Reverse(aFi.Transition()), TopAbs::Compose(aTr, theFd->Orientation()));
+  return theOnS == anIs1 ? aTr : TopAbs::Reverse(aTr);
+}
+
+// The face of theFaces (the faces of an edge) other than theF.
+static TopoDS_Face OtherFace(const NCollection_List<TopoDS_Shape>& theFaces,
+                             const TopoDS_Face&                    theF)
+{
+  TopoDS_Face aRes;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theFaces); anIt.More(); anIt.Next())
+  {
+    if (!theF.IsSame(anIt.Value()))
+    {
+      aRes = TopoDS::Face(anIt.Value());
+    }
+  }
+  return aRes;
+}
+
+// The edge at the vertex common to two faces.
+static TopoDS_Edge CommonEdge(const NCollection_List<TopoDS_Shape>& theEdges,
+                              const TopoDS_Face&                    theF1,
+                              const TopoDS_Face&                    theF2)
+{
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theEdges); anIt.More(); anIt.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anIt.Value());
+    if (!BRep_Tool::Degenerated(anE) && IsEdgeOfFace(anE, theF1) && IsEdgeOfFace(anE, theF2))
+    {
+      return anE;
+    }
+  }
+  return TopoDS_Edge();
+}
+
+// Where the straight section from theAd to theOp on the fillet theFil
+// crosses theSurf, the nearest to theAd.
+static bool CrossSection(const occ::handle<GeomAdaptor_Surface>& theFil,
+                         const gp_Pnt2d&                         theAd,
+                         const gp_Pnt2d&                         theOp,
+                         const occ::handle<Adaptor3d_Surface>&   theSurf,
+                         gp_Pnt2d&                               theUV)
+{
+  const double aLen = theAd.Distance(theOp);
+  if (aLen < Precision::PConfusion())
+  {
+    return false;
+  }
+  occ::handle<Geom2d_Line> aSec = new Geom2d_Line(theAd, gp_Dir2d(gp_Vec2d(theAd, theOp)));
+  occ::handle<Adaptor3d_CurveOnSurface> aSec3d =
+    new Adaptor3d_CurveOnSurface(new Geom2dAdaptor_Curve(aSec, 0., aLen), theFil);
+  IntCurveSurface_HInter anInter;
+  anInter.Perform(aSec3d, theSurf);
+  if (!anInter.IsDone())
+  {
+    return false;
+  }
+  double aBest = RealLast();
+  for (int i = 1; i <= anInter.NbPoints(); ++i)
+  {
+    const double aW = anInter.Point(i).W();
+    if (aW > 1.e-3 * aLen && aW < (1. - 1.e-3) * aLen && aW < aBest)
+    {
+      aBest = aW;
+    }
+  }
+  if (aBest == RealLast())
+  {
+    return false;
+  }
+  theUV = aSec->Value(aBest);
+  return true;
+}
+
+// CutFillet from theFil0/theSrf0 towards theFil1/theSrf1, the end of the
+// stripe: the cut goes in the direction of the surfdata, reversed at the
+// start of the stripe (theIsFirst). theSide, the side the cut may have to
+// be completed along at theFil1, is only used at the end of the stripe.
+static bool CutFilletAlong(const bool                              theIsFirst,
+                           const occ::handle<GeomAdaptor_Surface>& theFil,
+                           const occ::handle<BRepAdaptor_Surface>& theSrf,
+                           const occ::handle<Geom_Surface>&        theSrfSurf,
+                           const gp_Pnt2d&                         theFil0,
+                           const gp_Pnt2d&                         theSrf0,
+                           const gp_Pnt2d&                         theFil1,
+                           const gp_Pnt2d&                         theSrf1,
+                           const double                            theTol3d,
+                           const double                            theTol2d,
+                           const double                            theTolEnds,
+                           const occ::handle<Geom2d_Curve>&        theSide,
+                           occ::handle<Geom_Curve>&                theC3d,
+                           occ::handle<Geom2d_Curve>&              thePcFil,
+                           occ::handle<Geom2d_Curve>&              thePcSrf,
+                           double&                                 theTolReached)
+{
+  return theIsFirst ? CutFillet(theFil,
+                                theSrf,
+                                theFil->Surface(),
+                                theSrfSurf,
+                                theFil1,
+                                theSrf1,
+                                theFil0,
+                                theSrf0,
+                                theTol3d,
+                                theTol2d,
+                                theTolEnds,
+                                occ::handle<Geom2d_Curve>(),
+                                theC3d,
+                                thePcFil,
+                                thePcSrf,
+                                theTolReached)
+                    : CutFillet(theFil,
+                                theSrf,
+                                theFil->Surface(),
+                                theSrfSurf,
+                                theFil0,
+                                theSrf0,
+                                theFil1,
+                                theSrf1,
+                                theTol3d,
+                                theTol2d,
+                                theTolEnds,
+                                theSide,
+                                theC3d,
+                                thePcFil,
+                                thePcSrf,
+                                theTolReached);
+}
+
+// Splits theFprev at CP1, where its side theIad leaves its face on theArcA:
+// returns its end part theFb, on its own copy of the surface and of the
+// trace of the side iop; theFprev ends at CP1.
+static occ::handle<ChFiDS_SurfData> SplitAtCP1(TopOpeBRepDS_DataStructure&         theDStr,
+                                               const occ::handle<ChFiDS_SurfData>& theFprev,
+                                               const int                           theIad,
+                                               const bool                          theIsFirst,
+                                               const double                        theWCut,
+                                               const ChFiDS_CommonPoint&           theCP1,
+                                               const int                           theTraceOp,
+                                               const double                        theTolPnt)
+{
+  const int                    iop = 3 - theIad;
+  occ::handle<ChFiDS_SurfData> aFb = new ChFiDS_SurfData();
+  aFb->Copy(theFprev);
+  // A copy of the surface: two faces of one surface would share the pcurves
+  // of their edges.
+  const TopOpeBRepDS_Surface&     aPrevSurf = theDStr.Surface(theFprev->Surf());
+  const occ::handle<Geom_Surface> aSurfB =
+    occ::down_cast<Geom_Surface>(aPrevSurf.Surface()->Copy());
+  aFb->ChangeSurf(theDStr.AddSurface(TopOpeBRepDS_Surface(aSurfB, aPrevSurf.Tolerance())));
+  const occ::handle<Geom_Curve>& aTraceOp = theDStr.Curve(theTraceOp).Curve();
+  aFb->ChangeInterference(iop).SetLineIndex(
+    theDStr.AddCurve(TopOpeBRepDS_Curve(aTraceOp, theDStr.Curve(theTraceOp).Tolerance())));
+  aFb->ChangeInterference(iop).SetParameter(theWCut, !theIsFirst);
+  // The points of the corner get the tolerance of its curves: the one of CP1
+  // may come from the end of the walking on the tangent plane.
+  ChFiDS_CommonPoint aCP1;
+  aCP1.SetPoint(theCP1.Point());
+  aCP1.SetArc(std::max(theTolPnt, BRep_Tool::Tolerance(theCP1.Arc())),
+              theCP1.Arc(),
+              theCP1.ParameterOnArc(),
+              theCP1.TransitionOnArc());
+  aCP1.SetParameter(theCP1.Parameter());
+  ChFiDS_CommonPoint aCP1b;
+  aCP1b.SetPoint(aTraceOp->Value(theWCut));
+  aCP1b.SetParameter(theWCut);
+  aCP1b.SetTolerance(theTolPnt);
+  aFb->ChangeVertex(!theIsFirst, theIad)     = aCP1;
+  aFb->ChangeVertex(!theIsFirst, iop)        = aCP1b;
+  theFprev->ChangeVertex(theIsFirst, theIad) = aCP1;
+  theFprev->ChangeInterference(iop).SetParameter(theWCut, theIsFirst);
+  theFprev->ChangeVertex(theIsFirst, iop) = aCP1b;
+  if (theIsFirst)
+  {
+    aFb->LastSpineParam(theWCut);
+    theFprev->FirstSpineParam(theWCut);
+  }
+  else
+  {
+    aFb->FirstSpineParam(theWCut);
+    theFprev->LastSpineParam(theWCut);
+  }
+  return aFb;
+}
+
+// The section between two consecutive pieces theIn and theOut of the
+// fillet, theOut after theIn from the cut towards the end of the stripe,
+// from the point theX on the side theIad to theOp on the other side.
+static void AddSection(TopOpeBRepDS_DataStructure&         theDStr,
+                       NCollection_List<ChFiDS_Regul>&     theRegul,
+                       const bool                          theIsFirst,
+                       const int                           theIad,
+                       const occ::handle<ChFiDS_SurfData>& theIn,
+                       const occ::handle<ChFiDS_SurfData>& theOut,
+                       const ChFiDS_CommonPoint&           theX,
+                       const ChFiDS_CommonPoint&           theOp,
+                       const int                           theIndX,
+                       const int                           theIndOp,
+                       const gp_Pnt2d&                     theXin,
+                       const gp_Pnt2d&                     theOpIn,
+                       const gp_Pnt2d&                     theXout,
+                       const gp_Pnt2d&                     theOpOut,
+                       const double                        theTol3d,
+                       const double                        theTol2d)
+{
+  const bool                isAd1 = theIad == 1;
+  occ::handle<Geom_Curve>   aSec3d;
+  occ::handle<Geom2d_Curve> aSecIn, aSecOut;
+  double                    aParDeb = 0., aParFin = 0., aTolSec = theTol3d;
+  ChFi3d_ComputeArete(isAd1 ? theX : theOp,
+                      isAd1 ? theXin : theOpIn,
+                      isAd1 ? theOp : theX,
+                      isAd1 ? theOpIn : theXin,
+                      theDStr.Surface(theIn->Surf()).Surface(),
+                      aSec3d,
+                      aSecIn,
+                      aParDeb,
+                      aParFin,
+                      theTol3d,
+                      theTol2d,
+                      aTolSec,
+                      0);
+  double aTolSecO = aTolSec;
+  ChFi3d_ComputePCurv(aSec3d,
+                      isAd1 ? theXout : theOpOut,
+                      isAd1 ? theOpOut : theXout,
+                      aSecOut,
+                      theDStr.Surface(theOut->Surf()).Surface(),
+                      aParDeb,
+                      aParFin,
+                      theTol3d,
+                      aTolSecO);
+  const int ISec = theDStr.AddCurve(TopOpeBRepDS_Curve(aSec3d, std::max(aTolSec, aTolSecO)));
+  theDStr.ChangeCurveInterferences(ISec).Append(
+    ChFi3d_FilPointInDS(TopAbs_FORWARD, ISec, isAd1 ? theIndX : theIndOp, aParDeb));
+  theDStr.ChangeCurveInterferences(ISec).Append(
+    ChFi3d_FilPointInDS(TopAbs_REVERSED, ISec, isAd1 ? theIndOp : theIndX, aParFin));
+  // As in ChFi3d_FilDS: kept as the side 1 at the end of the first
+  // surfdata, and the reverse at the start of the next one.
+  const occ::handle<ChFiDS_SurfData>& aBefore = theIsFirst ? theOut : theIn;
+  const occ::handle<ChFiDS_SurfData>& anAfter = theIsFirst ? theIn : theOut;
+  theDStr.ChangeSurfaceInterferences(aBefore->Surf())
+    .Append(ChFi3d_FilCurveInDS(ISec,
+                                aBefore->Surf(),
+                                aBefore == theIn ? aSecIn : aSecOut,
+                                TransitionOnFillet(theDStr, aBefore, 1)));
+  theDStr.ChangeSurfaceInterferences(anAfter->Surf())
+    .Append(ChFi3d_FilCurveInDS(ISec,
+                                anAfter->Surf(),
+                                anAfter == theIn ? aSecIn : aSecOut,
+                                TopAbs::Reverse(TransitionOnFillet(theDStr, anAfter, 1))));
+  // The two are pieces of one fillet surface.
+  ChFiDS_Regul aRegSec;
+  aRegSec.SetCurve(ISec);
+  aRegSec.SetS1(theIn->Surf(), false);
+  aRegSec.SetS2(theOut->Surf(), false);
+  theRegul.Append(aRegSec);
+}
+
+// The edges of theFv from theArc to the vertex theVtx (also edges of
+// theAlso when it is given) are inside the extended theFv: they are removed
+// as the spine edge, at the vertex.
+static void RemoveEdgesToVertex(TopOpeBRepDS_DataStructure& theDStr,
+                                const TopoDS_Face&          theFv,
+                                const TopoDS_Edge&          theArc,
+                                const TopoDS_Vertex&        theVtx,
+                                const TopoDS_Face&          theAlso)
+{
+  TopoDS_Vertex aVA1, aVA2;
+  TopExp::Vertices(theArc, aVA1, aVA2);
+  TopoDS_Vertex aCur  = BRep_Tool::Pnt(aVA1).Distance(BRep_Tool::Pnt(theVtx))
+                           < BRep_Tool::Pnt(aVA2).Distance(BRep_Tool::Pnt(theVtx))
+                          ? aVA1
+                          : aVA2;
+  TopoDS_Edge   aPrev = theArc;
+  for (int aGuard = 0; aGuard < 10 && !aCur.IsSame(theVtx); ++aGuard)
+  {
+    TopoDS_Edge aNext;
+    for (TopExp_Explorer anExp(theFv, TopAbs_EDGE); anExp.More() && aNext.IsNull(); anExp.Next())
+    {
+      const TopoDS_Edge& anE = TopoDS::Edge(anExp.Current());
+      if (anE.IsSame(aPrev) || BRep_Tool::Degenerated(anE)
+          || (!theAlso.IsNull() && !IsEdgeOfFace(anE, theAlso)))
+      {
+        continue;
+      }
+      TopoDS_Vertex aV1, aV2;
+      TopExp::Vertices(anE, aV1, aV2);
+      if (aV1.IsSame(aCur) || aV2.IsSame(aCur))
+      {
+        aNext = anE;
+      }
+    }
+    if (aNext.IsNull())
+    {
+      break;
+    }
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aNext, aV1, aV2);
+    const TopoDS_Vertex aFar = aV1.IsSame(aCur) ? aV2 : aV1;
+    // Removed from its vertex towards the end of the fillet.
+    TopAbs_Orientation anOV = TopAbs_FORWARD;
+    for (TopExp_Explorer ex(aNext.Oriented(TopAbs_FORWARD), TopAbs_VERTEX); ex.More(); ex.Next())
+    {
+      if (aFar.IsSame(ex.Current()))
+      {
+        anOV = ex.Current().Orientation();
+        break;
+      }
+    }
+    const int IE = theDStr.AddShape(aNext);
+    theDStr.ChangeShapeInterferences(IE).Append(
+      ChFi3d_FilVertexInDS(TopAbs::Reverse(anOV),
+                           IE,
+                           theDStr.AddShape(aFar),
+                           BRep_Tool::Parameter(aFar, aNext)));
+    aPrev = aNext;
+    aCur  = aFar;
+  }
+}
+
+// The arc theArcC is cut at the end theCP of the fillet (the last section
+// is reduced to it, ChFi3d_FilDS does not do it), the spine edge at the
+// vertex.
+static void CutAtEnd(TopOpeBRepDS_DataStructure&      theDStr,
+                     const occ::handle<ChFiDS_Spine>& theSpine,
+                     const bool                       theIsFirst,
+                     const TopoDS_Vertex&             theVtx,
+                     const int                        theIVtx,
+                     const ChFiDS_CommonPoint&        theCP,
+                     const int                        theIndCP)
+{
+  const int IArcC = theDStr.AddShape(theCP.Arc());
+  theDStr.ChangeShapeInterferences(IArcC).Append(
+    ChFi3d_FilPointInDS(theCP.TransitionOnArc(), IArcC, theIndCP, theCP.ParameterOnArc()));
+  const TopoDS_Edge& Arcspine =
+    theIsFirst ? theSpine->Edges(1) : theSpine->Edges(theSpine->NbEdges());
+  TopAbs_Orientation OVtx = TopAbs_FORWARD;
+  for (TopExp_Explorer ex(Arcspine.Oriented(TopAbs_FORWARD), TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    if (theVtx.IsSame(ex.Current()))
+    {
+      OVtx = ex.Current().Orientation();
+      break;
+    }
+  }
+  const int IArcspine = theDStr.AddShape(Arcspine);
+  theDStr.ChangeShapeInterferences(IArcspine).Append(
+    ChFi3d_FilVertexInDS(TopAbs::Reverse(OVtx),
+                         IArcspine,
+                         theIVtx,
+                         BRep_Tool::Parameter(theVtx, Arcspine)));
+}
