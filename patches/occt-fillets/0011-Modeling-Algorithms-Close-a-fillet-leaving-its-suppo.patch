+//=================================================================================================
+
+bool ChFi3d_Builder::PerformCapAfterExtension(const int theIndex)
+{
+  // The fillet has left its support face Fad across an arc A on
+  // one side before the end of its spine: the side ends on A at
+  // CP1 while the surfdata goes on, the opposite side ending at
+  // CP2 on an arc where that support continues on a tangent face.
+  // The walking went on, along the tangent plane of Fad, up to
+  // the end P of the opposite side on an arc C. When the faces
+  // Fv1 beyond A and Fv2 beyond C are two faces of one surface
+  // meeting at the vertex, the fillet is closed by that surface:
+  // it is cut along its intersection with the surface from CP1,
+  // across the section at CP2 (point X), up to P. Fv1 is extended
+  // up to the cut from CP1 to X, Fv2 from X to P, the two being
+  // separated by a curve from the vertex to X.
+  // The surfdata of CP1 is split there: its end part takes Fv1
+  // on the side of A, the last surfdata takes Fv2.
+  // With a small radius the walking may go on along the surface
+  // of Fad within the last surfdata: it is then first split in
+  // the middle between CP1 and its end, the part after the split
+  // playing the surfdata computed on the tangent plane.
+  if (myVDataMap(theIndex).Extent() != 1)
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&       DStr   = myDS->ChangeDS();
+  const TopoDS_Vertex&              Vtx    = myVDataMap.FindKey(theIndex);
+  const occ::handle<ChFiDS_Stripe>& stripe = myVDataMap(theIndex).First();
+  const occ::handle<ChFiDS_Spine>&  spine  = stripe->Spine();
+  if (spine.IsNull() || spine->IsPeriodic())
+  {
+    return false;
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& SeqFil =
+    stripe->ChangeSetOfSurfData()->ChangeSequence();
+  int        sens    = 0;
+  const int  num     = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool isfirst = (sens == 1);
+  if (isfirst)
+  {
+    return false; // only the end of the stripe is processed
+  }
+  const int                    numPrev = isfirst ? num + 1 : num - 1;
+  occ::handle<ChFiDS_SurfData> Fd      = SeqFil.Value(num);
+  occ::handle<ChFiDS_SurfData> Fprev;
+  int                          iad = 0;
+  // Either the last surfdata was computed on the tangent plane of Fad (no
+  // face on the side iad), or the walking went on along the surface of Fad
+  // after the side iad had left the face: then the last surfdata is split
+  // in two in the same way, the part after the split playing the first.
+  bool isSplit = false;
+  if (Fd->IndexOfS1() == 0 && Fd->IndexOfS2() > 0)
+  {
+    iad = 1;
+  }
+  else if (Fd->IndexOfS2() == 0 && Fd->IndexOfS1() > 0)
+  {
+    iad = 2;
+  }
+  else if (Fd->IndexOfS1() > 0 && Fd->IndexOfS2() > 0)
+  {
+    for (int i = 1; i <= 2 && iad == 0; ++i)
+    {
+      const ChFiDS_FaceInterference& aFi = Fd->Interference(i);
+      const ChFiDS_FaceInterference& aFo = Fd->Interference(3 - i);
+      const double aLeft                 = isfirst ? aFi.Parameter(isfirst) - aFo.Parameter(isfirst)
+                                                   : aFo.Parameter(isfirst) - aFi.Parameter(isfirst);
+      if (Fd->Vertex(isfirst, i).IsOnArc() && Fd->Vertex(isfirst, 3 - i).IsOnArc()
+          && aLeft > 20. * tolesp)
+      {
+        iad = i;
+      }
+    }
+    isSplit = (iad != 0);
+  }
+  if (iad == 0)
+  {
+    return false;
+  }
+  const int iop = 3 - iad;
+  if (isSplit)
+  {
+    Fprev = Fd;
+  }
+  else
+  {
+    if (numPrev < 1 || numPrev > SeqFil.Length())
+    {
+      return false;
+    }
+    Fprev = SeqFil.Value(numPrev);
+  }
+  if (Fprev->IndexOfS1() <= 0 || Fprev->IndexOfS2() <= 0)
+  {
+    return false;
+  }
+
+  // The side iad of Fprev ends on the arc A before Fprev ends.
+  // Copies: the surfdatas are changed below.
+  const ChFiDS_CommonPoint CP1   = Fprev->Vertex(isfirst, iad);
+  ChFiDS_CommonPoint       CP2   = Fprev->Vertex(isfirst, iop);
+  const ChFiDS_CommonPoint CPop  = Fd->Vertex(isfirst, iop);
+  ChFiDS_FaceInterference  FiPad = Fprev->Interference(iad);
+  ChFiDS_FaceInterference  FiPop = Fprev->Interference(iop);
+  if (!CP1.IsOnArc() || CP1.IsVertex() || !CPop.IsOnArc() || CPop.IsVertex()
+      || FiPad.LineIndex() == 0 || FiPop.LineIndex() == 0 || FiPad.PCurveOnSurf().IsNull()
+      || FiPop.PCurveOnSurf().IsNull() || Fd->Interference(iad).PCurveOnSurf().IsNull()
+      || Fd->Interference(iop).PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  if (DStr.Curve(FiPop.LineIndex()).Curve().IsNull())
+  {
+    return false;
+  }
+  const double wCut = FiPad.Parameter(isfirst);
+  double       wEnd = FiPop.Parameter(isfirst);
+  if ((isfirst ? wCut - wEnd : wEnd - wCut) < 10. * tolesp)
+  {
+    return false;
+  }
+  // The surface of Fd, a copy of the surface of Fprev when it is split.
+  occ::handle<Geom_Surface> aSurfD = DStr.Surface(Fd->Surf()).Surface();
+  if (isSplit)
+  {
+    // Split in the middle between CP1 and the end.
+    const double wX = 0.5 * (wCut + wEnd);
+    wEnd            = wX;
+    aSurfD          = occ::down_cast<Geom_Surface>(aSurfD->Copy());
+    Fd              = new ChFiDS_SurfData();
+    Fd->Copy(Fprev);
+    if (iad == 1)
+    {
+      Fd->ChangeIndexOfS1(0);
+    }
+    else
+    {
+      Fd->ChangeIndexOfS2(0);
+    }
+    Fd->ChangeInterference(iad).SetParameter(wX, !isfirst);
+    Fd->ChangeInterference(iop).SetParameter(wX, !isfirst);
+    if (isfirst)
+    {
+      Fd->LastSpineParam(wX);
+    }
+    else
+    {
+      Fd->FirstSpineParam(wX);
+    }
+    // The point of the trace at the split.
+    const ChFiDS_CommonPoint aCPEnd = CP2;
+    CP2.Reset();
+    CP2.SetPoint(DStr.Curve(FiPop.LineIndex()).Curve()->Value(wX));
+    CP2.SetParameter(wX);
+    CP2.SetTolerance(std::max(tolapp3d, aCPEnd.Tolerance()));
+    Fd->ChangeVertex(!isfirst, iop) = CP2;
+    FiPop.SetParameter(wX, isfirst);
+  }
+  const ChFiDS_FaceInterference FiOp = Fd->Interference(iop);
+  if (FiOp.LineIndex() == 0)
+  {
+    return false;
+  }
+  const TopoDS_Face Fad  = TopoDS::Face(DStr.Shape(Fprev->Index(iad)));
+  const TopoDS_Face Fop  = TopoDS::Face(DStr.Shape(Fd->Index(iop)));
+  const TopoDS_Edge ArcA = CP1.Arc();
+  const TopoDS_Edge ArcC = CPop.Arc();
+  if (!IsEdgeOfFace(ArcA, Fad) || !IsEdgeOfFace(ArcC, Fop))
+  {
+    return false;
+  }
+  TopoDS_Face Fv1 = OtherFace(myEFMap(ArcA), Fad);
+  TopoDS_Face Fv2 = OtherFace(myEFMap(ArcC), Fop);
+  if (Fv1.IsNull() || Fv2.IsNull() || Fv1.IsSame(Fv2) || Fv1.IsSame(Fop) || Fv2.IsSame(Fad)
+      || Fv1.IsSame(Fad) || Fv2.IsSame(Fop))
+  {
+    return false;
+  }
+  // Fad really ends at A, and the two faces beyond meet at the vertex along
+  // an edge of one surface.
+  if (BRep_Tool::Continuity(ArcA, Fad, Fv1) != GeomAbs_C0)
+  {
+    return false;
+  }
+  const TopoDS_Edge aCommon = CommonEdge(myVEMap(Vtx), Fv1, Fv2);
+  if (aCommon.IsNull() || BRep_Tool::Continuity(aCommon, Fv1, Fv2) < GeomAbs_G2)
+  {
+    return false;
+  }
+  // The faces are stored in the DS as they are in the shape; their
+  // geometry is taken on the forward faces.
+  const TopoDS_Face Fv1InShape = Fv1;
+  const TopoDS_Face Fv2InShape = Fv2;
+  Fv1.Orientation(TopAbs_FORWARD);
+  Fv2.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom_Surface> aS1 = BRep_Tool::Surface(Fv1);
+  const occ::handle<Geom_Surface> aS2 = BRep_Tool::Surface(Fv2);
+  const double                    aTolS =
+    std::max(10. * tolapp3d,
+             std::max(BRep_Tool::Tolerance(ArcA), BRep_Tool::Tolerance(ArcC)) + tolapp3d);
+  const gp_Pnt aPntP = CPop.Point();
+
+  // Ends on the two fillet surfaces.
+  const occ::handle<GeomAdaptor_Surface> HGprev =
+    new GeomAdaptor_Surface(DStr.Surface(Fprev->Surf()).Surface());
+  const occ::handle<GeomAdaptor_Surface> HGd        = new GeomAdaptor_Surface(aSurfD);
+  const gp_Pnt2d                         aCP1onPrev = FiPad.PCurveOnSurf()->Value(wCut);
+  const gp_Pnt2d aPonFd = FiOp.PCurveOnSurf()->Value(FiOp.Parameter(isfirst));
+  // The section between Fprev and Fd, on Fd, from its side iad to iop.
+  const gp_Pnt2d aSecAd =
+    Fd->Interference(iad).PCurveOnSurf()->Value(Fd->Interference(iad).Parameter(!isfirst));
+  const gp_Pnt2d aSecOp = FiOp.PCurveOnSurf()->Value(FiOp.Parameter(!isfirst));
+  if (HGprev->Value(aCP1onPrev.X(), aCP1onPrev.Y()).Distance(CP1.Point()) > aTolS
+      || HGd->Value(aPonFd.X(), aPonFd.Y()).Distance(aPntP) > aTolS
+      || HGd->Value(aSecOp.X(), aSecOp.Y()).Distance(CP2.Point()) > aTolS
+      || aSecAd.Distance(aSecOp) < Precision::PConfusion())
+  {
+    return false;
+  }
+
+  // X: where the section crosses the surface of Fv1, the nearest to the
+  // side iad.
+  const occ::handle<GeomAdaptor_Surface> HS1 = new GeomAdaptor_Surface(aS1);
+  gp_Pnt2d                               aXonFd;
+  if (!CrossSection(HGd, aSecAd, aSecOp, HS1, aXonFd))
+  {
+    return false;
+  }
+  const gp_Pnt aPntX = HGd->Value(aXonFd.X(), aXonFd.Y());
+  gp_Pnt2d     aXonPrev;
+  if (!ProjectOnSurface(*HGprev, aPntX, aTolS, aXonPrev))
+  {
+    return false;
+  }
+
+  // Parameters on the surface of Fv1, in the period of the arc A.
+  double                          Ubid, Vbid;
+  const occ::handle<Geom2d_Curve> aPcA = BRep_Tool::CurveOnSurface(ArcA, Fv1, Ubid, Vbid);
+  const occ::handle<Geom2d_Curve> aPcC = BRep_Tool::CurveOnSurface(ArcC, Fv2, Ubid, Vbid);
+  if (aPcA.IsNull() || aPcC.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d aCP1on1 = aPcA->Value(CP1.ParameterOnArc());
+  gp_Pnt2d       aXon1, aPon1;
+  if (!ProjectOnSurface(*HS1, aPntX, aTolS, aXon1) || !ProjectOnSurface(*HS1, aPntP, aTolS, aPon1))
+  {
+    return false;
+  }
+  aXon1                  = PointInPeriod(aS1, aXon1, aCP1on1);
+  aPon1                  = PointInPeriod(aS1, aPon1, aXon1);
+  const gp_Pnt2d aVtxOn1 = PointInPeriod(aS1, BRep_Tool::Parameters(Vtx, Fv1), aXon1);
+  const gp_Pnt2d aPon2   = aPcC->Value(CPop.ParameterOnArc());
+  const gp_Pnt2d aVtxOn2 = PointInPeriod(aS2, BRep_Tool::Parameters(Vtx, Fv2), aPon2);
+
+  occ::handle<BRepAdaptor_Surface> HBs = new BRepAdaptor_Surface(Fv1, false);
+  {
+    double uu1, uu2, vv1, vv2, uu3, uu4, vv3, vv4;
+    ChFi3d_Boite(aCP1on1, aXon1, uu1, uu2, vv1, vv2);
+    ChFi3d_Boite(aXon1, aPon1, uu3, uu4, vv3, vv4);
+    ChFi3d_BoundFac(*HBs,
+                    std::min(uu1, uu3),
+                    std::max(uu2, uu4),
+                    std::min(vv1, vv3),
+                    std::max(vv2, vv4));
+  }
+
+  // The two cuts, each in the direction of its surfdata. The cut on Fd
+  // ends at P on the side iop.
+  const occ::handle<Geom2d_Curve> aTraceOnFd =
+    new Geom2d_TrimmedCurve(FiOp.PCurveOnSurf(), FiOp.FirstParameter(), FiOp.LastParameter());
+  occ::handle<Geom_Curve>   aCa, aCb;
+  occ::handle<Geom2d_Curve> aCaFil, aCaOn1, aCbFil, aCbOn1;
+  double                    aTolA = tolapp3d, aTolB = tolapp3d;
+  if (!CutFilletAlong(isfirst,
+                      HGprev,
+                      HBs,
+                      aS1,
+                      aCP1onPrev,
+                      aCP1on1,
+                      aXonPrev,
+                      aXon1,
+                      tolapp3d,
+                      tol2d,
+                      aTolS,
+                      occ::handle<Geom2d_Curve>(),
+                      aCa,
+                      aCaFil,
+                      aCaOn1,
+                      aTolA)
+      || !CutFilletAlong(isfirst,
+                         HGd,
+                         HBs,
+                         aS1,
+                         aXonFd,
+                         aXon1,
+                         aPonFd,
+                         aPon1,
+                         tolapp3d,
+                         tol2d,
+                         aTolS,
+                         aTraceOnFd,
+                         aCb,
+                         aCbFil,
+                         aCbOn1,
+                         aTolB))
+  {
+    return false;
+  }
+  double                    aTolProj = tolapp3d;
+  occ::handle<Geom2d_Curve> aCbOn2 =
+    GeomProjLib::Curve2d(aCb, aCb->FirstParameter(), aCb->LastParameter(), aS2, aTolProj);
+  if (aCbOn2.IsNull())
+  {
+    return false;
+  }
+  ShiftToPeriod(aS2, aCbOn2, isfirst ? aCb->FirstParameter() : aCb->LastParameter(), aPon2);
+  const gp_Pnt2d aXon2 = aCbOn2->Value(isfirst ? aCb->LastParameter() : aCb->FirstParameter());
+
+  // The curve between Fv1 and Fv2, from the vertex to X, straight in the
+  // parameters of the surface.
+  occ::handle<Geom_Curve>   aSplit;
+  occ::handle<Geom2d_Curve> aSplitOn1, aSplitOn2;
+  double                    aTolSplit = tolapp3d;
+  {
+    const double aLen = aVtxOn1.Distance(aXon1);
+    if (aLen < Precision::PConfusion())
+    {
+      return false;
+    }
+    aSplitOn1 =
+      new Geom2d_TrimmedCurve(new Geom2d_Line(aVtxOn1, gp_Dir2d(gp_Vec2d(aVtxOn1, aXon1))),
+                              0.,
+                              aLen);
+    Adaptor3d_CurveOnSurface aCOnS(new Geom2dAdaptor_Curve(aSplitOn1, 0., aLen), HS1);
+    double                   aMaxDev = 0., anAvDev = 0.;
+    GeomLib::BuildCurve3d(tolapp3d, aCOnS, 0., aLen, aSplit, aMaxDev, anAvDev);
+    if (aSplit.IsNull())
+    {
+      return false;
+    }
+    aTolSplit = std::max(aTolSplit, aMaxDev);
+    aSplitOn2 = GeomProjLib::Curve2d(aSplit, 0., aLen, aS2, aTolSplit);
+    if (aSplitOn2.IsNull())
+    {
+      return false;
+    }
+    ShiftToPeriod(aS2, aSplitOn2, 0., aVtxOn2);
+    if (aSplit->Value(0.).Distance(BRep_Tool::Pnt(Vtx)) > BRep_Tool::Tolerance(Vtx) + aTolS
+        || aSplit->Value(aLen).Distance(aPntX) > aTolS)
+    {
+      return false;
+    }
+  }
+
+  // Sides of the curves to keep on Fv1 (the triangle CP1, vertex, X) and on
+  // Fv2 (the triangle X, vertex, P).
+  const gp_Pnt2d           anIn1((aCP1on1.X() + aVtxOn1.X() + aXon1.X()) / 3.,
+                       (aCP1on1.Y() + aVtxOn1.Y() + aXon1.Y()) / 3.);
+  const gp_Pnt2d           anIn2((aXon2.X() + aVtxOn2.X() + aPon2.X()) / 3.,
+                       (aXon2.Y() + aVtxOn2.Y() + aPon2.Y()) / 3.);
+  const TopAbs_Orientation anEtA  = OrientationFromSide(aCaOn1, anIn1);
+  const TopAbs_Orientation anEtB  = OrientationFromSide(aCbOn2, anIn2);
+  const TopAbs_Orientation anEtS1 = OrientationFromSide(aSplitOn1, anIn1);
+  const TopAbs_Orientation anEtS2 = OrientationFromSide(aSplitOn2, anIn2);
+
+  // Everything is computed: the stripe is changed from here.
+  const double aTol = std::max(std::max(aTolA, aTolB), std::max(aTolProj, aTolSplit));
+  const int    IFv1 = DStr.AddShape(Fv1InShape);
+  const int    IFv2 = DStr.AddShape(Fv2InShape);
+  const int    IVtx = DStr.AddShape(Vtx);
+  const int    ICa  = DStr.AddCurve(TopOpeBRepDS_Curve(aCa, aTol));
+  const int    ICb  = DStr.AddCurve(TopOpeBRepDS_Curve(aCb, aTol));
+
+  // Fb: the end of Fprev from CP1, on Fv1 on the side iad; Fprev ends at CP1.
+  const double                 aTolPnt = std::max(aTol, tolapp3d);
+  occ::handle<ChFiDS_SurfData> Fb =
+    SplitAtCP1(DStr, Fprev, iad, isfirst, wCut, CP1, FiPop.LineIndex(), aTolPnt);
+  if (iad == 1)
+  {
+    Fb->ChangeIndexOfS1(IFv1);
+  }
+  else
+  {
+    Fb->ChangeIndexOfS2(IFv1);
+  }
+  Fb->ChangeInterference(iad).SetInterference(ICa, anEtA, aCaOn1, aCaFil);
+  Fb->ChangeInterference(iad).SetFirstParameter(aCa->FirstParameter());
+  Fb->ChangeInterference(iad).SetLastParameter(aCa->LastParameter());
+  Fb->ChangeInterference(iop).SetParameter(wEnd, isfirst);
+  Fb->ChangeVertex(isfirst, iop) = CP2;
+  ChFiDS_CommonPoint aCPX;
+  aCPX.SetPoint(aPntX);
+  aCPX.SetParameter(wEnd);
+  aCPX.SetTolerance(aTolPnt);
+  Fb->ChangeVertex(isfirst, iad) = aCPX;
+  if (isfirst)
+  {
+    Fb->FirstSpineParam(wEnd);
+  }
+  else
+  {
+    Fb->LastSpineParam(wEnd);
+  }
+
+  // Fd: on Fv2 on the side iad, its end is the point P.
+  if (isSplit)
+  {
+    // The part of the split surfdata after X, on its own copy of the surface
+    // and of the trace.
+    const TopOpeBRepDS_Surface& aSurfPrev = DStr.Surface(Fprev->Surf());
+    Fd->ChangeSurf(DStr.AddSurface(TopOpeBRepDS_Surface(aSurfD, aSurfPrev.Tolerance())));
+    Fd->ChangeInterference(iop).SetLineIndex(
+      DStr.AddCurve(TopOpeBRepDS_Curve(DStr.Curve(FiPop.LineIndex()).Curve(),
+                                       DStr.Curve(FiPop.LineIndex()).Tolerance())));
+  }
+  if (iad == 1)
+  {
+    Fd->ChangeIndexOfS1(IFv2);
+  }
+  else
+  {
+    Fd->ChangeIndexOfS2(IFv2);
+  }
+  Fd->ChangeInterference(iad).SetInterference(ICb, anEtB, aCbOn2, aCbFil);
+  Fd->ChangeInterference(iad).SetFirstParameter(aCb->FirstParameter());
+  Fd->ChangeInterference(iad).SetLastParameter(aCb->LastParameter());
+  ChFiDS_CommonPoint aCPP;
+  aCPP.SetPoint(aPntP);
+  aCPP.SetParameter(CPop.Parameter());
+  aCPP.SetTolerance(std::max(aTolPnt, BRep_Tool::Tolerance(ArcC)));
+  Fd->ChangeVertex(!isfirst, iad) = aCPX;
+  Fd->ChangeVertex(isfirst, iad)  = aCPP;
+
+  if (isfirst)
+  {
+    SeqFil.InsertBefore(isSplit ? num : numPrev, Fb);
+  }
+  else
+  {
+    SeqFil.InsertAfter(isSplit ? num : numPrev, Fb);
+  }
+  if (isSplit)
+  {
+    SeqFil.InsertAfter(num + 1, Fd);
+  }
+
+  // Points: P ends both sides of the stripe; X and CP2 end the section
+  // between Fb and Fd, stored here.
+  const int indP   = ChFi3d_IndexPointInDS(CPop, DStr);
+  const int indX   = DStr.AddPoint(TopOpeBRepDS_Point(aPntX, aTol));
+  const int indCP2 = ChFi3d_IndexPointInDS(CP2, DStr);
+  stripe->SetIndexPoint(indP, isfirst, 1);
+  stripe->SetIndexPoint(indP, isfirst, 2);
+  stripe->InDS(isfirst, 2);
+
+  // The section between Fb and Fd.
+  AddSection(DStr,
+             myRegul,
+             isfirst,
+             iad,
+             Fb,
+             Fd,
+             aCPX,
+             CP2,
+             indX,
+             indCP2,
+             aXonPrev,
+             FiPop.PCurveOnSurf()->Value(wEnd),
+             aXonFd,
+             aSecOp,
+             tolapp3d,
+             tol2d);
+
+  // The curve between Fv1 and Fv2.
+  const int ISplit = DStr.AddCurve(TopOpeBRepDS_Curve(aSplit, aTol));
+  DStr.ChangeShapeInterferences(IFv1).Append(ChFi3d_FilCurveInDS(ISplit, IFv1, aSplitOn1, anEtS1));
+  DStr.ChangeShapeInterferences(IFv2).Append(ChFi3d_FilCurveInDS(ISplit, IFv2, aSplitOn2, anEtS2));
+  DStr.ChangeCurveInterferences(ISplit).Append(
+    ChFi3d_FilVertexInDS(TopAbs_FORWARD, ISplit, IVtx, aSplit->FirstParameter()));
+  DStr.ChangeCurveInterferences(ISplit).Append(
+    ChFi3d_FilPointInDS(TopAbs_REVERSED, ISplit, indX, aSplit->LastParameter()));
+  // Fv1 and Fv2 are faces of one surface.
+  ChFiDS_Regul aRegSplit;
+  aRegSplit.SetCurve(ISplit);
+  aRegSplit.SetS1(IFv1, true);
+  aRegSplit.SetS2(IFv2, true);
+  myRegul.Append(aRegSplit);
+
+  // The edges between Fad and Fv1 from the arc A to the vertex are inside
+  // the extended Fv1.
+  RemoveEdgesToVertex(DStr, Fv1, ArcA, Vtx, Fad);
+  CutAtEnd(DStr, spine, isfirst, Vtx, IVtx, CPop, indP);
+  return true;
+}
