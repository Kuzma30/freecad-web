+namespace
+{
+// True if theEdge bounds theFace.
+bool IsEdgeOf(const TopoDS_Shape& theEdge, const TopoDS_Shape& theFace)
+{
+  for (TopExp_Explorer anExp(theFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    if (anExp.Current().IsSame(theEdge))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Parameter of the point of theCurve nearest to theP, by Newton steps from
+// theU0. The curve may be evaluated a little beyond its range: the trace of a
+// fillet may meet the other fillet just past the end of its surfdata.
+double NearestParameter(const occ::handle<Geom_Curve>& theCurve,
+                        const double                   theU0,
+                        const gp_Pnt&                  theP)
+{
+  double u = theU0;
+  for (int i = 0; i < 20; ++i)
+  {
+    gp_Pnt aP;
+    gp_Vec aD1, aD2;
+    theCurve->D2(u, aP, aD1, aD2);
+    const gp_Vec aV(theP, aP);
+    const double aF  = aV.Dot(aD1);
+    const double aDF = aD1.SquareMagnitude() + aV.Dot(aD2);
+    if (std::abs(aDF) < gp::Resolution())
+    {
+      break;
+    }
+    const double aDu = aF / aDF;
+    u -= aDu;
+    if (std::abs(aDu) < Precision::PConfusion())
+    {
+      break;
+    }
+  }
+  return u;
+}
+
+// Where a fillet meets the other one on the edge between their supports.
+struct MitreSide
+{
+  int         Side1 = 0, Side2 = 0; // sides of the two surfdata
+  TopoDS_Edge Arc;
+  gp_Pnt      Point;
+  bool        OnArc1 = false, OnArc2 = false;
+  double      U1 = 0., U2 = 0.; // parameters on the interferences
+};
+
+// A surfdata whose trace on one side must go on a little past its end to
+// reach the other fillet: its surface and that trace, extended.
+struct MitreExtension
+{
+  bool                      Done = false;
+  int                       Side = 0;
+  occ::handle<Geom_Surface> Surf;
+  occ::handle<Geom_Curve>   Curve;
+  occ::handle<Geom2d_Curve> PCOnFace, PCOnSurf;
+  double                    U = 0.;
+};
+
+// The pcurve theOrig on [theF, theL], followed past theAtFirst end by thePiece,
+// joined with C0 so that both keep their parameters.
+occ::handle<Geom2d_Curve> JoinPCurves(const occ::handle<Geom2d_Curve>& theOrig,
+                                      const double                     theF,
+                                      const double                     theL,
+                                      const occ::handle<Geom2d_Curve>& thePiece,
+                                      const bool                       theAtFirst,
+                                      const double                     theTol)
+{
+  occ::handle<Geom2d_BSplineCurve> anOrig =
+    Geom2dConvert::CurveToBSplineCurve(new Geom2d_TrimmedCurve(theOrig, theF, theL));
+  occ::handle<Geom2d_BSplineCurve> aPiece = Geom2dConvert::CurveToBSplineCurve(thePiece);
+  if (anOrig.IsNull() || aPiece.IsNull() || anOrig->IsRational() || aPiece->IsRational())
+  {
+    return occ::handle<Geom2d_Curve>();
+  }
+  const int aDeg = std::max(anOrig->Degree(), aPiece->Degree());
+  anOrig->IncreaseDegree(aDeg);
+  aPiece->IncreaseDegree(aDeg);
+  const occ::handle<Geom2d_BSplineCurve>& aC1 = theAtFirst ? aPiece : anOrig;
+  const occ::handle<Geom2d_BSplineCurve>& aC2 = theAtFirst ? anOrig : aPiece;
+  if (aC1->EndPoint().Distance(aC2->StartPoint()) > theTol
+      || std::abs(aC1->LastParameter() - aC2->FirstParameter()) > Precision::PConfusion())
+  {
+    return occ::handle<Geom2d_Curve>();
+  }
+  // clamped ends: the first and last poles are the ends of the curves
+  const int                    aNbP = aC1->NbPoles() + aC2->NbPoles() - 1;
+  const int                    aNbK = aC1->NbKnots() + aC2->NbKnots() - 1;
+  NCollection_Array1<gp_Pnt2d> aPoles(1, aNbP);
+  NCollection_Array1<double>   aKnots(1, aNbK);
+  NCollection_Array1<int>      aMults(1, aNbK);
+  int                          ip = 1;
+  for (int i = 1; i <= aC1->NbPoles(); ++i)
+  {
+    aPoles(ip++) = aC1->Pole(i);
+  }
+  aPoles(ip - 1) = gp_Pnt2d(0.5 * (aC1->EndPoint().XY() + aC2->StartPoint().XY()));
+  for (int i = 2; i <= aC2->NbPoles(); ++i)
+  {
+    aPoles(ip++) = aC2->Pole(i);
+  }
+  int ik = 1;
+  for (int i = 1; i <= aC1->NbKnots(); ++i)
+  {
+    aKnots(ik) = aC1->Knot(i);
+    aMults(ik) = aC1->Multiplicity(i);
+    ++ik;
+  }
+  aMults(ik - 1) = aDeg; // the joint: C0
+  for (int i = 2; i <= aC2->NbKnots(); ++i)
+  {
+    aKnots(ik) = aC2->Knot(i);
+    aMults(ik) = aC2->Multiplicity(i);
+    ++ik;
+  }
+  try
+  {
+    OCC_CATCH_SIGNALS
+    return new Geom2d_BSplineCurve(aPoles, aKnots, aMults, aDeg);
+  }
+  catch (Standard_Failure const&)
+  {
+    return occ::handle<Geom2d_Curve>();
+  }
+}
+
+// Extends theFd at its end theIsFirst so that its trace on theSide reaches
+// theP. The existing part of the surface and of the trace keeps its
+// parameters, so the rest of the stripe (its other end) is not changed.
+bool ExtendToPoint(TopOpeBRepDS_DataStructure&         theDS,
+                   const occ::handle<ChFiDS_SurfData>& theFd,
+                   const bool                          theIsFirst,
+                   const int                           theSide,
+                   const gp_Pnt&                       theP,
+                   const double                        theTol,
+                   MitreExtension&                     theExt)
+{
+  const ChFiDS_FaceInterference&   aFi    = theFd->Interference(theSide);
+  const occ::handle<Geom_Surface>  anOld  = theDS.Surface(theFd->Surf()).Surface();
+  const occ::handle<Geom_Curve>&   anOldC = theDS.Curve(aFi.LineIndex()).Curve();
+  occ::handle<Geom_BoundedSurface> aSurf  = occ::down_cast<Geom_BoundedSurface>(anOld->Copy());
+  if (aSurf.IsNull() || anOldC.IsNull())
+  {
+    return false;
+  }
+  const double                   aF0 = aFi.FirstParameter(), aL0 = aFi.LastParameter();
+  occ::handle<Geom_BoundedCurve> aCurve  = new Geom_TrimmedCurve(anOldC, aF0, aL0);
+  const gp_Pnt                   anEnd   = anOldC->Value(theIsFirst ? aF0 : aL0);
+  const double                   aLength = 2. * anEnd.Distance(theP) + theTol;
+  GeomLib::ExtendSurfByLength(aSurf, aLength, 3, false, !theIsFirst);
+  GeomLib::ExtendCurveToPoint(aCurve, theP, 3, !theIsFirst);
+
+  // The extension only approximates the fillet past its end; it is kept
+  // short, so the point is close to it.
+  GeomAPI_ProjectPointOnSurf aProj(theP, aSurf);
+  if (!aProj.IsDone() || aProj.NbPoints() == 0 || aProj.LowerDistance() > 10. * theTol)
+  {
+    return false;
+  }
+  // The old parts must keep their parameters.
+  const double   aMid   = 0.5 * (aF0 + aL0);
+  const gp_Pnt2d aUVMid = aFi.PCurveOnSurf()->Value(aMid);
+  if (aCurve->Value(aMid).Distance(anOldC->Value(aMid)) > Precision::Confusion()
+      || aSurf->Value(aUVMid.X(), aUVMid.Y()).Distance(anOld->Value(aUVMid.X(), aUVMid.Y()))
+           > Precision::Confusion())
+  {
+    return false;
+  }
+
+  // The pcurves are the old ones followed by the projection of the new piece.
+  const double              aF = aCurve->FirstParameter(), aL = aCurve->LastParameter();
+  const double              aPF = theIsFirst ? aF : aL0, aPL = theIsFirst ? aF0 : aL;
+  const TopoDS_Face&        aFace = TopoDS::Face(theDS.Shape(theFd->Index(theSide)));
+  TopLoc_Location           aLoc;
+  occ::handle<Geom_Surface> aFaceSurf = BRep_Tool::Surface(aFace, aLoc);
+  if (!aLoc.IsIdentity())
+  {
+    aFaceSurf = occ::down_cast<Geom_Surface>(aFaceSurf->Transformed(aLoc.Transformation()));
+  }
+  double                          aTolSurf = 10. * theTol, aTolFace = 10. * theTol;
+  const occ::handle<Geom2d_Curve> aPieceSurf =
+    GeomProjLib::Curve2d(aCurve, aPF, aPL, aSurf, aTolSurf);
+  const occ::handle<Geom2d_Curve> aPieceFace =
+    GeomProjLib::Curve2d(aCurve, aPF, aPL, aFaceSurf, aTolFace);
+  if (aPieceSurf.IsNull() || aPieceFace.IsNull())
+  {
+    return false;
+  }
+  const occ::handle<Geom2d_Curve> aPCSurf =
+    JoinPCurves(aFi.PCurveOnSurf(), aF0, aL0, aPieceSurf, theIsFirst, 10. * theTol);
+  const occ::handle<Geom2d_Curve> aPCFace =
+    JoinPCurves(aFi.PCurveOnFace(), aF0, aL0, aPieceFace, theIsFirst, 10. * theTol);
+  if (aPCSurf.IsNull() || aPCFace.IsNull()
+      || std::abs(aPCSurf->FirstParameter() - aF) > Precision::PConfusion()
+      || std::abs(aPCSurf->LastParameter() - aL) > Precision::PConfusion()
+      || std::abs(aPCFace->FirstParameter() - aF) > Precision::PConfusion()
+      || std::abs(aPCFace->LastParameter() - aL) > Precision::PConfusion())
+  {
+    return false;
+  }
+  theExt.Done     = true;
+  theExt.Side     = theSide;
+  theExt.Surf     = aSurf;
+  theExt.Curve    = aCurve;
+  theExt.PCOnFace = aPCFace;
+  theExt.PCOnSurf = aPCSurf;
+  theExt.U        = theIsFirst ? aF : aL;
+  return true;
+}
+} // namespace
