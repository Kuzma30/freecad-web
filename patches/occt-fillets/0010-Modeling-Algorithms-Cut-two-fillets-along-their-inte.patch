+bool ChFi3d_Builder::PerformTwoCornerMitre(const int theIndex)
+{
+  const TopoDS_Vertex&        Vtx  = myVDataMap.FindKey(theIndex);
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  if (myVDataMap(theIndex).Extent() != 2)
+  {
+    return false;
+  }
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator It(myVDataMap(theIndex));
+  occ::handle<ChFiDS_Stripe>                             St1 = It.Value();
+  It.Next();
+  occ::handle<ChFiDS_Stripe> St2 = It.Value();
+  if (St1 == St2)
+  {
+    return false;
+  }
+  int                                 Sens1 = 0, Sens2 = 0;
+  const int                           Isd1     = ChFi3d_IndexOfSurfData(Vtx, St1, Sens1);
+  const int                           Isd2     = ChFi3d_IndexOfSurfData(Vtx, St2, Sens2);
+  const occ::handle<ChFiDS_SurfData>& Fd1      = St1->SetOfSurfData()->Value(Isd1);
+  const occ::handle<ChFiDS_SurfData>& Fd2      = St2->SetOfSurfData()->Value(Isd2);
+  const bool                          isfirst1 = (Sens1 == 1), isfirst2 = (Sens2 == 1);
+  for (int j = 1; j <= 2; ++j)
+  {
+    if (Fd1->Index(j) <= 0 || Fd2->Index(j) <= 0 || Fd1->Interference(j).LineIndex() == 0
+        || Fd2->Interference(j).LineIndex() == 0)
+    {
+      return false;
+    }
+    for (int k = 1; k <= 2; ++k)
+    {
+      if (Fd1->Index(j) == Fd2->Index(k))
+      {
+        return false; // a common face: PerformMoreThreeCorner or TwoCorner
+      }
+    }
+  }
+
+  // Each support of the first fillet must meet a support of the second one
+  // on an edge at the vertex.
+  MitreSide aSides[2];
+  for (int j = 1; j <= 2; ++j)
+  {
+    MitreSide& aSide = aSides[j - 1];
+    aSide.Side1      = j;
+    for (int k = 1; k <= 2 && aSide.Arc.IsNull(); ++k)
+    {
+      for (NCollection_List<TopoDS_Shape>::Iterator anIt(myVEMap(Vtx)); anIt.More(); anIt.Next())
+      {
+        if (!BRep_Tool::Degenerated(TopoDS::Edge(anIt.Value()))
+            && IsEdgeOf(anIt.Value(), DStr.Shape(Fd1->Index(j)))
+            && IsEdgeOf(anIt.Value(), DStr.Shape(Fd2->Index(k))))
+        {
+          aSide.Arc   = TopoDS::Edge(anIt.Value());
+          aSide.Side2 = k;
+          break;
+        }
+      }
+    }
+    if (aSide.Arc.IsNull())
+    {
+      return false;
+    }
+  }
+  if (aSides[0].Side2 == aSides[1].Side2 || aSides[0].Arc.IsSame(aSides[1].Arc))
+  {
+    return false;
+  }
+
+  // The traces of the two fillets meet on each of these edges.
+  const double aTolMeet = std::max(10. * tolapp3d, Precision::Confusion());
+  for (MitreSide& aSide : aSides)
+  {
+    const ChFiDS_CommonPoint& aCP1 = Fd1->Vertex(isfirst1, aSide.Side1);
+    const ChFiDS_CommonPoint& aCP2 = Fd2->Vertex(isfirst2, aSide.Side2);
+    aSide.OnArc1                   = aCP1.IsOnArc() && aCP1.Arc().IsSame(aSide.Arc);
+    aSide.OnArc2                   = aCP2.IsOnArc() && aCP2.Arc().IsSame(aSide.Arc);
+    if (aSide.OnArc1)
+    {
+      aSide.Point = aCP1.Point();
+    }
+    else if (aSide.OnArc2)
+    {
+      aSide.Point = aCP2.Point();
+    }
+    else
+    {
+      return false;
+    }
+    const ChFiDS_FaceInterference& aFi1 = Fd1->Interference(aSide.Side1);
+    const ChFiDS_FaceInterference& aFi2 = Fd2->Interference(aSide.Side2);
+    const occ::handle<Geom_Curve>& aC1  = DStr.Curve(aFi1.LineIndex()).Curve();
+    const occ::handle<Geom_Curve>& aC2  = DStr.Curve(aFi2.LineIndex()).Curve();
+    if (aC1.IsNull() || aC2.IsNull())
+    {
+      return false;
+    }
+    aSide.U1 = aSide.OnArc1 ? aFi1.Parameter(isfirst1)
+                            : NearestParameter(aC1, aFi1.Parameter(isfirst1), aSide.Point);
+    aSide.U2 = aSide.OnArc2 ? aFi2.Parameter(isfirst2)
+                            : NearestParameter(aC2, aFi2.Parameter(isfirst2), aSide.Point);
+    if (aC1->Value(aSide.U1).Distance(aSide.Point) > aTolMeet
+        || aC2->Value(aSide.U2).Distance(aSide.Point) > aTolMeet)
+    {
+      return false;
+    }
+  }
+
+  // A trace that has to go past the end of its surfdata to reach the other
+  // fillet: that surfdata is extended there.
+  MitreExtension anExt1, anExt2;
+  for (MitreSide& aSide : aSides)
+  {
+    const ChFiDS_FaceInterference& aFi1 = Fd1->Interference(aSide.Side1);
+    const ChFiDS_FaceInterference& aFi2 = Fd2->Interference(aSide.Side2);
+    if (!aSide.OnArc1
+        && (aSide.U1 < aFi1.FirstParameter() - Precision::PConfusion()
+            || aSide.U1 > aFi1.LastParameter() + Precision::PConfusion()))
+    {
+      if (anExt1.Done
+          || !ExtendToPoint(DStr, Fd1, isfirst1, aSide.Side1, aSide.Point, aTolMeet, anExt1))
+      {
+        return false;
+      }
+      aSide.U1 = anExt1.U;
+    }
+    if (!aSide.OnArc2
+        && (aSide.U2 < aFi2.FirstParameter() - Precision::PConfusion()
+            || aSide.U2 > aFi2.LastParameter() + Precision::PConfusion()))
+    {
+      if (anExt2.Done
+          || !ExtendToPoint(DStr, Fd2, isfirst2, aSide.Side2, aSide.Point, aTolMeet, anExt2))
+      {
+        return false;
+      }
+      aSide.U2 = anExt2.U;
+    }
+  }
+
+  // The corner is the intersection of the two fillets between these points,
+  // from the side 1 of the first fillet to its side 2.
+  occ::handle<GeomAdaptor_Surface> HS1 =
+    anExt1.Done ? new GeomAdaptor_Surface(anExt1.Surf) : ChFi3d_BoundSurf(DStr, Fd1, 1, 2);
+  occ::handle<GeomAdaptor_Surface> HS2 =
+    anExt2.Done ? new GeomAdaptor_Surface(anExt2.Surf) : ChFi3d_BoundSurf(DStr, Fd2, 1, 2);
+  NCollection_Array1<double> Pardeb(1, 4), Parfin(1, 4);
+  for (int i = 0; i < 2; ++i)
+  {
+    const MitreSide& aSide = aSides[i];
+    const gp_Pnt2d   aUV1  = (anExt1.Done && anExt1.Side == aSide.Side1)
+                               ? anExt1.PCOnSurf->Value(aSide.U1)
+                               : Fd1->Interference(aSide.Side1).PCurveOnSurf()->Value(aSide.U1);
+    const gp_Pnt2d   aUV2  = (anExt2.Done && anExt2.Side == aSide.Side2)
+                               ? anExt2.PCOnSurf->Value(aSide.U2)
+                               : Fd2->Interference(aSide.Side2).PCurveOnSurf()->Value(aSide.U2);
+    const double     aTol1 = anExt1.Done ? 10. * aTolMeet : aTolMeet;
+    const double     aTol2 = anExt2.Done ? 10. * aTolMeet : aTolMeet;
+    if (HS1->Value(aUV1.X(), aUV1.Y()).Distance(aSide.Point) > aTol1
+        || HS2->Value(aUV2.X(), aUV2.Y()).Distance(aSide.Point) > aTol2)
+    {
+      return false;
+    }
+    NCollection_Array1<double>& aPar = (aSide.Side1 == 1) ? Pardeb : Parfin;
+    aPar(1)                          = aUV1.X();
+    aPar(2)                          = aUV1.Y();
+    aPar(3)                          = aUV2.X();
+    aPar(4)                          = aUV2.Y();
+  }
+  occ::handle<Geom2d_Curve> PGc1, PGc2;
+  occ::handle<Geom_Curve>   Gc;
+  double                    tolreached = tolapp3d;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    if (!ChFi3d_ComputeCurves(HS1,
+                              HS2,
+                              Pardeb,
+                              Parfin,
+                              Gc,
+                              PGc1,
+                              PGc2,
+                              tolapp3d,
+                              tol2d,
+                              tolreached))
+    {
+      return false;
+    }
+    // An extension too long to follow the fillet gives a poor curve; the
+    // corner patch is the better choice then.
+    if (tolreached > 10. * aTolMeet)
+    {
+      return false;
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+
+  // The extended surfdata take their new surface and trace.
+  for (int i = 0; i < 2; ++i)
+  {
+    const MitreExtension&               anExt = i == 0 ? anExt1 : anExt2;
+    const occ::handle<ChFiDS_SurfData>& aFd   = i == 0 ? Fd1 : Fd2;
+    const occ::handle<ChFiDS_Stripe>&   aSt   = i == 0 ? St1 : St2;
+    if (!anExt.Done)
+    {
+      continue;
+    }
+    const int anOldSurf = aFd->Surf();
+    aFd->ChangeSurf(
+      DStr.AddSurface(TopOpeBRepDS_Surface(anExt.Surf, DStr.Surface(anOldSurf).Tolerance())));
+    // keep the history of the spine edge on the new surface
+    const occ::handle<ChFiDS_Spine>& aSp = aSt->Spine();
+    for (int ie = 1; ie <= aSp->NbEdges(); ++ie)
+    {
+      const TopoDS_Edge& anE = aSp->Edges(ie);
+      if (!myEVIMap.IsBound(anE))
+      {
+        continue;
+      }
+      for (NCollection_List<int>::Iterator itl(myEVIMap.ChangeFind(anE)); itl.More(); itl.Next())
+      {
+        if (itl.Value() == anOldSurf)
+        {
+          itl.ChangeValue() = aFd->Surf();
+        }
+      }
+    }
+    ChFiDS_FaceInterference& aFi                    = aFd->ChangeInterference(anExt.Side);
+    DStr.ChangeCurve(aFi.LineIndex()).ChangeCurve() = anExt.Curve;
+    aFi.ChangePCurveOnFace()                        = anExt.PCOnFace;
+    aFi.ChangePCurveOnSurf()                        = anExt.PCOnSurf;
+    aFi.SetFirstParameter(anExt.Curve->FirstParameter());
+    aFi.SetLastParameter(anExt.Curve->LastParameter());
+  }
+
+  // The stripes end on this curve.
+  const double WFirst = Gc->FirstParameter();
+  const double WLast  = Gc->LastParameter();
+  const int    ICurv  = DStr.AddCurve(TopOpeBRepDS_Curve(Gc, tolreached));
+  St1->SetParameters(isfirst1, WFirst, WLast);
+  St1->SetCurve(ICurv, isfirst1);
+  St1->ChangePCurve(isfirst1) = PGc1;
+  St2->SetParameters(isfirst2, WFirst, WLast);
+  St2->SetCurve(ICurv, isfirst2);
+  St2->ChangePCurve(isfirst2) = PGc2;
+  if (aSides[0].Side2 != 1)
+  {
+    St2->SetOrientation(TopAbs_REVERSED, isfirst2);
+  }
+  for (const MitreSide& aSide : aSides)
+  {
+    ChFiDS_CommonPoint& aCP1 = Fd1->ChangeVertex(isfirst1, aSide.Side1);
+    ChFiDS_CommonPoint& aCP2 = Fd2->ChangeVertex(isfirst2, aSide.Side2);
+    if (!aSide.OnArc1)
+    {
+      aCP1 = aCP2;
+    }
+    else if (!aSide.OnArc2)
+    {
+      aCP2 = aCP1;
+    }
+    aCP1.SetTolerance(std::max(aCP1.Tolerance(), tolreached));
+    aCP2.SetTolerance(std::max(aCP2.Tolerance(), tolreached));
+    Fd1->ChangeInterference(aSide.Side1).SetParameter(aSide.U1, isfirst1);
+    Fd2->ChangeInterference(aSide.Side2).SetParameter(aSide.U2, isfirst2);
+    const int IPoint = ChFi3d_IndexPointInDS(aCP1, DStr);
+    St1->SetIndexPoint(IPoint, isfirst1, aSide.Side1);
+    St2->SetIndexPoint(IPoint, isfirst2, aSide.Side2);
+  }
+  return true;
+}
