+//! Builds <theData> as a part of the sphere of radius <theR> of a ball which
+//! stays still: its contact on the side <theApexSide> is the point <theApex>
+//! of a face of normal <theApexNormal>, the one on the other side is the
+//! trace <thePC>, between the parameters <theFirst> and <theLast>, on <theS>.
+//! The pole of the sphere is the apex, the trace goes along the longitude,
+//! so that the meridians through its ends are the sections of the ball.
+//! The interferences take the parameters of <thePC>, their transitions and
+//! the orientation of <theData> are left to the caller.
+//! Returns false, with <theData> unchanged, if the trace is not on the
+//! sphere within max(10 * <theTol3d>, R / 1000).
+//! @param[in,out] theDS data structure receiving the surface
+//! @param[in,out] theData surfdata to build
+//! @param[in] theApex point of contact of the ball on the apex side
+//! @param[in] theApexNormal normal of the face at the apex
+//! @param[in] theR radius of the ball
+//! @param[in] theApexSide side (1 or 2) of the apex
+//! @param[in] theS surface of the trace
+//! @param[in] thePC trace on theS
+//! @param[in] theFirst first parameter of the trace
+//! @param[in] theLast last parameter of the trace
+//! @param[in] theTol3d 3D tolerance
+//! @return false if the trace is not on the sphere
+bool ChFi3d_SphereData(TopOpeBRepDS_DataStructure&           theDS,
+                       const occ::handle<ChFiDS_SurfData>&   theData,
+                       const gp_Pnt&                         theApex,
+                       const gp_Vec&                         theApexNormal,
+                       const double                          theR,
+                       const int                             theApexSide,
+                       const occ::handle<Adaptor3d_Surface>& theS,
+                       const occ::handle<Geom2d_Curve>&      thePC,
+                       const double                          theFirst,
+                       const double                          theLast,
+                       const double                          theTol3d);
+
 #endif
