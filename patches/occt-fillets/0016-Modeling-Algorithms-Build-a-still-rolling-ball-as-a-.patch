+  set d [dump s]
+  if {[regexp {SphericalSurface} $d]} {
+    incr nbsph
+    regexp {Center :([-0-9.e]+), ([-0-9.e]+), ([-0-9.e]+)} $d full x y z
+    regexp {Radius :([-0-9.e]+)} $d full r
