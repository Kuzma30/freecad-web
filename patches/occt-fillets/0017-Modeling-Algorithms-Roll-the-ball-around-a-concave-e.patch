+//=================================================================================================
+
+bool ChFi3d_Builder::PerformTwoCornerOnRevolution(const int theIndex)
+{
+  // The ball touching the common end point of the two fillets on the pivot
+  // edge turns around the pivot from the end section of one fillet to the
+  // end section of the other. Its center stays at the radius from the
+  // pivot, so the corner is a torus around the pivot whose tube touches the
+  // axis. The torus stays tangent to a face of revolution around the pivot,
+  // on which the other supports of the fillets end.
+  const TopoDS_Vertex&        Vtx  = myVDataMap.FindKey(theIndex);
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  if (myVDataMap(theIndex).Extent() != 2)
+  {
+    return false;
+  }
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator anIt(myVDataMap(theIndex));
+  occ::handle<ChFiDS_Stripe>                             st1 = anIt.Value();
+  anIt.Next();
+  occ::handle<ChFiDS_Stripe> st2 = anIt.Value();
+  if (st1 == st2)
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_FilSpine> aSp1 = occ::down_cast<ChFiDS_FilSpine>(st1->Spine());
+  const occ::handle<ChFiDS_FilSpine> aSp2 = occ::down_cast<ChFiDS_FilSpine>(st2->Spine());
+  if (aSp1.IsNull() || aSp2.IsNull() || !aSp1->IsConstant() || !aSp2->IsConstant()
+      || std::abs(aSp1->Radius() - aSp2->Radius()) > Precision::Confusion())
+  {
+    return false;
+  }
+  const double                 aR    = aSp1->Radius();
+  int                          Sens1 = 0, Sens2 = 0;
+  const int                    Isd1     = ChFi3d_IndexOfSurfData(Vtx, st1, Sens1);
+  const int                    Isd2     = ChFi3d_IndexOfSurfData(Vtx, st2, Sens2);
+  occ::handle<ChFiDS_SurfData> sd1      = st1->SetOfSurfData()->Value(Isd1);
+  occ::handle<ChFiDS_SurfData> sd2      = st2->SetOfSurfData()->Value(Isd2);
+  const bool                   isfirst1 = (Sens1 == 1);
+  const bool                   isfirst2 = (Sens2 == 1);
+  for (int j = 1; j <= 2; ++j)
+  {
+    if (sd1->Index(j) <= 0 || sd2->Index(j) <= 0)
+    {
+      return false;
+    }
+    for (int k = 1; k <= 2; ++k)
+    {
+      if (sd1->Index(j) == sd2->Index(k))
+      {
+        return false; // a common support face: the other corners
+      }
+    }
+  }
+
+  // The pivot: a straight edge on which both fillets end at the same point,
+  // between plane supports through it.
+  const double aTol  = std::max(10. * tolapp3d, Precision::Confusion());
+  int          IArc1 = 0, IArc2 = 0;
+  for (int j = 1; j <= 2 && IArc1 == 0; ++j)
+  {
+    for (int k = 1; k <= 2 && IArc1 == 0; ++k)
+    {
+      const ChFiDS_CommonPoint& aCP1 = sd1->Vertex(isfirst1, j);
+      const ChFiDS_CommonPoint& aCP2 = sd2->Vertex(isfirst2, k);
+      if (aCP1.IsOnArc() && aCP2.IsOnArc() && aCP1.Arc().IsSame(aCP2.Arc())
+          && aCP1.Point().Distance(aCP2.Point()) <= aTol)
+      {
+        IArc1 = j;
+        IArc2 = k;
+      }
+    }
+  }
+  if (IArc1 == 0)
+  {
+    return false;
+  }
+  const int          ICo1   = 3 - IArc1;
+  const int          ICo2   = 3 - IArc2;
+  const TopoDS_Edge& aPivot = sd1->Vertex(isfirst1, IArc1).Arc();
+  BRepAdaptor_Curve  aPivC(aPivot);
+  if (aPivC.GetType() != GeomAbs_Line)
+  {
+    return false;
+  }
+  const gp_Dir aD  = aPivC.Line().Direction();
+  const gp_Pnt aPw = sd1->Vertex(isfirst1, IArc1).Point();
+
+  // The center of the end section of each fillet: at the radius from the
+  // pivot point on the normal to its plane support, and from the end of its
+  // other trace.
+  gp_Pnt     aO[2];
+  const auto aCenter = [&](const occ::handle<ChFiDS_SurfData>& theSd,
+                           const bool                          theIsFirst,
+                           const int                           theIArc,
+                           gp_Pnt&                             theO) -> bool {
+    const TopoDS_Face   aW = TopoDS::Face(DStr.Shape(theSd->Index(theIArc)));
+    BRepAdaptor_Surface aWAd(aW, false);
+    if (aWAd.GetType() != GeomAbs_Plane)
+    {
+      return false;
+    }
+    const gp_Dir aN = aWAd.Plane().Axis().Direction();
+    if (std::abs(aN.Dot(aD)) > Precision::Angular())
+    {
+      return false;
+    }
+    const gp_Pnt& aQ  = theSd->Vertex(theIsFirst, 3 - theIArc).Point();
+    const gp_Pnt  aOp = aPw.Translated(aR * gp_Vec(aN));
+    const gp_Pnt  aOm = aPw.Translated(-aR * gp_Vec(aN));
+    const double  aDp = std::abs(aOp.Distance(aQ) - aR);
+    const double  aDm = std::abs(aOm.Distance(aQ) - aR);
+    theO              = aDp < aDm ? aOp : aOm;
+    return std::min(aDp, aDm) <= aTol;
+  };
+  if (!aCenter(sd1, isfirst1, IArc1, aO[0]) || !aCenter(sd2, isfirst2, IArc2, aO[1]))
+  {
+    return false;
+  }
+
+  // The face of revolution: beyond the arcs where the other traces end.
+  const ChFiDS_CommonPoint& aQ1 = sd1->Vertex(isfirst1, ICo1);
+  const ChFiDS_CommonPoint& aQ2 = sd2->Vertex(isfirst2, ICo2);
+  if (!aQ1.IsOnArc() || !aQ2.IsOnArc() || !myEFMap.Contains(aQ1.Arc())
+      || !myEFMap.Contains(aQ2.Arc()))
+  {
+    return false;
+  }
+  TopoDS_Face aS;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt1(myEFMap(aQ1.Arc()));
+       anIt1.More() && aS.IsNull();
+       anIt1.Next())
+  {
+    if (anIt1.Value().IsSame(DStr.Shape(sd1->Index(ICo1))))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt2(myEFMap(aQ2.Arc())); anIt2.More();
+         anIt2.Next())
+    {
+      if (anIt2.Value().IsSame(anIt1.Value()))
+      {
+        aS = TopoDS::Face(anIt1.Value());
+        break;
+      }
+    }
+  }
+  if (aS.IsNull())
+  {
+    return false;
+  }
+  BRepAdaptor_Surface aSAd(aS, false);
+  if (aSAd.GetType() == GeomAbs_Sphere)
+  {
+    if (gp_Lin(aPw, aD).Distance(aSAd.Sphere().Location()) > aTol)
+    {
+      return false;
+    }
+  }
+  else if (aSAd.GetType() == GeomAbs_Plane)
+  {
+    if (!aSAd.Plane().Axis().Direction().IsParallel(aD, Precision::Angular()))
+    {
+      return false;
+    }
+  }
+  else
+  {
+    return false;
+  }
+
+  // The torus around the pivot, its angle from the first end section to
+  // the second one (the turn of the ball, less than a half turn). The end
+  // section of the first fillet on the torus goes from its point on the face
+  // of revolution to the pivot (the point of the torus on its axis) through
+  // the middle of the section; the axis is oriented so that this is the
+  // increasing direction of the second parameter, as for the toric corner
+  // between planes (ChFiKPart_MakeRotule).
+  gp_Pnt aMid;
+  {
+    const occ::handle<Geom_Surface>& aSurf1 = DStr.Surface(sd1->Surf()).Surface();
+    const gp_Pnt2d                   aUV1 =
+      sd1->Interference(1).PCurveOnSurf()->Value(sd1->Interference(1).Parameter(isfirst1));
+    const gp_Pnt2d aUV2 =
+      sd1->Interference(2).PCurveOnSurf()->Value(sd1->Interference(2).Parameter(isfirst1));
+    aMid = aSurf1->Value(0.5 * (aUV1.X() + aUV2.X()), 0.5 * (aUV1.Y() + aUV2.Y()));
+  }
+  const double aTwoPi = 2. * M_PI;
+  gp_Ax3       anAx;
+  double       aAlpha = 0., aVS = 0., aVP = 0.;
+  for (int anAxisSide = 0; anAxisSide < 2; ++anAxisSide)
+  {
+    const gp_Dir aZ    = anAxisSide == 0 ? aD : aD.Reversed();
+    anAx               = gp_Ax3(aPw, aZ, gp_Dir(gp_Vec(aPw, aO[0])));
+    const double aTurn = gp_Vec(aPw, aO[0]).AngleWithRef(gp_Vec(aPw, aO[1]), gp_Vec(aZ));
+    if (aTurn < 0.)
+    {
+      anAx.YReverse();
+    }
+    aAlpha    = std::abs(aTurn);
+    double aU = 0., aVM = 0.;
+    ElSLib::TorusParameters(anAx, aR, aR, aQ1.Point(), aU, aVS);
+    ElSLib::TorusParameters(anAx, aR, aR, aMid, aU, aVM);
+    const double aToPw  = std::fmod(M_PI - aVS + 2. * aTwoPi, aTwoPi);
+    const double aToMid = std::fmod(aVM - aVS + 2. * aTwoPi, aTwoPi);
+    if (aToMid < aToPw)
+    {
+      aVP = aVS + aToPw;
+      break;
+    }
+  }
+  if (aVP - aVS < Precision::Angular() || aAlpha < Precision::Angular()
+      || aAlpha > M_PI - Precision::Angular())
+  {
+    return false;
+  }
+  const occ::handle<Geom_ToroidalSurface> aTor = new Geom_ToroidalSurface(anAx, aR, aR);
+
+  // The torus is tangent to the face of revolution all along the turn, and
+  // ends on the end section of the second fillet.
+  const occ::handle<Geom_Surface> aSSurf = BRep_Tool::Surface(aS);
+  for (int i = 1; i <= 3; ++i)
+  {
+    gp_Pnt aP;
+    gp_Vec aDu, aDv;
+    aTor->D1(aAlpha * i / 4., aVS, aP, aDu, aDv);
+    GeomAPI_ProjectPointOnSurf aProj(aP, aSSurf);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > aTol)
+    {
+      return false;
+    }
+    double aUs = 0., aVs = 0.;
+    aProj.LowerDistanceParameters(aUs, aVs);
+    gp_Pnt aPs;
+    gp_Vec aDus, aDvs;
+    aSSurf->D1(aUs, aVs, aPs, aDus, aDvs);
+    const gp_Vec aNt = aDu.Crossed(aDv);
+    const gp_Vec aNs = aDus.Crossed(aDvs);
+    if (aNt.Magnitude() < gp::Resolution() || aNs.Magnitude() < gp::Resolution()
+        || !gp_Dir(aNt).IsParallel(gp_Dir(aNs), 1.e-3))
+    {
+      return false;
+    }
+  }
+  if (aTor->Value(aAlpha, aVS).Distance(aQ2.Point()) > aTol)
+  {
+    return false;
+  }
+
+  // The corner data: side 1 on the face of revolution, side 2 at the point
+  // of the pivot.
+  occ::handle<ChFiDS_Stripe>   corner = new ChFiDS_Stripe();
+  occ::handle<ChFiDS_SurfData> coin   = new ChFiDS_SurfData();
+  corner->ChangeSetOfSurfData()       = new NCollection_HSequence<occ::handle<ChFiDS_SurfData>>();
+  corner->ChangeSetOfSurfData()->Append(coin);
+  coin->ChangeSurf(DStr.AddSurface(TopOpeBRepDS_Surface(aTor, 0.)));
+
+  // Orientation of the corner and transition on the face of revolution, as
+  // for the toric corner between planes (ChFiKPart_MakeRotule).
+  TopAbs_Orientation aTrans = TopAbs_REVERSED;
+  {
+    gp_Pnt aP;
+    gp_Vec aDu, aDv;
+    aTor->D1(0.5 * aAlpha, aVS, aP, aDu, aDv);
+    const gp_Dir               aDrot(aDu.Crossed(aDv));
+    GeomAPI_ProjectPointOnSurf aProj(aP, aSSurf);
+    double                     aUs = 0., aVs = 0.;
+    aProj.LowerDistanceParameters(aUs, aVs);
+    gp_Pnt aPs;
+    gp_Vec aDus, aDvs;
+    aSSurf->D1(aUs, aVs, aPs, aDus, aDvs);
+    gp_Vec aNat   = aDus.Crossed(aDvs);
+    gp_Vec aNFace = aNat;
+    if (aS.Orientation() == TopAbs_REVERSED)
+    {
+      aNFace.Reverse();
+    }
+    if (aDrot.Dot(aNat) <= 0.)
+    {
+      aTrans = TopAbs_FORWARD;
+    }
+    coin->ChangeOrientation() = aDrot.Dot(aNFace) <= 0. ? TopAbs_REVERSED : TopAbs_FORWARD;
+  }
+
+  // The trace on the face of revolution: a circle of the torus, its pcurve
+  // on the face through points of it.
+  const occ::handle<Geom_Curve>              aTrace = aTor->VIso(aVS);
+  const int                                  aNb    = 24;
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aUVs   = new NCollection_HArray1<gp_Pnt2d>(1, aNb + 1);
+  occ::handle<NCollection_HArray1<double>>   aTs    = new NCollection_HArray1<double>(1, aNb + 1);
+  double                                     aTolTrace = Precision::Confusion();
+  double                                     aUMin = 0., aUMax = 0., aVMin = 0., aVMax = 0.;
+  BRepTools::UVBounds(aS, aUMin, aUMax, aVMin, aVMax);
+  for (int i = 0; i <= aNb; ++i)
+  {
+    const double               aT = aAlpha * i / aNb;
+    const gp_Pnt               aP = aTrace->Value(aT);
+    GeomAPI_ProjectPointOnSurf aProj(aP, aSSurf);
+    if (aProj.NbPoints() == 0)
+    {
+      return false;
+    }
+    double aUs = 0., aVs = 0.;
+    aProj.LowerDistanceParameters(aUs, aVs);
+    if (i == 0)
+    {
+      // in the parametric domain of the face
+      if (aSSurf->IsUPeriodic())
+      {
+        aUs = ElCLib::InPeriod(aUs,
+                               aUMin - Precision::PConfusion(),
+                               aUMin - Precision::PConfusion() + aSSurf->UPeriod());
+      }
+      if (aSSurf->IsVPeriodic())
+      {
+        aVs = ElCLib::InPeriod(aVs,
+                               aVMin - Precision::PConfusion(),
+                               aVMin - Precision::PConfusion() + aSSurf->VPeriod());
+      }
+    }
+    else
+    {
+      // stay on the same sheet of a periodic surface
+      const gp_Pnt2d& aPrev = aUVs->Value(i);
+      if (aSSurf->IsUPeriodic())
+      {
+        aUs = ElCLib::InPeriod(aUs,
+                               aPrev.X() - 0.5 * aSSurf->UPeriod(),
+                               aPrev.X() + 0.5 * aSSurf->UPeriod());
+      }
+      if (aSSurf->IsVPeriodic())
+      {
+        aVs = ElCLib::InPeriod(aVs,
+                               aPrev.Y() - 0.5 * aSSurf->VPeriod(),
+                               aPrev.Y() + 0.5 * aSSurf->VPeriod());
+      }
+    }
+    aUVs->SetValue(i + 1, gp_Pnt2d(aUs, aVs));
+    aTs->SetValue(i + 1, aT);
+    aTolTrace = std::max(aTolTrace, aProj.LowerDistance());
+  }
+  Geom2dAPI_Interpolate anInt(aUVs, aTs, false, Precision::PConfusion());
+  anInt.Perform();
+  if (!anInt.IsDone())
+  {
+    return false;
+  }
+  const occ::handle<Geom2d_Curve> aPCOnS(anInt.Curve());
+  for (int i = 0; i < 4 * aNb; ++i)
+  {
+    const double   aT  = aAlpha * (i + 0.5) / (4 * aNb);
+    const gp_Pnt2d aUV = aPCOnS->Value(aT);
+    aTolTrace = std::max(aTolTrace, aTrace->Value(aT).Distance(aSSurf->Value(aUV.X(), aUV.Y())));
+  }
+  ChFiDS_FaceInterference& aFi1 = coin->ChangeInterferenceOnS1();
+  aFi1.SetInterference(
+    DStr.AddCurve(TopOpeBRepDS_Curve(aTrace, std::max(tolapp3d, 1.5 * aTolTrace))),
+    aTrans,
+    aPCOnS,
+    new Geom2d_Line(gp_Pnt2d(0., aVS), gp::DX2d()));
+  aFi1.SetFirstParameter(0.);
+  aFi1.SetLastParameter(aAlpha);
+  ChFiDS_FaceInterference& aFi2 = coin->ChangeInterferenceOnS2();
+  aFi2.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(occ::handle<Geom_Curve>(), 0.)),
+                       aTrans,
+                       occ::handle<Geom2d_Curve>(),
+                       new Geom2d_Line(gp_Pnt2d(0., aVP), gp::DX2d()));
+  aFi2.SetFirstParameter(0.);
+  aFi2.SetLastParameter(aAlpha);
+  coin->ChangeVertexFirstOnS1() = aQ1;
+  coin->ChangeVertexLastOnS1()  = aQ2;
+  coin->ChangeVertexFirstOnS2() = sd1->Vertex(isfirst1, IArc1);
+  coin->ChangeVertexLastOnS2()  = sd2->Vertex(isfirst2, IArc2);
+
+  // The edges between the corner and the fillets: their end sections.
+  const ChFiDS_CommonPoint& Pf1          = coin->VertexFirstOnS1();
+  const ChFiDS_CommonPoint& Pf2          = coin->VertexFirstOnS2();
+  const ChFiDS_CommonPoint& Pl1          = coin->VertexLastOnS1();
+  const int                 If1          = ChFi3d_IndexPointInDS(Pf1, DStr);
+  const int                 If2          = ChFi3d_IndexPointInDS(Pf2, DStr);
+  const int                 Il1          = ChFi3d_IndexPointInDS(Pl1, DStr);
+  const int                 Il2          = If2;
+  const auto                anEndSection = [&](const occ::handle<ChFiDS_Stripe>&   theSt,
+                                const occ::handle<ChFiDS_SurfData>& theSd,
+                                const bool                          theIsFirst,
+                                const int                           theICo,
+                                const int                           theIArc,
+                                const double                        theU,
+                                occ::handle<Geom2d_Curve>&          thePCCorner,
+                                double&                             thePar1,
+                                double&                             thePar2) -> int {
+    const ChFiDS_CommonPoint& aP1 = theU == 0. ? Pf1 : Pl1;
+    occ::handle<Geom_Curve>   aC3d;
+    double                    aTolReached = tolapp3d;
+    ChFi3d_ComputeArete(aP1,
+                        gp_Pnt2d(theU, aVS),
+                        Pf2,
+                        gp_Pnt2d(theU, aVP),
+                        aTor,
+                        aC3d,
+                        thePCCorner,
+                        thePar1,
+                        thePar2,
+                        tolapp3d,
+                        tol2d,
+                        aTolReached,
+                        0);
+    const double aPar  = theSd->Interference(theIArc).Parameter(theIsFirst);
+    double       aTolR = tolapp3d;
+    ChFi3d_ComputePCurv(aC3d,
+                        theSd->Interference(theICo).PCurveOnSurf()->Value(aPar),
+                        theSd->Interference(theIArc).PCurveOnSurf()->Value(aPar),
+                        theSt->ChangePCurve(theIsFirst),
+                        DStr.Surface(theSd->Surf()).Surface(),
+                        thePar1,
+                        thePar2,
+                        tolapp3d,
+                        aTolR);
+    const int    anIC = DStr.AddCurve(TopOpeBRepDS_Curve(aC3d, std::max(aTolReached, aTolR)));
+    ChFiDS_Regul aRegul;
+    aRegul.SetCurve(anIC);
+    aRegul.SetS1(coin->Surf(), false);
+    aRegul.SetS2(theSd->Surf(), false);
+    myRegul.Append(aRegul);
+    theSd->ChangeInterference(theICo).SetParameter(aPar, theIsFirst);
+    return anIC;
+  };
+  double    P1deb = 0., P2deb = 0., P1fin = 0., P2fin = 0.;
+  const int Icf =
+    anEndSection(st1, sd1, isfirst1, ICo1, IArc1, 0., corner->ChangeFirstPCurve(), P1deb, P2deb);
+  const int Icl =
+    anEndSection(st2, sd2, isfirst2, ICo2, IArc2, aAlpha, corner->ChangeLastPCurve(), P1fin, P2fin);
+  corner->ChangeFirstCurve(Icf);
+  corner->ChangeFirstParameters(P1deb, P2deb);
+  corner->ChangeIndexFirstPointOnS1(If1);
+  corner->ChangeIndexFirstPointOnS2(If2);
+  corner->ChangeLastCurve(Icl);
+  corner->ChangeLastParameters(P1fin, P2fin);
+  corner->ChangeIndexLastPointOnS1(Il1);
+  corner->ChangeIndexLastPointOnS2(Il2);
+  coin->ChangeIndexOfS1(DStr.AddShape(aS));
+  coin->ChangeIndexOfS2(0);
+  corner->SetSolidIndex(st1->SolidIndex());
+
+  // The stripes end on these edges.
+  st1->SetCurve(Icf, isfirst1);
+  st1->SetIndexPoint(If1, isfirst1, ICo1);
+  st1->SetIndexPoint(If2, isfirst1, IArc1);
+  st1->SetParameters(isfirst1, P1deb, P2deb);
+  if (ICo1 == 2)
+  {
+    st1->SetOrientation(TopAbs_REVERSED, isfirst1);
+  }
+  st2->SetCurve(Icl, isfirst2);
+  st2->SetIndexPoint(Il1, isfirst2, ICo2);
+  st2->SetIndexPoint(Il2, isfirst2, IArc2);
+  st2->SetParameters(isfirst2, P1fin, P2fin);
+  if (ICo2 == 2)
+  {
+    st2->SetOrientation(TopAbs_REVERSED, isfirst2);
+  }
+  if (!myEVIMap.IsBound(Vtx))
+  {
+    myEVIMap.Bind(Vtx, NCollection_List<int>());
+  }
+  myEVIMap.ChangeFind(Vtx).Append(coin->Surf());
+  myListStripe.Append(corner);
+  return true;
+}
