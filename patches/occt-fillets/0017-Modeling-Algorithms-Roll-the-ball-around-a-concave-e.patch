+static gp_Pnt2d VertexParameters(const TopoDS_Vertex& theV, const TopoDS_Face& theF)
+{
+  // The parameters of the vertex on the face, or of its projection
+  // on the surface of the face if the vertex is not on the face (a
+  // common face of surfdatas further from the corner).
+  for (TopExp_Explorer anExp(theF, TopAbs_VERTEX); anExp.More(); anExp.Next())
+  {
+    if (anExp.Current().IsSame(theV))
+    {
+      return BRep_Tool::Parameters(theV, theF);
+    }
+  }
+  GeomAPI_ProjectPointOnSurf aProj(BRep_Tool::Pnt(theV), BRep_Tool::Surface(theF));
+  double                     aU = 0., aV = 0.;
+  if (aProj.NbPoints() > 0)
+  {
+    aProj.LowerDistanceParameters(aU, aV);
+  }
+  return gp_Pnt2d(aU, aV);
+}
