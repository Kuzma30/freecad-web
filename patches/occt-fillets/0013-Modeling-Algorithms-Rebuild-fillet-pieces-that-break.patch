diff --git a/tests/bugs/modalg_8/fillet_wall_profile_over_root b/tests/bugs/modalg_8/fillet_wall_profile_over_root
new file mode 100644
index 00000000..9cdf863c
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_wall_profile_over_root
@@ -0,0 +1,21 @@
+puts "============"
+puts "Modeling Algorithms - Fillet of the start wall of a thread over the fillet of its root"
+puts "(FreeCAD screw: edges of the start wall, radius 1 as the fillet of the root)"
+puts "============"
+puts ""
+
+# The fillet runs along the whole profile of the groove on its start wall.
+# A ball of the radius of the fillet of the root barely fits into it: the
+# walking goes back and forth on the wall there, the surfdata on the fillet
+# of the root is twisted and the next one starts with a hook. The hook is
+# left to the filling that rebuilds the twisted surfdata, its trace on the
+# wall following the neighbors smoothly. Both ends are closed as in
+# fillet_wall_profile_cusp_ends.
+restore [locate_data_file freecad_screw_wall_profile.brep] b
+explode b E
+
+blend result b 1 b_95
+
+checkshape result
+checkmaxtol result -ref 1.83e-4
+checkprops result -v 8707.45 -s 3016.81
diff --git a/tests/bugs/modalg_8/fillet_wall_profile_smooth_at_root b/tests/bugs/modalg_8/fillet_wall_profile_smooth_at_root
