+static occ::handle<Geom2d_Curve> SmoothPCurve(const occ::handle<Adaptor3d_Surface>& theSurf,
+                                              const gp_Pnt2d&                       thePnt1,
+                                              const gp_Vec2d&                       theTan1,
+                                              const gp_Pnt2d&                       thePnt2,
+                                              const gp_Vec2d&                       theTan2)
+{
+  // A cubic from thePnt1 to thePnt2 on the surface, tangent there to
+  // theTan1 and theTan2 (both along the curve), with the tangents
+  // of a circular arc turning by the angle between them.
+  // In parameters scaled to the lengths on the surface.
+  const double aUR = theSurf->UResolution(1.), aVR = theSurf->VResolution(1.);
+  const gp_XY  aP1(thePnt1.X() / aUR, thePnt1.Y() / aVR), aP2(thePnt2.X() / aUR, thePnt2.Y() / aVR);
+  gp_XY        aT1(theTan1.X() / aUR, theTan1.Y() / aVR), aT2(theTan2.X() / aUR, theTan2.Y() / aVR);
+  const double aChord = (aP2 - aP1).Modulus();
+  if (aT1.Modulus() > gp::Resolution())
+  {
+    aT1.Normalize();
+  }
+  if (aT2.Modulus() > gp::Resolution())
+  {
+    aT2.Normalize();
+  }
+  // The length of the tangents of a circular arc turning by the same angle.
+  const double aTurn = std::max(std::acos(std::max(-1., std::min(1., aT1 * aT2))), 1.e-3);
+  const double aLen  = aChord * 2. / 3. * std::tan(aTurn / 4.) / std::sin(aTurn / 2.);
+  NCollection_Array1<gp_Pnt2d> aPoles(1, 4);
+  aPoles(1) = gp_Pnt2d(aP1);
+  aPoles(2) = gp_Pnt2d(aP1 + aT1 * aLen);
+  aPoles(3) = gp_Pnt2d(aP2 - aT2 * aLen);
+  aPoles(4) = gp_Pnt2d(aP2);
+  for (int i = 1; i <= 4; ++i)
+  {
+    aPoles(i).SetCoord(aPoles(i).X() * aUR, aPoles(i).Y() * aVR);
+  }
+  return new Geom2d_BezierCurve(aPoles);
+}
