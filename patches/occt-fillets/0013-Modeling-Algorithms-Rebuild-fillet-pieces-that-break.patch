diff --git a/tests/bugs/modalg_8/fillet_wall_profile_corner_at_root b/tests/bugs/modalg_8/fillet_wall_profile_corner_at_root
new file mode 100644
index 00000000..e4c05570
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_wall_profile_corner_at_root
@@ -0,0 +1,19 @@
+puts "============"
+puts "Modeling Algorithms - Fillet of the start wall of a thread too large for its root"
+puts "(FreeCAD screw: edges of the start wall, radius 1.2, fillet of the root 1)"
+puts "============"
+puts ""
+
+# The ball does not fit into the fillet of the root: the walking makes a
+# swallowtail on the wall there. The trace on the wall of the surfdata before
+# is cut where the trace of the surfdata after, extended back, meets it; the
+# twisted surfdata between is rebuilt by a filling whose side on the wall is
+# the straight segment from that corner, tangent to the faces around it.
+restore [locate_data_file freecad_screw_wall_profile.brep] b
+explode b E
+
+blend result b 1.2 b_95
+
+checkshape result
+checkmaxtol result -ref 2.44e-4
+checkprops result -v 8708.12 -s 3016.4
