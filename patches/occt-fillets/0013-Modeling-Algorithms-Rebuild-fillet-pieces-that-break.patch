+//=================================================================================================
+
+static bool CornerOnPrevious(const occ::handle<ChFiDS_SurfData>& thePrev,
+                             const occ::handle<ChFiDS_SurfData>& theNext,
+                             const int                           theSide,
+                             const double                        theWNext,
+                             double&                             theW,
+                             double&                             theWNextOut)
+{
+  // The parameter theW on the trace on side theSide of thePrev
+  // (in its second half) where the trace of theNext, extended back
+  // straight from the parameter theWNext in the parameters of the
+  // face, meets it; theWNextOut, the parameter on the trace of
+  // theNext where it starts then (at the crossing, if the trace
+  // after already crosses the one before).
+  const ChFiDS_FaceInterference&   aFp = thePrev->Interference(theSide);
+  const occ::handle<Geom2d_Curve>& aCp = aFp.PCurveOnFace();
+  const occ::handle<Geom2d_Curve>& aCn = theNext->Interference(theSide).PCurveOnFace();
+  if (aCp.IsNull() || aCn.IsNull())
+  {
+    return false;
+  }
+  theWNextOut = theWNext;
+  gp_Pnt2d aP2;
+  gp_Vec2d aT2;
+  aCn->D1(theWNext, aP2, aT2);
+  if (aT2.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  aT2.Normalize();
+  // The signed distance to the line of the trace after, behind its start.
+  const auto aSide2 = [&](const double theW) {
+    return aT2.Crossed(gp_Vec2d(aP2, aCp->Value(theW)));
+  };
+  const double aF = aFp.FirstParameter(), aL = aFp.LastParameter();
+  const int    aNb = 100;
+  double       aW1 = aL, aD1 = aSide2(aL);
+  for (int k = aNb - 1; k >= aNb / 2; --k)
+  {
+    const double aW0 = aF + (aL - aF) * k / aNb;
+    const double aD0 = aSide2(aW0);
+    if ((aD0 <= 0.) != (aD1 <= 0.))
+    {
+      // Bisection.
+      double aA = aW0, aB = aW1, aDA = aD0;
+      for (int i = 0; i < 50; ++i)
+      {
+        const double aM  = 0.5 * (aA + aB);
+        const double aDM = aSide2(aM);
+        if ((aDM <= 0.) == (aDA <= 0.))
+        {
+          aA  = aM;
+          aDA = aDM;
+        }
+        else
+        {
+          aB = aM;
+        }
+      }
+      theW = 0.5 * (aA + aB);
+      // Behind the start of the trace after (or at it), and not at the end
+      // of the trace before (that is no corner).
+      const double   aScale = aCp->Value(aF).Distance(aCp->Value(aL));
+      const gp_Pnt2d aX     = aCp->Value(theW);
+      if (aL - theW < 1.e-3 * (aL - aF))
+      {
+        return false;
+      }
+      if (gp_Vec2d(aP2, aX).Dot(aT2) < 1.e-3 * aScale)
+      {
+        return true;
+      }
+      // Ahead of the start of the trace after: the trace after crosses the
+      // one before there, it starts at the crossing.
+      const ChFiDS_FaceInterference& aFn   = theNext->Interference(theSide);
+      double                         aBest = RealLast(), aWBest = theWNext;
+      for (int j = 0; j <= 200; ++j)
+      {
+        const double aWj = theWNext + (aFn.LastParameter() - theWNext) * j / 200.;
+        const double aDj = aCn->Value(aWj).Distance(aX);
+        if (aDj < aBest)
+        {
+          aBest  = aDj;
+          aWBest = aWj;
+        }
+      }
+      if (aBest > 1.e-2 * aScale || aWBest - theWNext > 0.5 * (aFn.LastParameter() - theWNext))
+      {
+        return false;
+      }
+      theWNextOut = aWBest;
+      return true;
+    }
+    aW1 = aW0;
+    aD1 = aD0;
+  }
+  return false;
+}
