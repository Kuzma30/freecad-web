diff --git a/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_three_fillets_corner b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_three_fillets_corner
new file mode 100644
index 000000000..f54e568c9
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_three_fillets_corner
@@ -0,0 +1,41 @@
+puts "============"
+puts "Modeling Algorithms - Corner of a concave fillet and two convex fillets at a square hole in a rounded cube"
+puts "(FreeCAD issue 20085: cube 20 with fillets of radius 6, square hole 8 x 8)"
+puts "============"
+puts ""
+
+# A vertical (concave) edge of the hole and the two upper (convex) edges at its
+# end are filleted together (Fillet001 in FreeCAD). The vertex has more edges
+# (smooth edges between the fillets and the sphere of the cube) and the corner
+# was a plate patch with tolerance 0.0068 (r = 0.5) to 0.21 (r = 2.5). The
+# vertical fillet is now computed first and the fillets of the upper edges go
+# round its end: the result is the one of the fillets made in two steps.
+restore [locate_data_file freecad20085_rounded_cube_pocket.brep] b
+explode b E
+
+foreach {r tol vol} {0.5 5.e-4 5155.21 1 2.4e-4 5154.84 2 1.5e-4 5145.02 2.5 1.e-4 5124.27} {
+  blend result b $r b_26 $r b_13 $r b_35
+  checkshape result
+  checkmaxtol result -ref $tol
+  checkprops result -v $vol
+
+  # in two steps: the vertical edge, then the upper edges shortened by it
+  blend r1 b $r b_26
+  set upper {}
+  foreach e [explode r1 E] {
+    set bb [bounding $e]
+    if {abs([lindex $bb 2] - 10.) < 1.e-3 && abs([lindex $bb 5] - 10.) < 1.e-3
+        && ((abs([lindex $bb 0] + 4.) < 1.e-3 && abs([lindex $bb 3] + 4.) < 1.e-3
+             && [lindex $bb 4] - [lindex $bb 1] > 4.)
+         || (abs([lindex $bb 1] + 4.) < 1.e-3 && abs([lindex $bb 4] + 4.) < 1.e-3
+             && [lindex $bb 3] - [lindex $bb 0] > 4.))} {
+      lappend upper $r $e
+    }
+  }
+  if {[llength $upper] != 4} {
+    puts "Error: r = $r, the upper edges are not found"
+    continue
+  }
+  eval blend r2 r1 $upper
+  checkprops r2 -equal result
+}
