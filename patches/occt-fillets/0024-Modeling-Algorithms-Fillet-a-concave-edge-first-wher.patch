+namespace
+{
+using ShapeListMap =
+  NCollection_IndexedDataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>;
+using ShapeMap = NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>;
+
+//! Returns the concavity of the angle of the two faces of an edge.
+//! @param[in] theEdge      edge of the shape
+//! @param[in] theEdgeFaces faces of the edges of the shape
+//! @return ChFiDS_Other if the edge does not bound two distinct faces
+ChFiDS_TypeOfConcavity edgeConcavity(const TopoDS_Edge& theEdge, const ShapeListMap& theEdgeFaces)
+{
+  const NCollection_List<TopoDS_Shape>* aFaces = theEdgeFaces.Seek(theEdge);
+  if (aFaces == nullptr || aFaces->Extent() != 2)
+  {
+    return ChFiDS_Other;
+  }
+  const TopoDS_Face& aFace1 = TopoDS::Face(aFaces->First());
+  const TopoDS_Face& aFace2 = TopoDS::Face(aFaces->Last());
+  if (aFace1.IsSame(aFace2))
+  {
+    return ChFiDS_Other;
+  }
+  return ChFi3d::DefineConnectType(theEdge, aFace1, aFace2, 1.e-5, true);
+}
+
+//=================================================================================================
+
+//! Returns the faces replacing a face of the input of a stage in its result.
+//! @param[in] theFace  face of the input of the stage
+//! @param[in] theStage computed stage
+//! @param[out] theImages faces of the result; empty if the face is deleted
+void faceImages(const TopoDS_Shape&             theFace,
+                BRepFilletAPI_MakeFillet&       theStage,
+                NCollection_List<TopoDS_Shape>& theImages)
+{
+  theImages.Clear();
+  if (theStage.IsDeleted(theFace))
+  {
+    return;
+  }
+  const NCollection_List<TopoDS_Shape>& aModified = theStage.Modified(theFace);
+  if (aModified.IsEmpty())
+  {
+    theImages.Append(theFace);
+    return;
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(aModified); anIt.More(); anIt.Next())
+  {
+    theImages.Append(anIt.Value());
+  }
+}
+
+//=================================================================================================
+
+//! Returns the edges replacing an edge of the input of a stage in its result:
+//! the edges of the result shared by the images of the two faces of the edge
+//! and lying on it.
+//! @param[in] theEdge        edge of the input of the stage
+//! @param[in] theEdgeFaces   faces of the edges of the input
+//! @param[in] theStage       computed stage
+//! @param[in] theResultEdges faces of the edges of the result of the stage
+//! @param[out] theImages     edges of the result
+void edgeImages(const TopoDS_Edge&              theEdge,
+                const ShapeListMap&             theEdgeFaces,
+                BRepFilletAPI_MakeFillet&       theStage,
+                const ShapeListMap&             theResultEdges,
+                NCollection_List<TopoDS_Shape>& theImages)
+{
+  theImages.Clear();
+  if (theResultEdges.Contains(theEdge))
+  {
+    theImages.Append(theEdge);
+    return;
+  }
+  const NCollection_List<TopoDS_Shape>* aFaces = theEdgeFaces.Seek(theEdge);
+  if (aFaces == nullptr || aFaces->Extent() != 2)
+  {
+    return;
+  }
+  NCollection_List<TopoDS_Shape> anImages1, anImages2;
+  faceImages(aFaces->First(), theStage, anImages1);
+  faceImages(aFaces->Last(), theStage, anImages2);
+  ShapeMap anImageMap1, anImageMap2;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(anImages1); anIt.More(); anIt.Next())
+  {
+    anImageMap1.Add(anIt.Value());
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(anImages2); anIt.More(); anIt.Next())
+  {
+    anImageMap2.Add(anIt.Value());
+  }
+  const BRepAdaptor_Curve anEdgeCurve(theEdge);
+  ShapeMap                aCandidates;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(anImages1); anIt.More(); anIt.Next())
+  {
+    for (TopExp_Explorer anExp(anIt.Value(), TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      const TopoDS_Edge& aCandidate = TopoDS::Edge(anExp.Current());
+      if (BRep_Tool::Degenerated(aCandidate) || !aCandidates.Add(aCandidate))
+      {
+        continue;
+      }
+      const NCollection_List<TopoDS_Shape>* aCandidateFaces = theResultEdges.Seek(aCandidate);
+      if (aCandidateFaces == nullptr || aCandidateFaces->Extent() != 2)
+      {
+        continue;
+      }
+      const TopoDS_Shape& aFace1 = aCandidateFaces->First();
+      const TopoDS_Shape& aFace2 = aCandidateFaces->Last();
+      if (!(anImageMap1.Contains(aFace1) && anImageMap2.Contains(aFace2))
+          && !(anImageMap1.Contains(aFace2) && anImageMap2.Contains(aFace1)))
+      {
+        continue;
+      }
+      const BRepAdaptor_Curve aCurve(aCandidate);
+      const gp_Pnt aMid = aCurve.Value(0.5 * (aCurve.FirstParameter() + aCurve.LastParameter()));
+      const Extrema_ExtPC anExt(aMid, anEdgeCurve);
+      if (!anExt.IsDone() || anExt.NbExt() == 0)
+      {
+        continue;
+      }
+      double aMinSqDist = anExt.SquareDistance(1);
+      for (int i = 2; i <= anExt.NbExt(); ++i)
+      {
+        aMinSqDist = std::min(aMinSqDist, anExt.SquareDistance(i));
+      }
+      const double aTol =
+        BRep_Tool::Tolerance(theEdge) + BRep_Tool::Tolerance(aCandidate) + Precision::Confusion();
+      if (aMinSqDist <= aTol * aTol)
+      {
+        theImages.Append(aCandidate);
+      }
+    }
+  }
+}
+
+//=================================================================================================
+
+//! Records the history of a stage: the faces modified or deleted and the
+//! shapes generated from the edges and vertices of its input.
+//! @param[in] theInput      input shape of the stage
+//! @param[in] theStage      computed stage
+//! @param[in] theWithEdges  when true, the new edges of the generated faces
+//!                          are recorded as generated as well, so that what
+//!                          a later stage builds on them is related to the
+//!                          input
+//! @param[in,out] theHistory history to fill
+void addStageHistory(const TopoDS_Shape&       theInput,
+                     BRepFilletAPI_MakeFillet& theStage,
+                     const bool                theWithEdges,
+                     BRepTools_History&        theHistory)
+{
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anInputEdges, aShapes;
+  TopExp::MapShapes(theInput, TopAbs_EDGE, anInputEdges);
+  TopExp::MapShapes(theInput, TopAbs_VERTEX, aShapes);
+  TopExp::MapShapes(theInput, TopAbs_EDGE, aShapes);
+  for (int i = 1; i <= aShapes.Extent(); ++i)
+  {
+    const TopoDS_Shape&                  aShape = aShapes(i);
+    const NCollection_List<TopoDS_Shape> aGenerated(theStage.Generated(aShape));
+    ShapeMap                             aGeneratedEdges;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(aGenerated); anIt.More(); anIt.Next())
+    {
+      theHistory.AddGenerated(aShape, anIt.Value());
+      if (!theWithEdges)
+      {
+        continue;
+      }
+      for (TopExp_Explorer anExp(anIt.Value(), TopAbs_EDGE); anExp.More(); anExp.Next())
+      {
+        const TopoDS_Shape& anEdge = anExp.Current();
+        if (!anInputEdges.Contains(anEdge) && aGeneratedEdges.Add(anEdge))
+        {
+          theHistory.AddGenerated(aShape, anEdge);
+        }
+      }
+    }
+  }
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aFaces;
+  TopExp::MapShapes(theInput, TopAbs_FACE, aFaces);
+  for (int i = 1; i <= aFaces.Extent(); ++i)
+  {
+    const TopoDS_Shape& aFace = aFaces(i);
+    if (theStage.IsDeleted(aFace))
+    {
+      theHistory.Remove(aFace);
+      continue;
+    }
+    const NCollection_List<TopoDS_Shape> aModified(theStage.Modified(aFace));
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(aModified); anIt.More(); anIt.Next())
+    {
+      if (!anIt.Value().IsSame(aFace))
+      {
+        theHistory.AddModified(aFace, anIt.Value());
+      }
+    }
+  }
+}
+} // namespace
