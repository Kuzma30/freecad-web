+
+// The same holed cube with a vertical (concave) edge of the hole and the two
+// upper (convex) edges at its end filleted together. Their corner was a plate
+// patch with tolerance up to 0.2. The vertical fillet is now computed first and
+// the fillets of the upper edges go round its end: the result is the one of the
+// fillets made in two steps, and the history relates it to the holed cube.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_ThreeFilletsCornerAsInTwoSteps)
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  // Returns the edges of theShape longer than 4 whose middle is one of thePoints.
+  const auto aFindEdges = [](const TopoDS_Shape&                 theShape,
+                             const NCollection_Sequence<gp_Pnt>& thePoints) {
+    NCollection_List<TopoDS_Shape>                                anEdges;
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aMap;
+    TopExp::MapShapes(theShape, TopAbs_EDGE, aMap);
+    for (int anIE = 1; anIE <= aMap.Extent(); ++anIE)
+    {
+      GProp_GProps aProps;
+      BRepGProp::LinearProperties(aMap(anIE), aProps);
+      for (int i = 1; i <= thePoints.Length(); ++i)
+      {
+        if (aProps.Mass() > 4.0 && aProps.CentreOfMass().Distance(thePoints(i)) < 0.6)
+        {
+          anEdges.Append(aMap(anIE));
+          break;
+        }
+      }
+    }
+    return anEdges;
+  };
+  const auto aVolume = [](const TopoDS_Shape& theShape) {
+    GProp_GProps aProps;
+    BRepGProp::VolumeProperties(theShape, aProps);
+    return aProps.Mass();
+  };
+  NCollection_Sequence<gp_Pnt> aVertical, anUpper;
+  aVertical.Append(gp_Pnt(-4.0, -4.0, 0.0));
+  anUpper.Append(gp_Pnt(-4.0, 0.0, 10.0));
+  anUpper.Append(gp_Pnt(0.0, -4.0, 10.0));
+  // On the cube after the vertical fillet the upper edges are shorter by r.
+  NCollection_Sequence<gp_Pnt> anUpperShortened;
+
+  const double aRadii[3] = {0.5, 1.0, 2.0};
+  for (int r = 0; r < 3; ++r)
+  {
+    const double aRadius = aRadii[r];
+    anUpperShortened.Clear();
+    anUpperShortened.Append(gp_Pnt(-4.0, 0.5 * aRadius, 10.0));
+    anUpperShortened.Append(gp_Pnt(0.5 * aRadius, -4.0, 10.0));
+
+    // All together.
+    BRepFilletAPI_MakeFillet       aFillet(aHoled);
+    NCollection_List<TopoDS_Shape> anEdges       = aFindEdges(aHoled, aVertical);
+    NCollection_List<TopoDS_Shape> anUpperEdges1 = aFindEdges(aHoled, anUpper);
+    anEdges.Append(anUpperEdges1);
+    ASSERT_EQ(anEdges.Extent(), 3);
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(anEdges); anIt.More(); anIt.Next())
+    {
+      aFillet.Add(aRadius, TopoDS::Edge(anIt.Value()));
+    }
+    ASSERT_EQ(aFillet.NbContours(), 3);
+    aFillet.Build();
+    ASSERT_TRUE(aFillet.IsDone()) << "r = " << aRadius;
+    const TopoDS_Shape& aResult = aFillet.Shape();
+    EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid()) << "r = " << aRadius;
+    double aMaxTol = 0.0;
+    for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+    {
+      aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+    }
+    EXPECT_LT(aMaxTol, 1.e-3) << "r = " << aRadius;
+
+    // In two steps.
+    BRepFilletAPI_MakeFillet aFirst(aHoled);
+    aFirst.Add(aRadius, TopoDS::Edge(aFindEdges(aHoled, aVertical).First()));
+    aFirst.Build();
+    ASSERT_TRUE(aFirst.IsDone());
+    BRepFilletAPI_MakeFillet             aSecond(aFirst.Shape());
+    const NCollection_List<TopoDS_Shape> anUpperEdges =
+      aFindEdges(aFirst.Shape(), anUpperShortened);
+    ASSERT_EQ(anUpperEdges.Extent(), 2) << "r = " << aRadius;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(anUpperEdges); anIt.More(); anIt.Next())
+    {
+      aSecond.Add(aRadius, TopoDS::Edge(anIt.Value()));
+    }
+    aSecond.Build();
+    ASSERT_TRUE(aSecond.IsDone());
+    EXPECT_NEAR(aVolume(aResult), aVolume(aSecond.Shape()), 1.e-6) << "r = " << aRadius;
+
+    // Each face of the result is a face of the holed cube, modified from one or
+    // generated from an edge or a vertex of it.
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anInputs, aTraced;
+    TopExp::MapShapes(aHoled, TopAbs_FACE, anInputs);
+    for (int i = 1; i <= anInputs.Extent(); ++i)
+    {
+      EXPECT_FALSE(aFillet.IsDeleted(anInputs(i)));
+      for (NCollection_List<TopoDS_Shape>::Iterator anIt(aFillet.Modified(anInputs(i)));
+           anIt.More();
+           anIt.Next())
+      {
+        aTraced.Add(anIt.Value());
+      }
+    }
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aSources;
+    TopExp::MapShapes(aHoled, TopAbs_EDGE, aSources);
+    TopExp::MapShapes(aHoled, TopAbs_VERTEX, aSources);
+    for (int i = 1; i <= aSources.Extent(); ++i)
+    {
+      for (NCollection_List<TopoDS_Shape>::Iterator anIt(aFillet.Generated(aSources(i)));
+           anIt.More();
+           anIt.Next())
+      {
+        aTraced.Add(anIt.Value());
+      }
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(anEdges); anIt.More(); anIt.Next())
+    {
+      EXPECT_FALSE(aFillet.Generated(anIt.Value()).IsEmpty()) << "r = " << aRadius;
+    }
+    int aNbUntraced = 0;
+    for (TopExp_Explorer anExp(aResult, TopAbs_FACE); anExp.More(); anExp.Next())
+    {
+      if (!anInputs.Contains(anExp.Current()) && !aTraced.Contains(anExp.Current()))
+      {
+        ++aNbUntraced;
+      }
+    }
+    EXPECT_EQ(aNbUntraced, 0) << "r = " << aRadius;
+  }
+}
