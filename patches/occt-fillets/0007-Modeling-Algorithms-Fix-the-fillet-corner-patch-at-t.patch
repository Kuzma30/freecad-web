+// The same fillet on all three edges: the edge between the two corner patches
+// at y = 50 is bounded by both of them, at its own vertices.
+TEST(BRepFilletAPI_MakeFilletTest, PastShrinkingSupportFaceOnAllEdges_ProducesValidShape)
+{
+  const TopoDS_Shape                  aShape  = MakeQuarterRevolveOnBox();
+  const NCollection_List<TopoDS_Edge> anEdges = RevolveFootEdges(aShape, true);
+  ASSERT_EQ(anEdges.Extent(), 3);
+
+  BRepFilletAPI_MakeFillet aFillet(aShape);
+  for (const TopoDS_Edge& anEdge : anEdges)
+  {
+    aFillet.Add(15.0, anEdge);
+  }
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+  EXPECT_LT(MaxVertexTolerance(aFillet.Shape()), 5.0);
+}
