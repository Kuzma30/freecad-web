+
+// A square hole exactly as wide as the flat top of a box with rounded edges:
+// the rim of the hole runs along the tangent lines of the rounded edges. The
+// corner patches of the rim fillet cannot be tangent to the fillets around
+// them; with the tangency constraints the plate waved far out of the corner
+// and the volume taken by the fillet was 527 mm3 instead of a few tens.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleFlushWithRoundedEdges_KeepsCornersLocal)
+{
+  const TopoDS_Shape       aBox = BRepPrimAPI_MakeBox(20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(3.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(3.0, 3.0, 12.0), 14.0, 14.0, 10.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  BRepFilletAPI_MakeFillet                                      aFillet(aHoled);
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+  TopExp::MapShapes(aHoled, TopAbs_EDGE, anEdges);
+  for (int i = 1; i <= anEdges.Extent(); ++i)
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(anEdges(i));
+    GProp_GProps       aProps;
+    BRepGProp::LinearProperties(anEdge, aProps);
+    const gp_Pnt aMid = aProps.CentreOfMass();
+    if (std::abs(aMid.Z() - 20.0) < 1.e-6
+        && (std::abs(aMid.X() - 3.0) < 1.e-6 || std::abs(aMid.X() - 17.0) < 1.e-6
+            || std::abs(aMid.Y() - 3.0) < 1.e-6 || std::abs(aMid.Y() - 17.0) < 1.e-6))
+    {
+      aFillet.Add(1.0, anEdge);
+    }
+  }
+  ASSERT_EQ(aFillet.NbContours(), 4);
+
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+
+  // A fillet of 1 mm along a rim of 56 mm takes about (1 - pi/4) * 56 = 12 mm3,
+  // plus the corners.
+  GProp_GProps aBefore, anAfter;
+  BRepGProp::VolumeProperties(aHoled, aBefore);
+  BRepGProp::VolumeProperties(aFillet.Shape(), anAfter);
+  const double aRemoved = aBefore.Mass() - anAfter.Mass();
+  EXPECT_GT(aRemoved, 5.0);
+  EXPECT_LT(aRemoved, 60.0);
+}
