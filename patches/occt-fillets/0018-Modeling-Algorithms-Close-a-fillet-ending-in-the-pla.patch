diff --git a/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_Test.cxx b/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_Test.cxx
index 0e9cf901b..fd59dfcf1 100644
--- a/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_Test.cxx
+++ b/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_Test.cxx
@@ -1395,3 +1395,81 @@ TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_RollsBallAroundHoleEd
   BRepGProp::VolumeProperties(aResult, anAfter);
   EXPECT_NEAR(aBefore.Mass() - anAfter.Mass(), 129.34, 0.05);
 }
+
+// The same holed cube with three of the four upper edges of the hole filleted.
+// Two fillets end at corners of the hole whose next edge is not filleted. Each
+// end lies in the plane of the next wall of the hole, which also holds the edge
+// between the fillet of the cube and the sphere of its corner: the wall is
+// extended up to the end of the fillet and bounded by that edge. Depending on
+// the side from which the faces at the corner were met, the fillet was cut by
+// three faces (a wavy patch) and the sphere lost its boundary.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_FilletEndsInWallPlane)
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  // The upper edges on the walls x = -4, y = 4 and x = 4.
+  BRepFilletAPI_MakeFillet                                      aFillet(aHoled);
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+  TopExp::MapShapes(aHoled, TopAbs_EDGE, anEdges);
+  for (int i = 1; i <= anEdges.Extent(); ++i)
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(anEdges(i));
+    GProp_GProps       aProps;
+    BRepGProp::LinearProperties(anEdge, aProps);
+    const gp_Pnt aMid = aProps.CentreOfMass();
+    if (std::abs(aMid.Z() - 10.0) < 1.e-6
+        && std::abs(std::abs(aMid.X()) + std::abs(aMid.Y()) - 4.0) < 1.e-6 && aMid.Y() > -1.0)
+    {
+      aFillet.Add(2.0, anEdge);
+    }
+  }
+  ASSERT_EQ(aFillet.NbContours(), 3);
+
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  const TopoDS_Shape& aResult = aFillet.Shape();
+  EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid());
+
+  double aMaxTol = 0.0;
+  for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+  {
+    aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+  }
+  EXPECT_LT(aMaxTol, 1.e-3);
+
+  // No patch at the ends: the faces of the fillets are cylinders and tori.
+  int aNbTori = 0, aNbFree = 0;
+  for (TopExp_Explorer anExp(aResult, TopAbs_FACE); anExp.More(); anExp.Next())
+  {
+    const BRepAdaptor_Surface aSurf(TopoDS::Face(anExp.Current()));
+    if (aSurf.GetType() == GeomAbs_Torus)
+    {
+      ++aNbTori;
+    }
+    else if (aSurf.GetType() == GeomAbs_BSplineSurface || aSurf.GetType() == GeomAbs_BezierSurface)
+    {
+      ++aNbFree;
+    }
+  }
+  EXPECT_EQ(aNbTori, 2);
+  EXPECT_EQ(aNbFree, 0);
+
+  // Three fillets of 14.18 mm3 and two corners of 1.99 mm3.
+  GProp_GProps aBefore, anAfter;
+  BRepGProp::VolumeProperties(aHoled, aBefore);
+  BRepGProp::VolumeProperties(aResult, anAfter);
+  EXPECT_NEAR(aBefore.Mass() - anAfter.Mass(), 46.51, 0.05);
+}
diff --git a/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_ends b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_ends
new file mode 100644
index 000000000..3dc500712
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_ends
@@ -0,0 +1,38 @@
+puts "============"
+puts "Modeling Algorithms - Fillets ending at the corners of a square hole in a rounded cube"
+puts "(FreeCAD issue 20085: cube 20 with fillets of radius 6, square hole 8 x 8)"
+puts "============"
+puts ""
+
+# Three upper edges of the hole and one lower edge are filleted. The fillets
+# end at corners of the hole whose next edge is not filleted: each end lies in
+# the plane of the next wall of the hole, which holds the edge between the
+# fillet of the cube and the sphere of its corner. The wall is extended up to
+# the end of the fillet and bounded by that edge; no patch is built.
+restore [locate_data_file freecad20085_rounded_cube_pocket.brep] b
+explode b E
+
+blend result b 2 b_13 2 b_43 2 b_58 2 b_33
+
+checkshape result
+checkmaxtol result -ref 1.e-4
+checkprops result -v 5094.43 -s 2212.9
+
+set nbtor 0
+set nbfree 0
+foreach f [explode result F] {
+  mksurface s $f
+  set d [dump s]
+  if {[regexp {ToroidalSurface} $d]} {
+    incr nbtor
+  }
+  if {[regexp {BSplineSurface|BezierSurface} $d]} {
+    incr nbfree
+  }
+}
+if {$nbtor != 2} {
+  puts "Error: $nbtor toroidal faces instead of 2"
+}
+if {$nbfree != 0} {
+  puts "Error: $nbfree patches at the ends of the fillets"
+}
