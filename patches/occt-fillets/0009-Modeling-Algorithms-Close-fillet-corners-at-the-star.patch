@@ -121,6 +126,127 @@ static void CompleteDS(TopOpeBRepDS_DataStructure& DStr, const TopoDS_Shape& S)
 
 //=================================================================================================
 
+// Gap in UV between the ends of theEdge (taken with its orientation in the
+// wire) and the edges of the wire meeting it, for the given pcurve.
+static double WireGapInUV(const TopoDS_Wire&               theWire,
+                          const TopoDS_Edge&               theEdge,
+                          const TopoDS_Face&               theFace,
+                          const occ::handle<Geom2d_Curve>& thePC)
+{
+  TopoDS_Vertex aV[2];
+  TopExp::Vertices(theEdge, aV[0], aV[1]);
+  double aGap = 0.;
+  for (int i = 0; i < 2; ++i)
+  {
+    if (aV[i].IsNull())
+    {
+      continue;
+    }
+    const gp_Pnt2d aUV   = thePC->Value(BRep_Tool::Parameter(aV[i], theEdge));
+    double         aBest = Precision::Infinite();
+    for (TopExp_Explorer anExp(theWire, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      const TopoDS_Edge& anE = TopoDS::Edge(anExp.Current());
+      if (anE.IsSame(theEdge) || BRep_Tool::Degenerated(anE))
+      {
+        continue;
+      }
+      for (TopExp_Explorer aVExp(anE, TopAbs_VERTEX); aVExp.More(); aVExp.Next())
+      {
+        if (!aVExp.Current().IsSame(aV[i]))
+        {
+          continue;
+        }
+        double                          aF, aL;
+        const occ::handle<Geom2d_Curve> aPC = BRep_Tool::CurveOnSurface(anE, theFace, aF, aL);
+        if (!aPC.IsNull())
+        {
+          const gp_Pnt2d aP =
+            aPC->Value(BRep_Tool::Parameter(TopoDS::Vertex(aVExp.Current()), anE));
+          aBest = std::min(aBest, aP.Distance(aUV));
+        }
+      }
+    }
+    if (!Precision::IsInfinite(aBest))
+    {
+      aGap += aBest;
+    }
+  }
+  return aGap;
+}
+
+//=================================================================================================
+
+// Two faces built on one surface handle (a cylinder split by a smooth edge)
+// keep both pcurves of their common edge in a single closed representation,
+// and which one each face gets depends on the edge orientation. Rebuilt
+// pieces of such an edge can come out with the two pcurves swapped, leaving
+// both faces with wires that jump by a period. Swap them back.
+static void FixSwappedPCurves(const TopoDS_Shape& theShape)
+{
+  BRep_Builder aBB;
+  for (TopExp_Explorer aFExp(theShape, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    const TopoDS_Face&        aFace = TopoDS::Face(aFExp.Current());
+    TopLoc_Location           aLoc;
+    occ::handle<Geom_Surface> aSurf = BRep_Tool::Surface(aFace, aLoc);
+    if (aSurf.IsNull())
+    {
+      continue;
+    }
+    for (TopExp_Explorer aWExp(aFace, TopAbs_WIRE); aWExp.More(); aWExp.Next())
+    {
+      const TopoDS_Wire& aWire = TopoDS::Wire(aWExp.Current());
+      for (TopExp_Explorer anEExp(aWire, TopAbs_EDGE); anEExp.More(); anEExp.Next())
+      {
+        const TopoDS_Edge& anEdge = TopoDS::Edge(anEExp.Current());
+        if (!BRep_Tool::IsClosed(anEdge, aSurf, aLoc))
+        {
+          continue;
+        }
+        int aNbUses = 0;
+        for (TopExp_Explorer anExp(aFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+        {
+          if (anExp.Current().IsSame(anEdge))
+          {
+            ++aNbUses;
+          }
+        }
+        if (aNbUses != 1)
+        {
+          continue; // a true seam
+        }
+        double                          aF, aL;
+        const TopoDS_Edge               anOther = TopoDS::Edge(anEdge.Reversed());
+        const occ::handle<Geom2d_Curve> aPCcur  = BRep_Tool::CurveOnSurface(anEdge, aFace, aF, aL);
+        const occ::handle<Geom2d_Curve> aPCalt  = BRep_Tool::CurveOnSurface(anOther, aFace, aF, aL);
+        if (aPCcur.IsNull() || aPCalt.IsNull())
+        {
+          continue;
+        }
+        const double aGapCur = WireGapInUV(aWire, anEdge, aFace, aPCcur);
+        const double aGapAlt = WireGapInUV(aWire, anEdge, aFace, aPCalt);
+        if (aGapCur < 1.e-3 || aGapAlt > 0.1 * aGapCur)
+        {
+          continue;
+        }
+        // The pcurve meant for this face is the one the other orientation
+        // gets now. The neighbour face uses the opposite orientation, so it
+        // gets the right one back with the same swap.
+        const TopoDS_Edge         anEdgeF = TopoDS::Edge(anEdge.Oriented(TopAbs_FORWARD));
+        double                    aF1, aL1;
+        occ::handle<Geom2d_Curve> aPC1 = BRep_Tool::CurveOnSurface(anEdgeF, aSurf, aLoc, aF1, aL1);
+        occ::handle<Geom2d_Curve> aPC2 =
+          BRep_Tool::CurveOnSurface(TopoDS::Edge(anEdgeF.Reversed()), aSurf, aLoc, aF1, aL1);
+        aBB.UpdateEdge(anEdgeF, aPC2, aPC1, aSurf, aLoc, BRep_Tool::Tolerance(anEdgeF));
+        aBB.Range(anEdgeF, aSurf, aLoc, aF1, aL1);
+      }
+    }
+  }
+}
+
+//=================================================================================================
+
 ChFi3d_Builder::~ChFi3d_Builder() = default;
 
 //=================================================================================================
@@ -514,6 +640,7 @@ void ChFi3d_Builder::Compute()
         ShapeFix::SameParameter(aF, false, SameParTol);
       }
     }
+    FixSwappedPCurves(myShapeResult);
   }
 }
 
