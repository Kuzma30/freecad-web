+//! face cross, finds the fillet whose other support face is a plane in which
+//! the other fillet ends: its last point on its other support lies on that
+//! plane, on an arc which does not bound the planar face.
+//! @param[in] theDStr the data structure
+//! @param[in] theVtx the vertex
+//! @param[in] theSt1 the first stripe at the vertex
+//! @param[in] theSt2 the second stripe at the vertex
+//! @return 1 or 2, the stripe whose support is that plane, or 0
+int ChFi3d_TwoCornerInFacePlane(TopOpeBRepDS_DataStructure&       theDStr,
+                                const TopoDS_Vertex&              theVtx,
+                                const occ::handle<ChFiDS_Stripe>& theSt1,
