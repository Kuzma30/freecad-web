diff --git a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_0.cxx b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_0.cxx
index 31976c8e..a57ae880 100644
--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_0.cxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_0.cxx
@@ -1243,6 +1243,77 @@ bool ChFi3d_IsInFront(TopOpeBRepDS_DataStructure&       DStr,
 
 //=================================================================================================
 
+int ChFi3d_TwoCornerInFacePlane(TopOpeBRepDS_DataStructure&       theDStr,
+                                const TopoDS_Vertex&              theVtx,
+                                const occ::handle<ChFiDS_Stripe>& theSt1,
+                                const occ::handle<ChFiDS_Stripe>& theSt2)
+{
+  if (theSt1 == theSt2 || occ::down_cast<ChFiDS_FilSpine>(theSt1->Spine()).IsNull()
+      || occ::down_cast<ChFiDS_FilSpine>(theSt2->Spine()).IsNull())
+  {
+    return 0;
+  }
+  int         aSens1 = 0, aSens2 = 0;
+  const int   anIsd1 = ChFi3d_IndexOfSurfData(theVtx, theSt1, aSens1);
+  const int   anIsd2 = ChFi3d_IndexOfSurfData(theVtx, theSt2, aSens2);
+  double      aP1 = 0., aP2 = 0.;
+  TopoDS_Face aFaCo;
+  bool        isSameSide = false, isVisAVis = false;
+  int         anIFaCo1 = 0, anIFaCo2 = 0;
+  const bool  isInter = ChFi3d_IsInFront(theDStr,
+                                        theSt1,
+                                        theSt2,
+                                        anIsd1,
+                                        anIsd2,
+                                        aSens1,
+                                        aSens2,
+                                        aP1,
+                                        aP2,
+                                        aFaCo,
+                                        isSameSide,
+                                        anIFaCo1,
+                                        anIFaCo2,
+                                        isVisAVis,
+                                        theVtx,
+                                        true);
+  if (!isInter || !isVisAVis || isSameSide)
+  {
+    return 0;
+  }
+  const occ::handle<ChFiDS_SurfData> aSD[2]     = {theSt1->SetOfSurfData()->Value(anIsd1),
+                                                   theSt2->SetOfSurfData()->Value(anIsd2)};
+  const bool                         isFirst[2] = {aSens1 == 1, aSens2 == 1};
+  const int                          anIFaOp[2] = {3 - anIFaCo1, 3 - anIFaCo2};
+  for (int k = 0; k < 2; ++k)
+  {
+    const int aK = 1 - k;
+    if (aSD[k]->Index(anIFaOp[k]) <= 0 || aSD[aK]->Index(anIFaOp[aK]) <= 0)
+    {
+      continue;
+    }
+    const TopoDS_Face         aF = TopoDS::Face(theDStr.Shape(aSD[k]->Index(anIFaOp[k])));
+    const BRepAdaptor_Surface aS(aF, false);
+    const ChFiDS_CommonPoint& aCP = aSD[aK]->Vertex(isFirst[aK], anIFaOp[aK]);
+    if (aS.GetType() != GeomAbs_Plane || !aCP.IsOnArc()
+        || aS.Plane().Distance(aCP.Point()) > 10. * Precision::Confusion())
+    {
+      continue;
+    }
+    bool isOnFace = false;
+    for (TopExp_Explorer anExp(aF, TopAbs_EDGE); anExp.More() && !isOnFace; anExp.Next())
+    {
+      isOnFace = anExp.Current().IsSame(aCP.Arc());
+    }
+    if (!isOnFace)
+    {
+      return k + 1;
+    }
+  }
+  return 0;
+}
