+// The same holed cube with a lower edge of the hole (convex) and the vertical
+// edge next to it (concave) filleted, not the other lower edge at their vertex.
+// The vertex has more edges (smooth edges between the fillets and the spheres of
+// the cube) and the corner was a plate patch with tolerance up to 1.1. The
+// convex fillet ends in the plane of the other wall, the support of the concave
+// one: the corner is filled between the two fillets and that wall.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_ConvexAndConcaveFilletsCorner)
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  // The vertical edge at x = 4, y = -4 with the lower edge on the wall y = -4
+  // or on the wall x = 4: the two results are the same.
+  const gp_Pnt aVertical(4.0, -4.0, 0.0);
+  const gp_Pnt aLower[2]   = {gp_Pnt(0.0, -4.0, -10.0), gp_Pnt(4.0, 0.0, -10.0)};
+  const double aRadii[2]   = {1.0, 2.0};
+  const double aVolumes[2] = {5157.00, 5157.07};
+  for (int r = 0; r < 2; ++r)
+  {
+    for (int aCase = 0; aCase < 2; ++aCase)
+    {
+      BRepFilletAPI_MakeFillet aFillet(aHoled);
+      for (TopExp_Explorer anExp(aHoled, TopAbs_EDGE); anExp.More(); anExp.Next())
+      {
+        GProp_GProps aProps;
+        BRepGProp::LinearProperties(anExp.Current(), aProps);
+        const gp_Pnt aMid = aProps.CentreOfMass();
+        if (aProps.Mass() > 1.0
+            && (aMid.Distance(aVertical) < 1.e-6 || aMid.Distance(aLower[aCase]) < 1.e-6))
+        {
+          aFillet.Add(aRadii[r], TopoDS::Edge(anExp.Current()));
+        }
+      }
+      ASSERT_EQ(aFillet.NbContours(), 2);
+      aFillet.Build();
+      ASSERT_TRUE(aFillet.IsDone()) << "r = " << aRadii[r] << ", case " << aCase;
+      const TopoDS_Shape& aResult = aFillet.Shape();
+      EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid())
+        << "r = " << aRadii[r] << ", case " << aCase;
+
+      double aMaxTol = 0.0;
+      for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+      {
+        aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+      }
+      EXPECT_LT(aMaxTol, 1.e-3) << "r = " << aRadii[r] << ", case " << aCase;
+
+      GProp_GProps aProps;
+      BRepGProp::VolumeProperties(aResult, aProps);
+      EXPECT_NEAR(aProps.Mass(), aVolumes[r], 0.01) << "r = " << aRadii[r] << ", case " << aCase;
+    }
+  }
+}
