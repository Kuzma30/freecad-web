+//=================================================================================================
+// A rim on a ring with concave edges ending in the top of the ring (FreeCAD issue 32231)
+
+namespace
+{
+// A quarter of a rim on a ring, as in FreeCAD issue 32231: the ring
+// 31.4 < r < 33.4, -1.45 < z < 0, and the rim 33.4 < r < 34.9 from -1.45 to
+// 8.55 between the half planes y = 0, x > 0 and x = 0, y < 0, with a 0.5 x 45
+// degrees chamfer at the bottom outside. The top edges of the two end walls
+// are rounded with radius 5, and the outer edge of the fillet at y < 0 with
+// radius 1, each step refined as FreeCAD does.
+TopoDS_Shape makeRimOnRing()
+{
+  const gp_Ax1               anAxis(gp::Origin(), gp::DZ());
+  BRepBuilderAPI_MakePolygon aRing(gp_Pnt(31.4, 0.0, -1.45),
+                                   gp_Pnt(33.4, 0.0, -1.45),
+                                   gp_Pnt(33.4, 0.0, 0.0),
+                                   gp_Pnt(31.4, 0.0, 0.0),
+                                   true);
+  BRepBuilderAPI_MakePolygon aRim;
+  aRim.Add(gp_Pnt(33.4, 0.0, -1.45));
+  aRim.Add(gp_Pnt(34.4, 0.0, -1.45));
+  aRim.Add(gp_Pnt(34.9, 0.0, -0.95));
+  aRim.Add(gp_Pnt(34.9, 0.0, 8.55));
+  aRim.Add(gp_Pnt(33.4, 0.0, 8.55));
+  aRim.Close();
+  const TopoDS_Shape aRingSolid =
+    BRepPrimAPI_MakeRevol(BRepBuilderAPI_MakeFace(aRing.Wire(), true).Face(), anAxis).Shape();
+  const TopoDS_Shape aRimSolid =
+    BRepPrimAPI_MakeRevol(BRepBuilderAPI_MakeFace(aRim.Wire(), true).Face(), anAxis, -M_PI / 2.0)
+      .Shape();
+  const auto refine = [](const TopoDS_Shape& theShape) {
+    ShapeUpgrade_UnifySameDomain aUnify(theShape);
+    aUnify.Build();
+    return aUnify.Shape();
+  };
+  TopoDS_Shape aShape = refine(BRepAlgoAPI_Fuse(aRingSolid, aRimSolid).Shape());
+
+  // the top edges of the end walls
+  BRepFilletAPI_MakeFillet aTop(aShape);
+  for (TopExp_Explorer anExp(aShape, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    BRepAdaptor_Curve aCurve(TopoDS::Edge(anExp.Current()));
+    const gp_Pnt      aMid = aCurve.Value(0.5 * (aCurve.FirstParameter() + aCurve.LastParameter()));
+    if (aCurve.GetType() == GeomAbs_Line && std::abs(aMid.Z() - 8.55) < 1.e-6)
+    {
+      aTop.Add(5.0, TopoDS::Edge(anExp.Current()));
+    }
+  }
+  aTop.Build();
+  if (!aTop.IsDone())
+  {
+    return TopoDS_Shape();
+  }
+  aShape = refine(aTop.Shape());
+
+  // the outer edge of the fillet at y < 0, from (0, -34.9, 3.55)
+  BRepFilletAPI_MakeFillet anOuter(aShape);
+  for (TopExp_Explorer anExp(aShape, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(anExp.Current());
+    if (BRepAdaptor_Curve(anEdge).GetType() == GeomAbs_Line)
+    {
+      continue;
+    }
+    for (const TopoDS_Vertex& aV : {TopExp::FirstVertex(anEdge), TopExp::LastVertex(anEdge)})
+    {
+      if (BRep_Tool::Pnt(aV).Distance(gp_Pnt(0.0, -34.9, 3.55)) < 1.e-6)
+      {
+        anOuter.Add(1.0, anEdge);
+        break;
+      }
+    }
+  }
+  anOuter.Build();
+  if (!anOuter.IsDone())
+  {
+    return TopoDS_Shape();
+  }
+  return refine(anOuter.Shape());
+}
+
+// The volume of the parts of theShape1 and theShape2 in theRegion that are not
+// in both.
+double changeIn(const TopoDS_Shape& theShape1,
+                const TopoDS_Shape& theShape2,
+                const TopoDS_Shape& theRegion)
+{
+  const TopoDS_Shape aPart1 = BRepAlgoAPI_Common(theShape1, theRegion).Shape();
+  const TopoDS_Shape aPart2 = BRepAlgoAPI_Common(theShape2, theRegion).Shape();
+  GProp_GProps       aProps1, aProps2;
+  BRepGProp::VolumeProperties(BRepAlgoAPI_Cut(aPart1, aPart2).Shape(), aProps1);
+  BRepGProp::VolumeProperties(BRepAlgoAPI_Cut(aPart2, aPart1).Shape(), aProps2);
+  return aProps1.Mass() + aProps2.Mass();
+}
+} // namespace
+
+// The edges between the outside of the ring and the end walls of the rim,
+// x = 0 and y = 0, -1.45 < z < 0, are concave. At their top vertex the top
+// of the ring z = 0 cuts the fillet or chamfer straight across: it must stop
+// there with a planar cap, and nothing above z = 0 may change (FreeCAD issue
+// 32231). In the model of the issue, the end of the trace at that vertex lay
+// 1e-16 above z = 0, and that rounding error sent the corner to
+// PerformIntersectionAtEnd, which built a patch rising over the rim (test
+// bugs/modalg_8/fillet_rim_on_ring_stops_at_ring_top).
+TEST(BRepFilletAPI_MakeFilletTest, RimOnRing_ConcaveEdgesStopAtRingTop)
+{
+  const TopoDS_Shape aShape = makeRimOnRing();
+  ASSERT_FALSE(aShape.IsNull());
+  ASSERT_TRUE(BRepCheck_Analyzer(aShape).IsValid());
+
+  TopoDS_Edge anEdgeX, anEdgeY;
+  for (TopExp_Explorer anExp(aShape, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    BRepAdaptor_Curve aCurve(TopoDS::Edge(anExp.Current()));
+    const gp_Pnt      aMid = aCurve.Value(0.5 * (aCurve.FirstParameter() + aCurve.LastParameter()));
+    if (aCurve.GetType() != GeomAbs_Line)
+    {
+      continue;
+    }
+    if (aMid.Distance(gp_Pnt(33.4, 0.0, -0.725)) < 1.e-6)
+    {
+      anEdgeX = TopoDS::Edge(anExp.Current());
+    }
+    else if (aMid.Distance(gp_Pnt(0.0, -33.4, -0.725)) < 1.e-6)
+    {
+      anEdgeY = TopoDS::Edge(anExp.Current());
+    }
+  }
+  ASSERT_FALSE(anEdgeX.IsNull());
+  ASSERT_FALSE(anEdgeY.IsNull());
+
+  const TopoDS_Shape anAbove =
+    BRepPrimAPI_MakeBox(gp_Pnt(-50.0, -50.0, 1.e-6), gp_Pnt(50.0, 50.0, 20.0)).Shape();
+  const TopoDS_Shape aBelow =
+    BRepPrimAPI_MakeBox(gp_Pnt(-50.0, -50.0, -50.0), gp_Pnt(50.0, 50.0, 0.0)).Shape();
+  const NCollection_List<TopoDS_Edge> aCases[] = {{anEdgeX}, {anEdgeY}, {anEdgeX, anEdgeY}};
+  for (const bool isChamfer : {false, true})
+  {
+    double anAdded[3] = {0.0, 0.0, 0.0};
+    for (int aCase = 0; aCase < 3; ++aCase)
+    {
+      TopoDS_Shape aResult;
+      if (isChamfer)
+      {
+        BRepFilletAPI_MakeChamfer aChamfer(aShape);
+        for (const TopoDS_Edge& anEdge : aCases[aCase])
+        {
+          aChamfer.Add(0.4, anEdge);
+        }
+        aChamfer.Build();
+        ASSERT_TRUE(aChamfer.IsDone()) << "chamfer, case " << aCase;
+        aResult = aChamfer.Shape();
+      }
+      else
+      {
+        BRepFilletAPI_MakeFillet aFillet(aShape);
+        for (const TopoDS_Edge& anEdge : aCases[aCase])
+        {
+          aFillet.Add(0.4, anEdge);
+        }
+        aFillet.Build();
+        ASSERT_TRUE(aFillet.IsDone()) << "fillet, case " << aCase;
+        aResult = aFillet.Shape();
+      }
+      EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid()) << isChamfer << ", case " << aCase;
+      EXPECT_NEAR(changeIn(aShape, aResult, anAbove), 0.0, 1.e-7)
+        << isChamfer << ", case " << aCase;
+      anAdded[aCase] = changeIn(aShape, aResult, aBelow);
+    }
+    // The two corners are mirror images, and they do not interact.
+    EXPECT_GT(anAdded[0], 0.04) << isChamfer;
+    EXPECT_NEAR(anAdded[0], anAdded[1], 1.e-6) << isChamfer;
+    EXPECT_NEAR(anAdded[2], anAdded[0] + anAdded[1], 1.e-6) << isChamfer;
+  }
+}
