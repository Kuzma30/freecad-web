+// The trace of a fillet on a face runs along a whole edge of the face (the
+// fillet ends exactly on the tangent edge of the face with the next face, and
+// its corners end on the vertices of that edge): the trace is that edge, and
+// its ends are the vertices of the edge. The points replaced by vertices are
+// added to thePointVertices.
+static void ShareCoincidentTraces(TopOpeBRepDS_DataStructure&             theDS,
+                                  const occ::handle<ChFiDS_Stripe>&       theStripe,
+                                  const ChFiDS_Map&                       theEFMap,
+                                  NCollection_DataMap<int, TopoDS_Shape>& thePointVertices)
+{
+  const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq =
+    theStripe->SetOfSurfData()->Sequence();
+  for (int j = 1; j <= aSeq.Length(); ++j)
+  {
+    const occ::handle<ChFiDS_SurfData>& aSD = aSeq(j);
+    for (int aSide = 1; aSide <= 2; ++aSide)
+    {
+      const ChFiDS_FaceInterference& aFi  = aSD->Interference(aSide);
+      const int                      anIc = aFi.LineIndex();
+      const int                      anIs = aSD->Index(aSide);
+      if (anIc == 0 || anIs <= 0)
+      {
+        continue;
+      }
+      const TopOpeBRepDS_Curve&      aDSC = theDS.Curve(anIc);
+      const occ::handle<Geom_Curve>& aC   = aDSC.Curve();
+      if (aC.IsNull() || !aDSC.ExistingEdge().IsNull())
+      {
+        continue;
+      }
+      // The points at the ends of the trace: its first and last points.
+      int    anIp[2]  = {0, 0};
+      double aPar[2]  = {RealLast(), RealFirst()};
+      bool   isPnt[2] = {false, false};
+      for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator anIt(
+             theDS.CurveInterferences(anIc));
+           anIt.More();
+           anIt.Next())
+      {
+        const occ::handle<TopOpeBRepDS_CurvePointInterference> aCPI =
+          occ::down_cast<TopOpeBRepDS_CurvePointInterference>(anIt.Value());
+        if (aCPI.IsNull())
+        {
+          continue;
+        }
+        for (int k = 0; k < 2; ++k)
+        {
+          if ((k == 0 && aCPI->Parameter() < aPar[0]) || (k == 1 && aCPI->Parameter() > aPar[1]))
+          {
+            anIp[k]  = aCPI->Geometry();
+            aPar[k]  = aCPI->Parameter();
+            isPnt[k] = aCPI->GeometryType() == TopOpeBRepDS_POINT;
+          }
+        }
+      }
+      if (anIp[0] == 0 || anIp[1] == 0 || aPar[1] - aPar[0] < Precision::PConfusion())
+      {
+        continue;
+      }
+      const TopoDS_Face aF = TopoDS::Face(theDS.Shape(anIs));
+      for (TopExp_Explorer anExp(aF, TopAbs_EDGE); anExp.More(); anExp.Next())
+      {
+        const TopoDS_Edge& anE = TopoDS::Edge(anExp.Current());
+        if (BRep_Tool::Degenerated(anE) || !theEFMap.Contains(anE))
+        {
+          continue;
+        }
+        double                         aEF = 0., aEL = 0.;
+        const occ::handle<Geom_Curve>& aCE = BRep_Tool::Curve(anE, aEF, aEL);
+        if (aCE.IsNull())
+        {
+          continue;
+        }
+        const double aTol = std::max(BRep_Tool::Tolerance(anE), Precision::Confusion());
+        // The ends of the trace on the vertices of the edge, its points on the edge.
+        TopoDS_Vertex aV[2];
+        TopExp::Vertices(anE, aV[0], aV[1]);
+        TopoDS_Vertex anEnd[2];
+        for (int k = 0; k < 2; ++k)
+        {
+          const gp_Pnt aP = aC->Value(aPar[k]);
+          for (int m = 0; m < 2; ++m)
+          {
+            if (!aV[m].IsNull() && aP.Distance(BRep_Tool::Pnt(aV[m])) < aTol)
+            {
+              anEnd[k] = aV[m];
+            }
+          }
+        }
+        if (anEnd[0].IsNull() || anEnd[1].IsNull() || anEnd[0].IsSame(anEnd[1]))
+        {
+          continue;
+        }
+        bool isOn = true;
+        for (int i = 1; i < 8 && isOn; ++i)
+        {
+          GeomAPI_ProjectPointOnCurve aProj(aC->Value(aPar[0] + (aPar[1] - aPar[0]) * i / 8.),
+                                            aCE,
+                                            aEF,
+                                            aEL);
+          isOn = aProj.NbPoints() > 0 && aProj.LowerDistance() < aTol;
+        }
+        if (!isOn)
+        {
+          continue;
+        }
+        const bool isReversed =
+          BRep_Tool::Parameter(anEnd[0], anE) > BRep_Tool::Parameter(anEnd[1], anE);
+        theDS.ChangeCurve(anIc).SetExistingEdge(anE, isReversed);
+        for (int k = 0; k < 2; ++k)
+        {
+          if (isPnt[k] && !thePointVertices.IsBound(anIp[k]))
+          {
+            thePointVertices.Bind(anIp[k], anEnd[k]);
+          }
+        }
+        break;
+      }
+    }
+  }
+}
+
+//=================================================================================================
+
+// The interferences on the points replaced by vertices of the shape refer to
+// the vertices.
+static void ReplacePointsByVertices(TopOpeBRepDS_DataStructure&                   theDS,
+                                    const NCollection_DataMap<int, TopoDS_Shape>& thePointVertices)
+{
+  if (thePointVertices.IsEmpty())
+  {
+    return;
+  }
+  const auto aReplace = [&](NCollection_List<occ::handle<TopOpeBRepDS_Interference>>& theList) {
+    for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator anIt(theList);
+         anIt.More();
+         anIt.Next())
+    {
+      const occ::handle<TopOpeBRepDS_Interference>& anI = anIt.Value();
+      if (anI->GeometryType() == TopOpeBRepDS_POINT && thePointVertices.IsBound(anI->Geometry()))
+      {
+        anI->GeometryType(TopOpeBRepDS_VERTEX);
+        anI->Geometry(theDS.AddShape(thePointVertices(anI->Geometry())));
+      }
+    }
+  };
+  for (int i = 1; i <= theDS.NbCurves(); ++i)
+  {
+    aReplace(theDS.ChangeCurveInterferences(i));
+  }
+  for (int i = 1; i <= theDS.NbShapes(); ++i)
+  {
+    aReplace(theDS.ChangeShapeInterferences(i));
+  }
+  for (int i = 1; i <= theDS.NbSurfaces(); ++i)
+  {
+    aReplace(theDS.ChangeSurfaceInterferences(i));
+  }
+}
