+// A box of 20 with fillets of radius 3 on all edges, so that its top is flat
+// over 14 x 14, and a square hole of 13 x 13 in the top. A fillet of radius 0.5
+// on the edges of the hole touches the top exactly along the tangent edges of
+// the top with the fillets of the box: the top is covered by the new fillets
+// up to its boundary, and the traces of the new fillets are these edges. The
+// coincident traces were built as new edges next to the old ones, and the
+// result had a negative volume (also with r = 1 and a hole of 12, r = 2 and a
+// hole of 10).
+TEST(BRepFilletAPI_MakeFilletTest, FilletTraceOnTangentEdge_CoversFaceExactly)
+{
+  const TopoDS_Shape       aBox = BRepPrimAPI_MakeBox(20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(3.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(3.5, 3.5, 12.0), 13.0, 13.0, 10.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  BRepFilletAPI_MakeFillet                                      aFillet(aHoled);
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+  TopExp::MapShapes(aHoled, TopAbs_EDGE, anEdges);
+  for (int i = 1; i <= anEdges.Extent(); ++i)
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(anEdges(i));
+    GProp_GProps       aProps;
+    BRepGProp::LinearProperties(anEdge, aProps);
+    const gp_Pnt aMid = aProps.CentreOfMass();
+    if (std::abs(aMid.Z() - 20.0) < 1.e-6
+        && (std::abs(aMid.X() - 3.5) < 1.e-6 || std::abs(aMid.X() - 16.5) < 1.e-6
+            || std::abs(aMid.Y() - 3.5) < 1.e-6 || std::abs(aMid.Y() - 16.5) < 1.e-6))
+    {
+      aFillet.Add(0.5, anEdge);
+    }
+  }
+  ASSERT_EQ(aFillet.NbContours(), 4);
+
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  const TopoDS_Shape& aResult = aFillet.Shape();
+  EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid());
+
+  // No face is left on the plane of the top.
+  int aNbTop = 0;
+  for (TopExp_Explorer anExp(aResult, TopAbs_FACE); anExp.More(); anExp.Next())
+  {
+    const BRepAdaptor_Surface aSurf(TopoDS::Face(anExp.Current()));
+    if (aSurf.GetType() == GeomAbs_Plane && std::abs(aSurf.Plane().Location().Z() - 20.0) < 1.e-6
+        && aSurf.Plane().Axis().Direction().IsParallel(gp::DZ(), 1.e-9))
+    {
+      ++aNbTop;
+    }
+  }
+  EXPECT_EQ(aNbTop, 0);
+
+  // Four fillets of (1 - pi / 4) * 0.25 * 13 and the corners where they meet.
+  GProp_GProps aBefore, anAfter;
+  BRepGProp::VolumeProperties(aHoled, aBefore);
+  BRepGProp::VolumeProperties(aResult, anAfter);
+  EXPECT_NEAR(aBefore.Mass() - anAfter.Mass(), 2.8378, 1.e-3);
+}
