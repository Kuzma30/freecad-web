@@ -6089,3 +6089,26 @@ bool ChFi3d_IsSmooth(const occ::handle<Geom_Curve>& C)
 
   return true;
 }
+
+//=================================================================================================
+
+bool ChFi3d_OrientAsNeighbour(const occ::handle<Geom_Surface>& theS,
+                              const gp_Pnt2d&                  theUV,
+                              const occ::handle<Geom_Surface>& theRefS,
+                              const gp_Pnt2d&                  theRefUV,
+                              const TopAbs_Orientation         theRefOr,
+                              TopAbs_Orientation&              theOr)
+{
+  gp_Pnt aP;
+  gp_Vec aDu, aDv;
+  theS->D1(theUV.X(), theUV.Y(), aP, aDu, aDv);
+  const gp_Vec aN = aDu.Crossed(aDv);
+  theRefS->D1(theRefUV.X(), theRefUV.Y(), aP, aDu, aDv);
+  const gp_Vec aNRef = aDu.Crossed(aDv);
+  if (aN.SquareMagnitude() <= gp::Resolution() || aNRef.SquareMagnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  theOr = aN.Dot(aNRef) > 0. ? theRefOr : TopAbs::Reverse(theRefOr);
+  return true;
+}
