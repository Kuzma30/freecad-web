+    return false;
+  }
+  occ::handle<BRepAdaptor_Surface> HBs1    = new BRepAdaptor_Surface(Fv1, false);
+  occ::handle<BRepAdaptor_Surface> HBs2    = new BRepAdaptor_Surface(Fv2, false);
+  const gp_Pnt2d                   aCP1on1 = aPcA->Value(CP1.ParameterOnArc());
+  const gp_Pnt2d                   aCP2on2 = aPcC->Value(CP2.ParameterOnArc());
+  gp_Pnt2d                         aX1on1, aMon1, aMon2;
+  if (!ProjectOnSurface(*HBs1, aPntX1, aTolS, aX1on1)
+      || !ProjectOnSurface(*HBs1, aPntM, aTolS, aMon1)
+      || !ProjectOnSurface(*HBs2, aPntM, aTolS, aMon2))
+  {
+    return false;
+  }
+  aX1on1                 = PointInPeriod(aS1, aX1on1, aCP1on1);
+  aMon1                  = PointInPeriod(aS1, aMon1, aX1on1);
+  aMon2                  = PointInPeriod(aS2, aMon2, aCP2on2);
+  const gp_Pnt2d aVtxOn1 = PointInPeriod(aS1, BRep_Tool::Parameters(Vtx, Fv1), aX1on1);
+  const gp_Pnt2d aVtxOn2 = PointInPeriod(aS2, BRep_Tool::Parameters(Vtx, Fv2), aMon2);
+  {
+    double uu1, uu2, vv1, vv2, uu3, uu4, vv3, vv4;
+    ChFi3d_Boite(aCP1on1, aX1on1, uu1, uu2, vv1, vv2);
+    ChFi3d_Boite(aX1on1, aMon1, uu3, uu4, vv3, vv4);
+    ChFi3d_BoundFac(*HBs1,
+                    std::min(uu1, uu3),
+                    std::max(uu2, uu4),
+                    std::min(vv1, vv3),
+                    std::max(vv2, vv4));
+    ChFi3d_Boite(aCP2on2, aMon2, uu1, uu2, vv1, vv2);
+    ChFi3d_BoundFac(*HBs2, uu1, uu2, vv1, vv2);
+  }
+
+  // The cuts, each in the direction of its surfdata: on Fb from CP1 to X1,
+  // on Fd from X1 to M (side iad) and from CP2 to M (side iop).
+  occ::handle<Geom_Curve>         aCa1, aCa2, aCb;
+  occ::handle<Geom2d_Curve>       aCa1Fil, aCa1On1, aCa2Fil, aCa2On1, aCbFil, aCbOn2;
+  double                          aTolA1 = tolapp3d, aTolA2 = tolapp3d, aTolB = tolapp3d;
+  const occ::handle<Geom2d_Curve> aNoSide;
+  if (!CutFilletAlong(isfirst,
+                      HGprev,
+                      HBs1,
+                      aS1,
+                      aCP1onPrev,
+                      aCP1on1,
+                      aX1onPrev,
+                      aX1on1,
+                      tolapp3d,
+                      tol2d,
+                      aTolS,
+                      aNoSide,
+                      aCa1,
+                      aCa1Fil,
+                      aCa1On1,
+                      aTolA1)
+      || !CutFilletAlong(isfirst,
+                         HGd,
+                         HBs1,
+                         aS1,
+                         aX1onD,
+                         aX1on1,
+                         aMonD,
+                         aMon1,
+                         tolapp3d,
+                         tol2d,
+                         aTolS,
+                         aNoSide,
+                         aCa2,
+                         aCa2Fil,
+                         aCa2On1,
+                         aTolA2)
+      || !CutFilletAlong(isfirst,
+                         HGd,
+                         HBs2,
+                         aS2,
+                         aCP2onD,
+                         aCP2on2,
+                         aMonD,
+                         aMon2,
+                         tolapp3d,
+                         tol2d,
+                         aTolS,
+                         aNoSide,
+                         aCb,
+                         aCbFil,
+                         aCbOn2,
+                         aTolB))
+  {
+    return false;
+  }
+
+  // Sides of the cuts to keep: Fv1, beyond a sharp edge, is extended up to
+  // its cuts, on the side of the vertex; Fv2, which the fillet covers near
+  // the vertex, is trimmed on the other side.
+  const TopAbs_Orientation anEtA1 = OrientationFromSide(aCa1On1, aVtxOn1);
+  const TopAbs_Orientation anEtA2 = OrientationFromSide(aCa2On1, aVtxOn1);
+  const TopAbs_Orientation anEtB  = TopAbs::Reverse(OrientationFromSide(aCbOn2, aVtxOn2));
+
+  // Everything is computed: the stripe is changed from here.
+  const double aTol    = std::max(std::max(aTolA1, aTolA2), aTolB);
+  const int    IFv1    = DStr.AddShape(Fv1InShape);
+  const int    IFv2    = DStr.AddShape(Fv2InShape);
+  const int    IVtx    = DStr.AddShape(Vtx);
+  const int    ICa1    = DStr.AddCurve(TopOpeBRepDS_Curve(aCa1, aTol));
+  const int    ICa2    = DStr.AddCurve(TopOpeBRepDS_Curve(aCa2, aTol));
+  const int    ICb     = DStr.AddCurve(TopOpeBRepDS_Curve(aCb, aTol));
+  const double aTolPnt = std::max(aTol, tolapp3d);
+
+  // Fb: the end of Fprev from CP1, on Fv1 on the side iad; Fprev ends at CP1.
+  occ::handle<ChFiDS_SurfData> Fb =
+    SplitAtCP1(DStr, Fprev, iad, isfirst, wCut, CP1, FiPop.LineIndex(), aTolPnt);
+  if (iad == 1)
+  {
+    Fb->ChangeIndexOfS1(IFv1);
+  }
+  else
+  {
+    Fb->ChangeIndexOfS2(IFv1);
+  }
+  Fb->ChangeInterference(iad).SetInterference(ICa1, anEtA1, aCa1On1, aCa1Fil);
+  Fb->ChangeInterference(iad).SetFirstParameter(aCa1->FirstParameter());
+  Fb->ChangeInterference(iad).SetLastParameter(aCa1->LastParameter());
+  ChFiDS_CommonPoint aCPX1;
+  aCPX1.SetPoint(aPntX1);
+  aCPX1.SetParameter(wJ);
+  aCPX1.SetTolerance(aTolPnt);
+  ChFiDS_CommonPoint aCPM;
+  aCPM.SetPoint(aPntM);
+  aCPM.SetParameter(wM);
+  aCPM.SetTolerance(aTolPnt);
+  Fb->ChangeVertex(isfirst, iad) = aCPX1;
+
+  // Fd: on Fv1 and Fv2, ends at M.
+  // Its orientation follows the one of Fprev: Fd was computed on other faces.
+  ChFi3d_OrientAsNeighbour(HGd->Surface(),
+                           aCP2onD,
+                           HGprev->Surface(),
+                           aSecOp,
+                           Fprev->Orientation(),
+                           Fd->ChangeOrientation());
+  if (iad == 1)
+  {
+    Fd->ChangeIndexOfS1(IFv1);
+    Fd->ChangeIndexOfS2(IFv2);
+  }
+  else
+  {
+    Fd->ChangeIndexOfS2(IFv1);
+    Fd->ChangeIndexOfS1(IFv2);
+  }
+  Fd->ChangeInterference(iad).SetInterference(ICa2, anEtA2, aCa2On1, aCa2Fil);
+  Fd->ChangeInterference(iad).SetFirstParameter(aCa2->FirstParameter());
+  Fd->ChangeInterference(iad).SetLastParameter(aCa2->LastParameter());
+  Fd->ChangeInterference(iop).SetInterference(ICb, anEtB, aCbOn2, aCbFil);
+  Fd->ChangeInterference(iop).SetFirstParameter(aCb->FirstParameter());
+  Fd->ChangeInterference(iop).SetLastParameter(aCb->LastParameter());
+  Fd->ChangeVertex(!isfirst, iad) = aCPX1;
+  Fd->ChangeVertex(!isfirst, iop) = CP2;
+  Fd->ChangeVertex(isfirst, iad)  = aCPM;
+  Fd->ChangeVertex(isfirst, iop)  = aCPM;
+  if (isfirst)
+  {
+    Fd->FirstSpineParam(wM);
+  }
+  else
+  {
+    Fd->LastSpineParam(wM);
+  }
+
+  if (isfirst)
+  {
+    SeqFil.InsertBefore(numPrev, Fb);
+  }
+  else
+  {
+    SeqFil.InsertAfter(numPrev, Fb);
+  }
+
+  // Points: M ends both sides of the stripe; X1 and CP2 end the section
+  // between Fb and Fd, stored here.
+  const int indM   = DStr.AddPoint(TopOpeBRepDS_Point(aPntM, aTolPnt));
+  const int indX1  = DStr.AddPoint(TopOpeBRepDS_Point(aPntX1, aTolPnt));
+  const int indCP2 = ChFi3d_IndexPointInDS(CP2, DStr);
+  stripe->SetIndexPoint(indM, isfirst, 1);
+  stripe->SetIndexPoint(indM, isfirst, 2);
+  stripe->InDS(isfirst, 2);
+
+  // The section between Fb and Fd.
+  AddSection(DStr,
+             myRegul,
+             isfirst,
+             iad,
+             Fb,
+             Fd,
+             aCPX1,
+             CP2,
+             indX1,
+             indCP2,
+             aX1onPrev,
+             aSecOp,
+             aX1onD,
+             aCP2onD,
+             tolapp3d,
+             tol2d);
+
+  // The common edge is cut at M, its part at the vertex is removed.
+  {
+    const int                IComm = DStr.AddShape(aCommon);
+    const TopAbs_Orientation aTrM =
+      BRep_Tool::Parameter(Vtx, aCommon) > aParM ? TopAbs_REVERSED : TopAbs_FORWARD;
+    DStr.ChangeShapeInterferences(IComm).Append(ChFi3d_FilPointInDS(aTrM, IComm, indM, aParM));
+  }
+
+  CutAtEnd(DStr, spine, isfirst, Vtx, IVtx, CP2, indCP2);
+  return true;
+}
+
+//=================================================================================================
+
+bool ChFi3d_Builder::PerformCapOnOneFace(const int theIndex)
+{
+  // The side iad of the fillet has left its face Fad across a
+  // sharp arc A at CP1 before the end of the surfdata Fprev; the
+  // surfdatas after it were computed on the extension of Fad,
+  // while the side iop went on, possibly over tangent edges, up to
+  // the end P on a sharp arc C. When the faces beyond A and C are
+  // one face Fv, the fillet is cut along Fv from CP1 to P, across
+  // the sections between the surfdatas, and Fv is extended up to
+  // the cut. Fprev is split at CP1, its end part taking Fv.
+
+  if (myVDataMap(theIndex).Extent() != 1)
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&       DStr   = myDS->ChangeDS();
+  const TopoDS_Vertex&              Vtx    = myVDataMap.FindKey(theIndex);
+  const occ::handle<ChFiDS_Stripe>& stripe = myVDataMap(theIndex).First();
+  const occ::handle<ChFiDS_Spine>&  spine  = stripe->Spine();
+  if (spine.IsNull() || spine->IsPeriodic())
+  {
+    return false;
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& SeqFil =
+    stripe->ChangeSetOfSurfData()->ChangeSequence();
+  int                                sens    = 0;
+  const int                          num     = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool                         isfirst = (sens == 1);
+  const int                          aStep   = isfirst ? 1 : -1;
+  const occ::handle<ChFiDS_SurfData> Fd      = SeqFil.Value(num);
+  int                                iad     = 0;
+  if (Fd->IndexOfS1() == 0 && Fd->IndexOfS2() > 0)
+  {
+    iad = 1;
+  }
+  else if (Fd->IndexOfS2() == 0 && Fd->IndexOfS1() > 0)
+  {
+    iad = 2;
+  }
+  else if (Fd->IndexOfS1() > 0 && Fd->IndexOfS2() > 0)
+  {
+    // The last surfdata itself goes on after its side left the face.
+    for (int i = 1; i <= 2 && iad == 0; ++i)
+    {
+      const double aWi = Fd->Interference(i).Parameter(isfirst);
+      const double aWo = Fd->Interference(3 - i).Parameter(isfirst);
+      if ((isfirst ? aWi - aWo : aWo - aWi) > 20. * tolesp && Fd->Vertex(isfirst, i).IsOnArc()
+          && Fd->Vertex(isfirst, 3 - i).IsOnArc())
+      {
+        iad = i;
+      }
+    }
+  }
+  if (iad == 0)
+  {
+    return false;
+  }
+  const int iop = 3 - iad;
+  // The surfdatas computed on the extension of Fad, from Fprev to the end.
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>> aChain;
+  int                                                numPrev = num;
+  while (numPrev >= 1 && numPrev <= SeqFil.Length() && SeqFil.Value(numPrev)->Index(iad) == 0
+         && SeqFil.Value(numPrev)->Index(iop) > 0)
+  {
+    aChain.Prepend(SeqFil.Value(numPrev));
+    numPrev += aStep;
+  }
+  if (numPrev < 1 || numPrev > SeqFil.Length() || aChain.Length() > 5
+      || (aChain.IsEmpty() && numPrev != num))
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData> Fprev = SeqFil.Value(numPrev);
+  if (Fprev->IndexOfS1() <= 0 || Fprev->IndexOfS2() <= 0)
+  {
+    return false;
+  }
+  const int aNb = aChain.Length();
+  if (aNb == 0)
+  {
+    // The usual end on a face: only the orientation of the last surfdata,
+    // partly computed out of its faces, is checked against the one before.
+    const int anIn = num + aStep;
+    if (anIn >= 1 && anIn <= SeqFil.Length() && !Fd->Interference(iop).PCurveOnSurf().IsNull()
+        && !SeqFil.Value(anIn)->Interference(iop).PCurveOnSurf().IsNull())
+    {
+      const occ::handle<ChFiDS_SurfData>& aN = SeqFil.Value(anIn);
+      // The parameters of the traces at the section between them: the one
+      // of a surfdata rebuilt by a filling is not the one on the spine.
+      ChFi3d_OrientAsNeighbour(
+        DStr.Surface(Fd->Surf()).Surface(),
+        Fd->Interference(iop).PCurveOnSurf()->Value(Fd->Interference(iop).Parameter(!isfirst)),
+        DStr.Surface(aN->Surf()).Surface(),
+        aN->Interference(iop).PCurveOnSurf()->Value(aN->Interference(iop).Parameter(isfirst)),
+        aN->Orientation(),
+        Fd->ChangeOrientation());
+    }
+    return false;
+  }
+  const ChFiDS_CommonPoint      CP1   = Fprev->Vertex(isfirst, iad);
+  const ChFiDS_CommonPoint      CPop  = Fd->Vertex(isfirst, iop);
+  const ChFiDS_FaceInterference FiPad = Fprev->Interference(iad);
+  const ChFiDS_FaceInterference FiPop = Fprev->Interference(iop);
+  if (!CP1.IsOnArc() || CP1.IsVertex() || !CPop.IsOnArc() || CPop.IsVertex()
+      || FiPad.LineIndex() == 0 || FiPop.LineIndex() == 0 || FiPad.PCurveOnSurf().IsNull()
+      || FiPop.PCurveOnSurf().IsNull() || DStr.Curve(FiPop.LineIndex()).Curve().IsNull())
+  {
+    return false;
+  }
+  for (int k = 1; k <= aNb; ++k)
+  {
+    const ChFiDS_FaceInterference& aFa = aChain(k)->Interference(iad);
+    const ChFiDS_FaceInterference& aFo = aChain(k)->Interference(iop);
+    if (aFa.PCurveOnSurf().IsNull() || aFo.PCurveOnSurf().IsNull() || aFo.LineIndex() == 0)
+    {
+      return false;
+    }
+  }
+  const double wCut = FiPad.Parameter(isfirst);
+  const double wJ0  = FiPop.Parameter(isfirst);
+  if ((isfirst ? wCut - wJ0 : wJ0 - wCut) < 10. * tolesp)
+  {
+    return false;
+  }
+
+  // The faces: Fv beyond the sharp arcs A and C.
+  const TopoDS_Face Fad    = TopoDS::Face(DStr.Shape(Fprev->Index(iad)));
+  const TopoDS_Face FopEnd = TopoDS::Face(DStr.Shape(Fd->Index(iop)));
+  const TopoDS_Edge ArcA   = CP1.Arc();
+  const TopoDS_Edge ArcC   = CPop.Arc();
+  if (!IsEdgeOfFace(ArcA, Fad) || !IsEdgeOfFace(ArcC, FopEnd))
+  {
+    return false;
+  }
+  TopoDS_Face Fv = OtherFace(myEFMap(ArcA), Fad);
+  if (Fv.IsNull() || !Fv.IsSame(OtherFace(myEFMap(ArcC), FopEnd)) || Fv.IsSame(Fad)
+      || Fv.IsSame(FopEnd) || BRep_Tool::Continuity(ArcA, Fad, Fv) != GeomAbs_C0
+      || BRep_Tool::Continuity(ArcC, FopEnd, Fv) > GeomAbs_G1)
+  {
+    return false;
+  }
+  const TopoDS_Face FvInShape = Fv;
+  Fv.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom_Surface>        aSv = BRep_Tool::Surface(Fv);
+  const occ::handle<GeomAdaptor_Surface> HSv = new GeomAdaptor_Surface(aSv);
+  const double                           aTolS =
+    std::max(10. * tolapp3d,
+             std::max(BRep_Tool::Tolerance(ArcA), BRep_Tool::Tolerance(ArcC)) + tolapp3d);
+
+  // The fillet surfaces: Fprev, then the chain.
+  NCollection_Array1<occ::handle<GeomAdaptor_Surface>> aHG(0, aNb);
+  aHG(0) = new GeomAdaptor_Surface(DStr.Surface(Fprev->Surf()).Surface());
+  for (int k = 1; k <= aNb; ++k)
+  {
+    aHG(k) = new GeomAdaptor_Surface(DStr.Surface(aChain(k)->Surf()).Surface());
+  }
+  const gp_Pnt2d aCP1onPrev = FiPad.PCurveOnSurf()->Value(wCut);
+  if (aHG(0)->Value(aCP1onPrev.X(), aCP1onPrev.Y()).Distance(CP1.Point()) > aTolS)
+  {
+    return false;
+  }
+
+  // X(k): where the section between the surfdata k (0 for Fprev) and k+1
+  // crosses Fv, the nearest to the side iad; on both surfdatas.
+  NCollection_Array1<gp_Pnt>   aPntX(0, aNb - 1);
+  NCollection_Array1<gp_Pnt2d> aXin(0, aNb - 1), aXout(0, aNb - 1), aOpOut(0, aNb - 1);
+  NCollection_Array1<double>   aWJ(0, aNb - 1);
+  for (int k = 0; k < aNb; ++k)
+  {
+    const occ::handle<ChFiDS_SurfData>& aIn  = k == 0 ? Fprev : aChain(k);
+    const occ::handle<ChFiDS_SurfData>& aOut = aChain(k + 1);
+    const double aW       = k == 0 ? wJ0 : aIn->Interference(iop).Parameter(isfirst);
+    aWJ(k)                = aW;
+    const gp_Pnt2d aSecAd = aIn->Interference(iad).PCurveOnSurf()->Value(aW);
+    const gp_Pnt2d aSecOp = aIn->Interference(iop).PCurveOnSurf()->Value(aW);
+    if (!CrossSection(aHG(k), aSecAd, aSecOp, HSv, aXin(k)))
+    {
+      return false;
+    }
+    aPntX(k) = aHG(k)->Value(aXin(k).X(), aXin(k).Y());
+    // The sections of two surfdatas computed separately may differ a little.
+    if (!ProjectOnSurface(*aHG(k + 1), aPntX(k), 10. * aTolS, aXout(k)))
+    {
+      return false;
+    }
+    aOpOut(k) = aOut->Interference(iop).PCurveOnSurf()->Value(aW);
+  }
+  const gp_Pnt   aPntP = CPop.Point();
+  const gp_Pnt2d aPonFd =
+    Fd->Interference(iop).PCurveOnSurf()->Value(Fd->Interference(iop).Parameter(isfirst));
+  if (aHG(aNb)->Value(aPonFd.X(), aPonFd.Y()).Distance(aPntP) > aTolS)
+  {
+    return false;
+  }
+
+  // Parameters on Fv, in the period of the arc A.
+  double                          Ubid, Vbid;
+  const occ::handle<Geom2d_Curve> aPcA = BRep_Tool::CurveOnSurface(ArcA, Fv, Ubid, Vbid);
+  if (aPcA.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d               aCP1onV = aPcA->Value(CP1.ParameterOnArc());
+  NCollection_Array1<gp_Pnt2d> aXonV(0, aNb - 1);
+  gp_Pnt2d                     aRef = aCP1onV;
+  for (int k = 0; k < aNb; ++k)
+  {
+    if (!ProjectOnSurface(*HSv, aPntX(k), aTolS, aXonV(k)))
+    {
+      return false;
+    }
+    aXonV(k) = PointInPeriod(aSv, aXonV(k), aRef);
+    aRef     = aXonV(k);
+  }
+  gp_Pnt2d aPonV;
+  if (!ProjectOnSurface(*HSv, aPntP, aTolS, aPonV))
+  {
+    return false;
+  }
+  aPonV                  = PointInPeriod(aSv, aPonV, aRef);
+  const gp_Pnt2d aVtxOnV = PointInPeriod(aSv, BRep_Tool::Parameters(Vtx, Fv), aCP1onV);
+  occ::handle<BRepAdaptor_Surface> HBs = new BRepAdaptor_Surface(Fv, false);
+  {
+    double aU1 = std::min(aCP1onV.X(), aPonV.X()), aU2 = std::max(aCP1onV.X(), aPonV.X());
+    double aV1 = std::min(aCP1onV.Y(), aPonV.Y()), aV2 = std::max(aCP1onV.Y(), aPonV.Y());
+    for (int k = 0; k < aNb; ++k)
+    {
+      aU1 = std::min(aU1, aXonV(k).X());
+      aU2 = std::max(aU2, aXonV(k).X());
+      aV1 = std::min(aV1, aXonV(k).Y());
+      aV2 = std::max(aV2, aXonV(k).Y());
+    }
+    ChFi3d_BoundFac(*HBs, aU1, aU2, aV1, aV2);
+  }
+
+  // The cuts, each in the direction of its surfdata: on Fprev from CP1 to
+  // X(0), on the surfdata k from X(k-1) to X(k), on the last one up to P.
+  NCollection_Array1<occ::handle<Geom_Curve>>   aC3d(0, aNb);
+  NCollection_Array1<occ::handle<Geom2d_Curve>> aCFil(0, aNb), aCOnV(0, aNb);
+  double                                        aTol = tolapp3d;
+  for (int k = 0; k <= aNb; ++k)
+  {
+    const gp_Pnt2d            aFil0 = k == 0 ? aCP1onPrev : aXout(k - 1);
+    const gp_Pnt2d            aSrf0 = k == 0 ? aCP1onV : aXonV(k - 1);
+    const gp_Pnt2d            aFil1 = k == aNb ? aPonFd : aXin(k);
+    const gp_Pnt2d            aSrf1 = k == aNb ? aPonV : aXonV(k);
+    occ::handle<Geom2d_Curve> aSide;
+    if (k == aNb)
+    {
+      const ChFiDS_FaceInterference& aFo = Fd->Interference(iop);
+      aSide =
+        new Geom2d_TrimmedCurve(aFo.PCurveOnSurf(), aFo.FirstParameter(), aFo.LastParameter());
+    }
+    double     aTolK = tolapp3d;
+    const bool isOk  = CutFilletAlong(isfirst,
+                                     aHG(k),
+                                     HBs,
+                                     aSv,
+                                     aFil0,
+                                     aSrf0,
+                                     aFil1,
+                                     aSrf1,
+                                     tolapp3d,
+                                     tol2d,
+                                     aTolS,
+                                     aSide,
+                                     aC3d(k),
+                                     aCFil(k),
+                                     aCOnV(k),
+                                     aTolK);
+    if (!isOk)
+    {
+      return false;
+    }
+    aTol = std::max(aTol, aTolK);
+  }
+  // The cuts make one curve, the vertex is on its left if the polygon it
+  // closes with the vertex turns counterclockwise. Fv is extended up to the
+  // cuts, on the side of the vertex, if the part between them and the
+  // vertex is out of it (the fillet adds an end face there), trimmed by
+  // them otherwise (the fillet covers that part).
+  double aArea = 0.;
+  {
+    gp_Pnt2d aPrevPnt = aVtxOnV;
+    for (int i = 0; i <= aNb; ++i)
+    {
+      const int                        k  = isfirst ? aNb - i : i;
+      const occ::handle<Geom2d_Curve>& aC = aCOnV(k);
+      const double aF = aC3d(k)->FirstParameter(), aL = aC3d(k)->LastParameter();
+      for (int j = 0; j <= 20; ++j)
+      {
+        const gp_Pnt2d aP = aC->Value(aF + (aL - aF) * j / 20.);
+        aArea += aPrevPnt.X() * aP.Y() - aP.X() * aPrevPnt.Y();
+        aPrevPnt = aP;
+      }
+    }
+    aArea += aPrevPnt.X() * aVtxOnV.Y() - aVtxOnV.X() * aPrevPnt.Y();
+  }
+  // Points just beside the cuts on the side of the vertex, voting.
+  bool isExtended = true;
+  {
+    BRepTopAdaptor_FClass2d aClass(Fv, Precision::PConfusion());
+    int                     aNbOutBoth = 0, aNbInBoth = 0, aNbOutOne = 0, aNbInOne = 0;
+    for (int k = 0; k <= aNb; ++k)
+    {
+      const occ::handle<Geom2d_Curve>& aC = aCOnV(k);
+      const double aF = aC3d(k)->FirstParameter(), aL = aC3d(k)->LastParameter();
+      const double aChord = aC->Value(aF).Distance(aC->Value(aL));
+      for (int j = 1; j <= 5; ++j)
+      {
+        gp_Pnt2d aPm;
+        gp_Vec2d aTm;
+        aC->D1(aF + (aL - aF) * (0.2 + 0.1 * j), aPm, aTm);
+        if (aTm.Magnitude() < gp::Resolution())
+        {
+          continue;
+        }
+        gp_Vec2d aN(-aTm.Y(), aTm.X());
+        aN.Normalize();
+        if (aArea < 0.)
+        {
+          aN.Reverse();
+        }
+        // The cut is a new boundary: Fv is on both sides of it or on none.
+        // A probe crossing an edge of Fv, where the cut runs close to it,
+        // tells the two sides apart; it counts only if nothing else does.
+        const gp_XY        anOff = aN.XY() * 0.01 * aChord;
+        const TopAbs_State aSt   = aClass.Perform(gp_Pnt2d(aPm.XY() + anOff));
+        const TopAbs_State aSt2  = aClass.Perform(gp_Pnt2d(aPm.XY() - anOff));
+        int&               aOut  = aSt == aSt2 ? aNbOutBoth : aNbOutOne;
+        int&               anIn  = aSt == aSt2 ? aNbInBoth : aNbInOne;
+        if (aSt == TopAbs_OUT)
+        {
+          ++aOut;
+        }
+        else if (aSt == TopAbs_IN)
+        {
+          ++anIn;
+        }
+      }
+    }
+    int aNbOut = aNbOutBoth, aNbIn = aNbInBoth;
+    if (aNbOut == aNbIn)
+    {
+      aNbOut += aNbOutOne;
+      aNbIn += aNbInOne;
+    }
+    if (aNbOut == aNbIn)
+    {
+      return false;
+    }
+    isExtended = aNbOut > aNbIn;
+  }
+  NCollection_Array1<TopAbs_Orientation> anEt(0, aNb);
+  anEt.Init((aArea > 0.) == isExtended ? TopAbs_FORWARD : TopAbs_REVERSED);
+
+  // Everything is computed: the stripe is changed from here.
+  // The orientation of Fprev follows the one of the surfdata before it: the
+  // one of a surfdata partly computed out of its faces may be wrong.
+  {
+    const int aIn = numPrev + aStep;
+    if (aIn >= 1 && aIn <= SeqFil.Length())
+    {
+      const occ::handle<ChFiDS_SurfData>& aN  = SeqFil.Value(aIn);
+      const occ::handle<Geom2d_Curve>&    aP1 = Fprev->Interference(iop).PCurveOnSurf();
+      const occ::handle<Geom2d_Curve>&    aP2 = aN->Interference(iop).PCurveOnSurf();
+      if (!aP1.IsNull() && !aP2.IsNull())
+      {
+        // As above, on the parameters of the traces.
+        ChFi3d_OrientAsNeighbour(aHG(0)->Surface(),
+                                 aP1->Value(Fprev->Interference(iop).Parameter(!isfirst)),
+                                 DStr.Surface(aN->Surf()).Surface(),
+                                 aP2->Value(aN->Interference(iop).Parameter(isfirst)),
+                                 aN->Orientation(),
+                                 Fprev->ChangeOrientation());
+      }
+    }
+  }
+  // The orientations of the chain follow the one of Fprev: its surfdatas
+  // were computed on other faces.
+  for (int k = 1; k <= aNb; ++k)
+  {
+    const occ::handle<ChFiDS_SurfData>& aIn = k == 1 ? Fprev : aChain(k - 1);
+    ChFi3d_OrientAsNeighbour(aHG(k)->Surface(),
+                             aXout(k - 1),
+                             aHG(k - 1)->Surface(),
+                             aXin(k - 1),
+                             aIn->Orientation(),
+                             aChain(k)->ChangeOrientation());
+  }
+  const double            aTolPnt = std::max(aTol, tolapp3d);
+  const int               IFv     = DStr.AddShape(FvInShape);
+  const int               IVtx    = DStr.AddShape(Vtx);
+  NCollection_Array1<int> anIC(0, aNb);
+  for (int k = 0; k <= aNb; ++k)
+  {
+    anIC(k) = DStr.AddCurve(TopOpeBRepDS_Curve(aC3d(k), aTol));
+  }
+  NCollection_Array1<ChFiDS_CommonPoint> aCPX(0, aNb - 1);
+  for (int k = 0; k < aNb; ++k)
+  {
+    aCPX(k).SetPoint(aPntX(k));
+    aCPX(k).SetParameter(aWJ(k));
+    aCPX(k).SetTolerance(aTolPnt);
+  }
+
+  // Fb: the end of Fprev from CP1, on Fv on the side iad; Fprev ends at CP1.
+  occ::handle<ChFiDS_SurfData> Fb =
+    SplitAtCP1(DStr, Fprev, iad, isfirst, wCut, CP1, FiPop.LineIndex(), aTolPnt);
+
+  // The side iad of Fb and of the chain on Fv.
+  ChFiDS_CommonPoint aCPP;
+  aCPP.SetPoint(aPntP);
+  aCPP.SetParameter(CPop.Parameter());
+  aCPP.SetTolerance(std::max(aTolPnt, BRep_Tool::Tolerance(ArcC)));
+  for (int k = 0; k <= aNb; ++k)
+  {
+    const occ::handle<ChFiDS_SurfData>& aSD = k == 0 ? Fb : aChain(k);
+    if (iad == 1)
+    {
+      aSD->ChangeIndexOfS1(IFv);
+    }
+    else
+    {
+      aSD->ChangeIndexOfS2(IFv);
+    }
+    aSD->ChangeInterference(iad).SetInterference(anIC(k), anEt(k), aCOnV(k), aCFil(k));
+    aSD->ChangeInterference(iad).SetFirstParameter(aC3d(k)->FirstParameter());
+    aSD->ChangeInterference(iad).SetLastParameter(aC3d(k)->LastParameter());
+    aSD->ChangeInterference(iad).SetLineIndex(anIC(k));
+    if (k > 0)
+    {
+      aSD->ChangeVertex(!isfirst, iad) = aCPX(k - 1);
+    }
+    aSD->ChangeVertex(isfirst, iad) = k == aNb ? aCPP : aCPX(k);
+  }
+
+  if (isfirst)
+  {
+    SeqFil.InsertBefore(numPrev, Fb);
+  }
+  else
+  {
+    SeqFil.InsertAfter(numPrev, Fb);
+  }
+
+  // Points: P ends both sides of the stripe; the sections between Fb and
+  // the chain are stored here.
+  const int indP = ChFi3d_IndexPointInDS(CPop, DStr);
+  stripe->SetIndexPoint(indP, isfirst, 1);
+  stripe->SetIndexPoint(indP, isfirst, 2);
+  stripe->InDS(isfirst, aNb + 1);
+
+  for (int k = 0; k < aNb; ++k)
+  {
+    const occ::handle<ChFiDS_SurfData>& aIn   = k == 0 ? Fb : aChain(k);
+    const occ::handle<ChFiDS_SurfData>& aOut  = aChain(k + 1);
+    const ChFiDS_CommonPoint            aCPop = aIn->Vertex(isfirst, iop);
+    const gp_Pnt2d                      aOpIn =
+      (k == 0 ? FiPop : aChain(k)->Interference(iop)).PCurveOnSurf()->Value(aWJ(k));
+    const int indX  = DStr.AddPoint(TopOpeBRepDS_Point(aPntX(k), aTolPnt));
+    const int indOp = ChFi3d_IndexPointInDS(aCPop, DStr);
+    AddSection(DStr,
+               myRegul,
+               isfirst,
+               iad,
+               aIn,
+               aOut,
+               aCPX(k),
+               aCPop,
+               indX,
+               indOp,
+               aXin(k),
+               aOpIn,
+               aXout(k),
+               aOpOut(k),
+               tolapp3d,
+               tol2d);
+    // The side iop crosses an edge there: it is cut.
+    if (aCPop.IsOnArc() && !aCPop.IsVertex())
+    {
+      const int IArc = DStr.AddShape(aCPop.Arc());
+      DStr.ChangeShapeInterferences(IArc).Append(
+        ChFi3d_FilPointInDS(aCPop.TransitionOnArc(), IArc, indOp, aCPop.ParameterOnArc()));
+    }
+  }
+
+  // The edges of Fv from the arcs A and C to the vertex are inside the
+  // extended Fv.
+  RemoveEdgesToVertex(DStr, Fv, ArcA, Vtx, TopoDS_Face());
+  RemoveEdgesToVertex(DStr, Fv, ArcC, Vtx, TopoDS_Face());
+  CutAtEnd(DStr, spine, isfirst, Vtx, IVtx, CPop, indP);
+  return true;
+}
