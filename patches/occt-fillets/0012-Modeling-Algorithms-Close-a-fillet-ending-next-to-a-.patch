+  for (int i = 1; i <= 2 && iad == 0; ++i)
+  {
+    const double aWi = Fprev->Interference(i).Parameter(isfirst);
+    const double aWo = Fprev->Interference(3 - i).Parameter(isfirst);
+    if ((isfirst ? aWi - wJ : wJ - aWi) > 20. * tolesp && std::abs(aWo - wJ) < 10. * tolesp)
+    {
+      iad = i;
+    }
+  }
+  if (iad == 0)
+  {
+    return false;
+  }
+  const int                        iop    = 3 - iad;
+  const ChFiDS_CommonPoint         CP1    = Fprev->Vertex(isfirst, iad);
+  const ChFiDS_CommonPoint         CP2    = Fprev->Vertex(isfirst, iop);
+  const ChFiDS_FaceInterference    FiPad  = Fprev->Interference(iad);
+  const ChFiDS_FaceInterference    FiPop  = Fprev->Interference(iop);
