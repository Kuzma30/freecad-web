From 2b06e2eb049953823cd947ab60824abc7e89d46e Mon Sep 17 00:00:00 2001
From: Kuzma30 <kuzemkoa@gmail.com>
Date: Mon, 26 Oct 2026 10:09:17 +0200
Subject: [PATCH 14/25] Modeling Algorithms - Keep the pcurves of fused edges
 on the ranges of the edges

BRepLib_FuseEdges::UpdatePCurve took a B-spline pcurve whole when it joined
the pcurves of the edges to fuse, and kept the pcurve of the first edge
whenever it was long enough for the new edge, wherever it started. A pcurve
going beyond its edge then shifted the parameters of the fused pcurve.

FreeCAD's refine merges two pieces of a fillet that have the same surface
and fuses their traces: the fused edge of the screw of the previous commit
deviated by 1.05 from its pcurve on the fillet, and the refined shape got a
tolerance of 1.1.

Each pcurve is now trimmed to the range of its edge before it is joined,
and the pcurve of the first edge is kept only if it covers the range of
the new edge from the start of the first edge.

GTest BRepLib_FuseEdgesTest.PCurveLongerThanEdge_KeepsPCurveOnEdgeRange.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01N85duF92anuCHYJzUxLgPg
---
 .../TKTopAlgo/BRepLib/BRepLib_FuseEdges.cxx   |  15 +-
 .../GTests/BRepLib_FuseEdges_Test.cxx         | 152 ++++++++++++++++++
 .../TKTopAlgo/GTests/FILES.cmake              |   1 +
 3 files changed, 165 insertions(+), 3 deletions(-)
 create mode 100644 src/ModelingAlgorithms/TKTopAlgo/GTests/BRepLib_FuseEdges_Test.cxx

diff --git a/src/ModelingAlgorithms/TKTopAlgo/BRepLib/BRepLib_FuseEdges.cxx b/src/ModelingAlgorithms/TKTopAlgo/BRepLib/BRepLib_FuseEdges.cxx
index d3de01de..cc010047 100644
--- a/src/ModelingAlgorithms/TKTopAlgo/BRepLib/BRepLib_FuseEdges.cxx
+++ b/src/ModelingAlgorithms/TKTopAlgo/BRepLib/BRepLib_FuseEdges.cxx
@@ -1138,10 +1138,18 @@ bool BRepLib_FuseEdges::UpdatePCurve(const TopoDS_Edge&                    theOl
         double f, l;
         f = Curv2d->FirstParameter();
         l = Curv2d->LastParameter();
-        if (l - f + 2. * Epsilon(l - f) < el - ef)
+        // The pcurve of the first edge is kept if it covers the range of the
+        // new edge from the start of the first edge (see the range below);
+        // being long enough is not enough.
+        const double aNeedF = theOldEdge.Orientation() == TopAbs_REVERSED ? cl - el + ef : cf;
+        const double aNeedL = theOldEdge.Orientation() == TopAbs_REVERSED ? cl : cf + el - ef;
+        if (aNeedF < f - Precision::PConfusion() || aNeedL > l + Precision::PConfusion())
         {
+          // Each pcurve is taken on the range of its edge: a bounded curve may
+          // go beyond it (the edge is then only a part of it).
           occ::handle<Geom2d_BoundedCurve> bcurve = occ::down_cast<Geom2d_BoundedCurve>(Curv2d);
-          if (bcurve.IsNull())
+          if (bcurve.IsNull() || cf > f + Precision::PConfusion()
+              || cl < l - Precision::PConfusion())
           {
             bcurve = new Geom2d_TrimmedCurve(Curv2d, cf, cl);
           }
@@ -1154,7 +1162,8 @@ bool BRepLib_FuseEdges::UpdatePCurve(const TopoDS_Edge&                    theOl
             double                    first, last;
             occ::handle<Geom2d_Curve> C = BRep_Tool::CurveOnSurface(E, Surf, loc, first, last);
             occ::handle<Geom2d_BoundedCurve> BC = occ::down_cast<Geom2d_BoundedCurve>(C);
-            if (BC.IsNull())
+            if (BC.IsNull() || first > C->FirstParameter() + Precision::PConfusion()
+                || last < C->LastParameter() - Precision::PConfusion())
             {
               BC = new Geom2d_TrimmedCurve(C, first, last);
             }
