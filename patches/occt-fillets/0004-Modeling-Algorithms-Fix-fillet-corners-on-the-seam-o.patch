+//=================================================================================================
+// Fillet whose corner lies on the seam of a cylinder
+
+// A groove turned into a cylinder from the seam over a quarter turn. Its end
+// wall lies in the plane of the seam, so the fillet of the rim ends at a
+// corner whose intersection curve runs along the seam. ChFi3d_Builder
+// read the extrema points of that parallel case and crashed.
+TEST(BRepFilletAPI_MakeFilletTest, GrooveEndingOnCylinderSeam_SucceedsWithoutCrash)
+{
+  const TopoDS_Shape         aCylinder = BRepPrimAPI_MakeCylinder(8.0, 10.0).Shape();
+  BRepBuilderAPI_MakePolygon aProfile(gp_Pnt(6.0, 0.0, 4.0),
+                                      gp_Pnt(9.0, 0.0, 4.0),
+                                      gp_Pnt(9.0, 0.0, 6.0),
+                                      gp_Pnt(6.0, 0.0, 6.0),
+                                      true);
+  const TopoDS_Face          aFace = BRepBuilderAPI_MakeFace(aProfile.Wire(), true).Face();
+  const TopoDS_Shape         aGroove =
+    BRepPrimAPI_MakeRevol(aFace, gp_Ax1(gp::Origin(), gp::DZ()), M_PI / 2.0).Shape();
+  BRepAlgoAPI_Cut aCut(aCylinder, aGroove);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aShape = aCut.Shape();
+
+  // the upper rim of the groove on the cylinder
+  TopoDS_Edge                                                   aRim;
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+  TopExp::MapShapes(aShape, TopAbs_EDGE, anEdges);
+  for (int i = 1; i <= anEdges.Extent() && aRim.IsNull(); ++i)
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(anEdges(i));
+    GProp_GProps       aProps;
+    BRepGProp::LinearProperties(anEdge, aProps);
+    if (std::abs(aProps.Mass() - 4.0 * M_PI) < 1.e-6
+        && std::abs(aProps.CentreOfMass().Z() - 6.0) < 1.e-6)
+    {
+      aRim = anEdge;
+    }
+  }
+  ASSERT_FALSE(aRim.IsNull());
+
+  BRepFilletAPI_MakeFillet aFillet(aShape);
+  aFillet.Add(0.5, aRim);
+  EXPECT_NO_THROW(aFillet.Build());
+}
