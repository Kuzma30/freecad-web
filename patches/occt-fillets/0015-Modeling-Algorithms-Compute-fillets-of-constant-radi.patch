+// The unit vector -N / |N| from a point of a surface of normal N towards the
+// center of a ball of negative radius, and its derivative along theDN.
+gp_Vec UnitNormal(const gp_Vec& theN)
+{
+  const double aM = theN.Magnitude();
+  return aM > Eps ? -theN / aM : -theN;
+}
+
+gp_Vec DUnitNormal(const gp_Vec& theN, const gp_Vec& theDN)
+{
+  const double aM2 = theN.SquareMagnitude();
+  if (aM2 < Eps * Eps)
+  {
+    return -theDN;
+  }
+  return -(theDN - theN * (theN.Dot(theDN) / aM2)) / std::sqrt(aM2);
+}
