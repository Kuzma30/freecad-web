+//=================================================================================================
+
 void ChFi3d_Builder::Compute()
 {
+  // The fillets of constant radius are the envelopes of a rolling
+  // ball. Where the corners or the ends of the fillets cannot
+  // follow them (the computation fails, or leaves gaps covered by
+  // the tolerances: a ball nesting in a fillet of its radius, a
+  // support face with a kink) the computation is done again with
+  // the sections in the planes normal to the guides, and the best
+  // result is kept.
+  // The contours as they are before a computation, which changes them (the
+  // states and the prolongations of the spines, stripes added at corners).
+  NCollection_Sequence<occ::handle<ChFiDS_Stripe>> aStripes, aStripeCopies;
+  NCollection_Sequence<occ::handle<ChFiDS_Spine>>  aSpineCopies;
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator anIt(myListStripe); anIt.More();
+       anIt.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>&  aStripe = anIt.Value();
+    const occ::handle<ChFiDS_FilSpine> aFilSpine =
+      occ::down_cast<ChFiDS_FilSpine>(aStripe->Spine());
+    aStripes.Append(aStripe);
+    aStripeCopies.Append(new ChFiDS_Stripe(*aStripe));
+    aSpineCopies.Append(aFilSpine.IsNull() ? occ::handle<ChFiDS_Spine>()
+                                           : new ChFiDS_FilSpine(*aFilSpine));
+  }
+  const auto aRestore = [&]() {
+    myListStripe.Clear();
+    for (int i = 1; i <= aStripes.Length(); ++i)
+    {
+      *aStripes(i) = *aStripeCopies(i);
+      *occ::down_cast<ChFiDS_FilSpine>(aStripes(i)->Spine()) =
+        *occ::down_cast<ChFiDS_FilSpine>(aSpineCopies(i));
+      myListStripe.Append(aStripes(i));
+    }
+    myCoup = new TopOpeBRepBuild_HBuilder(myCoup->BuildTool());
+  };
+
+  myIsBall     = true;
+  myIsBallUsed = false;
+  ComputeOnce();
+  if (!myIsBallUsed)
+  {
+    return;
+  }
+  for (int i = 1; i <= aSpineCopies.Length(); ++i)
+  {
+    if (aSpineCopies(i).IsNull())
+    {
+      return; // only the contours of fillets can be computed again
+    }
+  }
+  const double aTolBall = IsDone() && BRepCheck_Analyzer(myShapeResult).IsValid()
+                            ? MaxTolerance(myShapeResult)
+                            : RealLast();
+  if (aTolBall <= 10. * tolapp3d)
+  {
+    return;
+  }
+  myIsBall = false;
+  aRestore();
+  ComputeOnce();
+  const double aTolSection = IsDone() && BRepCheck_Analyzer(myShapeResult).IsValid()
+                               ? MaxTolerance(myShapeResult)
+                               : RealLast();
+  if (aTolSection < 0.5 * aTolBall || aTolBall == RealLast())
+  {
+    return;
+  }
+  myIsBall = true;
+  aRestore();
+  ComputeOnce();
+}
 
