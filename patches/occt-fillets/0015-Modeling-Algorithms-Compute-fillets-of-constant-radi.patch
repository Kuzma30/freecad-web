+bool BallValue(const ConstRadInvData& theCtx, const math_Vector& X, math_Vector& F)
+{
+  // As BlendFunc_ConstRad for a rolling ball: the center of the
+  // ball touching the surfaces is on their normals.
+  gp_Pnt ptcur;
+  gp_Vec d1cur;
+  theCtx.curv->D1(X(2), ptcur, d1cur);
+
+  const gp_Vec nplan = d1cur.Normalized();
+  const double theD  = -(nplan.XYZ().Dot(ptcur.XYZ()));
+
+  const gp_Pnt2d pt2d(theCtx.csurf->Value(X(1)));
+
+  gp_Pnt pts1, pts2;
+  gp_Vec d1u1, d1v1, d1u2, d1v2;
+  if (theCtx.first)
+  {
+    theCtx.surf1->D1(pt2d.X(), pt2d.Y(), pts1, d1u1, d1v1);
+    theCtx.surf2->D1(X(3), X(4), pts2, d1u2, d1v2);
+  }
+  else
+  {
+    theCtx.surf1->D1(X(3), X(4), pts1, d1u1, d1v1);
+    theCtx.surf2->D1(pt2d.X(), pt2d.Y(), pts2, d1u2, d1v2);
+  }
+
+  gp_Vec ns1 = d1u1.Crossed(d1v1);
+  if (ns1.Magnitude() < Eps)
+  {
+    BlendFunc::ComputeNormal(theCtx.surf1, theCtx.first ? pt2d : gp_Pnt2d(X(3), X(4)), ns1);
+  }
+  gp_Vec ns2 = d1u2.Crossed(d1v2);
+  if (ns2.Magnitude() < Eps)
+  {
+    BlendFunc::ComputeNormal(theCtx.surf2, theCtx.first ? gp_Pnt2d(X(3), X(4)) : pt2d, ns2);
+  }
+  const gp_Vec aMid((pts1.XYZ() + pts2.XYZ()) / 2.);
+  F(1) = nplan.XYZ().Dot(aMid.XYZ()) + theD;
+
+  gp_Vec resul;
+  resul.SetLinearForm(theCtx.ray1, UnitNormal(ns1), gp_Vec(pts2, pts1));
+  resul.Subtract(theCtx.ray2 * UnitNormal(ns2));
+  F(2) = resul.X();
+  F(3) = resul.Y();
+  F(4) = resul.Z();
+  return true;
+}
+
+//=================================================================================================
+
+bool BallValues(const ConstRadInvData& theCtx, const math_Vector& X, math_Vector& F, math_Matrix& D)
+{
+  gp_Pnt ptcur;
+  gp_Vec d1cur, d2cur;
+  theCtx.curv->D2(X(2), ptcur, d1cur, d2cur);
+  const double normtgcur = d1cur.Magnitude();
+  const gp_Vec nplan     = d1cur.Normalized();
+  const double theD      = -(nplan.XYZ().Dot(ptcur.XYZ()));
+  gp_Vec       dnplan;
+  dnplan.SetLinearForm(-nplan.Dot(d2cur), nplan, d2cur);
+  dnplan /= normtgcur;
+
+  gp_Pnt2d p2d;
+  gp_Vec2d v2d;
+  theCtx.csurf->D1(X(1), p2d, v2d);
+
+  gp_Pnt pts1, pts2;
+  gp_Vec d1u1, d1v1, d1u2, d1v2, d2u1, d2v1, d2uv1, d2u2, d2v2, d2uv2;
+  if (theCtx.first)
+  {
+    theCtx.surf1->D2(p2d.X(), p2d.Y(), pts1, d1u1, d1v1, d2u1, d2v1, d2uv1);
+    theCtx.surf2->D2(X(3), X(4), pts2, d1u2, d1v2, d2u2, d2v2, d2uv2);
+  }
+  else
+  {
+    theCtx.surf1->D2(X(3), X(4), pts1, d1u1, d1v1, d2u1, d2v1, d2uv1);
+    theCtx.surf2->D2(p2d.X(), p2d.Y(), pts2, d1u2, d1v2, d2u2, d2v2, d2uv2);
+  }
+
+  gp_Vec ns1 = d1u1.Crossed(d1v1);
+  if (ns1.Magnitude() < Eps)
+  {
+    BlendFunc::ComputeNormal(theCtx.surf1, theCtx.first ? p2d : gp_Pnt2d(X(3), X(4)), ns1);
+  }
+  gp_Vec ns2 = d1u2.Crossed(d1v2);
+  if (ns2.Magnitude() < Eps)
+  {
+    BlendFunc::ComputeNormal(theCtx.surf2, theCtx.first ? gp_Pnt2d(X(3), X(4)) : p2d, ns2);
+  }
+  const gp_Vec aMid((pts1.XYZ() + pts2.XYZ()) / 2.);
+  F(1) = nplan.XYZ().Dot(aMid.XYZ()) + theD;
+
+  gp_Vec resul;
+  resul.SetLinearForm(theCtx.ray1, UnitNormal(ns1), gp_Vec(pts2, pts1));
+  resul.Subtract(theCtx.ray2 * UnitNormal(ns2));
+  F(2) = resul.X();
+  F(3) = resul.Y();
+  F(4) = resul.Z();
+
+  // Derivatives of the equations by the parameters on the two surfaces.
+  const gp_Vec dns1u = d2u1.Crossed(d1v1).Added(d1u1.Crossed(d2uv1));
+  const gp_Vec dns1v = d2uv1.Crossed(d1v1).Added(d1u1.Crossed(d2v1));
+  const gp_Vec dns2u = d2u2.Crossed(d1v2).Added(d1u2.Crossed(d2uv2));
+  const gp_Vec dns2v = d2uv2.Crossed(d1v2).Added(d1u2.Crossed(d2v2));
+  const gp_Vec dNu1 = DUnitNormal(ns1, dns1u), dNv1 = DUnitNormal(ns1, dns1v);
+  const gp_Vec dNu2 = DUnitNormal(ns2, dns2u), dNv2 = DUnitNormal(ns2, dns2v);
+  gp_Vec       dEu1, dEv1, dEu2, dEv2;
+  dEu1.SetLinearForm(theCtx.ray1, dNu1, d1u1);
+  dEv1.SetLinearForm(theCtx.ray1, dNv1, d1v1);
+  dEu2.SetLinearForm(-theCtx.ray2, dNu2, -1., d1u2);
+  dEv2.SetLinearForm(-theCtx.ray2, dNv2, -1., d1v2);
+
+  // X(1) is the parameter on the curve on the surface (1 or 2), X(2) the
+  // parameter on the guide, X(3), X(4) the parameters on the other surface.
+  const gp_Vec& dEuc = theCtx.first ? dEu1 : dEu2;
+  const gp_Vec& dEvc = theCtx.first ? dEv1 : dEv2;
+  const gp_Vec& dEuo = theCtx.first ? dEu2 : dEu1;
+  const gp_Vec& dEvo = theCtx.first ? dEv2 : dEv1;
+  const gp_Vec& d1uc = theCtx.first ? d1u1 : d1u2;
+  const gp_Vec& d1vc = theCtx.first ? d1v1 : d1v2;
+  const gp_Vec& d1uo = theCtx.first ? d1u2 : d1u1;
+  const gp_Vec& d1vo = theCtx.first ? d1v2 : d1v1;
+
+  gp_Vec temp;
+  temp.SetLinearForm(v2d.X(), d1uc, v2d.Y(), d1vc);
+  D(1, 1) = nplan.Dot(temp) / 2.;
+  temp.SetXYZ(aMid.XYZ() - ptcur.XYZ());
+  D(1, 2) = dnplan.Dot(temp) - normtgcur;
+  D(1, 3) = nplan.Dot(d1uo) / 2.;
+  D(1, 4) = nplan.Dot(d1vo) / 2.;
+
+  temp.SetLinearForm(v2d.X(), dEuc, v2d.Y(), dEvc);
+  for (int i = 1; i <= 3; ++i)
+  {
+    D(i + 1, 1) = temp.Coord(i);
+    D(i + 1, 2) = 0.; // only the plane depends on the guide
+    D(i + 1, 3) = dEuo.Coord(i);
+    D(i + 1, 4) = dEvo.Coord(i);
+  }
+  return true;
+}
