+//=================================================================================================
+// Constant radius fillet as the envelope of a rolling ball
+
+// A quarter of a cone (FreeCAD and DRAW "pcone s 50 0 120 90"): the fillet of
+// the edge between the cone and a plane through its axis. Off that edge the
+// normals of the cone leave the plane normal to the edge, so a circle tangent
+// to the sections of the faces by that plane is not a ball touching them: it
+// missed the ball by 0.22 with a radius of 10. The fillet is the envelope of
+// the ball now: every point of it is at the radius from a center at the
+// radius from both faces.
+TEST(BRepFilletAPI_MakeFilletTest, ConstantRadius_FollowsRollingBall)
+{
+  const double       aR    = 10.0;
+  const TopoDS_Shape aCone = BRepPrimAPI_MakeCone(50.0, 0.0, 120.0, M_PI / 2.0).Shape();
+  NCollection_IndexedDataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>
+    anEF;
+  TopExp::MapShapesAndAncestors(aCone, TopAbs_EDGE, TopAbs_FACE, anEF);
+  TopoDS_Edge anEdge;
+  TopoDS_Face aConeFace, aPlaneFace;
+  for (int i = 1; i <= anEF.Extent() && anEdge.IsNull(); ++i)
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anEF.FindKey(i));
+    if (BRep_Tool::Degenerated(anE) || anEF(i).Extent() != 2
+        || BRepAdaptor_Curve(anE).GetType() != GeomAbs_Line)
+    {
+      continue;
+    }
+    for (int k = 0; k < 2; ++k)
+    {
+      const TopoDS_Face aF1 = TopoDS::Face(k == 0 ? anEF(i).First() : anEF(i).Last());
+      const TopoDS_Face aF2 = TopoDS::Face(k == 0 ? anEF(i).Last() : anEF(i).First());
+      if (BRepAdaptor_Surface(aF1).GetType() == GeomAbs_Cone
+          && BRepAdaptor_Surface(aF2).GetType() == GeomAbs_Plane)
+      {
+        anEdge     = anE;
+        aConeFace  = aF1;
+        aPlaneFace = aF2;
+        break;
+      }
+    }
+  }
+  ASSERT_FALSE(anEdge.IsNull());
+
+  BRepFilletAPI_MakeFillet aFillet(aCone);
+  aFillet.Add(aR, anEdge);
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+
+  const occ::handle<Geom_Surface> aConeSurf  = BRep_Tool::Surface(aConeFace);
+  const occ::handle<Geom_Surface> aPlaneSurf = BRep_Tool::Surface(aPlaneFace);
+  int                             aNbFillets = 0;
+  for (TopExp_Explorer anExp(aFillet.Shape(), TopAbs_FACE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Face& aFace = TopoDS::Face(anExp.Current());
+    if (BRepAdaptor_Surface(aFace).GetType() != GeomAbs_BSplineSurface)
+    {
+      continue;
+    }
+    ++aNbFillets;
+    const occ::handle<Geom_Surface> aSurf = BRep_Tool::Surface(aFace);
+    double                          aU0, aU1, aV0, aV1;
+    BRepTools::UVBounds(aFace, aU0, aU1, aV0, aV1);
+    BRepTopAdaptor_FClass2d aClass(aFace, 1.e-9);
+    double                  aMaxErr = 0.0;
+    for (int i = 1; i < 10; ++i)
+    {
+      for (int j = 1; j < 10; ++j)
+      {
+        const double aU = aU0 + (aU1 - aU0) * i / 10.0, aV = aV0 + (aV1 - aV0) * j / 10.0;
+        if (aClass.Perform(gp_Pnt2d(aU, aV)) != TopAbs_IN)
+        {
+          continue;
+        }
+        GeomLProp_SLProps aProps(aSurf, aU, aV, 1, 1.e-9);
+        ASSERT_TRUE(aProps.IsNormalDefined());
+        double anErr = RealLast();
+        for (const double aSign : {-1.0, 1.0})
+        {
+          const gp_Pnt aCenter = aProps.Value().Translated(gp_Vec(aProps.Normal()) * (aSign * aR));
+          GeomAPI_ProjectPointOnSurf aToCone(aCenter, aConeSurf), aToPlane(aCenter, aPlaneSurf);
+          ASSERT_TRUE(aToCone.NbPoints() > 0 && aToPlane.NbPoints() > 0);
+          anErr = std::min(anErr,
+                           std::max(std::abs(aToCone.LowerDistance() - aR),
+                                    std::abs(aToPlane.LowerDistance() - aR)));
+        }
+        aMaxErr = std::max(aMaxErr, anErr);
+      }
+    }
+    EXPECT_LT(aMaxErr, 1.e-3);
+  }
+  EXPECT_EQ(aNbFillets, 1);
+}
