 #define Eps 1.e-15
 
+namespace
+{
+// Unit vector of theV and its derivatives, given the derivatives of theV.
+gp_Vec Unit(const gp_Vec& theV)
+{
+  const double aM = theV.Magnitude();
+  return aM > Eps ? theV / aM : theV;
+}
+
+gp_Vec DUnit(const gp_Vec& theV, const gp_Vec& theDV)
+{
+  const double aM2 = theV.SquareMagnitude();
+  if (aM2 < Eps * Eps)
+  {
+    return theDV;
+  }
+  return (theDV - theV * (theV.Dot(theDV) / aM2)) / std::sqrt(aM2);
+}
+
+gp_Vec D2Unit(const gp_Vec& theV, const gp_Vec& theDa, const gp_Vec& theDb, const gp_Vec& theDab)
+{
+  const double aM2 = theV.SquareMagnitude();
+  if (aM2 < Eps * Eps)
+  {
+    return theDab;
+  }
+  const double aVa = theV.Dot(theDa), aVb = theV.Dot(theDb);
+  gp_Vec       aRes = theDab - theDa * (aVb / aM2) - theDb * (aVa / aM2);
+  aRes -= theV * ((theDa.Dot(theDb) + theV.Dot(theDab)) / aM2);
+  aRes += theV * (3. * aVa * aVb / (aM2 * aM2));
+  return aRes / std::sqrt(aM2);
+}
+
+// The unit vector -N / |N| from a point of a surface of normal N towards the
+// center of a ball of negative radius, and its derivatives.
+gp_Vec UnitNormal(const gp_Vec& theN)
+{
+  return -Unit(theN);
+}
+
+gp_Vec DUnitNormal(const gp_Vec& theN, const gp_Vec& theDN)
+{
+  return -DUnit(theN, theDN);
+}
+
+gp_Vec D2UnitNormal(const gp_Vec& theN,
+                    const gp_Vec& theDa,
+                    const gp_Vec& theDb,
+                    const gp_Vec& theDab)
+{
+  return -D2Unit(theN, theDa, theDb, theDab);
+}
+
+// The normal of the plane of a section, the circle through the points
+// Center + R * theNs1 and Center + R * theNs2, oriented as theRef (the
+// normal of the plane of the guide): the arc from theNs1 to theNs2 turns
+// around it, as in that plane. When the two directions are parallel, the
+// plane of the guide is taken.
+bool CircleNormal(const gp_Vec& theNs1,
+                  const gp_Vec& theNs2,
+                  const gp_Vec& theRef,
+                  gp_Vec&       theNormal)
+{
+  const gp_Vec aS = theNs1.Crossed(theNs2);
+  if (aS.Magnitude() < 1.e-6)
+  {
+    theNormal = theRef;
+    return false;
+  }
+  theNormal = aS.Dot(theRef) >= 0. ? Unit(aS) : -Unit(aS);
+  return true;
+}
+} // namespace
