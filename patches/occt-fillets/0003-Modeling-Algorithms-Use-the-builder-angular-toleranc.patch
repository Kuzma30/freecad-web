+// A plate with a tapered square shaft whose faces start flush with the faces
+// of the plate (FreeCAD issue 29234). At the root of the shaft the tapered
+// faces meet the plate faces at about 1.4 degrees. That kink was taken for a
+// tangency, so the end vertex of each long shaft edge looked like a corner of
+// three edges instead of four, and the fillet end could not be built.
+TEST(BRepFilletAPI_MakeFilletTest, TaperedShaftFlushWithPlate_ProducesValidShape)
+{
+  // planar frustum from the 5x5 square at x = 3 to the 4x4 square at x = 23
+  const gp_Pnt aP[8] = {gp_Pnt(3.0, -2.5, -2.5),
+                        gp_Pnt(3.0, 2.5, -2.5),
+                        gp_Pnt(3.0, 2.5, 2.5),
+                        gp_Pnt(3.0, -2.5, 2.5),
+                        gp_Pnt(23.0, -2.0, -2.0),
+                        gp_Pnt(23.0, 2.0, -2.0),
+                        gp_Pnt(23.0, 2.0, 2.0),
+                        gp_Pnt(23.0, -2.0, 2.0)};
+  const int    aQuads[6][4] =
+    {{0, 3, 2, 1}, {4, 5, 6, 7}, {0, 1, 5, 4}, {1, 2, 6, 5}, {2, 3, 7, 6}, {3, 0, 4, 7}};
+  BRepBuilderAPI_Sewing aSewing;
+  for (const auto& aQuad : aQuads)
+  {
+    BRepBuilderAPI_MakePolygon aPoly(aP[aQuad[0]], aP[aQuad[1]], aP[aQuad[2]], aP[aQuad[3]], true);
+    aSewing.Add(BRepBuilderAPI_MakeFace(aPoly.Wire(), true).Face());
+  }
+  aSewing.Perform();
+  BRepBuilderAPI_MakeSolid aShaft(TopoDS::Shell(aSewing.SewedShape()));
+  ASSERT_TRUE(aShaft.IsDone());
+
+  // the plate is as thick as the root of the shaft
+  const TopoDS_Shape aPlate = BRepPrimAPI_MakeBox(gp_Pnt(0.0, -7.0, -2.5), 3.0, 14.0, 5.0).Shape();
+  BRepAlgoAPI_Fuse   aFuse(aPlate, aShaft.Solid());
+  ASSERT_TRUE(aFuse.IsDone());
+  ShapeUpgrade_UnifySameDomain aUnify(aFuse.Shape());
+  aUnify.Build();
+  const TopoDS_Shape& aShape = aUnify.Shape();
+
+  GProp_GProps aBefore;
+  BRepGProp::VolumeProperties(aShape, aBefore);
+
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+  TopExp::MapShapes(aShape, TopAbs_EDGE, anEdges);
+  int aNbEdges = 0;
+  for (int i = 1; i <= anEdges.Extent(); ++i)
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(anEdges(i));
+    GProp_GProps       aLength;
+    BRepGProp::LinearProperties(anEdge, aLength);
+    if (std::abs(aLength.Mass() - 20.0) > 0.1)
+    {
+      continue; // not a long edge of the shaft
+    }
+    ++aNbEdges;
+    BRepFilletAPI_MakeFillet aFillet(aShape);
+    aFillet.Add(1.0, anEdge);
+    aFillet.Build();
+    ASSERT_TRUE(aFillet.IsDone()) << "shaft edge " << aNbEdges;
+    const TopoDS_Shape& aResult = aFillet.Shape();
+    EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid()) << "shaft edge " << aNbEdges;
+    double aMaxTol = 0.0;
+    for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+    {
+      aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+    }
+    EXPECT_LT(aMaxTol, 1.e-2) << "shaft edge " << aNbEdges;
+    GProp_GProps anAfter;
+    BRepGProp::VolumeProperties(aResult, anAfter);
+    // (1 - pi/4) * r^2 * length, the faces meet at almost 90 degrees
+    EXPECT_NEAR(aBefore.Mass() - anAfter.Mass(), 4.29, 0.01) << "shaft edge " << aNbEdges;
+  }
+  EXPECT_EQ(aNbEdges, 4);
+}
