@@ -5177,8 +5177,8 @@ void ChFi3d_Builder::PerformIntersectionAtEnd(const int Index)
   TopoDS_Face   Fga, Fdr;
   TopoDS_Vertex Vbid1;
   int           nbsurf, nbedge;
-  reg1    = false;
