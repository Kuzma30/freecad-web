@@ -5205,7 +5205,24 @@ void ChFi3d_Builder::PerformIntersectionAtEnd(const int Index)
     num1      = num - 1;
     state     = spine->LastStatus();
   }
-  if (nbsurf != nbedge && nbsurf != 1)
+  // Only the surfdatas on the edge of the spine at the vertex matter: the
+  // fillet may cross several faces on other edges of its spine.
+  int aNbOnEnd = 0;
+  {
+    const int    anEnd   = isfirst ? 1 : nbedge;
+    const double aWFirst = spine->FirstParameter(anEnd), aWLast = spine->LastParameter(anEnd);
+    const double aTolW = Precision::PConfusion();
