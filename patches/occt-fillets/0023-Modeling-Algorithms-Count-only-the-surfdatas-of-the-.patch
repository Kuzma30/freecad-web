diff --git a/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_Test.cxx b/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_Test.cxx
index fbae6ec56..ef8d253b4 100644
--- a/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_Test.cxx
+++ b/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_Test.cxx
@@ -1812,3 +1812,82 @@ TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_ConvexAndConcaveFille
     }
   }
 }
+
+// The same holed cube with a vertical (concave) edge of the hole filleted, then
+// a lower edge of the hole next to it in a second operation. The spine of the
+// second fillet goes on along the edge of the first one at the bottom of the
+// hole and along the next lower edge: the fillet goes round the corner of the
+// hole. Its ends, where it crosses several faces on the other edges of its
+// spine, were closed by plates with tolerance 9.5.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_RimFilletGoesRoundFilletedCorner)
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  const double aRadii[2]   = {1.0, 2.0};
+  const double aRemoved[2] = {4.5713, 27.2583};
+  for (int r = 0; r < 2; ++r)
+  {
+    // the vertical edge at x = -4, y = -4
+    BRepFilletAPI_MakeFillet aFirst(aHoled);
+    for (TopExp_Explorer anExp(aHoled, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      GProp_GProps aProps;
+      BRepGProp::LinearProperties(anExp.Current(), aProps);
+      if (aProps.CentreOfMass().Distance(gp_Pnt(-4.0, -4.0, 0.0)) < 1.e-6)
+      {
+        aFirst.Add(aRadii[r], TopoDS::Edge(anExp.Current()));
+      }
+    }
+    ASSERT_EQ(aFirst.NbContours(), 1);
+    aFirst.Build();
+    ASSERT_TRUE(aFirst.IsDone());
+    const TopoDS_Shape& aShape1 = aFirst.Shape();
+
+    // the lower edge on the wall y = -4, shortened by the first fillet
+    BRepFilletAPI_MakeFillet aSecond(aShape1);
+    for (TopExp_Explorer anExp(aShape1, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      const TopoDS_Edge& anEdge = TopoDS::Edge(anExp.Current());
+      BRepAdaptor_Curve  aCurve(anEdge);
+      const gp_Pnt       aP1 = aCurve.Value(aCurve.FirstParameter());
+      const gp_Pnt       aP2 = aCurve.Value(aCurve.LastParameter());
+      if (std::abs(aP1.Y() + 4.0) < 1.e-4 && std::abs(aP2.Y() + 4.0) < 1.e-4
+          && std::abs(aP1.Z() + 10.0) < 1.e-4 && std::abs(aP2.Z() + 10.0) < 1.e-4
+          && aP1.Distance(aP2) > 4.0)
+      {
+        aSecond.Add(aRadii[r], anEdge);
+        break;
+      }
+    }
+    ASSERT_EQ(aSecond.NbContours(), 1);
+    aSecond.Build();
+    ASSERT_TRUE(aSecond.IsDone()) << "r = " << aRadii[r];
+    const TopoDS_Shape& aResult = aSecond.Shape();
+    EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid()) << "r = " << aRadii[r];
+
+    double aMaxTol = 0.0;
+    for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+    {
+      aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+    }
+    EXPECT_LT(aMaxTol, 1.e-3) << "r = " << aRadii[r];
+
+    GProp_GProps aBefore, anAfter;
+    BRepGProp::VolumeProperties(aShape1, aBefore);
+    BRepGProp::VolumeProperties(aResult, anAfter);
+    EXPECT_NEAR(aBefore.Mass() - anAfter.Mass(), aRemoved[r], 0.01) << "r = " << aRadii[r];
+  }
+}
diff --git a/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_rim_after_corner b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_rim_after_corner
new file mode 100644
index 000000000..3d7322fb2
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_rim_after_corner
@@ -0,0 +1,40 @@
+puts "============"
+puts "Modeling Algorithms - Fillet of a rim of a square hole around a filleted corner of the hole"
+puts "(FreeCAD issue 20085: cube 20 with fillets of radius 6, square hole 8 x 8)"
+puts "============"
+puts ""
+
+# A vertical (concave) edge of the hole and the two upper edges at it are
+# filleted first (Fillet001 in FreeCAD), then a lower edge of the hole next to
+# that vertical edge (Fillet002). The spine of the second fillet goes on along
+# the edge of the first one at the bottom of the hole and along the next lower
+# edge: the fillet goes round the corner of the hole. At its ends it crosses
+# several faces on the other edges of its spine, and its ends were taken for
+# ends crossing smooth edges and closed by plates (tolerance 9.5).
+restore [locate_data_file freecad20085_rounded_cube_pocket.brep] b
+explode b E
+
+foreach {r tol vol} {1 0.0137 5150.04 2 0.0702 5114.92} {
+  blend r1 b $r b_26 $r b_13 $r b_35
+
+  # the lower edge on the wall y = -4, shortened by the first fillet
+  set e2 ""
+  foreach e [explode r1 E] {
+    set bb [bounding $e]
+    if {abs([lindex $bb 1] + 4.) < 1.e-3 && abs([lindex $bb 4] + 4.) < 1.e-3
+        && abs([lindex $bb 2] + 10.) < 1.e-3 && abs([lindex $bb 5] + 10.) < 1.e-3
+        && [lindex $bb 3] - [lindex $bb 0] > 4.} {
+      set e2 $e
+    }
+  }
+  if {$e2 == ""} {
+    puts "Error: r = $r, the lower edge is not found"
+    continue
+  }
+  blend result r1 $r $e2
+
+  checkshape result
+  # the tolerance is the one of the corner of the first fillets
+  checkmaxtol result -ref $tol
+  checkprops result -v $vol
+}
