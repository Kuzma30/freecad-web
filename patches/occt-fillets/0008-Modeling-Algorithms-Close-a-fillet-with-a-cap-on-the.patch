+//=================================================================================================
+
+// Signed distance from a point to the surface of a face, positive on the side
+// of the normal. For a plane it is exact; otherwise the point is projected.
+static bool SideOfSurface(const BRepAdaptor_Surface& theSurf, const gp_Pnt& theP, double& theDist)
+{
+  if (theSurf.GetType() == GeomAbs_Plane)
+  {
+    theDist = theSurf.Plane().SignedDistance(theP);
+    return true;
+  }
+  Extrema_ExtPS anExt(theP,
+                      theSurf,
+                      Precision::PConfusion(),
+                      Precision::PConfusion(),
+                      Extrema_ExtFlag_MIN);
+  if (!anExt.IsDone() || anExt.NbExt() == 0)
+  {
+    return false;
+  }
+  int    aBest = 1;
+  double aMin  = anExt.SquareDistance(1);
+  for (int i = 2; i <= anExt.NbExt(); ++i)
+  {
+    if (anExt.SquareDistance(i) < aMin)
+    {
+      aMin  = anExt.SquareDistance(i);
+      aBest = i;
+    }
+  }
+  double u, v;
+  anExt.Point(aBest).Parameter(u, v);
+  gp_Pnt aP;
+  gp_Vec aDU, aDV;
+  theSurf.D1(u, v, aP, aDU, aDV);
+  const gp_Vec aN = aDU.Crossed(aDV);
+  if (aN.SquareMagnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  theDist = gp_Vec(aP, theP).Dot(aN) / aN.Magnitude();
+  return true;
+}
+
+//=================================================================================================
+
+// Normal of a face at its vertex, oriented as the face.
+static bool NormalAtVertex(const TopoDS_Face& theFace, const TopoDS_Vertex& theV, gp_Dir& theN)
+{
+  // The fillet may end on a support face that does not reach the vertex.
+  bool isOnFace = false;
+  for (TopExp_Explorer anExp(theFace, TopAbs_VERTEX); anExp.More() && !isOnFace; anExp.Next())
+  {
+    isOnFace = anExp.Current().IsSame(theV);
+  }
+  if (!isOnFace)
+  {
+    return false;
+  }
+  const gp_Pnt2d      aUV = BRep_Tool::Parameters(theV, theFace);
+  BRepAdaptor_Surface aS(theFace, false);
+  gp_Pnt              aP;
+  gp_Vec              aDU, aDV;
+  aS.D1(aUV.X(), aUV.Y(), aP, aDU, aDV);
+  const gp_Vec aN = aDU.Crossed(aDV);
+  if (aN.SquareMagnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  theN = aN;
+  if (theFace.Orientation() == TopAbs_REVERSED)
+  {
+    theN.Reverse();
+  }
+  return true;
+}
+
+// True if the intersection of theFv and theFop leaves the vertex away from
+// the edges of theFop there.
+static bool CapLeavesEdgesOfFace(const TopoDS_Face&                    theFv,
+                                 const TopoDS_Face&                    theFop,
+                                 const TopoDS_Vertex&                  theV,
+                                 const NCollection_List<TopoDS_Shape>& theVEdges)
+{
+  gp_Dir aNv, aNop;
+  if (!NormalAtVertex(theFv, theV, aNv) || !NormalAtVertex(theFop, theV, aNop))
+  {
+    return false;
+  }
+  const gp_Vec aDir = gp_Vec(aNv).Crossed(gp_Vec(aNop));
+  if (aDir.Magnitude() < 1.e-3)
+  {
+    return false; // the faces are tangent at the vertex
+  }
+  const double anAngTol = 1.e-3;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theVEdges); anIt.More(); anIt.Next())
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(anIt.Value());
+    if (BRep_Tool::Degenerated(anEdge) || !IsEdgeOfFace(anEdge, theFop))
+    {
+      continue;
+    }
+    BRepAdaptor_Curve aC(anEdge);
+    gp_Pnt            aP;
+    gp_Vec            aT;
+    aC.D1(BRep_Tool::Parameter(theV, anEdge), aP, aT);
+    if (aT.SquareMagnitude() < gp::Resolution())
+    {
+      return false;
+    }
+    if (aT.IsParallel(aDir, anAngTol))
+    {
+      return false;
+    }
+  }
+  return true;
+}
