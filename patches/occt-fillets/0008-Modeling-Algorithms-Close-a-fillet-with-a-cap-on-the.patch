+//=================================================================================================
+
+// Orientation of a curve that starts at the corner vertex on a face: FORWARD
+// if the part of the face to keep, on the side of theInside, is on its left.
+static TopAbs_Orientation OrientationFromSide(const occ::handle<Geom2d_Curve>& theCurve,
+                                              const gp_Pnt2d&                  theInside)
+{
+  // The side is taken at the point of the curve nearest to theInside: on a
+  // curved section (a cap on a cylinder) the tangent at the middle may leave
+  // a point near the end of the curve on the wrong side.
+  double aPar = 0.5 * (theCurve->FirstParameter() + theCurve->LastParameter());
+  Geom2dAPI_ProjectPointOnCurve aProj(theInside,
+                                      theCurve,
+                                      theCurve->FirstParameter(),
+                                      theCurve->LastParameter());
+  if (aProj.NbPoints() > 0)
+  {
+    aPar = aProj.LowerDistanceParameter();
+  }
+  else if (theInside.Distance(theCurve->Value(theCurve->FirstParameter()))
+           < theInside.Distance(theCurve->Value(theCurve->LastParameter())))
+  {
+    aPar = theCurve->FirstParameter();
+  }
+  else
+  {
+    aPar = theCurve->LastParameter();
+  }
+  gp_Pnt2d aP;
+  gp_Vec2d aD;
+  theCurve->D1(aPar, aP, aD);
+  return aD.Crossed(gp_Vec2d(aP, theInside)) > 0. ? TopAbs_FORWARD : TopAbs_REVERSED;
+}
