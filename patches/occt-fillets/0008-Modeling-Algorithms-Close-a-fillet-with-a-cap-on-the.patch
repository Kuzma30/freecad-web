+bool ChFi3d_Builder::PerformCapOnEndFace(const int theIndex)
+{
+  // The fillet leaves its support faces across an arc on one side
+  // and its section lies across the plane of the face beyond that
+  // arc. The corner is then that face extended up to the fillet
+  // (a planar cap), the opposite support face being limited by its
+  // intersection with that plane from the vertex. The faces
+  // between the two, and their edges, are not changed.
+  if (myVDataMap(theIndex).Extent() != 1)
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&         DStr    = myDS->ChangeDS();
+  const TopoDS_Vertex&                Vtx     = myVDataMap.FindKey(theIndex);
+  const occ::handle<ChFiDS_Stripe>&   stripe  = myVDataMap(theIndex).First();
+  int                                 sens    = 0;
+  const int                           num     = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool                          isfirst = (sens == 1);
+  const occ::handle<ChFiDS_SurfData>& Fd      = stripe->SetOfSurfData()->Value(num);
+  if (Fd->IndexOfS1() == 0 || Fd->IndexOfS2() == 0)
+  {
+    return false;
+  }
+
+  const occ::handle<GeomAdaptor_Surface> aFilletSurf =
+    new GeomAdaptor_Surface(DStr.Surface(Fd->Surf()).Surface());
+  for (int aFadArc = 1; aFadArc <= 2; aFadArc++)
+  {
+    const ChFiDS_CommonPoint& aCPad = Fd->Vertex(isfirst, aFadArc);
+    if (!aCPad.IsOnArc())
+    {
+      continue;
+    }
+    const TopoDS_Edge& anArcPiv = aCPad.Arc();
+    if (!TopExp::FirstVertex(anArcPiv).IsSame(Vtx) && !TopExp::LastVertex(anArcPiv).IsSame(Vtx))
+    {
+      continue;
+    }
+    const TopoDS_Face aFad = TopoDS::Face(DStr.Shape(Fd->Index(aFadArc)));
+    const TopoDS_Face aFop = TopoDS::Face(DStr.Shape(Fd->Index(3 - aFadArc)));
+    TopoDS_Face       aFv;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(myEFMap(anArcPiv)); anIt.More(); anIt.Next())
+    {
+      if (!aFad.IsSame(anIt.Value()))
+      {
+        aFv = TopoDS::Face(anIt.Value());
+        break;
+      }
+    }
+    if (aFv.IsNull() || aFv.IsSame(aFop))
+    {
+      continue;
+    }
+    BRepAdaptor_Surface aFvSurf(aFv, false);
+
+    // Fv and Fop must not meet at the vertex: that is the plain OnSame case.
+    bool isShared = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(myVEMap(Vtx)); anIt.More() && !isShared;
+         anIt.Next())
+    {
+      const TopoDS_Edge& anEdge = TopoDS::Edge(anIt.Value());
+      isShared                  = IsEdgeOfFace(anEdge, aFv) && IsEdgeOfFace(anEdge, aFop);
+    }
+    if (isShared)
+    {
+      continue;
+    }
+    bool        hasSeam = false;
+    TopoDS_Edge aSeam;
+    ChFi3d_Couture(aFop, hasSeam, aSeam);
+    if (hasSeam)
+    {
+      continue;
+    }
+
+    // The edges at the vertex between Fv and Fop must stay clear of the
+    // fillet; otherwise the faces between them close it, which is the case
+    // of PerformIntersectionAtEnd.
+    bool isCrossed = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(myVEMap(Vtx)); anIt.More() && !isCrossed;
+         anIt.Next())
+    {
+      const TopoDS_Edge& anEdge = TopoDS::Edge(anIt.Value());
+      if (BRep_Tool::Degenerated(anEdge) || IsEdgeOfFace(anEdge, aFad)
+          || IsEdgeOfFace(anEdge, aFop))
+      {
+        continue;
+      }
+      IntCurveSurface_HInter anInter;
+      anInter.Perform(new BRepAdaptor_Curve(anEdge), aFilletSurf);
+      isCrossed = anInter.IsDone() && anInter.NbPoints() > 0;
+    }
+    if (isCrossed)
+    {
+      continue;
+    }
+
+    // The cap curve on Fop starts at the vertex along the intersection of Fv
+    // and Fop. If it runs along an edge of Fop there, it would only double
+    // that edge (the end face meets Fop on the boundary of Fop).
+    if (!CapLeavesEdgesOfFace(aFv, aFop, Vtx, myVEMap(Vtx)))
+    {
+      continue;
+    }
+
+    // The fillet must reach the surface of Fv on Fop: the end of its trace
+    // at this vertex and the middle of it lie on the two sides. The other end
+    // is not used, it may stop at another such face (an arc between two
+    // corners).
+    const ChFiDS_FaceInterference& aFiop = Fd->Interference(3 - aFadArc);
+    if (aFiop.LineIndex() == 0)
+    {
+      continue;
+    }
+    const occ::handle<Geom_Curve>& aC3d = DStr.Curve(aFiop.LineIndex()).Curve();
+    if (aC3d.IsNull())
+    {
+      continue;
+    }
+    const double anEnd = aFiop.Parameter(isfirst);
+    const double aMid  = 0.5 * (aFiop.FirstParameter() + aFiop.LastParameter());
+    double       aD1 = 0., aD2 = 0.;
+    if (!SideOfSurface(aFvSurf, aC3d->Value(anEnd), aD1)
+        || !SideOfSurface(aFvSurf, aC3d->Value(aMid), aD2) || aD1 * aD2 > 0.)
+    {
+      continue;
+    }
+
+    PerformOneCorner(theIndex, false, aFadArc);
+    return true;
+  }
+  return false;
+}
