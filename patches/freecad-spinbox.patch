+/// Digits of the number at the start of an editor text, with the power of ten each one
+/// carries. Engineering notation is handled: in "1.25e-3" the '5' carries 10^-5 and the
+/// exponent's '3' is listed separately, with power 0 within the exponent.
+struct NumberDigits
+{
+    double value {};
+    int length {};  ///< UTF-16 length of the number token
+    std::vector<std::pair<int, int>> mantissa;  ///< (text index, power of ten in the value)
+    std::vector<std::pair<int, int>> exponent;  ///< (text index, power of ten in the exponent)
+};
+
+std::optional<NumberDigits> scanNumberDigits(const QString& text, const Base::NumericLocaleContext& ctx)
+{
+    const QByteArray utf8 = text.toUtf8();
+    const auto scan = Base::scanLocalizedNumber(
+        std::string_view {utf8.constData(), static_cast<std::size_t>(utf8.size())},
+        ctx,
+        Base::NumericSyntaxContext::Standalone
+    );
+    if (scan.status != Base::LocalizedNumberResult::Status::Complete || scan.consumedBytes == 0) {
+        return std::nullopt;
+    }
+
+    NumberDigits number;
+    number.value = scan.value;
+    number.length = QString::fromUtf8(utf8.constData(), static_cast<int>(scan.consumedBytes)).size();
+
+    const QString token = text.left(number.length);
+    int ePos = token.indexOf(QLatin1Char('e'), 0, Qt::CaseInsensitive);
+    if (ePos < 0) {
+        ePos = number.length;
+    }
+    const QString dec = QString::fromStdString(ctx.decimalSeparator);
+    int decPos = dec.isEmpty() ? -1 : token.left(ePos).indexOf(dec);
+    if (decPos < 0) {
+        decPos = ePos;
+    }
+    const auto e = scan.canonicalText.find('e');
+    const int exp10 = e == std::string::npos ? 0 : std::stoi(scan.canonicalText.substr(e + 1));
+
+    int power = exp10;
+    for (int i = decPos - 1; i >= 0; --i) {
+        if (token.at(i).isDigit()) {
+            number.mantissa.emplace_back(i, power++);
+        }
+    }
+    power = exp10 - 1;
+    for (int i = decPos + static_cast<int>(dec.size()); i < ePos; ++i) {
+        if (token.at(i).isDigit()) {
+            number.mantissa.emplace_back(i, power--);
+        }
+    }
+    power = 0;
+    for (int i = number.length - 1; i > ePos; --i) {
+        if (token.at(i).isDigit()) {
+            number.exponent.emplace_back(i, power++);
+        }
+    }
+    return number;
+}
