+std::optional<QuantitySpinBox::DigitTarget> QuantitySpinBox::digitTargetAtCursor(
+    const double baseValue
+) const
+{
+    Q_D(const QuantitySpinBox);
+    QLineEdit* le = lineEdit();
+    const QString text = le->text();
+    const auto ctx = Gui::numericLocaleContextFor(locale());
+    const auto number = scanNumberDigits(text, ctx);
+    if (!number || number->mantissa.empty()) {
+        return std::nullopt;
+    }
+
+    int index = -1;
+    const bool hasSelection = le->hasSelectedText();
+    if (hasSelection) {
+        const int start = le->selectionStart();
+        const int end = start + le->selectedText().size();
+        if (start <= 0 && end >= number->length) {
+            // The whole number is selected (after focusing the field or a normal step):
+            // keep the classic singleStep behaviour.
+            return std::nullopt;
+        }
+        // Rightmost digit of the selection that belongs to the number.
+        for (int i = std::min(end, number->length) - 1; i >= start && index < 0; --i) {
+            if (text.at(i).isDigit()) {
+                index = i;
+            }
+        }
+    }
+    else {
+        // Caret: the digit to the left of it, or, at the very start, the one to the right.
+        const int pos = le->cursorPosition();
+        if (pos > 0 && pos <= number->length && text.at(pos - 1).isDigit()) {
+            index = pos - 1;
+        }
+        else if (pos < number->length && text.at(pos).isDigit()) {
+            index = pos;
+        }
+    }
+    if (index < 0) {
+        return std::nullopt;
+    }
+
+    // Size of one unit of the number as written, which need not be the display unit: the
+    // user may have typed "1 cm" or "1.5e-3 mm" where the schema shows mm or µm. Ask the
+    // quantity parser what "1" followed by the rest of the text is, then check that the number
+    // times that really is the value being stepped. That rejects expressions ("2+3 mm"),
+    // invalid edits and stale text, where the digit says nothing about the step size.
+    App::QuantityConstraints constraints;
+    if (d->unit != Base::Unit::One) {
+        constraints.requiredUnit = d->unit;
+    }
+    const QString probe = QStringLiteral("1") + text.mid(number->length);
+    const auto unit = App::interpretQuantityInput(
+        probe.toUtf8().toStdString(),
+        App::QuantityInputGrammar::Quantity,
+        getPath(),
+        d->displayUnit,
+        ctx,
+        App::InputPhase::Commit,
+        constraints
+    );
+    if (unit.status != App::InputStatus::Acceptable || !unit.quantity) {
+        return std::nullopt;
+    }
+    const double scale = unit.quantity->getValue();
+    const int lowest = number->mantissa.back().second;
+    const double tolerance = (0.5 * std::pow(10.0, lowest) + 1e-9 * std::abs(number->value))
+        * std::abs(scale);
+    if (scale == 0.0 || std::abs(number->value * scale - baseValue) > tolerance) {
+        return std::nullopt;
+    }
+
+    for (const auto& [i, power] : number->mantissa) {
+        if (i == index) {
+            return DigitTarget {power, false, hasSelection, scale};
+        }
+    }
+    for (const auto& [i, power] : number->exponent) {
+        if (i == index) {
+            return DigitTarget {power, true, hasSelection, scale};
+        }
+    }
+    return std::nullopt;
+}
+
+void QuantitySpinBox::restoreDigitTarget(const DigitTarget& target, const double displayScale)
+{
+    QLineEdit* le = lineEdit();
+    const auto number = scanNumberDigits(le->text(), Gui::numericLocaleContextFor(locale()));
+    const auto* digits = number ? (target.inExponent ? &number->exponent : &number->mantissa)
+                                : nullptr;
+    if (!digits || digits->empty()) {
+        selectNumber();
+        return;
+    }
+    // The text is now in the display unit, which may differ from the one typed (1 cm is shown
+    // as 10 mm): keep the digit of the same absolute weight. The re-formatted text may also
+    // have lost that digit (10 -> 0 drops the tens): take the closest one.
+    int power = target.power;
+    if (!target.inExponent) {
+        power += static_cast<int>(std::lround(std::log10(target.scale / displayScale)));
+    }
+    const auto closest = std::min_element(digits->begin(), digits->end(), [&](auto a, auto b) {
+        return std::abs(a.second - power) < std::abs(b.second - power);
+    });
+    if (target.selection) {
+        le->setSelection(closest->first, 1);
+    }
+    else {
+        le->setCursorPosition(closest->first + 1);
+    }
+}
