+bool BallValue(const ConstRadInvData& theCtx, const math_Vector& X, math_Vector& F)
+{
+  // As BlendFunc_ConstRad for a rolling ball: the center of the
+  // ball touching the surfaces is on their normals.
+  gp_Pnt ptcur;
+  gp_Vec d1cur;
+  theCtx.curv->D1(X(2), ptcur, d1cur);
+
+  const gp_Vec nplan = d1cur.Normalized();
+  const double theD  = -(nplan.XYZ().Dot(ptcur.XYZ()));
+
+  const gp_Pnt2d pt2d(theCtx.csurf->Value(X(1)));
+
+  gp_Pnt pts1, pts2;
+  gp_Vec d1u1, d1v1, d1u2, d1v2;
+  if (theCtx.first)
+  {
+    theCtx.surf1->D1(pt2d.X(), pt2d.Y(), pts1, d1u1, d1v1);
+    theCtx.surf2->D1(X(3), X(4), pts2, d1u2, d1v2);
+  }
+  else
+  {
+    theCtx.surf1->D1(X(3), X(4), pts1, d1u1, d1v1);
+    theCtx.surf2->D1(pt2d.X(), pt2d.Y(), pts2, d1u2, d1v2);
+  }
+
+  gp_Vec ns1 = d1u1.Crossed(d1v1);
+  if (ns1.Magnitude() < Eps)
+  {
+    BlendFunc::ComputeNormal(theCtx.surf1, theCtx.first ? pt2d : gp_Pnt2d(X(3), X(4)), ns1);
+  }
+  gp_Vec ns2 = d1u2.Crossed(d1v2);
+  if (ns2.Magnitude() < Eps)
+  {
+    BlendFunc::ComputeNormal(theCtx.surf2, theCtx.first ? gp_Pnt2d(X(3), X(4)) : pt2d, ns2);
+  }
+  const gp_Vec aMid((pts1.XYZ() + pts2.XYZ()) / 2.);
+  F(1) = nplan.XYZ().Dot(aMid.XYZ()) + theD;
+
+  gp_Vec resul;
+  resul.SetLinearForm(theCtx.ray1, UnitNormal(ns1), gp_Vec(pts2, pts1));
+  resul.Subtract(theCtx.ray2 * UnitNormal(ns2));
+  F(2) = resul.X();
+  F(3) = resul.Y();
+  F(4) = resul.Z();
+  return true;
+}
+
+//=================================================================================================
+
+bool BallValues(const ConstRadInvData& theCtx, const math_Vector& X, math_Vector& F, math_Matrix& D)
+{
+  gp_Pnt ptcur;
