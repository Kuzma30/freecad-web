+//=================================================================================================
+
+//! Removes the surfdatas computed beyond the end of a fillet at a vertex:
+//! the walking went on along the extension of the spine with one side out
+//! of its face (a surfdata with no face on that side), while the last
+//! surfdata on two faces ends on two arcs through the vertex. The end of
+//! the fillet is then computed from that surfdata, as when the walking
+//! stops there.
+//! @param[in] theStripe the stripe ending at the vertex
+//! @param[in] theVtx the vertex
+static void RemoveSurfDataBeyondVertex(const occ::handle<ChFiDS_Stripe>& theStripe,
+                                       const TopoDS_Vertex&              theVtx)
+{
+  int        aSens   = 0;
+  const int  aNum    = ChFi3d_IndexOfSurfData(theVtx, theStripe, aSens);
+  const bool isFirst = (aSens == 1);
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq =
+    theStripe->ChangeSetOfSurfData()->ChangeSequence();
+  const occ::handle<ChFiDS_SurfData>& aLast = aSeq.Value(aNum);
+  if ((aLast->IndexOfS1() == 0) == (aLast->IndexOfS2() == 0))
+  {
+    return;
+  }
+  int anIn = aNum;
+  while (anIn >= 1 && anIn <= aSeq.Length()
+         && (aSeq.Value(anIn)->IndexOfS1() <= 0 || aSeq.Value(anIn)->IndexOfS2() <= 0))
+  {
+    anIn += isFirst ? 1 : -1;
+  }
+  if (anIn < 1 || anIn > aSeq.Length())
+  {
+    return;
+  }
+  const occ::handle<ChFiDS_SurfData>& aSD = aSeq.Value(anIn);
+  for (int k = 1; k <= 2; ++k)
+  {
+    const ChFiDS_CommonPoint& aCP = aSD->Vertex(isFirst, k);
+    if (!aCP.IsOnArc())
+    {
+      return;
+    }
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aCP.Arc(), aV1, aV2);
+    if (!aV1.IsSame(theVtx) && !aV2.IsSame(theVtx))
+    {
+      return;
+    }
+  }
+  if (isFirst)
+  {
+    aSeq.Remove(1, anIn - 1);
+  }
+  else
+  {
+    aSeq.Remove(anIn + 1, aSeq.Length());
+  }
+}
