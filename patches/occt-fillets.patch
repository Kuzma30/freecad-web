+static bool IsSmoothTransition(const TopOpeBRepDS_DataStructure&   theDS,
+                               const occ::handle<ChFiDS_SurfData>& theA,
+                               const occ::handle<ChFiDS_SurfData>& theB,
+                               const int                           theSide)
+{
+  // The side theSide of theA goes on to theB (following it) on the
+  // same face, or across a smooth edge of the shape.
+  if (theA.IsNull() || theB.IsNull() || theA->Index(theSide) <= 0 || theB->Index(theSide) <= 0)
+  {
+    return false;
+  }
+  if (theA->Index(theSide) == theB->Index(theSide))
+  {
+    return true;
+  }
+  const ChFiDS_CommonPoint& aCP = theA->Vertex(false, theSide);
+  if (!aCP.IsOnArc())
+  {
+    return false;
+  }
+  const TopoDS_Face aFa = TopoDS::Face(theDS.Shape(theA->Index(theSide)));
+  const TopoDS_Face aFb = TopoDS::Face(theDS.Shape(theB->Index(theSide)));
+  return BRep_Tool::HasContinuity(aCP.Arc(), aFa, aFb)
+         && BRep_Tool::Continuity(aCP.Arc(), aFa, aFb) >= GeomAbs_G1;
+}
