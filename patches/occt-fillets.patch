+bool BRepFilletAPI_MakeFillet::buildConcaveFirst()
+{
+  const int aNbContours = NbContours();
+  if (aNbContours < 3)
+  {
+    return false;
+  }
+  for (int anIC = 1; anIC <= aNbContours; ++anIC)
+  {
+    if (!myBuilder.IsConstant(anIC))
+    {
+      return false;
+    }
+  }
+
+  ShapeListMap anEdgeFaces, aVertexEdges;
+  TopExp::MapShapesAndAncestors(myInitialShape, TopAbs_EDGE, TopAbs_FACE, anEdgeFaces);
+  TopExp::MapShapesAndAncestors(myInitialShape, TopAbs_VERTEX, TopAbs_EDGE, aVertexEdges);
+
+  // Ends of the contours at each vertex: the index of the contour, negated
+  // for a convex one.
+  NCollection_DataMap<TopoDS_Shape, NCollection_List<int>, TopTools_ShapeMapHasher> anEnds;
+  for (int anIC = 1; anIC <= aNbContours; ++anIC)
+  {
+    if (Closed(anIC))
+    {
+      continue;
+    }
+    for (int anEnd = 0; anEnd < 2; ++anEnd)
+    {
+      const TopoDS_Vertex          aVertex = anEnd == 0 ? FirstVertex(anIC) : LastVertex(anIC);
+      const TopoDS_Edge&           anEdge  = Edge(anIC, anEnd == 0 ? 1 : NbEdges(anIC));
+      const ChFiDS_TypeOfConcavity aType   = edgeConcavity(anEdge, anEdgeFaces);
+      if (aType != ChFiDS_Concave && aType != ChFiDS_Convex)
+      {
+        continue;
+      }
+      if (!anEnds.IsBound(aVertex))
+      {
+        anEnds.Bind(aVertex, NCollection_List<int>());
+      }
+      anEnds.ChangeFind(aVertex).Append(aType == ChFiDS_Concave ? anIC : -anIC);
+    }
+  }
+
+  // The first stage: the concave contours ending at a vertex with two convex
+  // contours, the vertex having more edges than contour ends.
+  NCollection_Map<int> aFirstStage;
+  for (NCollection_DataMap<TopoDS_Shape, NCollection_List<int>, TopTools_ShapeMapHasher>::Iterator
+         anIt(anEnds);
+       anIt.More();
+       anIt.Next())
+  {
+    int aNbConcave = 0, aNbConvex = 0;
+    for (NCollection_List<int>::Iterator anEndIt(anIt.Value()); anEndIt.More(); anEndIt.Next())
+    {
+      if (anEndIt.Value() > 0)
+      {
+        ++aNbConcave;
+      }
+      else
+      {
+        ++aNbConvex;
+      }
+    }
+    if (aNbConcave == 0 || aNbConvex < 2)
+    {
+      continue;
+    }
+    ShapeMap anEdges;
+    if (const NCollection_List<TopoDS_Shape>* aList = aVertexEdges.Seek(anIt.Key()))
+    {
+      for (NCollection_List<TopoDS_Shape>::Iterator anEdgeIt(*aList); anEdgeIt.More();
+           anEdgeIt.Next())
+      {
+        if (!BRep_Tool::Degenerated(TopoDS::Edge(anEdgeIt.Value())))
+        {
+          anEdges.Add(anEdgeIt.Value());
+        }
+      }
+    }
+    if (anEdges.Extent() <= aNbConcave + aNbConvex)
+    {
+      continue;
+    }
+    for (NCollection_List<int>::Iterator anEndIt(anIt.Value()); anEndIt.More(); anEndIt.Next())
+    {
+      if (anEndIt.Value() > 0)
+      {
+        aFirstStage.Add(anEndIt.Value());
+      }
+    }
+  }
+  if (aFirstStage.IsEmpty() || aFirstStage.Extent() == aNbContours)
+  {
+    return false;
+  }
+
+  // The fillets of the second stage propagate round the ends of the fillets
+  // of the first stage. Not to fillet edges which are not asked for, at each
+  // end of a contour of the first stage the other sharp edges must be either
+  // all filleted or none.
+  for (NCollection_Map<int>::Iterator anIt(aFirstStage); anIt.More(); anIt.Next())
+  {
+    const int anIC = anIt.Value();
+    for (int anEnd = 0; anEnd < 2; ++anEnd)
+    {
+      const TopoDS_Vertex aVertex = anEnd == 0 ? FirstVertex(anIC) : LastVertex(anIC);
+      const NCollection_List<TopoDS_Shape>* anEdges = aVertexEdges.Seek(aVertex);
+      if (anEdges == nullptr)
+      {
+        continue;
+      }
+      int aNbFilleted = 0, aNbFree = 0;
+      for (NCollection_List<TopoDS_Shape>::Iterator anEdgeIt(*anEdges); anEdgeIt.More();
+           anEdgeIt.Next())
+      {
+        const TopoDS_Edge& anEdge = TopoDS::Edge(anEdgeIt.Value());
+        const int          anIC2  = Contour(anEdge);
+        if (anIC2 != 0 && aFirstStage.Contains(anIC2))
+        {
+          continue;
+        }
+        const ChFiDS_TypeOfConcavity aType = edgeConcavity(anEdge, anEdgeFaces);
+        if (aType != ChFiDS_Concave && aType != ChFiDS_Convex)
+        {
+          continue;
+        }
+        if (anIC2 != 0)
+        {
+          ++aNbFilleted;
+        }
+        else
+        {
+          ++aNbFree;
+        }
+      }
+      if (aNbFilleted != 0 && aNbFree != 0)
+      {
+        return false;
+      }
+    }
+  }
+
+  const ChFi3d_FilletShape aFilletShape = GetFilletShape();
+  BRepFilletAPI_MakeFillet aStage1(myInitialShape, aFilletShape);
+  if (myHasParams)
+  {
+    aStage1.SetParams(myParams[0], myParams[1], myParams[2], myParams[3], myParams[4], myParams[5]);
+  }
+  if (myHasContinuity)
+  {
+    aStage1.SetContinuity(myInternalContinuity, myAngularTolerance);
+  }
+  for (NCollection_Map<int>::Iterator anIt(aFirstStage); anIt.More(); anIt.Next())
+  {
+    const int anIC = anIt.Value();
+    for (int anIE = 1; anIE <= NbEdges(anIC); ++anIE)
+    {
+      aStage1.Add(Radius(anIC), Edge(anIC, anIE));
+    }
+  }
+  try
+  {
+    aStage1.Build();
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+  if (!aStage1.IsDone())
+  {
+    return false;
+  }
+
+  const TopoDS_Shape aShape1 = aStage1.Shape();
+  ShapeListMap       aShape1EdgeFaces;
+  TopExp::MapShapesAndAncestors(aShape1, TopAbs_EDGE, TopAbs_FACE, aShape1EdgeFaces);
+
+  occ::handle<BRepTools_History> aHistory = new BRepTools_History();
+  addStageHistory(myInitialShape, aStage1, true, *aHistory);
+
+  BRepFilletAPI_MakeFillet aStage2(aShape1, aFilletShape);
+  if (myHasParams)
+  {
+    aStage2.SetParams(myParams[0], myParams[1], myParams[2], myParams[3], myParams[4], myParams[5]);
+  }
+  if (myHasContinuity)
+  {
+    aStage2.SetContinuity(myInternalContinuity, myAngularTolerance);
+  }
