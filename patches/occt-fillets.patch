diff --git a/tests/bugs/modalg_8/fillet_trace_on_tangent_edge b/tests/bugs/modalg_8/fillet_trace_on_tangent_edge
new file mode 100644
index 00000000..d5af2973
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_trace_on_tangent_edge
@@ -0,0 +1,35 @@
+puts "============"
+puts "Modeling Algorithms - Fillet whose trace is a tangent edge of its face"
+puts "(box with rounded edges, square hole as wide as the flat top minus the fillets)"
+puts "============"
+puts ""
+
+# A box of 20 with fillets of radius 3 on all edges has a flat top of 14 x 14.
+# A square hole of 12 x 12 is cut in it, and the edges of the hole are filleted
+# with radius 1: the new fillets touch the top exactly along its tangent edges
+# with the fillets of the box. The top is covered by the new fillets, and their
+# traces are these edges.
+box b 20 20 20
+explode b E
+blend r b 3 b_1 3 b_2 3 b_3 3 b_4 3 b_5 3 b_6 3 b_7 3 b_8 3 b_9 3 b_10 3 b_11 3 b_12
+box t 4 4 12 12 12 10
+bcut h r t
+
+set edges {}
+foreach e [explode h E] {
+  regexp {X = +([-0-9.e]+)} [lprops $e] full x
+  regexp {Y = +([-0-9.e]+)} [lprops $e] full y
+  regexp {Z = +([-0-9.e]+)} [lprops $e] full z
+  if {abs($z - 20.) < 1.e-6 && (abs($x - 4.) < 1.e-6 || abs($x - 16.) < 1.e-6 || abs($y - 4.) < 1.e-6 || abs($y - 16.) < 1.e-6)} {
+    lappend edges 1 $e
+  }
+}
+if {[llength $edges] != 8} {
+  puts "Error: [expr [llength $edges] / 2] edges of the hole instead of 4"
+}
+
+eval blend result h $edges
+
+checkshape result
+checkmaxtol result -ref 1.39e-7
+checkprops result -v 6409.93 -s 2444.74
