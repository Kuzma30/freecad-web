+// The holed cube of FreeCAD issue 20085 filleted in two operations: an upper
+// edge of the hole, then the next one. The second fillet stops at the end of
+// the first one, where its spine goes on along the tangent edge between the
+// wall and the sphere of the corner of the cube; it failed ("command not
+// done"). At its other end the walking went on past the vertex, out of the
+// wall, and the end was closed by a patch.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_SecondFilletNextToFirst)
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  // The fillet of the upper edge of the hole through theMid.
+  const auto aFilletAt = [](const TopoDS_Shape& theShape,
+                            const double        theRadius,
+                            const gp_Pnt&       theMid,
+                            TopoDS_Shape&       theResult) {
+    BRepFilletAPI_MakeFillet aFillet(theShape);
+    for (TopExp_Explorer anExp(theShape, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      GProp_GProps aProps;
+      BRepGProp::LinearProperties(anExp.Current(), aProps);
+      if (aProps.Mass() > 1.0 && aProps.CentreOfMass().Distance(theMid) < 1.e-6)
+      {
+        aFillet.Add(theRadius, TopoDS::Edge(anExp.Current()));
+        break;
+      }
+    }
+    if (aFillet.NbContours() != 1)
+    {
+      return false;
+    }
+    aFillet.Build();
+    if (!aFillet.IsDone())
+    {
+      return false;
+    }
+    theResult = aFillet.Shape();
+    return true;
+  };
+  const auto aVolume = [](const TopoDS_Shape& theShape) {
+    GProp_GProps aProps;
+    BRepGProp::VolumeProperties(theShape, aProps);
+    return aProps.Mass();
+  };
+
+  // The upper edges on the walls y = 4, x = -4, y = -4 and x = 4.
+  const gp_Pnt aMids[4]      = {gp_Pnt(0.0, 4.0, 10.0),
+                                gp_Pnt(-4.0, 0.0, 10.0),
+                                gp_Pnt(0.0, -4.0, 10.0),
+                                gp_Pnt(4.0, 0.0, 10.0)};
+  const double aRadii[2]     = {1.0, 2.0};
+  const double aOneFillet[2] = {2.3110, 14.1751};
+  for (int r = 0; r < 2; ++r)
+  {
+    for (int i = 0; i < 4; ++i)
+    {
+      TopoDS_Shape aFirst, aSecond;
+      ASSERT_TRUE(aFilletAt(aHoled, aRadii[r], aMids[i], aFirst));
+      ASSERT_TRUE(aFilletAt(aFirst, aRadii[r], aMids[(i + 1) % 4], aSecond))
+        << "r = " << aRadii[r] << ", edge " << i;
+      EXPECT_TRUE(BRepCheck_Analyzer(aSecond).IsValid()) << "r = " << aRadii[r] << ", edge " << i;
+
+      double aMaxTol = 0.0;
+      for (TopExp_Explorer anExp(aSecond, TopAbs_VERTEX); anExp.More(); anExp.Next())
+      {
+        aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+      }
+      EXPECT_LT(aMaxTol, 1.e-3) << "r = " << aRadii[r] << ", edge " << i;
+
+      // Each fillet removes the same volume.
+      EXPECT_NEAR(aVolume(aHoled) - aVolume(aFirst), aOneFillet[r], 1.e-3);
+      EXPECT_NEAR(aVolume(aFirst) - aVolume(aSecond), aOneFillet[r], 1.e-3)
+        << "r = " << aRadii[r] << ", edge " << i;
+    }
+  }
+}
