+// Fillet whose support face shrinks to nothing at its end (FreeCAD issue 27807)
+
+namespace
+{
+
+// A box with a quarter turn of a 25 x 50 square on top of it. The flat ends
+// of the revolved part are quarter discs whose height falls to zero at y = 50,
+// so a fillet of radius 15 along their bottom edges runs past them there.
+TopoDS_Shape MakeQuarterRevolveOnBox()
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-50.0, -50.0, 0.0), 100.0, 100.0, 100.0).Shape();
+  BRepBuilderAPI_MakePolygon aProfile(gp_Pnt(0.0, 0.0, 100.0),
+                                      gp_Pnt(25.0, 0.0, 100.0),
+                                      gp_Pnt(25.0, 0.0, 150.0),
+                                      gp_Pnt(0.0, 0.0, 150.0),
+                                      true);
+  const TopoDS_Face          aFace = BRepBuilderAPI_MakeFace(aProfile.Wire(), true).Face();
+  const TopoDS_Shape         aRevol =
+    BRepPrimAPI_MakeRevol(aFace, gp_Ax1(gp_Pnt(0.0, 0.0, 100.0), gp::DX()), -M_PI / 2.0).Shape();
+  ShapeUpgrade_UnifySameDomain aUnify(BRepAlgoAPI_Fuse(aBox, aRevol).Shape());
+  aUnify.Build();
+  return aUnify.Shape();
+}
+
+// Returns the edges on the top of the box along the ends of the revolved part,
+// at x = 0 and x = 25 (theWithEnd adds the edge at y = 0 between them).
+NCollection_List<TopoDS_Edge> RevolveFootEdges(const TopoDS_Shape& theShape, const bool theWithEnd)
+{
+  NCollection_List<TopoDS_Edge>                                 anEdges;
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aMap;
+  TopExp::MapShapes(theShape, TopAbs_EDGE, aMap);
+  for (int i = 1; i <= aMap.Extent(); ++i)
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(aMap(i));
+    GProp_GProps       aProps;
+    BRepGProp::LinearProperties(anEdge, aProps);
+    const gp_Pnt aMid = aProps.CentreOfMass();
+    if (std::abs(aMid.Z() - 100.0) > 1.e-6)
+    {
+      continue;
+    }
+    const bool isSide = (std::abs(aMid.X()) < 1.e-6 || std::abs(aMid.X() - 25.0) < 1.e-6)
+                        && std::abs(aMid.Y() - 25.0) < 1.e-6;
+    const bool isEnd = std::abs(aMid.X() - 12.5) < 1.e-6 && std::abs(aMid.Y()) < 1.e-6;
+    if (isSide || (theWithEnd && isEnd))
+    {
+      anEdges.Append(anEdge);
+    }
+  }
+  return anEdges;
+}
+
+double MaxVertexTolerance(const TopoDS_Shape& theShape)
+{
+  double aMax = 0.0;
+  for (TopExp_Explorer anExp(theShape, TopAbs_VERTEX); anExp.More(); anExp.Next())
+  {
+    aMax = std::max(aMax, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+  }
+  return aMax;
+}
