+static void OrientAsPrevious(const TopOpeBRepDS_DataStructure&   theDS,
+                             const occ::handle<ChFiDS_SurfData>& thePrev,
+                             const occ::handle<ChFiDS_SurfData>& theCur,
+                             const int                           theSide)
+{
+  // The orientation of theCur follows the one of thePrev, by their
+  // normals at the section between them, on the side theSide.
+  if (thePrev.IsNull())
+  {
+    return;
+  }
+  const occ::handle<Geom2d_Curve>& aP1 = theCur->Interference(theSide).PCurveOnSurf();
+  const occ::handle<Geom2d_Curve>& aP2 = thePrev->Interference(theSide).PCurveOnSurf();
+  if (aP1.IsNull() || aP2.IsNull())
+  {
+    return;
+  }
+  ChFi3d_OrientAsNeighbour(theDS.Surface(theCur->Surf()).Surface(),
+                           aP1->Value(theCur->Interference(theSide).FirstParameter()),
+                           theDS.Surface(thePrev->Surf()).Surface(),
+                           aP2->Value(thePrev->Interference(theSide).LastParameter()),
+                           thePrev->Orientation(),
+                           theCur->ChangeOrientation());
+}
