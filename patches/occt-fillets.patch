+//=================================================================================================
+// Planar cap on the face at the end of a fillet
+
+// The corner of a rectangular pocket in a part whose outer edges along the
+// pocket walls are chamfered at 45 degrees (as in FreeCAD issue 31894). The
+// edge between the wall x = 5 and the chamfer x + z = 5 ends at the pocket
+// corner, where the other wall y = 5 cuts the fillet straight across, but
+// does not meet the chamfer: the face between them is the second chamfer.
+// The corner must be the wall y = 5 extended up to the fillet, with a new
+// straight edge on the chamfer. It was built as a plate patch instead.
+TEST(BRepFilletAPI_MakeFilletTest, PocketCornerOnChamfer_ClosedByPlanarCap)
+{
+  const TopoDS_Shape aBlock =
+    BRepPrimAPI_MakeBox(gp_Pnt(-5.0, -5.0, 0.0), gp_Pnt(15.0, 15.0, 3.0)).Shape();
+  const TopoDS_Face aChamferX =
+    BRepBuilderAPI_MakeFace(gp_Pln(gp_Pnt(5.0, 0.0, 0.0), gp_Dir(1.0, 0.0, 1.0))).Face();
+  const TopoDS_Face aChamferY =
+    BRepBuilderAPI_MakeFace(gp_Pln(gp_Pnt(0.0, 5.0, 0.0), gp_Dir(0.0, 1.0, 1.0))).Face();
+  const TopoDS_Shape aHalfX =
+    BRepPrimAPI_MakeHalfSpace(aChamferX, gp_Pnt(10.0, 10.0, 10.0)).Solid();
+  const TopoDS_Shape aHalfY =
+    BRepPrimAPI_MakeHalfSpace(aChamferY, gp_Pnt(10.0, 10.0, 10.0)).Solid();
+  const TopoDS_Shape aChamfered =
+    BRepAlgoAPI_Common(BRepAlgoAPI_Common(aBlock, aHalfX).Shape(), aHalfY).Shape();
+  const TopoDS_Shape aPocket =
+    BRepPrimAPI_MakeBox(gp_Pnt(5.0, 5.0, -1.0), gp_Pnt(16.0, 16.0, 4.0)).Shape();
+  const TopoDS_Shape aShape = BRepAlgoAPI_Cut(aChamfered, aPocket).Shape();
+  ASSERT_TRUE(BRepCheck_Analyzer(aShape).IsValid());
+
+  // the edge between the wall x = 5 and the chamfer x + z = 5, from y = 5 to y = 15
+  TopoDS_Edge                                                   aSpine;
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+  TopExp::MapShapes(aShape, TopAbs_EDGE, anEdges);
+  for (int i = 1; i <= anEdges.Extent(); ++i)
+  {
+    GProp_GProps aProps;
+    BRepGProp::LinearProperties(anEdges(i), aProps);
+    const gp_Pnt aMid = aProps.CentreOfMass();
+    if (std::abs(aMid.X() - 5.0) < 1.e-6 && std::abs(aMid.Z()) < 1.e-6 && aMid.Y() > 5.0)
+    {
+      aSpine = TopoDS::Edge(anEdges(i));
+    }
+  }
+  ASSERT_FALSE(aSpine.IsNull());
+
+  const double             aRadius = 0.5;
+  BRepFilletAPI_MakeFillet aFillet(aShape);
+  aFillet.Add(aRadius, aSpine);
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  const TopoDS_Shape& aResult = aFillet.Shape();
+  EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid());
+
+  // Both ends are planar caps, so the fillet takes exactly its section times
+  // the length: (cot(pi/8) - 3 pi / 8) r^2 * 10.
+  GProp_GProps aBefore, anAfter;
+  BRepGProp::VolumeProperties(aShape, aBefore);
+  BRepGProp::VolumeProperties(aResult, anAfter);
+  const double anExpected =
+    aRadius * aRadius * (1.0 / std::tan(M_PI / 8.0) - 3.0 * M_PI / 8.0) * 10.0;
+  EXPECT_NEAR(aBefore.Mass() - anAfter.Mass(), anExpected, 1.e-4);
+
+  // The section at the pocket corner is a circle in the wall y = 5.
+  bool hasCapSection = false;
+  for (TopExp_Explorer anExp(aResult, TopAbs_EDGE); anExp.More() && !hasCapSection; anExp.Next())
+  {
+    BRepAdaptor_Curve aCurve(TopoDS::Edge(anExp.Current()));
+    hasCapSection = aCurve.GetType() == GeomAbs_Circle
+                    && std::abs(aCurve.Circle().Location().Y() - 5.0) < 1.e-6
+                    && std::abs(aCurve.Circle().Radius() - aRadius) < 1.e-6;
+  }
+  EXPECT_TRUE(hasCapSection);
+}
