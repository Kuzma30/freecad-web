+static double TraceKink(const TopOpeBRepDS_DataStructure&   theDS,
+                        const occ::handle<ChFiDS_SurfData>& theA,
+                        const occ::handle<ChFiDS_SurfData>& theB,
+                        const int                           theSide,
+                        const bool                          theOnOneFace = true)
+{
+  // The angle between the traces on side theSide of theA and theB
+  // (theB following theA) at the section between them. If they
+  // cannot be compared: 0 when they must be on one face
+  // (theOnOneFace), pi otherwise.
+  const double aNone = theOnOneFace ? 0. : M_PI;
+  if (theA.IsNull() || theB.IsNull()
+      || (theOnOneFace
+          && (theA->Index(theSide) <= 0 || theA->Index(theSide) != theB->Index(theSide))))
+  {
+    return aNone;
+  }
+  const ChFiDS_FaceInterference& aFa = theA->Interference(theSide);
+  const ChFiDS_FaceInterference& aFb = theB->Interference(theSide);
+  if (aFa.LineIndex() == 0 || aFb.LineIndex() == 0)
+  {
+    return aNone;
+  }
+  const occ::handle<Geom_Curve>& aCa = theDS.Curve(aFa.LineIndex()).Curve();
+  const occ::handle<Geom_Curve>& aCb = theDS.Curve(aFb.LineIndex()).Curve();
+  if (aCa.IsNull() || aCb.IsNull())
+  {
+    return aNone;
+  }
+  gp_Pnt aPa, aPb;
+  gp_Vec aTa, aTb;
+  aCa->D1(aFa.LastParameter(), aPa, aTa);
+  aCb->D1(aFb.FirstParameter(), aPb, aTb);
+  if (aTa.Magnitude() < gp::Resolution() || aTb.Magnitude() < gp::Resolution()
+      || aPa.Distance(aPb) > 1.e-3)
+  {
+    return aNone;
+  }
+  return aTa.Angle(aTb);
+}
