+static bool UntwistedEnd(const occ::handle<ChFiDS_SurfData>& theSD,
+                         const int                           theSide,
+                         const occ::handle<Geom_Curve>&      theTrace,
+                         const bool                          theFromStart,
+                         double&                             theW)
+{
+  // The parameter on the trace on side theSide of theSD from which
+  // (theFromStart) or up to which the trace goes on smoothly: near
+  // that end, and only there, it turns sharply (more than 10 degrees
+  // between chords of 1/100 of it; a hook, or a cusp where the
+  // walking came back).
+  // False if the trace goes on smoothly up to that end, or if it
+  // does not further than its first (last) 40 percent.
+  if (theTrace.IsNull())
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& aFi = theSD->Interference(theSide);
+  const double                   aF = aFi.FirstParameter(), aL = aFi.LastParameter();
+  if (aL - aF < Precision::PConfusion())
+  {
+    return false;
+  }
+  const int    aNb      = 100;
+  const int    aZone    = 2 * aNb / 5;
+  const double aSharp   = 10. * M_PI / 180.;
+  int          aBadLast = -1, aBadFirst = aNb + 1;
+  gp_Pnt       aPrev = theTrace->Value(aF);
+  gp_Vec       aPrevD;
+  for (int k = 1; k <= aNb; ++k)
+  {
+    const gp_Pnt aP = theTrace->Value(aF + (aL - aF) * k / aNb);
+    const gp_Vec aD(aPrev, aP);
+    aPrev = aP;
+    if (aD.Magnitude() < Precision::Confusion())
+    {
+      continue;
+    }
+    const bool isBad = aPrevD.Magnitude() > Precision::Confusion() && aPrevD.Angle(aD) > aSharp;
+    aPrevD           = aD;
+    if (isBad)
+    {
+      aBadLast  = k;
+      aBadFirst = std::min(aBadFirst, k);
+    }
+  }
+  if (aBadLast < 0)
+  {
+    return false;
+  }
+  if (theFromStart ? aBadLast > aZone : aBadFirst < aNb - aZone)
+  {
+    return false;
+  }
+  // A few steps beyond the last chord going wrong.
+  const int aK = theFromStart ? aBadLast + 2 : aBadFirst - 3;
+  theW         = aF + (aL - aF) * aK / aNb;
+  return true;
+}
