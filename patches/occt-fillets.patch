+// A face of the result whose wire goes twice through a vertex, the face being
+// on both sides of it (two parts of a face touching at a point, left by a cap
+// cut along the edge between them), is split into one face per part.
+static TopoDS_Shape SplitPinchedFaces(const TopoDS_Shape& theShape)
+{
+  occ::handle<BRepTools_ReShape> aReShape  = new BRepTools_ReShape();
+  bool                           isChanged = false;
+  for (TopExp_Explorer aFExp(theShape, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    const TopoDS_Face& aFace = TopoDS::Face(aFExp.Current());
+    if (BRepCheck_Analyzer(aFace).IsValid())
+    {
+      continue;
+    }
+    // A vertex used by more than two edges of one wire.
+    bool isPinched = false;
+    for (TopExp_Explorer aWExp(aFace, TopAbs_WIRE); aWExp.More() && !isPinched; aWExp.Next())
+    {
+      NCollection_IndexedDataMap<TopoDS_Shape,
+                                 NCollection_List<TopoDS_Shape>,
+                                 TopTools_ShapeMapHasher>
+        aVE;
+      TopExp::MapShapesAndAncestors(aWExp.Current(), TopAbs_VERTEX, TopAbs_EDGE, aVE);
+      for (int i = 1; i <= aVE.Extent() && !isPinched; ++i)
+      {
+        isPinched = aVE(i).Extent() > 2;
+      }
+    }
+    if (!isPinched)
+    {
+      continue;
+    }
+    ShapeFix_Face aFix(aFace);
+    aFix.FixLoopWiresMode()   = 1;
+    aFix.FixSplitFaceMode()   = 1;
+    aFix.FixOrientationMode() = 1;
+    aFix.Perform();
+    const TopoDS_Shape aFixed  = aFix.Result();
+    bool               isValid = true;
+    for (TopExp_Explorer anExp(aFixed, TopAbs_FACE); anExp.More() && isValid; anExp.Next())
+    {
+      isValid = BRepCheck_Analyzer(anExp.Current()).IsValid();
+    }
+    if (isValid)
+    {
+      aReShape->Replace(aFace, aFixed);
+      isChanged = true;
+    }
+  }
+  return isChanged ? aReShape->Apply(theShape) : theShape;
+}
