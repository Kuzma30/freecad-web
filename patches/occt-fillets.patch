+// A straight B-spline of degree 1 from theP1 at theT1 to theP2 at theT2.
+occ::handle<Geom_BSplineCurve> makeLine3d(const gp_Pnt& theP1,
+                                          const gp_Pnt& theP2,
+                                          const double  theT1,
+                                          const double  theT2)
+{
+  NCollection_Array1<gp_Pnt> aPoles(1, 2);
+  aPoles(1) = theP1;
+  aPoles(2) = theP2;
+  NCollection_Array1<double> aKnots(1, 2);
+  aKnots(1) = theT1;
+  aKnots(2) = theT2;
+  NCollection_Array1<int> aMults(1, 2);
+  aMults.Init(2);
+  return new Geom_BSplineCurve(aPoles, aKnots, aMults, 1);
+}
+
+occ::handle<Geom2d_BSplineCurve> makeLine2d(const gp_Pnt2d& theP1,
+                                            const gp_Pnt2d& theP2,
+                                            const double    theT1,
+                                            const double    theT2)
+{
+  NCollection_Array1<gp_Pnt2d> aPoles(1, 2);
+  aPoles(1) = theP1;
+  aPoles(2) = theP2;
+  NCollection_Array1<double> aKnots(1, 2);
+  aKnots(1) = theT1;
+  aKnots(2) = theT2;
+  NCollection_Array1<int> aMults(1, 2);
+  aMults.Init(2);
+  return new Geom2d_BSplineCurve(aPoles, aKnots, aMults, 1);
+}
+} // namespace
+
+// Two edges on one B-spline curve, consecutive on a face, are fused. The
+// pcurve of the first one is a B-spline that goes beyond the edge: only the
+// part on the edge may be joined to the pcurve of the second one. Joining
+// the whole curve shifted the parameters of the fused pcurve (the case of
+// a fillet split in two pieces, merged by FreeCAD's refine).
+TEST(BRepLib_FuseEdgesTest, PCurveLongerThanEdge_KeepsPCurveOnEdgeRange)
+{
+  occ::handle<Geom_Plane> aPlane = new Geom_Plane(gp_Pln());
+  // x = t along the bottom side, t in [-1, 2]; the edges are [0, 1] and [1, 2].
+  occ::handle<Geom_BSplineCurve> aCurve =
+    makeLine3d(gp_Pnt(-1., 0., 0.), gp_Pnt(2., 0., 0.), -1., 2.);
+  // The pcurve of the first edge starts at t = -1, the one of the second at t = 1.
+  occ::handle<Geom2d_BSplineCurve> aPc1 = makeLine2d(gp_Pnt2d(-1., 0.), gp_Pnt2d(1., 0.), -1., 1.);
+  occ::handle<Geom2d_BSplineCurve> aPc2 = makeLine2d(gp_Pnt2d(1., 0.), gp_Pnt2d(2., 0.), 1., 2.);
+
+  const TopoDS_Vertex aV0 = BRepBuilderAPI_MakeVertex(gp_Pnt(0., 0., 0.));
+  const TopoDS_Vertex aV1 = BRepBuilderAPI_MakeVertex(gp_Pnt(1., 0., 0.));
+  const TopoDS_Vertex aV2 = BRepBuilderAPI_MakeVertex(gp_Pnt(2., 0., 0.));
+  const TopoDS_Vertex aV3 = BRepBuilderAPI_MakeVertex(gp_Pnt(2., 1., 0.));
+  const TopoDS_Vertex aV4 = BRepBuilderAPI_MakeVertex(gp_Pnt(0., 1., 0.));
+
+  BRep_Builder aBB;
+  TopoDS_Edge  anE1 = BRepBuilderAPI_MakeEdge(aCurve, aV0, aV1, 0., 1.);
+  TopoDS_Edge  anE2 = BRepBuilderAPI_MakeEdge(aCurve, aV1, aV2, 1., 2.);
+  aBB.UpdateEdge(anE1, aPc1, aPlane, TopLoc_Location(), Precision::Confusion());
+  aBB.UpdateEdge(anE2, aPc2, aPlane, TopLoc_Location(), Precision::Confusion());
+
+  BRepBuilderAPI_MakeWire aMW;
+  aMW.Add(anE1);
+  aMW.Add(anE2);
+  aMW.Add(BRepBuilderAPI_MakeEdge(aV2, aV3));
+  aMW.Add(BRepBuilderAPI_MakeEdge(aV3, aV4));
+  aMW.Add(BRepBuilderAPI_MakeEdge(aV4, aV0));
+  ASSERT_TRUE(aMW.IsDone());
+  const TopoDS_Face aFace = BRepBuilderAPI_MakeFace(aPlane, aMW.Wire());
+  ASSERT_TRUE(BRepCheck_Analyzer(aFace).IsValid());
+
+  BRepLib_FuseEdges  aFuse(aFace);
+  const TopoDS_Shape aResult = aFuse.Shape();
+  ASSERT_FALSE(aResult.IsNull());
+  int aNbEdges = 0;
+  for (TopExp_Explorer anExp(aResult, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    ++aNbEdges;
+  }
+  EXPECT_EQ(aNbEdges, 4);
+  EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid());
+
+  // The fused edge: its pcurve follows its 3D curve.
+  const TopoDS_Face aNewFace = TopoDS::Face(TopExp_Explorer(aResult, TopAbs_FACE).Current());
+  bool              isFound  = false;
+  for (TopExp_Explorer anExp(aNewFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Edge&            anE = TopoDS::Edge(anExp.Current());
+    double                        aF, aL;
+    const occ::handle<Geom_Curve> aC3d = BRep_Tool::Curve(anE, aF, aL);
+    if (aC3d.IsNull() || aC3d->Value(aF).Distance(aC3d->Value(aL)) < 1.5)
+    {
+      continue;
+    }
+    isFound = true;
+    double                          aPF, aPL;
+    const occ::handle<Geom2d_Curve> aPc = BRep_Tool::CurveOnSurface(anE, aNewFace, aPF, aPL);
+    ASSERT_FALSE(aPc.IsNull());
+    double aDev = 0.;
+    for (int i = 0; i <= 20; ++i)
+    {
+      const double   aT  = aF + (aL - aF) * i / 20.;
+      const gp_Pnt2d aUV = aPc->Value(aT);
+      aDev = std::max(aDev, aC3d->Value(aT).Distance(aPlane->Value(aUV.X(), aUV.Y())));
+    }
+    EXPECT_LT(aDev, 1.e-7);
+    EXPECT_LT(BRep_Tool::Tolerance(anE), 1.e-4);
+  }
+  EXPECT_TRUE(isFound);
+}
