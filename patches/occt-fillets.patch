+// Near y = 50 the fillet is higher than the quarter disc it rests on. The end
+// of the fillet was intersected with the revolved cylinder, which only touches
+// it; the degenerated curve was kept with a tolerance of tens of millimeters,
+// and the added volume was ten times too large.
+TEST(BRepFilletAPI_MakeFilletTest, PastShrinkingSupportFace_KeepsAddedVolume)
+{
+  const TopoDS_Shape                  aShape  = MakeQuarterRevolveOnBox();
+  const NCollection_List<TopoDS_Edge> anEdges = RevolveFootEdges(aShape, false);
+  ASSERT_EQ(anEdges.Extent(), 2);
+
+  GProp_GProps aBaseProps;
+  BRepGProp::VolumeProperties(aShape, aBaseProps);
+  for (const TopoDS_Edge& anEdge : anEdges)
+  {
+    BRepFilletAPI_MakeFillet aFillet(aShape);
+    aFillet.Add(15.0, anEdge);
+    aFillet.Build();
+    ASSERT_TRUE(aFillet.IsDone());
+    EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+    EXPECT_LT(MaxVertexTolerance(aFillet.Shape()), 5.0);
+
+    // About (1 - pi/4) * 15^2 * 50 = 2414 mm3 is added along the edge.
+    GProp_GProps aProps;
+    BRepGProp::VolumeProperties(aFillet.Shape(), aProps);
+    const double anAdded = aProps.Mass() - aBaseProps.Mass();
+    EXPECT_GT(anAdded, 1500.0);
+    EXPECT_LT(anAdded, 2700.0);
+  }
+}
