diff --git a/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_rim_after_corner b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_rim_after_corner
new file mode 100644
index 00000000..58c92dbd
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_rounded_cube_square_hole_rim_after_corner
@@ -0,0 +1,41 @@
+puts "============"
+puts "Modeling Algorithms - Fillet of a rim of a square hole around a filleted corner of the hole"
+puts "(FreeCAD issue 20085: cube 20 with fillets of radius 6, square hole 8 x 8)"
+puts "============"
+puts ""
+
+# A vertical (concave) edge of the hole and the two upper edges at it are
+# filleted first (Fillet001 in FreeCAD), then a lower edge of the hole next to
+# that vertical edge (Fillet002). The spine of the second fillet goes on along
+# the edge of the first one at the bottom of the hole and along the next lower
+# edge: the fillet goes round the corner of the hole. At its ends it crosses
+# several faces on the other edges of its spine, and its ends were taken for
+# ends crossing smooth edges and closed by plates (tolerance 9.5).
+restore [locate_data_file freecad20085_rounded_cube_pocket.brep] b
+explode b E
+
+foreach {r tol vol} {1 2.4e-4 5150.26 2 1.5e-4 5117.77} {
+  blend r1 b $r b_26 $r b_13 $r b_35
+
+  # the lower edge on the wall y = -4, shortened by the first fillet
+  set e2 ""
+  foreach e [explode r1 E] {
+    set bb [bounding $e]
+    if {abs([lindex $bb 1] + 4.) < 1.e-3 && abs([lindex $bb 4] + 4.) < 1.e-3
+        && abs([lindex $bb 2] + 10.) < 1.e-3 && abs([lindex $bb 5] + 10.) < 1.e-3
+        && [lindex $bb 3] - [lindex $bb 0] > 4.} {
+      set e2 $e
+    }
+  }
+  if {$e2 == ""} {
+    puts "Error: r = $r, the lower edge is not found"
+    continue
+  }
+  blend result r1 $r $e2
+
+  checkshape result
+  # the tolerance is the one of the first fillets, where the upper ones go
+  # round the end of the vertical one
+  checkmaxtol result -ref $tol
+  checkprops result -v $vol
+}
