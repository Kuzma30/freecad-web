+//=================================================================================================
+
+static bool StillBallData(TopOpeBRepDS_DataStructure&             theDS,
+                          const occ::handle<ChFiDS_SurfData>&     theData,
+                          const occ::handle<BRepBlend_Line>&      theLin,
+                          const occ::handle<BRepAdaptor_Surface>& theS1,
+                          const occ::handle<BRepAdaptor_Surface>& theS2,
+                          const TopAbs_Orientation                theOr,
+                          const double                            theR,
+                          const bool                              theIsGiven,
+                          const double                            theTol3d)
+{
+  // The walking of a ball which stays still (nested into a fillet
+  // of the same radius: its contact on a face does not move) can
+  // not be approximated, the trace on that face is a point. The
+  // surfdata is a part of the sphere of the ball, twisted on that
+  // side to be bounded by its neighbors (see PerformSetOfKGen).
+  const int aNb = theLin->NbPoints();
+  if (aNb < 4 || theIsGiven || theS1.IsNull() || theS2.IsNull())
+  {
+    return false;
+  }
+  int anApexSide = 0;
+  for (int aSide = 1; aSide <= 2 && anApexSide == 0; ++aSide)
+  {
+    const gp_Pnt& aP0   = aSide == 1 ? theLin->Point(1).PointOnS1() : theLin->Point(1).PointOnS2();
+    double        aDist = 0.;
+    for (int k = 2; k <= aNb; ++k)
+    {
+      aDist = std::max(
+        aDist,
+        aP0.Distance(aSide == 1 ? theLin->Point(k).PointOnS1() : theLin->Point(k).PointOnS2()));
+    }
+    if (aDist < theTol3d)
+    {
+      anApexSide = aSide;
+    }
+  }
+  if (anApexSide == 0)
+  {
+    return false;
+  }
+  const occ::handle<BRepAdaptor_Surface>& aSApex  = anApexSide == 1 ? theS1 : theS2;
+  const occ::handle<BRepAdaptor_Surface>& aSTrace = anApexSide == 1 ? theS2 : theS1;
+  double                                  aU, aV;
+  if (anApexSide == 1)
+  {
+    theLin->Point(1).ParametersOnS1(aU, aV);
+  }
+  else
+  {
+    theLin->Point(1).ParametersOnS2(aU, aV);
+  }
+  gp_Pnt anApex;
+  gp_Vec aDu, aDv;
+  aSApex->D1(aU, aV, anApex, aDu, aDv);
+  const gp_Vec anApexNormal = aDu.Crossed(aDv);
+
+  // The trace on the other face, through points of the walking.
+  const int                      aNbSample = std::min(aNb, 60);
+  NCollection_Sequence<gp_Pnt2d> aUVSeq;
+  NCollection_Sequence<double>   aWSeq;
+  for (int j = 0; j < aNbSample; ++j)
+  {
+    const int          k  = 1 + (int)std::lround(double(aNb - 1) * j / (aNbSample - 1));
+    const Blend_Point& aP = theLin->Point(k);
+    if (!aWSeq.IsEmpty() && aP.Parameter() <= aWSeq.Last() + Precision::PConfusion())
+    {
+      continue;
+    }
+    if (anApexSide == 1)
+    {
+      aP.ParametersOnS2(aU, aV);
+    }
+    else
+    {
+      aP.ParametersOnS1(aU, aV);
+    }
+    aUVSeq.Append(gp_Pnt2d(aU, aV));
+    aWSeq.Append(aP.Parameter());
+  }
+  if (aWSeq.Length() < 4)
+  {
+    return false;
+  }
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aUVs =
+    new NCollection_HArray1<gp_Pnt2d>(1, aWSeq.Length());
+  occ::handle<NCollection_HArray1<double>> aWs = new NCollection_HArray1<double>(1, aWSeq.Length());
+  for (int j = 1; j <= aWSeq.Length(); ++j)
+  {
+    aUVs->SetValue(j, aUVSeq(j));
+    aWs->SetValue(j, aWSeq(j));
+  }
+  Geom2dAPI_Interpolate anInt(aUVs, aWs, false, Precision::PConfusion());
+  anInt.Perform();
+  if (!anInt.IsDone())
+  {
+    return false;
+  }
+  const occ::handle<Geom2d_Curve> aPC(anInt.Curve());
+  const double                    aW1 = aWSeq.First(), aW2 = aWSeq.Last();
+  if (!ChFi3d_SphereData(theDS,
+                         theData,
+                         anApex,
+                         anApexNormal,
+                         theR,
+                         anApexSide,
+                         aSTrace,
+                         aPC,
+                         aW1,
+                         aW2,
+                         theTol3d))
+  {
+    return false;
+  }
+
+  // The transitions are the ones of the walking, the orientation is the one
+  // of the face S1 to the fillet, as by StoreData.
+  theData->ChangeInterferenceOnS1().SetTransition(ChFi3d_TrsfTrans(theLin->TransitionOnS1()));
+  theData->ChangeInterferenceOnS2().SetTransition(ChFi3d_TrsfTrans(theLin->TransitionOnS2()));
+  const occ::handle<Geom_Surface>& aSurf = theDS.Surface(theData->Surf()).Surface();
+  const double                     aWm   = 0.5 * (aW1 + aW2);
+  gp_Pnt2d                         aUVS1;
+  gp_Pnt2d                         aUVFil = theData->InterferenceOnS1().PCurveOnSurf()->Value(aWm);
+  if (anApexSide == 1)
+  {
+    // Next to the pole.
+    double aU1, aV1;
+    theLin->Point(1).ParametersOnS1(aU1, aV1);
+    aUVS1 = gp_Pnt2d(aU1, aV1);
+    aUVFil.SetY(aUVFil.Y() + 1.e-3);
+  }
+  else
+  {
+    aUVS1 = aPC->Value(aWm);
+  }
+  gp_Pnt aP;
+  theS1->D1(aUVS1.X(), aUVS1.Y(), aP, aDu, aDv);
+  gp_Vec aN1 = aDu.Crossed(aDv);
+  if (theOr == TopAbs_REVERSED)
+  {
+    aN1.Reverse();
+  }
+  aSurf->D1(aUVFil.X(), aUVFil.Y(), aP, aDu, aDv);
+  theData->ChangeOrientation() = aN1.Dot(aDu.Crossed(aDv)) > 0. ? TopAbs_FORWARD : TopAbs_REVERSED;
+
+  const double aTol1 = theDS.Curve(theData->InterferenceOnS1().LineIndex()).Tolerance();
