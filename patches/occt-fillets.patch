+// The context of the function.
+struct ConstRadInvData
+{
+  const occ::handle<Adaptor3d_Surface>& surf1;
+  const occ::handle<Adaptor3d_Surface>& surf2;
+  const occ::handle<Adaptor3d_Curve>&   curv;
