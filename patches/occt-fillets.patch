diff --git a/tests/bugs/modalg_8/fillet_wall_profile_sphere_at_root b/tests/bugs/modalg_8/fillet_wall_profile_sphere_at_root
new file mode 100644
index 00000000..72ee9fec
--- /dev/null
+++ b/tests/bugs/modalg_8/fillet_wall_profile_sphere_at_root
@@ -0,0 +1,36 @@
+puts "============"
+puts "Modeling Algorithms - Fillet of the start wall of a thread over the fillet of its root"
+puts "(FreeCAD screw: fillets of the crests of radius 2, fillet of the wall of radius 1)"
+puts "============"
+puts ""
+
+# A ball of the radius of the fillet of the root (1) stays still in it,
+# touching the wall at one point: the walking can not be approximated there.
+# That part of the fillet is the sphere of the ball, as SolidWorks makes it
+# (center (-6.3705, 1, 41.7026)), with its pole at the point on the wall,
+# between the fillets of the two flanks.
+restore [locate_data_file freecad_screw_wall_profile_crest2.brep] b
+explode b E
+
+blend result b 1 b_95
+
+checkshape result
+checkmaxtol result -ref 1.83e-4
+checkprops result -v 8684.69 -s 2997.19
+
+set nbsph 0
+foreach f [explode result F] {
+  mksurface s $f
+  set d [dump s]
+  if {[regexp {SphericalSurface} $d]} {
+    incr nbsph
+    regexp {Center :([-0-9.e]+), ([-0-9.e]+), ([-0-9.e]+)} $d full x y z
+    regexp {Radius :([-0-9.e]+)} $d full r
+    if {abs($x + 6.3705) > 1.e-3 || abs($y - 1.) > 1.e-3 || abs($z - 41.7026) > 1.e-3 || abs($r - 1.) > 1.e-7} {
+      puts "Error: the sphere is ($x $y $z) R=$r instead of (-6.3705 1 41.7026) R=1"
+    }
+  }
+}
+if {$nbsph != 1} {
+  puts "Error: $nbsph spherical faces instead of 1"
+}
