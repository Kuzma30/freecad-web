+}
+
+//=================================================================================================
+
+bool ChFi3d_SphereData(TopOpeBRepDS_DataStructure&           theDS,
+                       const occ::handle<ChFiDS_SurfData>&   theData,
+                       const gp_Pnt&                         theApex,
+                       const gp_Vec&                         theApexNormal,
+                       const double                          theR,
+                       const int                             theApexSide,
+                       const occ::handle<Adaptor3d_Surface>& theS,
+                       const occ::handle<Geom2d_Curve>&      thePC,
+                       const double                          theFirst,
+                       const double                          theLast,
+                       const double                          theTol3d)
+{
+  if (thePC.IsNull() || theR <= Precision::Confusion() || theLast - theFirst <= 0.
+      || theApexNormal.Magnitude() < Precision::Confusion())
+  {
+    return false;
+  }
+  const int                  aNb = 40;
+  NCollection_Array1<gp_Pnt> aPnts(0, aNb);
+  NCollection_Array1<double> aPars(0, aNb);
+  for (int i = 0; i <= aNb; ++i)
+  {
+    aPars(i)           = theFirst + (theLast - theFirst) * i / aNb;
+    const gp_Pnt2d aUV = thePC->Value(aPars(i));
+    aPnts(i)           = theS->Value(aUV.X(), aUV.Y());
+  }
+  // The center is on the normal to the face at the apex, towards the trace.
+  gp_Vec aN = theApexNormal.Normalized();
+  if (gp_Vec(theApex, aPnts(aNb / 2)).Dot(aN) < 0.)
+  {
+    aN.Reverse();
+  }
+  const gp_Pnt aC   = theApex.Translated(theR * aN);
+  double       aDev = 0.;
+  for (int i = 0; i <= aNb; ++i)
+  {
+    aDev = std::max(aDev, std::abs(aC.Distance(aPnts(i)) - theR));
+  }
+  if (aDev > std::max(10. * theTol3d, 1.e-3 * theR))
+  {
+    return false;
+  }
+
+  // The pole of the sphere (v = -pi/2 on the side 1, pi/2 on the side 2) is
+  // the apex, the origin of the longitude is in the middle of the trace.
+  const gp_Dir aZ = theApexSide == 1 ? gp_Dir(aN) : gp_Dir(aN.Reversed());
+  gp_Vec       aX(aC, aPnts(aNb / 2));
+  aX -= aX.Dot(gp_Vec(aZ)) * gp_Vec(aZ);
+  if (aX.Magnitude() < 1.e-3 * theR)
+  {
+    return false;
+  }
+  gp_Ax3     anAx(aC, aZ, gp_Dir(aX));
+  const auto aParams = [&](const gp_Pnt& theP) {
+    double aU, aV;
+    ElSLib::SphereParameters(anAx, theR, theP, aU, aV);
+    return gp_Pnt2d(aU > M_PI ? aU - 2. * M_PI : aU, aV);
+  };
+  // The longitude grows along the trace.
+  if (aParams(aPnts(aNb)).X() < aParams(aPnts(0)).X())
+  {
+    anAx.YReverse();
+  }
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aUVs   = new NCollection_HArray1<gp_Pnt2d>(1, aNb + 1);
+  occ::handle<NCollection_HArray1<gp_Pnt>>   aXYZs  = new NCollection_HArray1<gp_Pnt>(1, aNb + 1);
+  occ::handle<NCollection_HArray1<double>>   aTs    = new NCollection_HArray1<double>(1, aNb + 1);
+  double                                     aUPrev = -M_PI;
+  for (int i = 0; i <= aNb; ++i)
+  {
+    const gp_Pnt2d aUV = aParams(aPnts(i));
+    if (aUV.X() <= aUPrev || std::abs(aUV.Y()) > 0.5 * M_PI - 1.e-3)
+    {
+      return false;
+    }
+    aUPrev = aUV.X();
+    aUVs->SetValue(i + 1, aUV);
+    aXYZs->SetValue(i + 1, aPnts(i));
+    aTs->SetValue(i + 1, aPars(i));
+  }
+  Geom2dAPI_Interpolate anInt2d(aUVs, aTs, false, Precision::PConfusion());
+  anInt2d.Perform();
+  GeomAPI_Interpolate anInt3d(aXYZs, aTs, false, Precision::Confusion());
+  anInt3d.Perform();
+  if (!anInt2d.IsDone() || !anInt3d.IsDone())
+  {
+    return false;
+  }
+  const occ::handle<Geom2d_Curve>          aPCOnSph(anInt2d.Curve());
+  const occ::handle<Geom_Curve>            aCrv(anInt3d.Curve());
+  const occ::handle<Geom_SphericalSurface> aSph = new Geom_SphericalSurface(anAx, theR);
+  double                                   aTol = 0.;
+  for (int i = 0; i <= 4 * aNb; ++i)
+  {
+    const double   aT  = theFirst + (theLast - theFirst) * i / (4 * aNb);
+    const gp_Pnt2d aUV = thePC->Value(aT);
+    const gp_Pnt2d aSt = aPCOnSph->Value(aT);
+    const gp_Pnt   aP  = aCrv->Value(aT);
+    aTol               = std::max(aTol, aP.Distance(theS->Value(aUV.X(), aUV.Y())));
+    aTol               = std::max(aTol, aP.Distance(aSph->Value(aSt.X(), aSt.Y())));
+  }
+  aTol = std::max(1.5 * aTol, Precision::Confusion());
+
+  theData->ChangeSurf(theDS.AddSurface(TopOpeBRepDS_Surface(aSph, theTol3d)));
+  const int    aTrSide = 3 - theApexSide;
+  const double aVPole  = theApexSide == 1 ? -0.5 * M_PI : 0.5 * M_PI;
+  const gp_Pnt aPole   = aSph->Value(0., aVPole);
+  theData->ChangeVertex(true, theApexSide).SetPoint(aPole);
+  theData->ChangeVertex(false, theApexSide).SetPoint(aPole);
+  theData->ChangeVertex(true, aTrSide).SetPoint(aCrv->Value(theFirst));
+  theData->ChangeVertex(false, aTrSide).SetPoint(aCrv->Value(theLast));
+
+  // The apex side: the pole, from the first meridian to the last one.
+  NCollection_Array1<gp_Pnt2d> aPolePoles(1, 2);
+  aPolePoles(1) = gp_Pnt2d(aPCOnSph->Value(theFirst).X(), aVPole);
+  aPolePoles(2) = gp_Pnt2d(aPCOnSph->Value(theLast).X(), aVPole);
+  NCollection_Array1<double> aKnots(1, 2);
+  aKnots(1) = theFirst;
+  aKnots(2) = theLast;
+  NCollection_Array1<int> aMults(1, 2);
+  aMults.Init(2);
+  const occ::handle<Geom2d_Curve> aPCPole = new Geom2d_BSplineCurve(aPolePoles, aKnots, aMults, 1);
+  ChFiDS_FaceInterference&        aFiPole = theData->ChangeInterference(theApexSide);
+  aFiPole.SetFirstParameter(theFirst);
+  aFiPole.SetLastParameter(theLast);
+  aFiPole.SetInterference(theDS.AddCurve(TopOpeBRepDS_Curve(occ::handle<Geom_Curve>(), aTol)),
+                          TopAbs_FORWARD,
+                          occ::handle<Geom2d_Curve>(),
+                          aPCPole);
+
+  // The trace side.
+  ChFiDS_FaceInterference& aFi = theData->ChangeInterference(aTrSide);
+  aFi.SetFirstParameter(theFirst);
+  aFi.SetLastParameter(theLast);
+  aFi.SetInterference(theDS.AddCurve(TopOpeBRepDS_Curve(aCrv, aTol)),
+                      TopAbs_FORWARD,
+                      new Geom2d_TrimmedCurve(thePC, theFirst, theLast),
+                      aPCOnSph);
+  return true;
+}
