 //=================================================================================================
 
+static double SectionChord(const Blend_Point& thePnt)
+{
+  // The walking may go on past the ends of the spine, over the
+  // extrapolated faces. When these faces diverge, the section
+  // opens up towards a half circle and the line can no longer be
+  // approximated. Cut the extension at the point where the chord
+  // of the section starts to move away from its value at the end
+  // of the spine.
+  return thePnt.PointOnS1().Distance(thePnt.PointOnS2());
+}
+
+static bool TrimDegeneratedExtension(const occ::handle<BRepBlend_Line>& theLine,
+                                     const double                       theSpFirst,
+                                     const double                       theSpLast,
+                                     bool&                              theTrimmedFirst,
+                                     bool&                              theTrimmedLast)
+{
+  theTrimmedFirst = theTrimmedLast = false;
+  const double aMaxDrift           = 0.1; // relative change of the chord
+  const double aTol                = Precision::PConfusion();
+  bool         isTrimmed           = false;
+  double       aU, aV;
+
+  int aNb = theLine->NbPoints();
+  if (aNb > 3 && theLine->Point(1).Parameter() < theSpFirst - aTol)
+  {
+    int anIn = 1;
+    while (anIn < aNb && theLine->Point(anIn).Parameter() < theSpFirst - aTol)
+    {
+      anIn++;
+    }
+    const double aRef  = SectionChord(theLine->Point(anIn));
+    int          aKeep = aRef > Precision::Confusion() ? anIn : 1;
+    while (aKeep > 1
+           && std::abs(SectionChord(theLine->Point(aKeep - 1)) - aRef) <= aMaxDrift * aRef)
+    {
+      aKeep--;
+    }
+    if (aKeep > 1 && aNb - aKeep >= 2)
+    {
+      theLine->Remove(1, aKeep - 1);
+      const Blend_Point&  aP = theLine->Point(1);
+      BRepBlend_Extremity anExt1, anExt2;
+      aP.ParametersOnS1(aU, aV);
+      anExt1.SetValue(aP.PointOnS1(), aU, aV, Precision::Confusion());
+      aP.ParametersOnS2(aU, aV);
+      anExt2.SetValue(aP.PointOnS2(), aU, aV, Precision::Confusion());
+      theLine->SetStartPoints(anExt1, anExt2);
+      isTrimmed = theTrimmedFirst = true;
+    }
+  }
+
+  aNb = theLine->NbPoints();
+  if (aNb > 3 && theLine->Point(aNb).Parameter() > theSpLast + aTol)
+  {
+    int anIn = aNb;
+    while (anIn > 1 && theLine->Point(anIn).Parameter() > theSpLast + aTol)
+    {
+      anIn--;
+    }
+    const double aRef  = SectionChord(theLine->Point(anIn));
+    int          aKeep = aRef > Precision::Confusion() ? anIn : aNb;
+    while (aKeep < aNb
+           && std::abs(SectionChord(theLine->Point(aKeep + 1)) - aRef) <= aMaxDrift * aRef)
+    {
+      aKeep++;
+    }
+    if (aKeep < aNb && aKeep >= 3)
+    {
+      theLine->Remove(aKeep + 1, aNb);
+      const Blend_Point&  aP = theLine->Point(aKeep);
+      BRepBlend_Extremity anExt1, anExt2;
+      aP.ParametersOnS1(aU, aV);
+      anExt1.SetValue(aP.PointOnS1(), aU, aV, Precision::Confusion());
+      aP.ParametersOnS2(aU, aV);
+      anExt2.SetValue(aP.PointOnS2(), aU, aV, Precision::Confusion());
+      theLine->SetEndPoints(anExt1, anExt2);
+      isTrimmed = theTrimmedLast = true;
+    }
+  }
+  return isTrimmed;
+}
