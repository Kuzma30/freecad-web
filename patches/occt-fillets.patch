+//! Computes the batten of CalculBatten on a sphere in the parameters of the
+//! sphere whose axis goes through the vertex of the corner, so that the
+//! boundary of the corner does not depend on the axis of the sphere of the
+//! face (two corners of a shape, symmetric to each other, get the same
+//! boundaries). Falls back to CalculBatten on another surface or if the
+//! result leaves the face.
+//! @param[in] theVertex the vertex of the corner
+//! The other parameters are those of CalculBatten.
+static void CalculBattenOnSphere(const occ::handle<GeomAdaptor_Surface>& ASurf,
+                                 const TopoDS_Face&                      Face,
+                                 const double                            xdir,
+                                 const double                            ydir,
+                                 const gp_Pnt2d&                         p2d1,
+                                 const gp_Pnt2d&                         p2d2,
+                                 const bool                              contraint1,
+                                 const bool                              contraint2,
+                                 occ::handle<Geom2d_Curve>&              curv2d1,
+                                 occ::handle<Geom2d_Curve>&              curv2d2,
+                                 const double                            picicplus,
+                                 const double                            picplusic,
+                                 const bool                              inverseic,
+                                 const bool                              inverseicplus,
+                                 const gp_Pnt&                           theVertex,
+                                 occ::handle<Geom2d_Curve>&              pcurve)
+{
+  // The batten is computed in the parameters of the surface: on a sphere it
+  // depends on the axis of the sphere. It is computed for the sphere whose
+  // axis goes through the vertex of the corner, so that the corners of a
+  // shape are the same whatever the axes of their spheres.
+  const gp_Sphere aSph = ASurf->GetType() == GeomAbs_Sphere ? ASurf->Sphere() : gp_Sphere();
+  const gp_Vec    anAxisVec(aSph.Location(), theVertex);
+  if (ASurf->GetType() != GeomAbs_Sphere || anAxisVec.Magnitude() < Precision::Confusion()
+      || gp_Lin(aSph.Position().Axis()).Distance(theVertex) < Precision::Confusion())
+  {
+    CalculBatten(ASurf,
+                 Face,
+                 xdir,
+                 ydir,
+                 p2d1,
+                 p2d2,
+                 contraint1,
+                 contraint2,
+                 curv2d1,
+                 curv2d2,
+                 picicplus,
+                 picplusic,
+                 inverseic,
+                 inverseicplus,
+                 pcurve);
+    return;
+  }
+  const gp_Sphere aFrame(gp_Ax3(aSph.Location(), gp_Dir(anAxisVec)), aSph.Radius());
+  // A point and a tangent of the parameters of the sphere in those of the frame.
+  const auto aToFrame =
+    [&](const gp_Pnt2d& theUV, const gp_Vec2d& theD, gp_Pnt2d& theUVF, gp_Vec2d& theDF) {
+      gp_Pnt aP;
+      gp_Vec aDU, aDV;
+      ElSLib::D1(theUV.X(), theUV.Y(), aSph, aP, aDU, aDV);
+      const gp_Vec aT = aDU * theD.X() + aDV * theD.Y();
+      double       aU = 0., aV = 0.;
+      ElSLib::Parameters(aFrame, aP, aU, aV);
+      theUVF = gp_Pnt2d(aU, aV);
+      gp_Pnt aPF;
+      gp_Vec aDUF, aDVF;
+      ElSLib::D1(aU, aV, aFrame, aPF, aDUF, aDVF);
+      // aT = a * aDUF + b * aDVF (least squares)
+      const double a11 = aDUF.Dot(aDUF), a12 = aDUF.Dot(aDVF), a22 = aDVF.Dot(aDVF);
+      const double b1 = aT.Dot(aDUF), b2 = aT.Dot(aDVF);
+      const double aDet = a11 * a22 - a12 * a12;
+      theDF             = std::abs(aDet) < gp::Resolution()
+                            ? gp_Vec2d()
+                            : gp_Vec2d((b1 * a22 - b2 * a12) / aDet, (a11 * b2 - a12 * b1) / aDet);
+    };
+  gp_Pnt2d aP1, aP2, aQ1, aQ2;
+  gp_Vec2d aT1, aT2, aD1, aD2;
+  curv2d1->D1(picicplus, aP1, aT1);
+  curv2d2->D1(picplusic, aP2, aT2);
+  aToFrame(aP1, aT1, aQ1, aD1);
+  aToFrame(aP2, aT2, aQ2, aD2);
+  gp_Pnt2d aF1, aF2;
+  gp_Vec2d aDummy;
+  aToFrame(p2d1, gp_Vec2d(1., 0.), aF1, aDummy);
+  aToFrame(p2d2, gp_Vec2d(1., 0.), aF2, aDummy);
+  aF2.SetX(ElCLib::InPeriod(aF2.X(), aF1.X() - M_PI, aF1.X() + M_PI));
+  if (aD1.Magnitude() < gp::Resolution() || aD2.Magnitude() < gp::Resolution()
+      || aF1.Distance(aF2) < Precision::PConfusion())
+  {
+    CalculBatten(ASurf,
+                 Face,
+                 xdir,
+                 ydir,
+                 p2d1,
+                 p2d2,
+                 contraint1,
+                 contraint2,
+                 curv2d1,
+                 curv2d2,
+                 picicplus,
+                 picplusic,
+                 inverseic,
+                 inverseicplus,
+                 pcurve);
+    return;
+  }
+  occ::handle<Geom2d_Curve>              aC1 = new Geom2d_Line(aQ1, gp_Dir2d(aD1));
+  occ::handle<Geom2d_Curve>              aC2 = new Geom2d_Line(aQ2, gp_Dir2d(aD2));
+  const occ::handle<GeomAdaptor_Surface> aFrameSurf =
+    new GeomAdaptor_Surface(new Geom_SphericalSurface(gp_Ax3(aFrame.Position()), aFrame.Radius()));
+  occ::handle<Geom2d_Curve> aFrameCurve;
+  CalculBatten(aFrameSurf,
+               Face,
+               aF2.X() - aF1.X(),
+               aF2.Y() - aF1.Y(),
+               aF1,
+               aF2,
+               contraint1,
+               contraint2,
+               aC1,
+               aC2,
+               0.,
+               0.,
+               inverseic,
+               inverseicplus,
+               aFrameCurve,
+               false);
+  // Back to the parameters of the sphere, through points of the curve.
+  constexpr int                              THE_NB = 24;
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aPnts =
+    new NCollection_HArray1<gp_Pnt2d>(1, THE_NB + 1);
+  const double aFirst = aFrameCurve->FirstParameter(), aLast = aFrameCurve->LastParameter();
+  double       aUMin = 0., aUMax = 0., aVMin = 0., aVMax = 0.;
+  BRepTools::UVBounds(Face, aUMin, aUMax, aVMin, aVMax);
+  bool isIn = true;
+  for (int i = 0; i <= THE_NB; ++i)
+  {
+    const gp_Pnt2d aUVF = aFrameCurve->Value(aFirst + (aLast - aFirst) * i / THE_NB);
+    double         aU = 0., aV = 0.;
+    ElSLib::Parameters(aSph, ElSLib::Value(aUVF.X(), aUVF.Y(), aFrame), aU, aV);
+    const double aRef = i == 0 ? p2d1.X() : aPnts->Value(i).X();
+    aU                = ElCLib::InPeriod(aU, aRef - M_PI, aRef + M_PI);
+    aPnts->SetValue(i + 1, gp_Pnt2d(aU, aV));
+    isIn =
+      isIn && aU > aUMin - 1.e-7 && aU < aUMax + 1.e-7 && aV > aVMin - 1.e-7 && aV < aVMax + 1.e-7;
+  }
+  // The ends are the given points.
+  aPnts->SetValue(1, p2d1);
+  aPnts->SetValue(
+    THE_NB + 1,
+    gp_Pnt2d(
+      ElCLib::InPeriod(p2d2.X(), aPnts->Value(THE_NB).X() - M_PI, aPnts->Value(THE_NB).X() + M_PI),
+      p2d2.Y()));
+  Geom2dAPI_Interpolate anInterp(aPnts, false, Precision::PConfusion());
+  anInterp.Perform();
+  if (!isIn || !anInterp.IsDone()
+      || aPnts->Value(THE_NB + 1).Distance(p2d2) > Precision::PConfusion())
+  {
+    CalculBatten(ASurf,
+                 Face,
+                 xdir,
+                 ydir,
+                 p2d1,
+                 p2d2,
+                 contraint1,
+                 contraint2,
+                 curv2d1,
+                 curv2d2,
+                 picicplus,
+                 picplusic,
+                 inverseic,
+                 inverseicplus,
+                 pcurve);
+    return;
+  }
+  pcurve = anInterp.Curve();
+}
