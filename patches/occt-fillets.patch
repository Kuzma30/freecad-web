+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  // The vertical edge at x = 4, y = -4 alone, then with the lower edges on
+  // both sides of it.
+  const gp_Pnt aVertical(4.0, -4.0, 0.0);
+  const gp_Pnt aLower[2] = {gp_Pnt(0.0, -4.0, -10.0), gp_Pnt(4.0, 0.0, -10.0)};
+  for (int aCase = 0; aCase < 2; ++aCase)
+  {
+    const double             aRadius = aCase == 0 ? 2.0 : 1.0;
+    BRepFilletAPI_MakeFillet aFillet(aHoled);
+    for (TopExp_Explorer anExp(aHoled, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      GProp_GProps aProps;
+      BRepGProp::LinearProperties(anExp.Current(), aProps);
+      const gp_Pnt aMid = aProps.CentreOfMass();
+      if (aProps.Mass() > 1.0
+          && (aMid.Distance(aVertical) < 1.e-6
+              || (aCase == 1
+                  && (aMid.Distance(aLower[0]) < 1.e-6 || aMid.Distance(aLower[1]) < 1.e-6))))
+      {
+        aFillet.Add(aRadius, TopoDS::Edge(anExp.Current()));
+      }
+    }
+    ASSERT_EQ(aFillet.NbContours(), aCase == 0 ? 1 : 3);
+    aFillet.Build();
+    ASSERT_TRUE(aFillet.IsDone()) << "case " << aCase;
+    const TopoDS_Shape& aResult = aFillet.Shape();
+    EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid()) << "case " << aCase;
+
+    double aMaxTol = 0.0;
+    for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+    {
+      aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+    }
+    EXPECT_LT(aMaxTol, 1.e-3) << "case " << aCase;
+
+    GProp_GProps aBefore, anAfter;
+    BRepGProp::VolumeProperties(aHoled, aBefore);
+    BRepGProp::VolumeProperties(aResult, anAfter);
+    if (aCase == 0)
+    {
+      // The fillet adds r * r * (1 - pi / 4) * 20.
+      EXPECT_NEAR(anAfter.Mass() - aBefore.Mass(),
+                  aRadius * aRadius * (1.0 - M_PI / 4.0) * 20.0,
+                  1.e-3);
+    }
+    else
+    {
+      // The lower fillets go round the end of the vertical one.
+      EXPECT_NEAR(anAfter.Mass(), 5154.84, 0.05);
+    }
+  }
+}
+
+// The same holed cube with a lower edge of the hole (convex) and the vertical
+// edge next to it (concave) filleted, not the other lower edge at their vertex.
+// The vertex has more edges (smooth edges between the fillets and the spheres of
+// the cube) and the corner was a plate patch with tolerance up to 1.1. The
+// convex fillet ends in the plane of the other wall, the support of the concave
+// one: the corner is filled between the two fillets and that wall.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_ConvexAndConcaveFilletsCorner)
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  // The vertical edge at x = 4, y = -4 with the lower edge on the wall y = -4
+  // or on the wall x = 4: the two results are the same.
+  const gp_Pnt aVertical(4.0, -4.0, 0.0);
+  const gp_Pnt aLower[2]   = {gp_Pnt(0.0, -4.0, -10.0), gp_Pnt(4.0, 0.0, -10.0)};
+  const double aRadii[2]   = {1.0, 2.0};
+  const double aVolumes[2] = {5157.00, 5157.07};
+  for (int r = 0; r < 2; ++r)
+  {
+    for (int aCase = 0; aCase < 2; ++aCase)
+    {
+      BRepFilletAPI_MakeFillet aFillet(aHoled);
+      for (TopExp_Explorer anExp(aHoled, TopAbs_EDGE); anExp.More(); anExp.Next())
+      {
+        GProp_GProps aProps;
+        BRepGProp::LinearProperties(anExp.Current(), aProps);
+        const gp_Pnt aMid = aProps.CentreOfMass();
+        if (aProps.Mass() > 1.0
+            && (aMid.Distance(aVertical) < 1.e-6 || aMid.Distance(aLower[aCase]) < 1.e-6))
+        {
+          aFillet.Add(aRadii[r], TopoDS::Edge(anExp.Current()));
+        }
+      }
+      ASSERT_EQ(aFillet.NbContours(), 2);
+      aFillet.Build();
+      ASSERT_TRUE(aFillet.IsDone()) << "r = " << aRadii[r] << ", case " << aCase;
+      const TopoDS_Shape& aResult = aFillet.Shape();
+      EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid())
+        << "r = " << aRadii[r] << ", case " << aCase;
+
+      double aMaxTol = 0.0;
+      for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+      {
+        aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+      }
+      EXPECT_LT(aMaxTol, 1.e-3) << "r = " << aRadii[r] << ", case " << aCase;
+
+      GProp_GProps aProps;
+      BRepGProp::VolumeProperties(aResult, aProps);
+      EXPECT_NEAR(aProps.Mass(), aVolumes[r], 0.01) << "r = " << aRadii[r] << ", case " << aCase;
+    }
+  }
+}
+
+// The same holed cube with a vertical (concave) edge of the hole filleted, then
+// a lower edge of the hole next to it in a second operation. The spine of the
+// second fillet goes on along the edge of the first one at the bottom of the
+// hole and along the next lower edge: the fillet goes round the corner of the
+// hole. Its ends, where it crosses several faces on the other edges of its
+// spine, were closed by plates with tolerance 9.5.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_RimFilletGoesRoundFilletedCorner)
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  const double aRadii[2]   = {1.0, 2.0};
+  const double aRemoved[2] = {4.5713, 27.2583};
+  for (int r = 0; r < 2; ++r)
+  {
+    // the vertical edge at x = -4, y = -4
+    BRepFilletAPI_MakeFillet aFirst(aHoled);
+    for (TopExp_Explorer anExp(aHoled, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      GProp_GProps aProps;
+      BRepGProp::LinearProperties(anExp.Current(), aProps);
+      if (aProps.CentreOfMass().Distance(gp_Pnt(-4.0, -4.0, 0.0)) < 1.e-6)
+      {
+        aFirst.Add(aRadii[r], TopoDS::Edge(anExp.Current()));
+      }
+    }
+    ASSERT_EQ(aFirst.NbContours(), 1);
+    aFirst.Build();
+    ASSERT_TRUE(aFirst.IsDone());
+    const TopoDS_Shape& aShape1 = aFirst.Shape();
+
+    // the lower edge on the wall y = -4, shortened by the first fillet
+    BRepFilletAPI_MakeFillet aSecond(aShape1);
+    for (TopExp_Explorer anExp(aShape1, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      const TopoDS_Edge& anEdge = TopoDS::Edge(anExp.Current());
+      BRepAdaptor_Curve  aCurve(anEdge);
+      const gp_Pnt       aP1 = aCurve.Value(aCurve.FirstParameter());
+      const gp_Pnt       aP2 = aCurve.Value(aCurve.LastParameter());
+      if (std::abs(aP1.Y() + 4.0) < 1.e-4 && std::abs(aP2.Y() + 4.0) < 1.e-4
+          && std::abs(aP1.Z() + 10.0) < 1.e-4 && std::abs(aP2.Z() + 10.0) < 1.e-4
+          && aP1.Distance(aP2) > 4.0)
+      {
+        aSecond.Add(aRadii[r], anEdge);
+        break;
+      }
+    }
+    ASSERT_EQ(aSecond.NbContours(), 1);
+    aSecond.Build();
+    ASSERT_TRUE(aSecond.IsDone()) << "r = " << aRadii[r];
+    const TopoDS_Shape& aResult = aSecond.Shape();
+    EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid()) << "r = " << aRadii[r];
+
+    double aMaxTol = 0.0;
+    for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+    {
+      aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+    }
+    EXPECT_LT(aMaxTol, 1.e-3) << "r = " << aRadii[r];
+
+    GProp_GProps aBefore, anAfter;
+    BRepGProp::VolumeProperties(aShape1, aBefore);
+    BRepGProp::VolumeProperties(aResult, anAfter);
+    EXPECT_NEAR(aBefore.Mass() - anAfter.Mass(), aRemoved[r], 0.01) << "r = " << aRadii[r];
+  }
+}
+
+// The same holed cube with a vertical (concave) edge of the hole and the two
+// upper (convex) edges at its end filleted together. Their corner was a plate
+// patch with tolerance up to 0.2. The vertical fillet is now computed first and
+// the fillets of the upper edges go round its end: the result is the one of the
+// fillets made in two steps, and the history relates it to the holed cube.
+TEST(BRepFilletAPI_MakeFilletTest, SquareHoleInRoundedCube_ThreeFilletsCornerAsInTwoSteps)
+{
+  const TopoDS_Shape aBox =
+    BRepPrimAPI_MakeBox(gp_Pnt(-10.0, -10.0, -10.0), 20.0, 20.0, 20.0).Shape();
+  BRepFilletAPI_MakeFillet aRound(aBox);
+  for (TopExp_Explorer anExp(aBox, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aRound.Add(6.0, TopoDS::Edge(anExp.Current()));
+  }
+  aRound.Build();
+  ASSERT_TRUE(aRound.IsDone());
+
+  const TopoDS_Shape aTool = BRepPrimAPI_MakeBox(gp_Pnt(-4.0, -4.0, -11.0), 8.0, 8.0, 22.0).Shape();
+  BRepAlgoAPI_Cut    aCut(aRound.Shape(), aTool);
+  ASSERT_TRUE(aCut.IsDone());
+  const TopoDS_Shape& aHoled = aCut.Shape();
+
+  // Returns the edges of theShape longer than 4 whose middle is one of thePoints.
+  const auto aFindEdges = [](const TopoDS_Shape&                 theShape,
+                             const NCollection_Sequence<gp_Pnt>& thePoints) {
+    NCollection_List<TopoDS_Shape>                                anEdges;
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aMap;
+    TopExp::MapShapes(theShape, TopAbs_EDGE, aMap);
+    for (int anIE = 1; anIE <= aMap.Extent(); ++anIE)
+    {
+      GProp_GProps aProps;
+      BRepGProp::LinearProperties(aMap(anIE), aProps);
+      for (int i = 1; i <= thePoints.Length(); ++i)
+      {
+        if (aProps.Mass() > 4.0 && aProps.CentreOfMass().Distance(thePoints(i)) < 0.6)
+        {
+          anEdges.Append(aMap(anIE));
+          break;
+        }
+      }
+    }
+    return anEdges;
+  };
+  const auto aVolume = [](const TopoDS_Shape& theShape) {
+    GProp_GProps aProps;
+    BRepGProp::VolumeProperties(theShape, aProps);
+    return aProps.Mass();
+  };
+  NCollection_Sequence<gp_Pnt> aVertical, anUpper;
+  aVertical.Append(gp_Pnt(-4.0, -4.0, 0.0));
+  anUpper.Append(gp_Pnt(-4.0, 0.0, 10.0));
+  anUpper.Append(gp_Pnt(0.0, -4.0, 10.0));
+  // On the cube after the vertical fillet the upper edges are shorter by r.
+  NCollection_Sequence<gp_Pnt> anUpperShortened;
+
+  const double aRadii[3] = {0.5, 1.0, 2.0};
+  for (int r = 0; r < 3; ++r)
+  {
+    const double aRadius = aRadii[r];
+    anUpperShortened.Clear();
+    anUpperShortened.Append(gp_Pnt(-4.0, 0.5 * aRadius, 10.0));
+    anUpperShortened.Append(gp_Pnt(0.5 * aRadius, -4.0, 10.0));
+
+    // All together.
+    BRepFilletAPI_MakeFillet       aFillet(aHoled);
+    NCollection_List<TopoDS_Shape> anEdges       = aFindEdges(aHoled, aVertical);
+    NCollection_List<TopoDS_Shape> anUpperEdges1 = aFindEdges(aHoled, anUpper);
+    anEdges.Append(anUpperEdges1);
+    ASSERT_EQ(anEdges.Extent(), 3);
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(anEdges); anIt.More(); anIt.Next())
+    {
+      aFillet.Add(aRadius, TopoDS::Edge(anIt.Value()));
+    }
+    ASSERT_EQ(aFillet.NbContours(), 3);
+    aFillet.Build();
+    ASSERT_TRUE(aFillet.IsDone()) << "r = " << aRadius;
+    const TopoDS_Shape& aResult = aFillet.Shape();
+    EXPECT_TRUE(BRepCheck_Analyzer(aResult).IsValid()) << "r = " << aRadius;
+    double aMaxTol = 0.0;
+    for (TopExp_Explorer anExp(aResult, TopAbs_VERTEX); anExp.More(); anExp.Next())
+    {
+      aMaxTol = std::max(aMaxTol, BRep_Tool::Tolerance(TopoDS::Vertex(anExp.Current())));
+    }
+    EXPECT_LT(aMaxTol, 1.e-3) << "r = " << aRadius;
+
+    // In two steps.
+    BRepFilletAPI_MakeFillet aFirst(aHoled);
+    aFirst.Add(aRadius, TopoDS::Edge(aFindEdges(aHoled, aVertical).First()));
+    aFirst.Build();
+    ASSERT_TRUE(aFirst.IsDone());
+    BRepFilletAPI_MakeFillet             aSecond(aFirst.Shape());
+    const NCollection_List<TopoDS_Shape> anUpperEdges =
+      aFindEdges(aFirst.Shape(), anUpperShortened);
+    ASSERT_EQ(anUpperEdges.Extent(), 2) << "r = " << aRadius;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(anUpperEdges); anIt.More(); anIt.Next())
+    {
+      aSecond.Add(aRadius, TopoDS::Edge(anIt.Value()));
+    }
+    aSecond.Build();
+    ASSERT_TRUE(aSecond.IsDone());
+    EXPECT_NEAR(aVolume(aResult), aVolume(aSecond.Shape()), 1.e-6) << "r = " << aRadius;
+
+    // Each face of the result is a face of the holed cube, modified from one or
+    // generated from an edge or a vertex of it.
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anInputs, aTraced;
+    TopExp::MapShapes(aHoled, TopAbs_FACE, anInputs);
+    for (int i = 1; i <= anInputs.Extent(); ++i)
+    {
+      EXPECT_FALSE(aFillet.IsDeleted(anInputs(i)));
+      for (NCollection_List<TopoDS_Shape>::Iterator anIt(aFillet.Modified(anInputs(i)));
+           anIt.More();
+           anIt.Next())
+      {
+        aTraced.Add(anIt.Value());
+      }
+    }
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aSources;
+    TopExp::MapShapes(aHoled, TopAbs_EDGE, aSources);
+    TopExp::MapShapes(aHoled, TopAbs_VERTEX, aSources);
+    for (int i = 1; i <= aSources.Extent(); ++i)
+    {
+      for (NCollection_List<TopoDS_Shape>::Iterator anIt(aFillet.Generated(aSources(i)));
+           anIt.More();
+           anIt.Next())
+      {
+        aTraced.Add(anIt.Value());
+      }
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(anEdges); anIt.More(); anIt.Next())
+    {
+      EXPECT_FALSE(aFillet.Generated(anIt.Value()).IsEmpty()) << "r = " << aRadius;
+    }
+    int aNbUntraced = 0;
+    for (TopExp_Explorer anExp(aResult, TopAbs_FACE); anExp.More(); anExp.Next())
+    {
+      if (!anInputs.Contains(anExp.Current()) && !aTraced.Contains(anExp.Current()))
+      {
+        ++aNbUntraced;
+      }
+    }
+    EXPECT_EQ(aNbUntraced, 0) << "r = " << aRadius;
+  }
+}
