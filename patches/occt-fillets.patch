+  temp.SetXYZ(aMid.XYZ() - ptcur.XYZ());
+  D(1, 2) = dnplan.Dot(temp) - normtgcur;
+  D(1, 3) = nplan.Dot(d1uo) / 2.;
+  D(1, 4) = nplan.Dot(d1vo) / 2.;
+
+  temp.SetLinearForm(v2d.X(), dEuc, v2d.Y(), dEvc);
+  for (int i = 1; i <= 3; ++i)
+  {
+    D(i + 1, 1) = temp.Coord(i);
+    D(i + 1, 2) = 0.; // only the plane depends on the guide
+    D(i + 1, 3) = dEuo.Coord(i);
+    D(i + 1, 4) = dEvo.Coord(i);
+  }
+  return true;
+}
