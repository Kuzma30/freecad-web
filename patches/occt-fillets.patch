+//=================================================================================================
+
+bool ChFi3d_Builder::PerformCapInSectionPlane(const int theIndex)
+{
+  // The fillet stops before the end of its spine, at a vertex Vs where the
+  // spine goes on along a tangent edge on which the ball does not fit (a
+  // fillet made before has left too narrow a face there). Its last section
+  // lies in a plane through Vs, which is the plane of a face Fv of the shape
+  // near the end of the section. The end is closed by Fv extended up to the
+  // section: a planar cap bounded by the section, by the arc of the section
+  // through Vs (on the face Gj beyond that arc) and by the line from Vs to
+  // the other end of the section on the other support Fk of the fillet.
+  if (myVDataMap(theIndex).Extent() != 1)
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&        DStr    = myDS->ChangeDS();
+  const TopoDS_Vertex&               Vtx     = myVDataMap.FindKey(theIndex);
+  occ::handle<ChFiDS_Stripe>         stripe  = myVDataMap(theIndex).First();
+  int                                sens    = 0;
+  const int                          num0    = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool                         isfirst = (sens == 1);
+  const int                          num     = LastSurfDataOnTwoFaces(stripe, num0, isfirst);
+  const occ::handle<ChFiDS_SurfData> Fd      = stripe->SetOfSurfData()->Value(num);
+  if (Fd->IndexOfS1() <= 0 || Fd->IndexOfS2() <= 0)
+  {
+    return false;
+  }
+  const ChFiDS_CommonPoint* aCP[2] = {&Fd->Vertex(isfirst, 1), &Fd->Vertex(isfirst, 2)};
+  const gp_Pnt              aPVtx  = BRep_Tool::Pnt(Vtx);
+  const double              aTol   = 10. * tolapp3d;
+  for (int k = 0; k < 2; ++k)
+  {
+    if (!aCP[k]->IsOnArc() || aCP[k]->Point().Distance(aPVtx) < aTol)
+    {
+      return false;
+    }
+  }
+
+  // The plane of the last section.
+  const occ::handle<Geom_Surface>& aFilSurf = DStr.Surface(Fd->Surf()).Surface();
+  gp_Pnt2d                         aUVSec[2];
+  for (int k = 0; k < 2; ++k)
+  {
+    const ChFiDS_FaceInterference& aFi = Fd->Interference(k + 1);
+    aUVSec[k]                          = aFi.PCurveOnSurf()->Value(aFi.Parameter(isfirst));
+  }
+  const auto aSectionPoint = [&](const double theT) {
+    const gp_XY aUV = aUVSec[0].XY() * (1. - theT) + aUVSec[1].XY() * theT;
+    return aFilSurf->Value(aUV.X(), aUV.Y());
+  };
+  const gp_Pnt aP0 = aCP[0]->Point(), aP1 = aCP[1]->Point(), aPm = aSectionPoint(0.5);
+  const gp_Vec aNormal = gp_Vec(aP0, aP1).Crossed(gp_Vec(aP0, aPm));
+  if (aNormal.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  const gp_Pln aPln(aP0, gp_Dir(aNormal));
+  for (int i = 1; i < 8; ++i)
+  {
+    if (aPln.Distance(aSectionPoint(i / 8.)) > aTol)
+    {
+      return false;
+    }
+  }
+
+  // The side J whose arc goes through Vs, Vs on the plane and on Fk.
+  for (int aJ = 0; aJ < 2; ++aJ)
+  {
+    const int          aK  = 1 - aJ;
+    const TopoDS_Edge& anA = aCP[aJ]->Arc();
+    const TopoDS_Face  aFj = TopoDS::Face(DStr.Shape(Fd->Index(aJ + 1)));
+    const TopoDS_Face  aFk = TopoDS::Face(DStr.Shape(Fd->Index(aK + 1)));
+    if (!myEFMap.Contains(anA))
+    {
+      continue;
+    }
+    TopoDS_Face aGj;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(myEFMap(anA)); anIt.More(); anIt.Next())
+    {
+      if (!anIt.Value().IsSame(aFj))
+      {
+        aGj = TopoDS::Face(anIt.Value());
+      }
+    }
+    const BRepAdaptor_Surface aFkSurf(aFk, false);
+    if (aGj.IsNull() || aGj.IsSame(aFk) || aFkSurf.GetType() != GeomAbs_Plane)
+    {
+      continue;
+    }
+    TopoDS_Vertex aVA[2];
+    TopExp::Vertices(anA, aVA[0], aVA[1]);
+    for (int m = 0; m < 2; ++m)
+    {
+      const TopoDS_Vertex& aVs = aVA[m];
+      if (aVs.IsNull() || aVs.IsSame(Vtx))
+      {
+        continue;
+      }
+      const gp_Pnt aPVs   = BRep_Tool::Pnt(aVs);
+      bool         isOnFk = false;
+      for (TopExp_Explorer anExp(aFk, TopAbs_VERTEX); anExp.More() && !isOnFk; anExp.Next())
+      {
+        isOnFk = anExp.Current().IsSame(aVs);
+      }
+      if (!isOnFk || aPln.Distance(aPVs) > aTol || aPVs.Distance(aCP[aK]->Point()) < aTol)
+      {
+        continue;
+      }
+      // The line from Vs to the end of the section on Fk is on Fk and on the plane.
+      const gp_Vec aSeg(aPVs, aCP[aK]->Point());
+      if (std::abs(aSeg.Dot(aFkSurf.Plane().Axis().Direction())) > aTol
+          || std::abs(aSeg.Dot(aPln.Axis().Direction())) > aTol)
+      {
+        continue;
+      }
+      // The face Fv in the plane of the section, at the end of the section on Fk.
+      TopoDS_Face                    aFv;
+      NCollection_List<TopoDS_Shape> aCandidates;
+      const auto anAddFaces = [&aCandidates](const NCollection_List<TopoDS_Shape>& theFaces) {
+        for (NCollection_List<TopoDS_Shape>::Iterator anIt(theFaces); anIt.More(); anIt.Next())
+        {
+          aCandidates.Append(anIt.Value());
+        }
+      };
+      if (myEFMap.Contains(aCP[aK]->Arc()))
+      {
+        anAddFaces(myEFMap(aCP[aK]->Arc()));
+      }
+      if (aCP[aK]->IsVertex() && myVFMap.Contains(aCP[aK]->Vertex()))
+      {
+        anAddFaces(myVFMap(aCP[aK]->Vertex()));
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator anIt(aCandidates); anIt.More() && aFv.IsNull();
+           anIt.Next())
+      {
+        const TopoDS_Face&        aF = TopoDS::Face(anIt.Value());
+        const BRepAdaptor_Surface aS(aF, false);
+        if (aF.IsSame(aFk) || aF.IsSame(aFj) || aS.GetType() != GeomAbs_Plane)
+        {
+          continue;
+        }
+        const gp_Pln aP = aS.Plane();
+        if (aP.Axis().Direction().IsParallel(aPln.Axis().Direction(), Precision::Angular())
+            && aP.Distance(aPVs) < aTol)
+        {
+          aFv = aF;
+        }
+      }
+      if (aFv.IsNull())
+      {
+        continue;
+      }
+      return CapInSectionPlane(theIndex, aJ + 1, aVs, aGj, TopoDS_Face());
+    }
+  }
+  return false;
+}
+
+//=================================================================================================
+
+bool ChFi3d_Builder::PerformCapInTangentPlane(const int theIndex)
+{
+  // The fillet ends at the end vertex V of its spine, its last section on the
+  // arcs A1 and A2 of its supports through V. The section, A1 and A2 lie in a
+  // plane, and the faces G1 and G2 beyond A1 and A2 are tangent to that plane
+  // along them (a concave edge of a hole whose walls meet the rounded edges
+  // of the shape along their tangent lines: the plane is the face of the shape
+  // removed by the hole). The end is closed by a planar cap in that plane,
+  // bounded by the section and by the arcs from the section to V.
+  if (myVDataMap(theIndex).Extent() != 1)
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&        DStr    = myDS->ChangeDS();
+  const TopoDS_Vertex&               Vtx     = myVDataMap.FindKey(theIndex);
+  occ::handle<ChFiDS_Stripe>         stripe  = myVDataMap(theIndex).First();
+  int                                sens    = 0;
+  const int                          num0    = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool                         isfirst = (sens == 1);
+  const int                          num     = LastSurfDataOnTwoFaces(stripe, num0, isfirst);
+  const occ::handle<ChFiDS_SurfData> Fd      = stripe->SetOfSurfData()->Value(num);
+  if (Fd->IndexOfS1() <= 0 || Fd->IndexOfS2() <= 0)
+  {
+    return false;
+  }
+  const gp_Pnt aPVtx = BRep_Tool::Pnt(Vtx);
+  const double aTol  = 10. * tolapp3d;
+  TopoDS_Face  aG[2];
+  for (int k = 0; k < 2; ++k)
+  {
+    const ChFiDS_CommonPoint& aCP = Fd->Vertex(isfirst, k + 1);
+    if (!aCP.IsOnArc() || aCP.Point().Distance(aPVtx) < aTol || !myEFMap.Contains(aCP.Arc()))
+    {
+      return false;
+    }
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aCP.Arc(), aV1, aV2);
+    if (!aV1.IsSame(Vtx) && !aV2.IsSame(Vtx))
+    {
+      return false;
+    }
+    const TopoDS_Shape& aF = DStr.Shape(Fd->Index(k + 1));
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(myEFMap(aCP.Arc())); anIt.More();
+         anIt.Next())
+    {
+      if (!anIt.Value().IsSame(aF))
+      {
+        aG[k] = TopoDS::Face(anIt.Value());
+      }
+    }
+    if (aG[k].IsNull())
+    {
+      return false;
+    }
+  }
+  if (aG[0].IsSame(aG[1]))
+  {
+    return false;
+  }
+
+  // The plane of the last section, through V.
+  const occ::handle<Geom_Surface>& aFilSurf = DStr.Surface(Fd->Surf()).Surface();
+  gp_Pnt2d                         aUVSec[2];
+  for (int k = 0; k < 2; ++k)
+  {
+    const ChFiDS_FaceInterference& aFi = Fd->Interference(k + 1);
+    aUVSec[k]                          = aFi.PCurveOnSurf()->Value(aFi.Parameter(isfirst));
+  }
+  const auto aSectionPoint = [&](const double theT) {
+    const gp_XY aUV = aUVSec[0].XY() * (1. - theT) + aUVSec[1].XY() * theT;
+    return aFilSurf->Value(aUV.X(), aUV.Y());
+  };
+  const gp_Pnt aP0 = Fd->Vertex(isfirst, 1).Point(), aP1 = Fd->Vertex(isfirst, 2).Point();
+  const gp_Vec aNormal = gp_Vec(aP0, aP1).Crossed(gp_Vec(aP0, aSectionPoint(0.5)));
+  if (aNormal.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  const gp_Pln aPln(aP0, gp_Dir(aNormal));
+  if (aPln.Distance(aPVtx) > aTol)
+  {
+    return false;
+  }
+  for (int i = 1; i < 8; ++i)
+  {
+    if (aPln.Distance(aSectionPoint(i / 8.)) > aTol)
+    {
+      return false;
+    }
+  }
+
+  // The arcs from the section to V lie in the plane, the faces beyond them are
+  // tangent to it.
+  for (int k = 0; k < 2; ++k)
+  {
+    const ChFiDS_CommonPoint& aCP = Fd->Vertex(isfirst, k + 1);
+    const BRepAdaptor_Curve   anArc(aCP.Arc());
+    const double              aTc = aCP.ParameterOnArc();
+    const double              aTv = BRep_Tool::Parameter(Vtx, aCP.Arc());
+    const BRepAdaptor_Surface aGS(aG[k], false);
+    for (int i = 1; i < 8; ++i)
+    {
+      const double aT = aTc + (aTv - aTc) * i / 8.;
+      if (aPln.Distance(anArc.Value(aT)) > aTol)
+      {
+        return false;
+      }
+    }
+    double                          aPF = 0., aPL = 0.;
+    const occ::handle<Geom2d_Curve> aPC = BRep_Tool::CurveOnSurface(aCP.Arc(), aG[k], aPF, aPL);
+    if (aPC.IsNull())
+    {
+      return false;
+    }
+    const gp_Pnt2d aUV = aPC->Value(0.5 * (aTc + aTv));
+    gp_Pnt         aP;
+    gp_Vec         aDU, aDV;
+    aGS.D1(aUV.X(), aUV.Y(), aP, aDU, aDV);
+    const gp_Vec aN = aDU.Crossed(aDV);
+    if (aN.Magnitude() < gp::Resolution() || !aN.IsParallel(gp_Vec(aPln.Axis().Direction()), 1.e-6))
+    {
+      return false;
+    }
+  }
+  return CapInSectionPlane(theIndex, 1, Vtx, aG[0], aG[1]);
+}
+
+//=================================================================================================
+
+bool ChFi3d_Builder::CapInSectionPlane(const int            theIndex,
+                                       const int            theJ,
+                                       const TopoDS_Vertex& theVs,
+                                       const TopoDS_Face&   theGj,
+                                       const TopoDS_Face&   theGk)
+{
+  // See PerformCapInSectionPlane and PerformCapInTangentPlane: everything is
+  // checked, the cap is built as a corner whose surface is the plane of the
+  // section. Its sides are the arc of side J up to Vs (on Gj) and, on side K,
+  // either the arc of side K up to Vs (on Gk, if given) or the line from the
+  // end of the section on Fk to Vs (on Fk); its sections are the last section
+  // of the fillet and the point Vs.
+  TopOpeBRepDS_DataStructure&        DStr    = myDS->ChangeDS();
+  const TopoDS_Vertex&               Vtx     = myVDataMap.FindKey(theIndex);
+  occ::handle<ChFiDS_Stripe>         stripe  = myVDataMap(theIndex).First();
+  int                                sens    = 0;
+  const int                          num0    = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool                         isfirst = (sens == 1);
+  const int                          num     = LastSurfDataOnTwoFaces(stripe, num0, isfirst);
+  const occ::handle<ChFiDS_SurfData> Fd      = stripe->SetOfSurfData()->Value(num);
+  const int                          aK      = 3 - theJ;
+  const ChFiDS_CommonPoint           aCPj    = Fd->Vertex(isfirst, theJ);
+  ChFiDS_CommonPoint                 aCPk    = Fd->Vertex(isfirst, aK);
+  const TopoDS_Face                  aFk     = TopoDS::Face(DStr.Shape(Fd->Index(aK)));
+  const gp_Pnt                       aPVs    = BRep_Tool::Pnt(theVs);
+  const occ::handle<Geom_Surface>    aSk     = BRep_Tool::Surface(aFk);
+
+  // The section, from the point on side 1 to the point on side 2.
+  const ChFiDS_CommonPoint&      aCP1 = Fd->Vertex(isfirst, 1);
+  const ChFiDS_CommonPoint&      aCP2 = Fd->Vertex(isfirst, 2);
+  const ChFiDS_FaceInterference& aFi1 = Fd->Interference(1);
+  const ChFiDS_FaceInterference& aFi2 = Fd->Interference(2);
+  occ::handle<Geom_Curve>        aCSec;
+  occ::handle<Geom2d_Curve>      aPCSecOnFil;
+  double                         aSec1 = 0., aSec2 = 0., aTolSec = tolapp3d;
+  ChFi3d_ComputeArete(aCP1,
+                      aFi1.PCurveOnSurf()->Value(aFi1.Parameter(isfirst)),
+                      aCP2,
+                      aFi2.PCurveOnSurf()->Value(aFi2.Parameter(isfirst)),
+                      DStr.Surface(Fd->Surf()).Surface(),
+                      aCSec,
+                      aPCSecOnFil,
+                      aSec1,
+                      aSec2,
+                      tolapp3d,
+                      tol2d,
+                      aTolSec,
+                      0);
+  if (aCSec.IsNull() || aPCSecOnFil.IsNull())
+  {
+    return false;
+  }
+
+  // The plane of the cap, its normal out of the solid (away from the part of
+  // the spine without fillet).
+  const gp_Pnt aMid = aCSec->Value(0.5 * (aSec1 + aSec2));
+  gp_Vec       aN   = gp_Vec(aCP1.Point(), aCP2.Point()).Crossed(gp_Vec(aCP1.Point(), aMid));
+  if (aN.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Plane> aPlane = new Geom_Plane(gp_Pln(aPVs, gp_Dir(aN)));
+  // The normal of the plane points to the fillet.
+  bool isToFillet = false;
+  {
+    const double   aW0 = aFi1.Parameter(isfirst), aW1 = aFi1.Parameter(!isfirst);
+    const gp_Pnt2d aUVIn = aFi1.PCurveOnSurf()->Value(aW0 + 0.05 * (aW1 - aW0));
+    const gp_Pnt   aPIn  = DStr.Surface(Fd->Surf()).Surface()->Value(aUVIn.X(), aUVIn.Y());
+    isToFillet           = aN.Dot(gp_Vec(aCP1.Point(), aPIn)) > 0.;
+  }
+
+  // The arc of side J (and of side K) from the section to Vs: the point Vs is
+  // the last section.
+  const auto anArcToVs = [&theVs](const ChFiDS_CommonPoint&  theCP,
+                                  const TopoDS_Face&         theG,
+                                  occ::handle<Geom_Curve>&   theC,
+                                  occ::handle<Geom2d_Curve>& thePC) {
+    double                         aF = 0., aL = 0.;
+    const occ::handle<Geom_Curve>& aCurve = BRep_Tool::Curve(theCP.Arc(), aF, aL);
+    const double                   aTc    = theCP.ParameterOnArc();
+    const double                   aTv    = BRep_Tool::Parameter(theVs, theCP.Arc());
+    if (aCurve.IsNull() || std::abs(aTv - aTc) < Precision::PConfusion())
+    {
+      return false;
+    }
+    theC = new Geom_TrimmedCurve(aCurve, std::min(aTc, aTv), std::max(aTc, aTv));
+    if (aTv < aTc)
+    {
+      theC  = theC->Reversed();
+      thePC = GeomProjLib::Curve2d(theC,
+                                   theC->FirstParameter(),
+                                   theC->LastParameter(),
+                                   BRep_Tool::Surface(theG));
+    }
+    else
+    {
+      thePC = BRep_Tool::CurveOnSurface(theCP.Arc(), theG, aF, aL);
+    }
+    return !thePC.IsNull();
+  };
+  // A point of theG next to the middle of thePC, inside theG.
+  const auto anInside = [](const TopoDS_Face&               theG,
+                           const occ::handle<Geom2d_Curve>& thePC,
+                           const double                     theW,
+                           gp_Pnt2d&                        theIn) {
+    gp_Pnt2d aUV;
+    gp_Vec2d aD;
+    thePC->D1(theW, aUV, aD);
+    if (aD.Magnitude() < gp::Resolution())
+    {
+      return false;
+    }
+    aD.Normalize();
+    BRepTopAdaptor_FClass2d aClass(theG, Precision::PConfusion());
+    const gp_Vec2d          aNrm(-aD.Y(), aD.X());
+    theIn = aUV.Translated(aNrm * 1.e-3);
+    if (aClass.Perform(theIn) != TopAbs_IN)
+    {
+      theIn = aUV.Translated(-aNrm * 1.e-3);
+    }
+    return true;
+  };
+  occ::handle<Geom_Curve>   aCArc;
+  occ::handle<Geom2d_Curve> aPCArcOnG;
+  if (!anArcToVs(aCPj, theGj, aCArc, aPCArcOnG))
+  {
+    return false;
+  }
+  const double aArcF = aCArc->FirstParameter(), aArcL = aCArc->LastParameter();
+  // Side K: the arc on Gk, or the line from the end of the section on Fk.
+  occ::handle<Geom_Curve>   aCLine;
+  occ::handle<Geom2d_Curve> aPCLineOnK;
+  double                    aLen = 0.;
+  if (!theGk.IsNull())
+  {
+    if (!anArcToVs(aCPk, theGk, aCLine, aPCLineOnK))
+    {
+      return false;
+    }
+    aCLine = new Geom_TrimmedCurve(aCLine, aCLine->FirstParameter(), aCLine->LastParameter());
+  }
+  else
+  {
+    aLen   = aPVs.Distance(aCPk.Point());
+    aCLine = new Geom_TrimmedCurve(new Geom_Line(aCPk.Point(), gp_Dir(gp_Vec(aCPk.Point(), aPVs))),
+                                   0.,
+                                   aLen);
+    aPCLineOnK = GeomProjLib::Curve2d(aCLine, 0., aLen, aSk);
+  }
+  const double aLineF = aCLine->FirstParameter(), aLineL = aCLine->LastParameter();
+  const occ::handle<Geom2d_Curve> aPCSecOnP  = GeomProjLib::Curve2d(aCSec, aSec1, aSec2, aPlane);
+  const occ::handle<Geom2d_Curve> aPCArcOnP  = GeomProjLib::Curve2d(aCArc, aArcF, aArcL, aPlane);
+  const occ::handle<Geom2d_Curve> aPCLineOnP = GeomProjLib::Curve2d(aCLine, aLineF, aLineL, aPlane);
+  if (aPCSecOnP.IsNull() || aPCArcOnP.IsNull() || aPCLineOnP.IsNull() || aPCLineOnK.IsNull())
+  {
+    return false;
+  }
+
+  // The sides to keep: on Gj (and Gk) the face, on Fk the part beyond the
+  // plane, away from the fillet.
+  gp_Pnt2d anInG, anInK;
+  if (!anInside(theGj, aPCArcOnG, 0.5 * (aArcF + aArcL), anInG))
+  {
+    return false;
+  }
+  if (!theGk.IsNull())
+  {
+    if (!anInside(theGk, aPCLineOnK, 0.5 * (aLineF + aLineL), anInK))
+    {
+      return false;
+    }
+  }
+  else
+  {
+    double aU = 0., aV = 0.;
+    gp_Vec aBeyond(aN);
+    aBeyond.Normalize();
+    if (isToFillet)
+    {
+      aBeyond.Reverse();
+    }
+    const gp_Pnt aInK =
+      gp_Pnt(aPVs.XYZ() * 0.5 + aCPk.Point().XYZ() * 0.5).Translated(aBeyond * (0.1 * aLen));
+    GeomAPI_ProjectPointOnSurf aProjK(aInK, aSk);
+    aProjK.LowerDistanceParameters(aU, aV);
+    anInK.SetCoord(aU, aV);
+  }
+  const TopAbs_Orientation anOrArcG  = OrientationFromSide(aPCArcOnG, anInG);
+  const TopAbs_Orientation anOrLineK = OrientationFromSide(aPCLineOnK, anInK);
+
+  // The edge of the spine filleted up to Vs: the corner ends on Vs as on the
+  // end of a spine made of it, which cuts it there (see ChFi3d_FilDS).
+  TopoDS_Edge anE1;
+  {
+    const occ::handle<ChFiDS_Spine>& aSpine = stripe->Spine();
+    for (int ie = 1; ie <= aSpine->NbEdges() && anE1.IsNull(); ++ie)
+    {
+      const TopoDS_Edge& anE = aSpine->Edges(ie);
+      TopoDS_Vertex      aV1, aV2;
+      TopExp::Vertices(anE, aV1, aV2);
+      if (!aV1.IsSame(theVs) && !aV2.IsSame(theVs))
+      {
+        continue;
+      }
+      bool isOnFk = false, isOnFj = false;
+      for (NCollection_List<TopoDS_Shape>::Iterator anIt(myEFMap(anE)); anIt.More(); anIt.Next())
+      {
+        isOnFk = isOnFk || anIt.Value().IsSame(aFk);
+        isOnFj = isOnFj || anIt.Value().IsSame(DStr.Shape(Fd->Index(theJ)));
+      }
+      if (isOnFk && isOnFj)
+      {
+        anE1 = anE;
+      }
+    }
+  }
+  if (anE1.IsNull())
+  {
+    return false;
+  }
+
+  // Everything is computed: the data structure is changed from here.
+  if (num != num0)
+  {
+    // the surfdatas past the section are removed
+    if (isfirst)
+    {
+      stripe->ChangeSetOfSurfData()->Remove(1, num - 1);
+    }
+    else
+    {
+      stripe->ChangeSetOfSurfData()->Remove(num + 1, stripe->SetOfSurfData()->Length());
+    }
+  }
+  if (aCPk.IsVertex())
+  {
+    // The section ends at a vertex of Fk: no arc is cut there.
+    const TopoDS_Vertex aVk = aCPk.Vertex();
+    const gp_Pnt        aPk = aCPk.Point();
+    const double        aTk = aCPk.Tolerance();
+    ChFiDS_CommonPoint& aCP = Fd->ChangeVertex(isfirst, aK);
+    aCP.Reset();
+    aCP.SetPoint(aPk);
+    aCP.SetVertex(aVk);
+    aCP.SetTolerance(aTk);
+    aCPk = aCP;
+  }
+  const int IVs = DStr.AddShape(theVs);
+  const int IP1 = ChFi3d_IndexPointInDS(Fd->Vertex(isfirst, 1), DStr);
+  const int IP2 = ChFi3d_IndexPointInDS(Fd->Vertex(isfirst, 2), DStr);
+  const int IGj = DStr.AddShape(theGj);
+  const int IFk = DStr.AddShape(theGk.IsNull() ? aFk : theGk);
+
+  occ::handle<ChFiDS_Stripe>   corner = new ChFiDS_Stripe();
+  occ::handle<ChFiDS_SurfData> coin   = new ChFiDS_SurfData();
+  corner->ChangeSetOfSurfData()       = new NCollection_HSequence<occ::handle<ChFiDS_SurfData>>();
+  corner->ChangeSetOfSurfData()->Append(coin);
+  coin->ChangeSurf(DStr.AddSurface(TopOpeBRepDS_Surface(aPlane, 0.)));
+  {
+    // The edge on Gj is used in the cap with the opposite orientation: the
+    // cap is oriented so that it lies on the left of the arc in the plane
+    // when the arc is reversed in Gj.
+    double aCu = 0., aCv = 0.;
+    ElSLib::Parameters(aPlane->Pln(), gp_Pnt((aMid.XYZ() + aPVs.XYZ()) * 0.5), aCu, aCv);
+    const TopAbs_Orientation anOnG = TopAbs::Compose(anOrArcG, theGj.Orientation());
+    const TopAbs_Orientation anOnP = OrientationFromSide(aPCArcOnP, gp_Pnt2d(aCu, aCv));
+    coin->ChangeOrientation() = TopAbs::Reverse(anOnG) == anOnP ? TopAbs_FORWARD : TopAbs_REVERSED;
+  }
+  coin->ChangeIndexOfS1(IGj);
+  coin->ChangeIndexOfS2(IFk);
+  ChFiDS_FaceInterference& aCFi1 = coin->ChangeInterferenceOnS1();
+  aCFi1.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(aCArc, tolapp3d)),
+                        anOrArcG,
+                        aPCArcOnG,
+                        aPCArcOnP);
+  aCFi1.SetFirstParameter(aArcF);
+  aCFi1.SetLastParameter(aArcL);
+  ChFiDS_FaceInterference& aCFi2 = coin->ChangeInterferenceOnS2();
+  aCFi2.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(aCLine, tolapp3d)),
+                        anOrLineK,
+                        aPCLineOnK,
+                        aPCLineOnP);
+  aCFi2.SetFirstParameter(aLineF);
+  aCFi2.SetLastParameter(aLineL);
+  ChFiDS_CommonPoint aCPVs;
+  aCPVs.SetPoint(aPVs);
+  aCPVs.SetVertex(theVs);
+  aCPVs.SetTolerance(BRep_Tool::Tolerance(theVs));
+  coin->ChangeVertexFirstOnS1() = aCPj;
+  coin->ChangeVertexFirstOnS2() = aCPk;
+  coin->ChangeVertexLastOnS1()  = aCPVs;
+  coin->ChangeVertexLastOnS2()  = aCPVs;
+
+  // The section between the fillet and the cap.
+  const int ISec = DStr.AddCurve(TopOpeBRepDS_Curve(aCSec, aTolSec));
+  const int IPj  = theJ == 1 ? IP1 : IP2;
+  const int IPk  = theJ == 1 ? IP2 : IP1;
+  // the point Vs: a degenerated section of the cap
+  double aUVs = 0., aVVs = 0.;
+  ElSLib::Parameters(aPlane->Pln(), aPVs, aUVs, aVVs);
+  const gp_Pnt2d                  aUVVs(aUVs, aVVs);
+  const occ::handle<Geom2d_Curve> aPCDeg = new Geom2d_Line(aUVVs, gp::DX2d());
+  const int                       IDeg   = DStr.AddCurve(TopOpeBRepDS_Curve(aCLine, tolapp3d));
+  corner->ChangeFirstCurve(ISec);
+  corner->ChangeFirstPCurve() = aPCSecOnP;
+  corner->ChangeFirstParameters(aSec1, aSec2);
+  corner->ChangeIndexFirstPointOnS1(IPj);
+  corner->ChangeIndexFirstPointOnS2(IPk);
+  if (theJ == 2)
+  {
+    corner->SetOrientation(TopAbs_REVERSED, true);
+  }
+  corner->ChangeLastCurve(IDeg);
+  corner->ChangeLastPCurve() = aPCDeg;
+  corner->ChangeLastParameters(0., 0.);
+  corner->ChangeIndexLastPointOnS1(IVs);
+  corner->ChangeIndexLastPointOnS2(IVs);
+  corner->SetSolidIndex(stripe->SolidIndex());
+  corner->ChangeSpine() = new ChFiDS_Spine();
+  corner->ChangeSpine()->SetEdges(anE1);
+
+  // The fillet ends on the section.
+  stripe->SetCurve(ISec, isfirst);
+  stripe->ChangePCurve(isfirst) = aPCSecOnFil;
+  stripe->SetParameters(isfirst, aSec1, aSec2);
+  stripe->SetIndexPoint(IP1, isfirst, 1);
+  stripe->SetIndexPoint(IP2, isfirst, 2);
+  if (!myEVIMap.IsBound(Vtx))
+  {
+    myEVIMap.Bind(Vtx, NCollection_List<int>());
+  }
+  myEVIMap.ChangeFind(Vtx).Append(coin->Surf());
+  myListStripe.Append(corner);
+  return true;
+}
+
+//=================================================================================================
+
+// Moves theCurve by whole periods of theSurf so that its value at theParam
+// is the nearest to theRef.
+static void ShiftToPeriod(const occ::handle<Geom_Surface>& theSurf,
+                          const occ::handle<Geom2d_Curve>& theCurve,
+                          const double                     theParam,
+                          const gp_Pnt2d&                  theRef)
+{
+  const gp_Pnt2d aP = theCurve->Value(theParam);
+  gp_Vec2d       aShift(0., 0.);
+  if (theSurf->IsUPeriodic())
+  {
+    const double aPer = theSurf->UPeriod();
+    aShift.SetX(aPer * std::round((theRef.X() - aP.X()) / aPer));
+  }
+  if (theSurf->IsVPeriodic())
+  {
+    const double aPer = theSurf->VPeriod();
+    aShift.SetY(aPer * std::round((theRef.Y() - aP.Y()) / aPer));
+  }
+  if (aShift.SquareMagnitude() > 0.)
+  {
+    theCurve->Translate(aShift);
+  }
+}
+
+// Same for a point.
+static gp_Pnt2d PointInPeriod(const occ::handle<Geom_Surface>& theSurf,
+                              const gp_Pnt2d&                  thePnt,
+                              const gp_Pnt2d&                  theRef)
+{
+  gp_Pnt2d aP = thePnt;
+  if (theSurf->IsUPeriodic())
+  {
+    const double aPer = theSurf->UPeriod();
+    aP.SetX(aP.X() + aPer * std::round((theRef.X() - aP.X()) / aPer));
+  }
+  if (theSurf->IsVPeriodic())
+  {
+    const double aPer = theSurf->VPeriod();
+    aP.SetY(aP.Y() + aPer * std::round((theRef.Y() - aP.Y()) / aPer));
+  }
+  return aP;
+}
+
+// Parameters of a point of a surface, by projection.
+static bool ProjectOnSurface(const Adaptor3d_Surface& theSurf,
+                             const gp_Pnt&            thePnt,
+                             const double             theTol,
+                             gp_Pnt2d&                theUV)
+{
+  Extrema_ExtPS anExt(thePnt,
+                      theSurf,
+                      Precision::PConfusion(),
+                      Precision::PConfusion(),
+                      Extrema_ExtFlag_MIN);
+  if (!anExt.IsDone() || anExt.NbExt() == 0)
+  {
+    return false;
+  }
+  int aBest = 1;
+  for (int i = 2; i <= anExt.NbExt(); ++i)
+  {
+    if (anExt.SquareDistance(i) < anExt.SquareDistance(aBest))
+    {
+      aBest = i;
+    }
+  }
+  if (anExt.SquareDistance(aBest) > theTol * theTol)
+  {
+    return false;
+  }
+  double u, v;
+  anExt.Point(aBest).Parameter(u, v);
+  theUV.SetCoord(u, v);
+  return true;
+}
+
+// Intersection curve of a fillet surface and the surface of a face, from
+// the points (theFil0, theSrf0) to (theFil1, theSrf1). Where the surfaces
+// are tangent (the fillet reaches the face along a support tangent to it)
+// the intersection stops short of the point: the curve is then completed
+// up to it on the fillet.
+// The intersection of a fillet with a surface may be approximated far from
+// the surfaces: its points are brought onto both surfaces and the curve is
+// interpolated on the fillet. The result replaces the curves when closer.
+static void RefineCut(const occ::handle<GeomAdaptor_Surface>& theFil,
+                      const occ::handle<Geom_Surface>&        theFilSurf,
+                      const occ::handle<Geom_Surface>&        theSrfSurf,
+                      const gp_Pnt2d&                         theFil0,
+                      const gp_Pnt2d&                         theFil1,
+                      const gp_Pnt2d&                         theSrf0,
+                      const double                            theTol3d,
+                      occ::handle<Geom_Curve>&                theC3d,
+                      occ::handle<Geom2d_Curve>&              thePcFil,
+                      occ::handle<Geom2d_Curve>&              thePcSrf,
+                      double&                                 theTolReached)
+{
+  const int                    aNb = 60;
+  const double                 aW0 = theC3d->FirstParameter(), aW1 = theC3d->LastParameter();
+  NCollection_Array1<gp_Pnt2d> aUVf_s(1, aNb + 1);
+  NCollection_Array1<double>   aPars(1, aNb + 1);
+  GeomAdaptor_Surface          aSrf(theSrfSurf);
+  Extrema_GenLocateExtPS       aLocF(*theFil), aLocS(aSrf);
+  for (int i = 0; i <= aNb; ++i)
+  {
+    const double aW = aW0 + (aW1 - aW0) * i / aNb;
+    aPars(i + 1)    = aW;
+    if (i == 0 || i == aNb)
+    {
+      aUVf_s(i + 1) = i == 0 ? theFil0 : theFil1;
+      continue;
+    }
+    gp_Pnt2d aUVf = thePcFil->Value(aW);
+    gp_Pnt2d aUVs = thePcSrf->Value(aW);
+    for (int k = 0; k < 50; ++k)
+    {
+      const gp_Pnt aPf = theFil->Value(aUVf.X(), aUVf.Y());
+      aLocS.Perform(aPf, aUVs.X(), aUVs.Y());
+      if (!aLocS.IsDone())
+      {
+        return;
+      }
+      aLocS.Point().Parameter(aUVs.ChangeCoord().ChangeCoord(1), aUVs.ChangeCoord().ChangeCoord(2));
+      const gp_Pnt aPs = aLocS.Point().Value();
+      // The middle of the two points, on the fillet.
+      const gp_Pnt aPm((aPf.XYZ() + aPs.XYZ()) * 0.5);
+      aLocF.Perform(aPm, aUVf.X(), aUVf.Y());
+      if (!aLocF.IsDone())
+      {
+        return;
+      }
+      aLocF.Point().Parameter(aUVf.ChangeCoord().ChangeCoord(1), aUVf.ChangeCoord().ChangeCoord(2));
+      if (aPf.Distance(aPs) < 0.01 * theTol3d)
+      {
+        break;
+      }
+    }
+    aUVf_s(i + 1) = aUVf;
+  }
+  occ::handle<Geom2d_Curve> aFil2d;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    occ::handle<NCollection_HArray1<gp_Pnt2d>> aPnts =
+      new NCollection_HArray1<gp_Pnt2d>(aUVf_s.Lower(), aUVf_s.Upper());
+    occ::handle<NCollection_HArray1<double>> aPrm =
+      new NCollection_HArray1<double>(aPars.Lower(), aPars.Upper());
+    for (int i = aUVf_s.Lower(); i <= aUVf_s.Upper(); ++i)
+    {
+      aPnts->SetValue(i, aUVf_s(i));
+      aPrm->SetValue(i, aPars(i));
+    }
+    Geom2dAPI_Interpolate anInterp(aPnts, aPrm, false, Precision::PConfusion());
+    anInterp.Perform();
+    if (!anInterp.IsDone())
+    {
+      return;
+    }
+    aFil2d = anInterp.Curve();
+  }
+  catch (Standard_Failure const&)
+  {
+    return;
+  }
+  occ::handle<Geom_Curve> aC3d;
+  {
+    Adaptor3d_CurveOnSurface aCOnS(new Geom2dAdaptor_Curve(aFil2d), theFil);
+    double                   aMaxDev = 0., anAvDev = 0.;
+    GeomLib::BuildCurve3d(theTol3d, aCOnS, aW0, aW1, aC3d, aMaxDev, anAvDev);
+    if (aC3d.IsNull())
+    {
+      return;
+    }
+  }
+  double                    aTolP = theTol3d;
+  occ::handle<Geom2d_Curve> aPcS  = GeomProjLib::Curve2d(aC3d, aW0, aW1, theSrfSurf, aTolP);
+  if (aPcS.IsNull())
+  {
+    return;
+  }
+  ShiftToPeriod(theSrfSurf, aPcS, aW0, theSrf0);
+  double aDev = 0.;
+  for (int i = 0; i <= 200; ++i)
+  {
+    const double   aW  = aW0 + (aW1 - aW0) * i / 200.;
+    const gp_Pnt   aP  = aC3d->Value(aW);
+    const gp_Pnt2d aUf = aFil2d->Value(aW);
+    const gp_Pnt2d aUs = aPcS->Value(aW);
+    aDev               = std::max(aDev, aP.Distance(theFilSurf->Value(aUf.X(), aUf.Y())));
+    aDev               = std::max(aDev, aP.Distance(theSrfSurf->Value(aUs.X(), aUs.Y())));
+  }
+  if (aDev < theTolReached)
+  {
+    theC3d        = aC3d;
+    thePcFil      = aFil2d;
+    thePcSrf      = aPcS;
+    theTolReached = std::max(aDev, theTol3d);
+  }
+}
+
+static bool CutFillet(const occ::handle<GeomAdaptor_Surface>& theFil,
+                      const occ::handle<BRepAdaptor_Surface>& theSrf,
+                      const occ::handle<Geom_Surface>&        theFilSurf,
+                      const occ::handle<Geom_Surface>&        theSrfSurf,
+                      const gp_Pnt2d&                         theFil0,
+                      const gp_Pnt2d&                         theSrf0,
+                      const gp_Pnt2d&                         theFil1,
+                      const gp_Pnt2d&                         theSrf1,
+                      const double                            theTol3d,
+                      const double                            theTol2d,
+                      const double                            theTolEnds,
+                      const occ::handle<Geom2d_Curve>&        theFil1Side,
+                      occ::handle<Geom_Curve>&                theC3d,
+                      occ::handle<Geom2d_Curve>&              thePcFil,
+                      occ::handle<Geom2d_Curve>&              thePcSrf,
+                      double&                                 theTolReached)
+{
+  NCollection_Array1<double> aDeb(1, 4), aFin(1, 4);
+  aDeb(1) = theFil0.X();
+  aDeb(2) = theFil0.Y();
+  aDeb(3) = theSrf0.X();
+  aDeb(4) = theSrf0.Y();
+  aFin(1) = theFil1.X();
+  aFin(2) = theFil1.Y();
+  aFin(3) = theSrf1.X();
+  aFin(4) = theSrf1.Y();
+  try
+  {
+    OCC_CATCH_SIGNALS
+    if (!ChFi3d_ComputeCurves(theFil,
+                              theSrf,
+                              aDeb,
+                              aFin,
+                              theC3d,
+                              thePcFil,
+                              thePcSrf,
+                              theTol3d,
+                              theTol2d,
+                              theTolReached))
+    {
+      return false;
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+  if (theTolReached > 2. * theTol3d)
+  {
+    RefineCut(theFil,
+              theFilSurf,
+              theSrfSurf,
+              theFil0,
+              theFil1,
+              theSrf0,
+              theTol3d,
+              theC3d,
+              thePcFil,
+              thePcSrf,
+              theTolReached);
+  }
+  const gp_Pnt aP0     = theFil->Value(theFil0.X(), theFil0.Y());
+  const gp_Pnt aP1     = theFil->Value(theFil1.X(), theFil1.Y());
+  const double aGap0   = theC3d->Value(theC3d->FirstParameter()).Distance(aP0);
+  const double aGap1   = theC3d->Value(theC3d->LastParameter()).Distance(aP1);
+  const double aSinMin = std::sin(15. * M_PI / 180.);
+  // The curve may also reach theFil1 along its side, touching or crossing
+  // it just before the end. A point is away from that side if it is on the
+  // side of theFil0 and far enough from it, seen from theFil1.
+  const auto isAway = [&](const gp_Pnt2d& theP, const double theSign) -> bool {
+    // The nearest point of the side, its ends included.
+    const double aT0 = theFil1Side->FirstParameter(), aT1 = theFil1Side->LastParameter();
+    double       aT =
+      theFil1Side->Value(aT0).Distance(theP) < theFil1Side->Value(aT1).Distance(theP) ? aT0 : aT1;
+    double                        aDist = theFil1Side->Value(aT).Distance(theP);
+    Geom2dAPI_ProjectPointOnCurve aProj(theP, theFil1Side, aT0, aT1);
+    if (aProj.NbPoints() > 0 && aProj.LowerDistance() < aDist)
+    {
+      aT    = aProj.LowerDistanceParameter();
+      aDist = aProj.LowerDistance();
+    }
+    gp_Pnt2d aPs;
+    gp_Vec2d aTs;
+    theFil1Side->D1(aT, aPs, aTs);
+    const double aSide = aTs.Crossed(gp_Vec2d(aPs, theP));
+    return aSide * theSign >= 0. && aDist >= aSinMin * theP.Distance(theFil1);
+  };
+  double aSign       = 0.;
+  bool   isAlongSide = false;
+  if (!theFil1Side.IsNull())
+  {
+    Geom2dAPI_ProjectPointOnCurve aProj0(theFil0,
+                                         theFil1Side,
+                                         theFil1Side->FirstParameter(),
+                                         theFil1Side->LastParameter());
+    if (aProj0.NbPoints() > 0)
+    {
+      gp_Pnt2d aPs;
+      gp_Vec2d aTs;
+      theFil1Side->D1(aProj0.LowerDistanceParameter(), aPs, aTs);
+      aSign = aTs.Crossed(gp_Vec2d(aPs, theFil0)) >= 0. ? 1. : -1.;
+    }
+    const double aFirstPar = theC3d->FirstParameter();
+    const double aLastPar0 = theC3d->LastParameter();
+    for (int i = 1; i < 1000 && !isAlongSide; ++i)
+    {
+      isAlongSide =
+        !isAway(thePcFil->Value(aFirstPar + (aLastPar0 - aFirstPar) * 0.001 * i), aSign);
+    }
+  }
+  // Ends farther than the approximation tolerance are completed.
+  if (aGap0 <= theTol3d && aGap1 <= theTol3d && !isAlongSide)
+  {
+    return true;
+  }
+  // Only a short end lost along a tangency is completed, by a straight
+  // segment in the parameters of the fillet: the curve stays on the fillet
+  // and inside its face, its distance to the other surface is small there.
+  const double aLength = aP0.Distance(aP1);
+  if (aGap0 > 0.05 * aLength || aGap1 > 0.05 * aLength)
+  {
+    return false;
+  }
+  // Near a tangency the intersection runs along the side of the fillet that
+  // ends at theFil1: the curve is taken back to where the segment up to
+  // theFil1 leaves that side at an angle.
+  double aLastPar = theC3d->LastParameter();
+  if ((aGap1 > theTol3d || isAlongSide) && !theFil1Side.IsNull())
+  {
+    const double aFirstPar = theC3d->FirstParameter();
+    for (int i = 1; i <= 100; ++i)
+    {
+      const double aW = aLastPar - (aLastPar - aFirstPar) * 0.005 * i;
+      if (isAway(thePcFil->Value(aW), aSign))
+      {
+        aLastPar = aW;
+        break;
+      }
+      if (i == 100)
+      {
+        return false;
+      }
+    }
+  }
+  occ::handle<Geom2d_BSplineCurve> aFil2d;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    aFil2d = Geom2dConvert::CurveToBSplineCurve(
+      new Geom2d_TrimmedCurve(thePcFil, theC3d->FirstParameter(), aLastPar));
+    Geom2dConvert_CompCurveToBSplineCurve aComp(aFil2d);
+    if (aGap0 > theTol3d)
+    {
+      const gp_Pnt2d aFrom = aFil2d->Value(aFil2d->FirstParameter());
+      if (aFrom.Distance(theFil0) > Precision::PConfusion())
+      {
+        aComp.Add(
+          new Geom2d_TrimmedCurve(new Geom2d_Line(theFil0, gp_Dir2d(gp_Vec2d(theFil0, aFrom))),
+                                  0.,
+                                  theFil0.Distance(aFrom)),
+          Precision::PConfusion(),
+          false);
+      }
+    }
+    if (aGap1 > theTol3d || aLastPar < theC3d->LastParameter())
+    {
+      const gp_Pnt2d aFrom = aFil2d->Value(aFil2d->LastParameter());
+      if (aFrom.Distance(theFil1) > Precision::PConfusion())
+      {
+        aComp.Add(
+          new Geom2d_TrimmedCurve(new Geom2d_Line(aFrom, gp_Dir2d(gp_Vec2d(aFrom, theFil1))),
+                                  0.,
+                                  aFrom.Distance(theFil1)),
+          Precision::PConfusion(),
+          true);
+      }
+    }
+    aFil2d = aComp.BSplineCurve();
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+  occ::handle<Geom_Curve> aBC;
+  {
+    Adaptor3d_CurveOnSurface aCOnS(new Geom2dAdaptor_Curve(aFil2d), theFil);
+    double                   aMaxDev = 0., anAvDev = 0.;
+    GeomLib::BuildCurve3d(theTol3d,
+                          aCOnS,
+                          aFil2d->FirstParameter(),
+                          aFil2d->LastParameter(),
+                          aBC,
+                          aMaxDev,
+                          anAvDev);
+    if (aBC.IsNull())
+    {
+      return false;
+    }
+  }
+  double                    aTolS = theTol3d;
+  occ::handle<Geom2d_Curve> aPcF  = aFil2d;
+  occ::handle<Geom2d_Curve> aPcS =
+    GeomProjLib::Curve2d(aBC, aBC->FirstParameter(), aBC->LastParameter(), theSrfSurf, aTolS);
+  if (aPcS.IsNull())
+  {
+    return false;
+  }
+  ShiftToPeriod(theSrfSurf, aPcS, aBC->FirstParameter(), theSrf0);
+  // The tolerance is the distance of the curve to the two surfaces.
+  double aDev = aTolS;
+  for (int i = 0; i <= 40; ++i)
+  {
+    const double aW =
+      aBC->FirstParameter() + (aBC->LastParameter() - aBC->FirstParameter()) * i / 40.;
+    const gp_Pnt   aP  = aBC->Value(aW);
+    const gp_Pnt2d aUf = aPcF->Value(aW);
+    const gp_Pnt2d aUs = aPcS->Value(aW);
+    aDev               = std::max(aDev, aP.Distance(theFilSurf->Value(aUf.X(), aUf.Y())));
+    aDev               = std::max(aDev, aP.Distance(theSrfSurf->Value(aUs.X(), aUs.Y())));
+  }
+  if (aBC->Value(aBC->FirstParameter()).Distance(aP0) > theTolEnds
+      || aBC->Value(aBC->LastParameter()).Distance(aP1) > theTolEnds)
+  {
+    return false;
+  }
+  aDev          = std::max(aDev, aBC->Value(aBC->FirstParameter()).Distance(aP0));
+  aDev          = std::max(aDev, aBC->Value(aBC->LastParameter()).Distance(aP1));
+  theC3d        = aBC;
+  thePcFil      = aPcF;
+  thePcSrf      = aPcS;
+  theTolReached = std::max(theTolReached, aDev);
+  return true;
+}
+
+// Orientation of the curve of a surfdata on the side theOnS, computed as in
+// ChFi3d_FilDS from the interference of the side 1 (or 2 without face on 1).
+static TopAbs_Orientation TransitionOnFillet(const TopOpeBRepDS_DataStructure&   theDStr,
+                                             const occ::handle<ChFiDS_SurfData>& theFd,
+                                             const int                           theOnS)
+{
+  const int                      anIs1 = theFd->IndexOfS1() > 0 ? 1 : 2;
+  const ChFiDS_FaceInterference& aFi   = theFd->Interference(anIs1);
+  TopAbs_Orientation             aTr   = theDStr.Shape(theFd->Index(anIs1)).Orientation();
+  aTr =
+    TopAbs::Compose(TopAbs::Reverse(aFi.Transition()), TopAbs::Compose(aTr, theFd->Orientation()));
+  return theOnS == anIs1 ? aTr : TopAbs::Reverse(aTr);
+}
+
+// The face of theFaces (the faces of an edge) other than theF.
+static TopoDS_Face OtherFace(const NCollection_List<TopoDS_Shape>& theFaces,
+                             const TopoDS_Face&                    theF)
+{
+  TopoDS_Face aRes;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theFaces); anIt.More(); anIt.Next())
+  {
+    if (!theF.IsSame(anIt.Value()))
+    {
+      aRes = TopoDS::Face(anIt.Value());
+    }
+  }
+  return aRes;
+}
+
+// The edge at the vertex common to two faces.
+static TopoDS_Edge CommonEdge(const NCollection_List<TopoDS_Shape>& theEdges,
+                              const TopoDS_Face&                    theF1,
+                              const TopoDS_Face&                    theF2)
+{
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theEdges); anIt.More(); anIt.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anIt.Value());
+    if (!BRep_Tool::Degenerated(anE) && IsEdgeOfFace(anE, theF1) && IsEdgeOfFace(anE, theF2))
+    {
+      return anE;
+    }
+  }
+  return TopoDS_Edge();
+}
+
+// Where the straight section from theAd to theOp on the fillet theFil
+// crosses theSurf, the nearest to theAd.
+static bool CrossSection(const occ::handle<GeomAdaptor_Surface>& theFil,
+                         const gp_Pnt2d&                         theAd,
+                         const gp_Pnt2d&                         theOp,
+                         const occ::handle<Adaptor3d_Surface>&   theSurf,
+                         gp_Pnt2d&                               theUV)
+{
+  const double aLen = theAd.Distance(theOp);
+  if (aLen < Precision::PConfusion())
+  {
+    return false;
+  }
+  occ::handle<Geom2d_Line> aSec = new Geom2d_Line(theAd, gp_Dir2d(gp_Vec2d(theAd, theOp)));
+  occ::handle<Adaptor3d_CurveOnSurface> aSec3d =
+    new Adaptor3d_CurveOnSurface(new Geom2dAdaptor_Curve(aSec, 0., aLen), theFil);
+  IntCurveSurface_HInter anInter;
+  anInter.Perform(aSec3d, theSurf);
+  if (!anInter.IsDone())
+  {
+    return false;
+  }
+  double aBest = RealLast();
+  for (int i = 1; i <= anInter.NbPoints(); ++i)
+  {
+    const double aW = anInter.Point(i).W();
+    if (aW > 1.e-3 * aLen && aW < (1. - 1.e-3) * aLen && aW < aBest)
+    {
+      aBest = aW;
+    }
+  }
+  if (aBest == RealLast())
+  {
+    return false;
+  }
+  theUV = aSec->Value(aBest);
+  return true;
+}
+
+// CutFillet from theFil0/theSrf0 towards theFil1/theSrf1, the end of the
+// stripe: the cut goes in the direction of the surfdata, reversed at the
+// start of the stripe (theIsFirst). theSide, the side the cut may have to
+// be completed along at theFil1, is only used at the end of the stripe.
+static bool CutFilletAlong(const bool                              theIsFirst,
+                           const occ::handle<GeomAdaptor_Surface>& theFil,
+                           const occ::handle<BRepAdaptor_Surface>& theSrf,
+                           const occ::handle<Geom_Surface>&        theSrfSurf,
+                           const gp_Pnt2d&                         theFil0,
+                           const gp_Pnt2d&                         theSrf0,
+                           const gp_Pnt2d&                         theFil1,
+                           const gp_Pnt2d&                         theSrf1,
+                           const double                            theTol3d,
+                           const double                            theTol2d,
+                           const double                            theTolEnds,
+                           const occ::handle<Geom2d_Curve>&        theSide,
+                           occ::handle<Geom_Curve>&                theC3d,
+                           occ::handle<Geom2d_Curve>&              thePcFil,
+                           occ::handle<Geom2d_Curve>&              thePcSrf,
+                           double&                                 theTolReached)
+{
+  return theIsFirst ? CutFillet(theFil,
+                                theSrf,
+                                theFil->Surface(),
+                                theSrfSurf,
+                                theFil1,
+                                theSrf1,
+                                theFil0,
+                                theSrf0,
+                                theTol3d,
+                                theTol2d,
+                                theTolEnds,
+                                occ::handle<Geom2d_Curve>(),
+                                theC3d,
+                                thePcFil,
+                                thePcSrf,
+                                theTolReached)
+                    : CutFillet(theFil,
+                                theSrf,
+                                theFil->Surface(),
+                                theSrfSurf,
+                                theFil0,
+                                theSrf0,
+                                theFil1,
+                                theSrf1,
+                                theTol3d,
+                                theTol2d,
+                                theTolEnds,
+                                theSide,
+                                theC3d,
+                                thePcFil,
+                                thePcSrf,
+                                theTolReached);
+}
+
+// Splits theFprev at CP1, where its side theIad leaves its face on theArcA:
+// returns its end part theFb, on its own copy of the surface and of the
+// trace of the side iop; theFprev ends at CP1.
+static occ::handle<ChFiDS_SurfData> SplitAtCP1(TopOpeBRepDS_DataStructure&         theDStr,
+                                               const occ::handle<ChFiDS_SurfData>& theFprev,
+                                               const int                           theIad,
+                                               const bool                          theIsFirst,
+                                               const double                        theWCut,
+                                               const ChFiDS_CommonPoint&           theCP1,
+                                               const int                           theTraceOp,
+                                               const double                        theTolPnt)
+{
+  const int                    iop = 3 - theIad;
+  occ::handle<ChFiDS_SurfData> aFb = new ChFiDS_SurfData();
+  aFb->Copy(theFprev);
+  // A copy of the surface: two faces of one surface would share the pcurves
+  // of their edges.
+  const TopOpeBRepDS_Surface&     aPrevSurf = theDStr.Surface(theFprev->Surf());
+  const occ::handle<Geom_Surface> aSurfB =
+    occ::down_cast<Geom_Surface>(aPrevSurf.Surface()->Copy());
+  aFb->ChangeSurf(theDStr.AddSurface(TopOpeBRepDS_Surface(aSurfB, aPrevSurf.Tolerance())));
+  const occ::handle<Geom_Curve>& aTraceOp = theDStr.Curve(theTraceOp).Curve();
+  aFb->ChangeInterference(iop).SetLineIndex(
+    theDStr.AddCurve(TopOpeBRepDS_Curve(aTraceOp, theDStr.Curve(theTraceOp).Tolerance())));
+  aFb->ChangeInterference(iop).SetParameter(theWCut, !theIsFirst);
+  // The points of the corner get the tolerance of its curves: the one of CP1
+  // may come from the end of the walking on the tangent plane.
+  ChFiDS_CommonPoint aCP1;
+  aCP1.SetPoint(theCP1.Point());
+  aCP1.SetArc(std::max(theTolPnt, BRep_Tool::Tolerance(theCP1.Arc())),
+              theCP1.Arc(),
+              theCP1.ParameterOnArc(),
+              theCP1.TransitionOnArc());
+  aCP1.SetParameter(theCP1.Parameter());
+  ChFiDS_CommonPoint aCP1b;
+  aCP1b.SetPoint(aTraceOp->Value(theWCut));
+  aCP1b.SetParameter(theWCut);
+  aCP1b.SetTolerance(theTolPnt);
+  aFb->ChangeVertex(!theIsFirst, theIad)     = aCP1;
+  aFb->ChangeVertex(!theIsFirst, iop)        = aCP1b;
+  theFprev->ChangeVertex(theIsFirst, theIad) = aCP1;
+  theFprev->ChangeInterference(iop).SetParameter(theWCut, theIsFirst);
+  theFprev->ChangeVertex(theIsFirst, iop) = aCP1b;
+  if (theIsFirst)
+  {
+    aFb->LastSpineParam(theWCut);
+    theFprev->FirstSpineParam(theWCut);
+  }
+  else
+  {
+    aFb->FirstSpineParam(theWCut);
+    theFprev->LastSpineParam(theWCut);
+  }
+  return aFb;
+}
+
+// The section between two consecutive pieces theIn and theOut of the
+// fillet, theOut after theIn from the cut towards the end of the stripe,
+// from the point theX on the side theIad to theOp on the other side.
+static void AddSection(TopOpeBRepDS_DataStructure&         theDStr,
+                       NCollection_List<ChFiDS_Regul>&     theRegul,
+                       const bool                          theIsFirst,
+                       const int                           theIad,
+                       const occ::handle<ChFiDS_SurfData>& theIn,
+                       const occ::handle<ChFiDS_SurfData>& theOut,
+                       const ChFiDS_CommonPoint&           theX,
+                       const ChFiDS_CommonPoint&           theOp,
+                       const int                           theIndX,
+                       const int                           theIndOp,
+                       const gp_Pnt2d&                     theXin,
+                       const gp_Pnt2d&                     theOpIn,
+                       const gp_Pnt2d&                     theXout,
+                       const gp_Pnt2d&                     theOpOut,
+                       const double                        theTol3d,
+                       const double                        theTol2d)
+{
+  const bool                isAd1 = theIad == 1;
+  occ::handle<Geom_Curve>   aSec3d;
+  occ::handle<Geom2d_Curve> aSecIn, aSecOut;
+  double                    aParDeb = 0., aParFin = 0., aTolSec = theTol3d;
+  ChFi3d_ComputeArete(isAd1 ? theX : theOp,
+                      isAd1 ? theXin : theOpIn,
+                      isAd1 ? theOp : theX,
+                      isAd1 ? theOpIn : theXin,
+                      theDStr.Surface(theIn->Surf()).Surface(),
+                      aSec3d,
+                      aSecIn,
+                      aParDeb,
+                      aParFin,
+                      theTol3d,
+                      theTol2d,
+                      aTolSec,
+                      0);
+  double aTolSecO = aTolSec;
+  ChFi3d_ComputePCurv(aSec3d,
+                      isAd1 ? theXout : theOpOut,
+                      isAd1 ? theOpOut : theXout,
+                      aSecOut,
+                      theDStr.Surface(theOut->Surf()).Surface(),
+                      aParDeb,
+                      aParFin,
+                      theTol3d,
+                      aTolSecO);
+  const int ISec = theDStr.AddCurve(TopOpeBRepDS_Curve(aSec3d, std::max(aTolSec, aTolSecO)));
+  theDStr.ChangeCurveInterferences(ISec).Append(
+    ChFi3d_FilPointInDS(TopAbs_FORWARD, ISec, isAd1 ? theIndX : theIndOp, aParDeb));
+  theDStr.ChangeCurveInterferences(ISec).Append(
+    ChFi3d_FilPointInDS(TopAbs_REVERSED, ISec, isAd1 ? theIndOp : theIndX, aParFin));
+  // As in ChFi3d_FilDS: kept as the side 1 at the end of the first
+  // surfdata, and the reverse at the start of the next one.
+  const occ::handle<ChFiDS_SurfData>& aBefore = theIsFirst ? theOut : theIn;
+  const occ::handle<ChFiDS_SurfData>& anAfter = theIsFirst ? theIn : theOut;
+  theDStr.ChangeSurfaceInterferences(aBefore->Surf())
+    .Append(ChFi3d_FilCurveInDS(ISec,
+                                aBefore->Surf(),
+                                aBefore == theIn ? aSecIn : aSecOut,
+                                TransitionOnFillet(theDStr, aBefore, 1)));
+  theDStr.ChangeSurfaceInterferences(anAfter->Surf())
+    .Append(ChFi3d_FilCurveInDS(ISec,
+                                anAfter->Surf(),
+                                anAfter == theIn ? aSecIn : aSecOut,
+                                TopAbs::Reverse(TransitionOnFillet(theDStr, anAfter, 1))));
+  // The two are pieces of one fillet surface.
+  ChFiDS_Regul aRegSec;
+  aRegSec.SetCurve(ISec);
+  aRegSec.SetS1(theIn->Surf(), false);
+  aRegSec.SetS2(theOut->Surf(), false);
+  theRegul.Append(aRegSec);
+}
+
+// The edges of theFv from theArc to the vertex theVtx (also edges of
+// theAlso when it is given) are inside the extended theFv: they are removed
+// as the spine edge, at the vertex.
+static void RemoveEdgesToVertex(TopOpeBRepDS_DataStructure& theDStr,
+                                const TopoDS_Face&          theFv,
+                                const TopoDS_Edge&          theArc,
+                                const TopoDS_Vertex&        theVtx,
+                                const TopoDS_Face&          theAlso)
+{
+  TopoDS_Vertex aVA1, aVA2;
+  TopExp::Vertices(theArc, aVA1, aVA2);
+  TopoDS_Vertex aCur  = BRep_Tool::Pnt(aVA1).Distance(BRep_Tool::Pnt(theVtx))
+                           < BRep_Tool::Pnt(aVA2).Distance(BRep_Tool::Pnt(theVtx))
+                          ? aVA1
+                          : aVA2;
+  TopoDS_Edge   aPrev = theArc;
+  for (int aGuard = 0; aGuard < 10 && !aCur.IsSame(theVtx); ++aGuard)
+  {
+    TopoDS_Edge aNext;
+    for (TopExp_Explorer anExp(theFv, TopAbs_EDGE); anExp.More() && aNext.IsNull(); anExp.Next())
+    {
+      const TopoDS_Edge& anE = TopoDS::Edge(anExp.Current());
+      if (anE.IsSame(aPrev) || BRep_Tool::Degenerated(anE)
+          || (!theAlso.IsNull() && !IsEdgeOfFace(anE, theAlso)))
+      {
+        continue;
+      }
+      TopoDS_Vertex aV1, aV2;
+      TopExp::Vertices(anE, aV1, aV2);
+      if (aV1.IsSame(aCur) || aV2.IsSame(aCur))
+      {
+        aNext = anE;
+      }
+    }
+    if (aNext.IsNull())
+    {
+      break;
+    }
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aNext, aV1, aV2);
+    const TopoDS_Vertex aFar = aV1.IsSame(aCur) ? aV2 : aV1;
+    // Removed from its vertex towards the end of the fillet.
+    TopAbs_Orientation anOV = TopAbs_FORWARD;
+    for (TopExp_Explorer ex(aNext.Oriented(TopAbs_FORWARD), TopAbs_VERTEX); ex.More(); ex.Next())
+    {
+      if (aFar.IsSame(ex.Current()))
+      {
+        anOV = ex.Current().Orientation();
+        break;
+      }
+    }
+    const int IE = theDStr.AddShape(aNext);
+    theDStr.ChangeShapeInterferences(IE).Append(
+      ChFi3d_FilVertexInDS(TopAbs::Reverse(anOV),
+                           IE,
+                           theDStr.AddShape(aFar),
+                           BRep_Tool::Parameter(aFar, aNext)));
+    aPrev = aNext;
+    aCur  = aFar;
+  }
+}
+
+// The arc theArcC is cut at the end theCP of the fillet (the last section
+// is reduced to it, ChFi3d_FilDS does not do it), the spine edge at the
+// vertex.
+static void CutAtEnd(TopOpeBRepDS_DataStructure&      theDStr,
+                     const occ::handle<ChFiDS_Spine>& theSpine,
+                     const bool                       theIsFirst,
+                     const TopoDS_Vertex&             theVtx,
+                     const int                        theIVtx,
+                     const ChFiDS_CommonPoint&        theCP,
+                     const int                        theIndCP)
+{
+  const int IArcC = theDStr.AddShape(theCP.Arc());
+  theDStr.ChangeShapeInterferences(IArcC).Append(
+    ChFi3d_FilPointInDS(theCP.TransitionOnArc(), IArcC, theIndCP, theCP.ParameterOnArc()));
+  const TopoDS_Edge& Arcspine =
+    theIsFirst ? theSpine->Edges(1) : theSpine->Edges(theSpine->NbEdges());
+  TopAbs_Orientation OVtx = TopAbs_FORWARD;
+  for (TopExp_Explorer ex(Arcspine.Oriented(TopAbs_FORWARD), TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    if (theVtx.IsSame(ex.Current()))
+    {
+      OVtx = ex.Current().Orientation();
+      break;
+    }
+  }
+  const int IArcspine = theDStr.AddShape(Arcspine);
+  theDStr.ChangeShapeInterferences(IArcspine).Append(
+    ChFi3d_FilVertexInDS(TopAbs::Reverse(OVtx),
+                         IArcspine,
+                         theIVtx,
+                         BRep_Tool::Parameter(theVtx, Arcspine)));
+}
