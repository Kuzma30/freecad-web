+static bool IsEdgeOfFace(const TopoDS_Edge& theEdge, const TopoDS_Face& theFace)
+{
+  for (TopExp_Explorer anExp(theFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    if (anExp.Current().IsSame(theEdge))
+    {
+      return true;
+    }
+  }
+  return false;
+}
