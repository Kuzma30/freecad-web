+// Python. On the desktop that hardly matters -- a theme is picked up on the next start.
+// In the browser a "restart" is a page reload, which costs the user their session, so the
+// Addon Manager needs to rescan in place after installing a theme.
+PyObject* ApplicationPy::sRescanPreferencePacks(PyObject* /*self*/, PyObject* args)
+{
+    if (!PyArg_ParseTuple(args, "")) {
+        return nullptr;
+    }
+    PY_TRY
+    {
+        Application::Instance->prefPackManager()->rescan();
+        Py_Return;
+    }
+    PY_CATCH
+}
+
+PyObject* ApplicationPy::sListPreferencePacks(PyObject* /*self*/, PyObject* args)
+{
+    if (!PyArg_ParseTuple(args, "")) {
+        return nullptr;
+    }
+    PY_TRY
+    {
+        Py::List names;
+        for (const auto& name : Application::Instance->prefPackManager()->preferencePackNames()) {
+            names.append(Py::String(name));
+        }
+        return Py::new_reference_to(names);
+    }
+    PY_CATCH
+}
+
+PyObject* ApplicationPy::sApplyPreferencePack(PyObject* /*self*/, PyObject* args)
+{
+    const char* name = nullptr;
+    if (!PyArg_ParseTuple(args, "s", &name)) {
+        return nullptr;
+    }
+    PY_TRY
+    {
+        bool ok = Application::Instance->prefPackManager()->apply(std::string(name));
+        return Py::new_reference_to(Py::Boolean(ok));
+    }
+    PY_CATCH
+}
