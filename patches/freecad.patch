+#if defined(__EMSCRIPTEN__)
+// FCWEB: gl_legacy_stubs.c. Park the load for one turn of the browser event loop (JSPI),
+// at most every 100 ms, so the tab paints and Chrome does not call it hung.
+//
+// Every load runs with the GIL held (Gui::Application::open goes through
+// FreeCAD.openDocument), and Python that runs while the load is parked may release the
+// GIL and suspend in turn (PySide releases it around QDialog::exec; the boot gate's
+// network probe did the same): the resumed load then freed a tuple with no thread
+// state -- fatal PyThreadState_Get, gate run 34913239544. So the park is a proper
+// blocking call: the GIL is released before it and taken back after, and if another
+// activation holds it when the turn ends, the load parks again until it is free.
+// Native events that arrived during the park queued in Qt's suspend-resume control
+// (the park holds its resume slot, gl_legacy_stubs.c); they are delivered here,
+// synchronously, exactly where the desktop's progress bar pumps processEvents() --
+// never on a raw stack in the middle of the restore, which asserted in
+// QWasmSuspendResumeControl::sendPendingEvents (2026-09-15). Input stays out: the
+// wait cursor is up and a click into a half-restored document is a desktop bug too.
+extern "C" int fcweb_yield_due(void);
+extern "C" void fcweb_yield_now(void);
+static void fcweb_yield_point()
+{
+    if (!fcweb_yield_due()) {
+        return;
+    }
+    if (PyGILState_Check()) {
+        PyThreadState* ts = PyEval_SaveThread();
+        try { fcweb_yield_now(); } catch (...) {}
+        for (int spin = 0; PyGILState_Check() && spin < 100000; ++spin) {
+            try { fcweb_yield_now(); } catch (...) {}
+        }
+        PyEval_RestoreThread(ts);
+    }
+    else {
+        try { fcweb_yield_now(); } catch (...) {}
+    }
+    QCoreApplication::processEvents(QEventLoop::ExcludeUserInputEvents);
+}
+#endif
