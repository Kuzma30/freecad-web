+    """The in-browser gmsh bridge, or None when running normally.
+
+    FreeCAD-Web has no fork/exec, so the gmsh binary is replaced by a wasm module
+    reached through the _fcwebgmsh builtin. Everything below falls back to the usual
+    binary when this returns None, so desktop behaviour is untouched.
+    """
+    try:
+        import _fcwebgmsh
+    except ImportError:
+        return None
+    try:
+        return _fcwebgmsh if _fcwebgmsh.available() else None
+    except Exception:
+        return None
+
+
+class _FcwebGmshProcess(QtCore.QObject):
+    """Stands in for the QProcess that compute() would normally return.
+
+    femtaskpanels/base_femmeshtaskpanel.py connects to started/finished/
+    readyReadStandardOutput/readyReadStandardError and reads the output with
+    readAllStandardOutput/Error, so the shim carries the same surface. The mesh itself
+    is produced synchronously (the wasm call suspends the interpreter via JSPI and
+    resumes when the module is done), then `finished` is emitted.
+    """
+
+    started = QtCore.Signal()
+    finished = QtCore.Signal(int, int)
+    readyReadStandardOutput = QtCore.Signal()
+    readyReadStandardError = QtCore.Signal()
+
+    def __init__(self, tool):
+        super().__init__()
+        self._tool = tool
+        self._out = b""
+        self._err = b""
+        self._done = False
+        self._rc = 1
+        self._timer = None
+
+    def start(self):
+        # A real QTimer rather than singleShot, because this one has to be cancellable.
+        # The mesher suspends the whole wasm stack (JSPI) while gmsh runs, and a suspended
+        # stack yields to the browser -- so a pending zero-timer fires DURING the mesh and
+        # re-enters _run on a stack that was not entered through a promising export. That
+        # second entry cannot suspend: it dies with "trying to suspend without
+        # WebAssembly.promising", the mesh is never written, and the caller is left reading
+        # a .unv that does not exist. Holding the timer lets waitForFinished stop it before
+        # anything suspends.
+        self._timer = QtCore.QTimer(self)
+        self._timer.setSingleShot(True)
+        self._timer.setInterval(0)
+        self._timer.timeout.connect(self._run)
+        self._timer.start()
+        return self
+
+    def waitForFinished(self, msecs=-1):
+        """The blocking path: ObjectTools.run(blocking=True) waits on this.
+
+        The mesher is synchronous here, so there is nothing to wait for -- run it on this
+        stack, which was entered through the promising fcweb_run_python export and can
+        therefore suspend. The timer is stopped first so it cannot fire mid-suspension.
+        """
+        self._stop_timer()
+        self._run()
+        return self._rc == 0
+
+    def _stop_timer(self):
+        if self._timer is not None:
+            try:
+                self._timer.stop()
+            except Exception:
+                pass
+            self._timer = None
+
+    def _run(self):
+        if self._done:
+            return
+        self._done = True
+        self._stop_timer()
+        self.started.emit()
+        rc = 1
+        try:
+            err = self._tool.run_gmsh_with_geo()
+            rc = 1 if getattr(self._tool, "error", False) else 0
+            if err:
+                self._err = err.encode("utf-8", "replace")
+                self.readyReadStandardError.emit()
+        except Exception as e:
+            self._err = f"{e}\n".encode("utf-8", "replace")
+            self.readyReadStandardError.emit()
+        self._rc = rc
+        # QProcess.NormalExit == 0
+        self.finished.emit(rc, 0)
+
+    # -- the bits the panel calls on the returned object --------------------
+    def readAllStandardOutput(self):
+        out, self._out = self._out, b""
+        return out
+
+    def readAllStandardError(self):
+        err, self._err = self._err, b""
+        return err
+
+    def state(self):
+        return 0  # QProcess.NotRunning
+
+    def kill(self):
+        pass
+
+    terminate = kill
+
+
 
 
