+QString PdfView::pageText(int page) const
+{
+    if (page < 0 || page >= pageCount()) {
+        return {};
+    }
+
+    const QPdfSelection sel = pdfDocument->getAllText(page);
+    return sel.isValid() ? sel.text() : QString();
