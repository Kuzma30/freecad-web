+void PdfView::setupActions()
+{
+    connect(searchEdit, &QLineEdit::textChanged, this, &PdfView::onSearchTextChanged);
+    connect(searchEdit, &QLineEdit::returnPressed, this, &PdfView::onFindNext);
+    connect(nextButton, &QToolButton::clicked, this, &PdfView::onFindNext);
+    connect(prevButton, &QToolButton::clicked, this, &PdfView::onFindPrevious);
+
+    // The key sequences on these actions are only there to show up in the
+    // context menu. Ctrl+C and Ctrl+A also belong to Std_Copy and
+    // Std_SelectAll, and two live shortcuts for one key cancel each other
+    // out, so the keys themselves are taken in event() and keyPressEvent().
+    copyAction = new QAction(this);
+    copyAction->setShortcut(QKeySequence::Copy);
+    copyAction->setShortcutContext(Qt::WidgetWithChildrenShortcut);
+    connect(copyAction, &QAction::triggered, this, &PdfView::onCopySelection);
+    addAction(copyAction);
+
+    selectPageAction = new QAction(this);
+    selectPageAction->setShortcut(QKeySequence::SelectAll);
+    selectPageAction->setShortcutContext(Qt::WidgetWithChildrenShortcut);
+    connect(selectPageAction, &QAction::triggered, pdfView,
+            &PdfSelectionView::selectAllOnCurrentPage);
+    addAction(selectPageAction);
+
+    copyPageAction = new QAction(this);
+    connect(copyPageAction, &QAction::triggered, this, &PdfView::onCopyPageText);
+    addAction(copyPageAction);
+
+    copyAllAction = new QAction(this);
+    connect(copyAllAction, &QAction::triggered, this, &PdfView::onCopyAllText);
+    addAction(copyAllAction);
+
+    insertRegionAction = new QAction(this);
+    insertRegionAction->setEnabled(false);
+    connect(insertRegionAction, &QAction::triggered,
+            this, &PdfView::onInsertRegionAsImagePlane);
+    addAction(insertRegionAction);
+
+    importVectorsAction = new QAction(this);
+    importVectorsAction->setEnabled(false);
+    connect(importVectorsAction, &QAction::triggered,
+            this, &PdfView::onImportRegionAsVectors);
+    addAction(importVectorsAction);
+
+    connect(pdfView, &PdfSelectionView::selectionChanged,
+            this, &PdfView::onSelectionChanged);
+    connect(pdfView, &PdfSelectionView::regionChanged,
+            this, &PdfView::onRegionChanged);
+    connect(regionButton, &QToolButton::toggled,
+            this, &PdfView::onDragModeToggled);
+    connect(bookmarkButton, &QToolButton::toggled, this, [this](bool on) {
+        bookmarkView->setVisible(on);
+    });
+
+    setContextMenuPolicy(Qt::ActionsContextMenu);
+
+    retranslateActions();
+}
