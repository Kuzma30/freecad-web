+    // Page rectangles in document coordinates, i.e. before the scroll offset
+    // is applied, and the pixels-per-point of each.  Recomputing these per
+    // mouse event was quadratic in the page count and made dragging unusable
+    // on long documents.
+    mutable QList<QRectF> layoutCache;
+    mutable QList<qreal> scaleCache;
+    mutable int cachedFirst {-1};
+    mutable int cachedLast {-1};
+    mutable QSize cachedViewport;
+    mutable QPdfView::ZoomMode cachedZoomMode {QPdfView::ZoomMode::Custom};
+    mutable qreal cachedZoom {-1.0};
+
+    DragMode mode {DragMode::SelectText};
+    int regionPageIndex {-1};
+    QRectF region;
+};
