+PdfView::PdfView(QWidget* parent)
+    : MDIView(nullptr, parent)
+    , pdfDocument(new QPdfDocument(this))
+    , searchModel(new QPdfSearchModel(this))
+    , pdfView(new PdfSelectionView(this))
+{
+    setupUi();
+    setupActions();
+
+    bookmarkModel = new QPdfBookmarkModel(this);
+    bookmarkModel->setDocument(pdfDocument);
+    bookmarkView->setModel(bookmarkModel);
+    connect(bookmarkView, &QTreeView::activated, this, &PdfView::onBookmarkActivated);
+
+    // The model fills in after load() has already returned, so wait to be
+    // told rather than asking once and hiding the panel for good.
+    connect(bookmarkModel, &QAbstractItemModel::modelReset,
+            this, &PdfView::updateBookmarkPanel);
+    connect(bookmarkModel, &QAbstractItemModel::rowsInserted,
+            this, &PdfView::updateBookmarkPanel);
+    connect(pdfDocument, &QPdfDocument::statusChanged,
+            this, &PdfView::updateBookmarkPanel);
+    connect(bookmarkModel, &QPdfBookmarkModel::documentChanged,
+            this, &PdfView::updateBookmarkPanel);
+
+    searchModel->setDocument(pdfDocument);
+    // The search model works through the pages on a timer, so results keep
+    // arriving after setSearchString() has returned.
+    connect(searchModel, &QAbstractItemModel::rowsInserted, this, &PdfView::onSearchResultsChanged);
+    connect(searchModel, &QAbstractItemModel::modelReset, this, &PdfView::onSearchResultsChanged);
+    pdfView->setDocument(pdfDocument);
+    pdfView->invalidateLayout();
+#if QT_VERSION >= QT_VERSION_CHECK(6, 5, 0)
+    // Highlighting matches on the page needs Qt 6.5; with 6.4 search still
+    // finds and jumps to them.
+    pdfView->setSearchModel(searchModel);
+#endif
+    pdfView->setPageMode(QPdfView::PageMode::MultiPage);
+
+    connect(pdfView->pageNavigator(), &QPdfPageNavigator::currentPageChanged,
+            this, &PdfView::onPageChanged);
+
+    setWindowIcon(Gui::BitmapFactory().pixmap("document-open"));
+}
+
+PdfView::~PdfView()
+{
+    // ~QWidget deletes the children before ~QObject drops the connections,
+    // and QPdfDocument emits statusChanged() while it closes. Without this
+    // the slots below would run on a view that is already half destroyed.
+    pdfDocument->disconnect(this);
+    searchModel->disconnect(this);
+    bookmarkModel->disconnect(this);
+    pdfView->pageNavigator()->disconnect(this);
+}
